<script src="~/js/modernizr.min.js"></script>
<script src="~/js/jquery.slimscroll.min.js"></script>
<script src="~/js/slidebars.min.js"></script>

<script src="~/plugins/counter/jquery.counterup.min.js"></script>
<script src="~/plugins/waypoints/jquery.waypoints.min.js"></script>
<script src="~/plugins/sparkline-chart/jquery.sparkline.min.js"></script>
<script src="~/pages/jquery.sparkline.init.js"></script>

<script src="~/plugins/chart-js/Chart.bundle.js"></script>
<script src="~/plugins/morris-chart/raphael-min.js"></script>
<script src="~/plugins/morris-chart/morris.js"></script>
<script src="~/pages/dashboard-init.js"></script>



@section Scripts {
    <script src="~/js/jquery.table2excel.js" type="text/javascript"></script>
    <script>
        var barchart;
        var teamChart;
        var divisionChart;
        var prograssChart;

        $(document).ready(function ($) {
            $('#tblTablee').DataTable();
            generateRankWiseOfficersChart();
            divisionWiseOfficers();
            BatchWiseOfficers();
            prograssWiseOfficers();

            $("#myInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $(".specialBranchUnits tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });


            $("#search_employees").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#tbEmplist tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            $('html, body').animate({
                scrollTop: $("#bodySection").offset().top
            });  // }, 2000);

            $("#barChart").click(
                function (evt) {
                    var activePoints = barchart.getSegmentsAtEvent(evt);
                    alert(activePoints);
                }
            );

        });

        function unitEmployees(unitId, rankId, batchId, divisionId, name, count) {
            let titel = name + " (Total- " + count + ")";

            $('#tbEmplist').empty();
            $('#myTabContent').load("/Portfolio/PortfolioDashboard/GetUnitWiseEmployeePortfolioList?unitId=" + unitId + "&rankId=" + rankId + "&batchId=" + batchId + "&divisionId=" + divisionId);
            $('#employeeInformation').modal({ show: true, backdrop: 'static', keyboard: false });
            $('#unitName').text(titel);
        }

        function percentEmployees(id, label) {
            let titel = label;

            $('#tbEmplist').empty();
            $('#myTabContent').load("/Portfolio/PortfolioDashboard/GetPercentPrograssEmployeePortfolioList?status=" + id);
            $('#employeeInformation').modal({ show: true, backdrop: 'static', keyboard: false });
            $('#unitName').text(titel);
        }

        function exportToExcel() {
            var storeId = $('#unitName').html();

            var titleex = storeId;
            var table = $('#tblTable');
            if (table && table.length) {
                var preserveColors = (table.hasClass('table2excel_with_colors') ? true : false);
                $(table).table2excel({
                    exclude: ".noExl",
                    name: "Excel Document Name",
                    filename: titleex + '_' + new Date().toISOString().replace(/[\-\:\.]/g, "") + ".xls",
                    fileext: ".xls",
                    exclude_img: true,
                    exclude_links: true,
                    exclude_inputs: true,
                    preserveColors: preserveColors
                });
            }
        }

        function generateRankWiseOfficersChart() {
            $('#barChart').remove();
            $('.cbarChart').append('<canvas id="barChart" style="display: block;width: 841px;height: 360px;"></canvas>');
            $.get("/global/api/GetRankWiseEmployeeCount", function (data) {
                barchart = new Chart(document.getElementById("barChart"), {
                    type: 'bar',
                    data: {
                        labels: data.allRanks,
                        datasets: [
                            {
                                label: "Total Officer: ",
                                backgroundColor: ["#3e95cd", "#8e5ea2", "#3cba9f", "#e8c3b9", "#c45850", "#c45760"],
                                data: data.noOfEmployees,
                                rankIds: data.rankIds
                            }
                        ]
                    },
                    options: {
                        legend: { display: false },
                        title: {
                            display: true,
                            text: "Rank Wise Officers'"
                        },
                        scales: {
                            yAxes: [{
                                ticks: {
                                    beginAtZero: true
                                }
                            }]
                        },
                        onClick: function (c, i) {
                            e = i[0];
                            var label = this.data.labels[e._index];
                            var y_value = this.data.datasets[0].data[e._index];
                            var rankId = this.data.datasets[0].rankIds[e._index];
                            console.log(y_value);
                            console.log(label);
                            unitEmployees(0, rankId, 0, 0, label, y_value);
                        }




                    }
                });
            })
        }

        function divisionWiseOfficers() {
            $('#morris-donut-chart').remove();
            $('.morrisDonut').append('<div id="morris-donut-chart"></div>');
            $.get("/global/api/GetDivisionWiseEmployeeCount", function (data) {
                divisionChart = Morris.Donut({
                    element: 'morris-donut-chart',
                    data: data,

                    resize: true, colors: ["#3e95cd", "#8e5ea2", "#3cba9f", "#e8c3b9", "#245850", "#445760", "#845760", "#9e5ea2"],
                }).on('click', function (i, row) {
                    unitEmployees(0, 0, 0, row.divId, row.label, row.value);
                });
            })

        }

        function prograssWiseOfficers() {
            $('#prograssOfficers').remove();
            $('.prograssChart').append('<div id="prograssOfficers"></div>');
            $.get("/api/PortfolioDashboard/GetPercentWisePrograss", function (data) {
                prograssChart = Morris.Donut({
                    element: 'prograssOfficers',
                    data: data,

                    resize: true, colors: ["#3e95cd", "#8e5ea2", "#3cba9f", "#e8c3b9", "#245850", "#445760", "#845760", "#9e5ea2"],
                }).on('click', function (i, row) {
                    percentEmployees(row.percents, row.label);
                });
            })

        }

        function BatchWiseOfficers() {
            $('#team-chart').remove();
            $('.teamCompleted').append('<canvas id="team-chart"></canvas>');
            $.get("/global/api/GetBatchWiseEmployeeCount", function (data) {
                teamChart = new Chart(document.getElementById("team-chart"), {
                    type: 'line',
                    data: {
                        labels: data.allBatches,
                        type: 'line', defaultFontFamily: 'Montserrat',
                        datasets: [{
                            data: data.noOfEmployees,
                            batchIds: data.batchIds,
                            label: "",
                            backgroundColor: '#b9dcec',
                            borderColor: '#f572a1',
                            borderWidth: 3.5,
                            pointStyle: 'circle',
                            pointRadius: 5,
                            pointBorderColor: 'transparent',
                            pointBackgroundColor: '#f572a1',
                        }
                            ,]
                    },
                    options: {
                        responsive: true,
                        tooltips: {
                            mode: 'index',
                            titleFontSize: 12,
                            titleFontColor: '#000',
                            bodyFontColor: '#000',
                            backgroundColor: '#fff',
                            titleFontFamily: 'Montserrat',
                            bodyFontFamily: 'Montserrat',
                            cornerRadius: 3,
                            intersect: false,
                        },
                        legend: {
                            display: false,
                            position: 'top',
                            labels: {
                                usePointStyle: true, fontFamily: 'Montserrat',
                            }
                            ,
                        },
                        scales: {
                            xAxes: [{
                                display: true,
                                gridLines: {
                                    display: false, drawBorder: false
                                }
                                , scaleLabel: {
                                    display: false, labelString: 'Month'
                                }
                            }
                            ],
                            yAxes: [{
                                display: true,
                                gridLines: {
                                    display: false,
                                    drawBorder: false
                                }
                                , scaleLabel: {
                                    display: true,
                                    labelString: "officers'"
                                },
                                ticks: {
                                    beginAtZero: true
                                }
                            }
                            ]
                        },
                        onClick: function (c, i) {
                            e = i[0];
                            var label = this.data.labels[e._index];
                            var y_value = this.data.datasets[0].data[e._index];
                            var batchId = this.data.datasets[0].batchIds[e._index];
                            //  console.log(y_value);
                            //   console.log(label);
                            unitEmployees(0, 0, batchId, 0, label, y_value);
                        }
                        , title: {
                            display: false,
                        }
                    }
                }
                );
            })
        }
    </script>
}
