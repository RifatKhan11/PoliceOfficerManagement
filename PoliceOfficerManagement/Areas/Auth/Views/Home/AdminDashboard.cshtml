        <div class="container-fluid">

            <div class="page-head">
                <h4 class="mt-2 mb-2">Dashboard</h4>
            </div>


            <div class="row">
                <div class="col-lg-8 col-sm-12 col-12">
                    <div class="card m-b-30">
                        <div class="card-body">
                            <div class="panel-body cbarChart">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-12 col-12" style="height: 453px;overflow-y:scroll" id="dashHeight">
                    <div class="card m-b-30">
                        <div class="card-body">

                            <div class="table-rep-plugin">
                                <div class="table-responsive" data-pattern="priority-columns">
                                    <table id="tech-companies-1" class="table table-striped specialBranchUnits">
                                        <thead>
                                            <tr>
                                                <form class="search-content class=" fixed-top"">
                                                    <input type="text" class="form-control" name="keyword" id="myInput" placeholder="Search...">
                                                    <span class="searchbuttonDashboard"><i class="ti ti-search"></i></span>
                                                </form>
                                            </tr>
                                            @* @foreach (var unit in Model.unitList)
                                            {

                                                <tr>

                                                    <th style="width:80%"><a href="#" onclick="unitEmployees(@unit.unitId,0,0,0,'@unit.unitName',@unit.count)">@unit.unitName</a></th>
                                                    <th style="width:20%;text-align:right"><a href="#" onclick="unitEmployees(@unit.unitId,0,0,0,'@unit.unitName',@unit.count)">@unit.count</a></th>

                                                </tr>


                                            } *@
                                        </thead>
                                    </table>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

            </div>
            <div class="row mt-5">

                <div class="col-lg-4 col-sm-12">
                    <div class="form-horizontal">

                        <div class="card m-b-30">
                            <div class="card-body">
                                <h5 class="header-title pb-3">Division Wise Officer's</h5>
                                <div class="morrisDonut">
                                    <div id="morris-donut-chart"></div>
                                </div>
                            </div>
                        </div>

                        <div class="card m-b-30">
                            <div class="card-body">
                                <h5 class="header-title pb-3">Progress Wise Officer's</h5>
                                <div class="prograssChart">
                                    <div id="prograssOfficers"></div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="col-lg-8 col-sm-12">
                    <div class="card m-b-30">
                        <div class="card-body">

                            <h5 class="header-title pb-3">Batch Total Completed</h5>
                            <div class="sales-chartbat teamCompleted">
                            </div>

                        </div>
                    </div>
                </div>


                <div class="col-lg-12 col-sm-12">
                    <div class="card m-b-30">
                        <div class="card-body">
                            <h5 class="header-title pb-3"></h5>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="table-responsive">
                                        <table class="table table-hover m-b-0" id="tblTablee">
                                            <thead>
                                                <tr>
