                                                    <td>Rank</td>
                                                    <td>Unit</td>
                                                    <td>BCS Batch</td>
                                                    <td>%</td>
                                                    <td>Action</td>
                                                </tr>
                                            </thead>
                                            <tbody id="tbEmplistt">
                                                @{
                                                    var i = 1;

                                                    var statusMessageColor = "gray";
                                                    var fontcolor = "black";
                                                    string currentStaus = "Ongoing";
                                                    string currentStausColor = "gray";
                                                    @*@foreach (var item in Model.employeeInfosViewModelFor_SPs)
                                                    {
                                                        <tr>
                                                            <td>@i</td>

                                                            <td>@item.nameEnglish</td>
                                                            <td>@item.employeeCode</td>
                                                            <td>@item.rankName</td>
                                                            <td>@item.sectionName</td>
                                                            <td>@item.batchName</td>



                                                            @if (item.statusMark >= 70)
                                                            {
                                                                statusMessageColor = "green";
                                                                fontcolor = "white";
                                                            }
                                                            else if (item.statusMark >= 50 && item.statusMark < 70)
                                                            {
