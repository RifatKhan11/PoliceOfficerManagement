<div class="modal fade bd-example-modal-lg" id="employeeInformation" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1350px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="unitName" style="color:#008000"> </h5>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" style="color: red;">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <button class="btn btn-info btn-sm" onclick="exportToExcel()">Export To Excel</button>
                    </div>
                    <div class="col-md-6">
                        <div class="float-right">
                            <input type="text" class="form-control" name="keyword" id="search_employees" placeholder="Search...">
                            <span class="search-button"><i class="ti ti-search"></i></span>
                        </div>
                    </div>

                </div>

                <div class="tab-content" id="myTabContent" style="height:400px;overflow-y:scroll;width:100%">
                    <div></div>
                </div>
                <br />
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Close</button>
                </div>

            </div>

        </div>
    </div>
</div>


@section Scripts{
    <!-- Responsive and datatable js -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
    <script src="~/js/jquery.table2excel.js" type="text/javascript"></script>
    <link href="~/plugins/morris-chart/morris.css" rel="stylesheet">
    <script src="~/plugins/chart-js/Chart.bundle.js"></script>
    <script src="~/plugins/morris-chart/raphael-min.js"></script>
    <script src="~/plugins/morris-chart/morris.js"></script>
    <script>
        var barchart;
        var teamChart;
        var divisionChart;
        var prograssChart;

        function percentEmployees(id, label) {
            let titel = label;

            $('#tbEmplist').empty();
            $('#myTabContent').load("/Portfolio/PortfolioDashboard/GetPercentPrograssEmployeePortfolioList?status=" + id);
            $('#employeeInformation').modal({ show: true, backdrop: 'static', keyboard: false });
            $('#unitName').text(titel);
        }

        function exportToExcel() {
            var storeId = $('#unitName').html();

            var titleex = storeId;
            var table = $('#tblTable');
            if (table && table.length) {
                var preserveColors = (table.hasClass('table2excel_with_colors') ? true : false);
                $(table).table2excel({
                    exclude: ".noExl",
                    name: "Excel Document Name",
                    filename: titleex + '_' + new Date().toISOString().replace(/[\-\:\.]/g, "") + ".xls",
                    fileext: ".xls",
                    exclude_img: true,
                    exclude_links: true,
                    exclude_inputs: true,
                    preserveColors: preserveColors
                });
            }
        }

        function prograssWiseOfficers() {
            $('#prograssOfficers').remove();
            $('.prograssChart').append('<div id="prograssOfficers"></div>');
            $.get("/api/PortfolioDashboard/GetPercentWisePrograss", function (data) {
                prograssChart = Morris.Donut({
                    element: 'prograssOfficers',
                    data: data,

                    resize: true, colors: ["#3e95cd", "#8e5ea2", "#3cba9f", "#e8c3b9", "#245850", "#445760", "#845760", "#9e5ea2"],
                }).on('click', function (i, row) {
                    percentEmployees(row.percents, row.label);
                });
            })

        }

        function FnLoad() {
            window.location.reload();
        }

        $(document).ready(function ($) {

            prograssWiseOfficers();

            $('#tblMain').DataTable();
            $("#myInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $(".specialBranchUnits tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });


            $("#search_employees").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#tbEmplist tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            $('html, body').animate({
                scrollTop: $("#bodySection").offset().top
            });  // }, 2000);


            generateRankWiseOfficersChart();
        });

        function generateRankWiseOfficersChart() {
            $('#barChart').remove();
            $('.cbarChart').append('<canvas id="barChart" style="display: block;width: 841px;height: 360px;"></canvas>');
            $.get("/global/api/GetRankWiseEmployeeCountChecked", function (data) {
                barchart = new Chart(document.getElementById("barChart"), {
                    type: 'bar',
                    data: {
                        labels: data.allRanks,
                        datasets: [
                            {
                                label: "Total Officer: ",
                                backgroundColor: ["#3e95cd", "#8e5ea2", "#3cba9f", "#e8c3b9", "#c45850", "#c45760"],
                                data: data.noOfEmployees,
                                rankIds: data.rankIds
                            }
                        ]
                    },
                    options: {
                        legend: { display: false },
                        title: {
                            display: true,
                            text: "Rank Wise Checked Officers'"
                        },
                        scales: {
                            yAxes: [{
                                ticks: {
                                    beginAtZero: true
                                }
                            }]
                        },
                        onClick: function (c, i) {
                            e = i[0];
                            var label = this.data.labels[e._index];
                            var y_value = this.data.datasets[0].data[e._index];
                            var rankId = this.data.datasets[0].rankIds[e._index];
                            console.log(y_value);
                            console.log(label);
                            unitEmployees(0, rankId, 0, 0, label, y_value);
                        }

                    }
                });
            })
        }
    </script>
}
