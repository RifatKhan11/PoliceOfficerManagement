@model EmployeePortfolioDashBoardViewModel
@{
    ViewData["Title"] = "PHQ DashBoard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    h5 {
        color: white;
    }

    a {
        color: white;
    }

        a:hover {
            color: aqua;
        }
</style>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12">
                <div class="card text-center text-white" style="background-color:rgb(114,112,0)">
                    <a href="/Employee/EmployeeInfo/EmployeeList">
                        <br />
                        <br />
                        <i class="fa fa-user-circle-o fa-3x "></i><br />
                        <br />
                        <h5>OFFICERS'<br />PORTFOLIO</h5>
                        <br />
                    </a>
                </div>
            </div>
            <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12">
                <div class="card text-center text-white" style="background-color:rgb(16,22,54)">
                    <a href="/InternalPosting/InternalEmployee/EmployeeIndexAdditional">
                        <br />
                        <br />
                        <i class="fa fa-cubes fa-3x "></i><br />
                        <br />
                        <h5>
                            ADDITIONAL<br />
                            CHARGE
                        </h5>
                        <br />
                    </a>
                </div>
            </div>

            <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12">
                <div class="card text-center text-white" style="background-color:rgb(14,87,157)">
                    <a href="/InternalPosting/InternalEmployee/OverDue">
                        <br />
                        <br />
                        <i class="fa fa-database fa-3x "></i><br />
                        <br />
                        <h5>OVER DUE<br />POSTING</h5>
                        <br />
                    </a>
                </div>
            </div>
            <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12">
                <div class="card text-center text-white" style="background-color:rgb(81,96,121)">
                    <a href="/InternalPosting/InternalEmployee/EmployeeIndex">
                        <br />
                        <br />
                        <i class="fa fa-telegram fa-3x "></i><br />
                        <br />
                        <h5>INTERNAL<br /> POSTING</h5>
                        <br />
                    </a>
                </div>
            </div>
        </div>
        <br />
        <div class="row">

            <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12">
                <div class="card text-center text-white" style="background-color:rgb(0,67,20)">
                    <a href="/InternalPosting/InternalEmployee/AssignmentMaster">
                        <br />
                        <br />
                        <i class="fa fa-line-chart fa-3x "></i><br />
                        <br />
                        <h5>@Model.onGoing</h5>
                        <h5>
                            Ongoing
                        </h5>
                        <br />
                    </a>
                </div>
            </div>
            <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12">
                <div class="card text-center text-white" style="background-color:rgb(39,0,106)">
                    <a href="/InternalPosting/InternalEmployee/AssignmentMasterApprove">
                        <br />
                        <br />
                        <i class="fa fa-users fa-3x "></i><br />
                        <br />
                        <h5>@Model.finalSubmit</h5>
                        <h5>
                            Approved
                        </h5>
                        <br />
                    </a>
                </div>
            </div>

            <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12">
                <div class="card text-center text-white" style="background-color:#1e8989">
                    <a href="/InternalPosting/InternalEmployee/AssignmentReturnList">
                        <br />
                        <br />
                        <i class="fa fa-cogs fa-3x "></i><br />
                        <br />
                        <h5>@Model.returned</h5>
                        <h5>Return</h5>
                        <br />
                    </a>
                </div>
            </div>
            <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12">
                <div class="card text-center text-white" style="background-color:rgb(116,56,1)">
                    <a href="/InternalPosting/InternalEmployee/EmployeeListHeadQuater">
                        <br />
                        <br />
                        <i class="fa fa-sitemap fa-3x "></i><br />
                        <br />
                        <h5>@Model.registration</h5>
                        <h5>PHQ</h5>
                        <br />
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
<br />
<br />
<section>
    <!-- body content start-->

    <div class="row" style="display:none">

        @*<div class="col-lg-12 col-sm-12">
                <div class="card m-b-30">
                    <div class="card-body">
                        <h5 class="header-title pb-3 text-dark">Unit Wise Over Due Posting</h5>
                        <div class="panel-body unitChart">

                        </div>
                    </div>
                </div>
            </div>*@

        <div class="col-lg-6 col-sm-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <h5 class="header-title pb-3 text-dark">Rank Wise Over Due Posting</h5>
                    <div class="panel-body overDueChart">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-sm-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <h5 class="header-title pb-3 text-dark">Rank Wise Vacancy</h5>
                    <div class="panel-body rankChart">
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!--end body content-->
</section>


@section Scripts{

    <script>
        $(document).ready(function () {
            rankWiseVacancy();
            rankWiseOverDue();
            unitWiseOverduePosting();
        });

        function unitWiseOverduePosting() {
            $('#barChart').remove();
            $('.unitChart').append('<canvas id="barChart" style="display: block;width: 100%;height: 370px;"></canvas>');
            $.get("/global/api/GetUnitWiseOverduePosting", function (unit) {

                new Chart(document.getElementById("barChart"), {
                    type: 'line',
                    data: {
                        labels: unit.branchUnitName,
                        backgroundColor: 'transparent', borderColor: '#b9dcec', borderWidth: 3, pointStyle: 'circle', pointRadius: 5, pointBorderColor: 'transparent', pointBackgroundColor: '#b9dcec',
                        datasets: [{
                            label: "",
                            data: unit.totalEmployee,
                            backgroundColor: 'transparent', borderColor: '#f572a1', borderWidth: 3, pointStyle: 'circle', pointRadius: 5, pointBorderColor: 'transparent', pointBackgroundColor: '#f572a1',
                            // backgroundColor: ["#242440", "#8596a7", "#a7cccc", "#E9B9D3", "#FF9F32"],
                            borderWidth: "0",
                            // backgroundColor: ["#242440", "#8596a7", "#a7cccc", "#E9B9D3", "#FF9F32"],
                            // barPercentage: 0.4
                        }]
                    }
                    , options: {
                        responsive: true, tooltips: {
                            mode: 'index', titleFontSize: 12, titleFontColor: '#000', bodyFontColor: '#000', backgroundColor: '#fff', titleFontFamily: 'Montserrat', bodyFontFamily: 'Montserrat', cornerRadius: 3, intersect: false,
                        }
                        , legend: {
                            display: false, labels: {
                                usePointStyle: true, fontFamily: 'Montserrat',
                            }
                            ,
                        }
                        , scales: {
                            xAxes: [{
                                display: true, gridLines: {
                                    display: false, drawBorder: false
                                }
                                , scaleLabel: {
                                    display: false, labelString: 'Month'
                                }
                            }
                            ], yAxes: [{
                                display: true, gridLines: {
                                    display: false, drawBorder: false
                                }
                                , scaleLabel: {
                                    display: true, labelString: 'Value'
                                }
                            }
                            ]
                        }
                        , title: {
                            display: false, text: 'Normal Legend'
                        }
                    }
                }
                )

            });
        }

        function rankWiseVacancy() {
            $('#doughutChart').remove();
            $('.rankChart').append('<canvas id="doughutChart" style="display: block;width: 541px;height: 270px;"></canvas>');
            $.get("/global/api/GetRankWiseVacancyCount", function (data) {

                new Chart(document.getElementById("doughutChart"),
                    {
                        type: 'doughnut',
                        data: {
                            labels: data.rankName,
                            datasets: [{
                                backgroundColor: ["#242440", "#8596a7", "#a7cccc", "#E9B9D3", "#FF9F32", "#27006A"],
                                hoverBackgroundColor: ["#242440", "#8596a7", "#a7cccc", "#E9B9D3", "#FF9F32", "#27006A"],
                                data: data.totalVacant,
                            }],
                        },

                        options:
                        {
                            responsive: true
                        }

                    }
                );

            });
        }




        function rankWiseOverDue() {
            $('#pieChart').remove();
            $('.overDueChart').append('<canvas id="pieChart" style="display: block;width: 541px;height: 270px;"></canvas>');

            $.get("/global/api/GetRankWisOverDueCount", function (overDue) {
                console.log(overDue);
                new Chart(document.getElementById("pieChart"), {
                    type: 'pie', data: {
                        labels: overDue.rankName,
                        datasets: [{
                            data: overDue.totalEmployee,
                            backgroundColor: ["#242440", "#8596a7", "#a7cccc", "#E9B9D3", "#FF9F32", "#27006A"],
                            hoverBackgroundColor: ["#242440", "#8596a7", "#a7cccc", "#E9B9D3", "#FF9F32", "#27006A"]
                        }],
                    },

                    options:
                    {
                        responsive: true
                    }

                }
                );

            });
        }



    </script>

}



