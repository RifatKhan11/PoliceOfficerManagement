@model PhoneBookViewModel;
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "Phone Book";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";

}
<link href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.11.4/jquery-ui.css" rel="stylesheet" />
<link href="~/css/bootstrap.min.css" rel="stylesheet">

<style>

    @@media screen and (max-width: 599px) {
        #jobHisListView, #proHisListView, #eduListView, #localTrListView, #forignTrListView, #awardListView, #medicalListView, #frnTrvlListView, #frnTrvlListViewUN, #familyListView, #displinaryListView, #preAddList, #parAddList, #inLawAddList, #spouseAddList {
            display: none;
        }

        #mobileResponse {
            width:120%;
        }

        #jobHisCardView, #proHisCardView, #eduCardView, #localTrCardView, #forignTrCardView, #awardCardView, #medicalCardView, #frnTrvlCardView, #frnTrvlCardViewUN, #familyCardView, #displinaryCardView, #preAddCard, #parAddCard, #inLowAddCard, #spouseAddCard {
            display: block;
            padding: 0;
            margin: 0;
        }

        #jobhistoryCard, #inLowAddCard, #spouseAddCard, #parAddCard, #preAddCard, #promotionCardView, #eduCard, #domesticCard, #forCard, #awardCard, #medicalCardAdd, #foriegnTrvlCard, #familyCard {
            padding: 0;
            margin: 0;
        }

        #personlDiv {
            margin-top: 140px;
        }

        #fnt {
            font-size: 27px;
        }

        #local-Training-Main-Div, #foreign-Training-Main-Div {
            padding: 0
        }

        #finalBtnDiv {
            margin-bottom: 40px;
        }
    }

    @@media screen and (min-width: 600px) {
        #jobHisListView, #proHisListView, #eduListView, #localTrListView, #forignTrListView, #awardListView, #medicalListView, #frnTrvlListView, #frnTrvlListViewUN, #familyListView, #displinaryListView, #preAddList, #parAddList, #inLawAddList, #spouseAddList {
            display: block;
        }

        #jobHisCardView, #proHisCardView, #eduCardView, #localTrCardView, #forignTrCardView, #awardCardView, #medicalCardView, #frnTrvlCardView, #frnTrvlCardViewUN, #familyCardView, #displinaryCardView, #preAddCard, #parAddCard, #inLowAddCard, #spouseAddCard {
            display: none;
        }
    }

    .mobCardHeader {
        padding: 0;
        padding-top: 5px;
        text-align: center;
        background-color: oldlace;
    }

    .mobCard {
        border-radius: 50%;
        background-color: #2A1067;
        font-size: 23px;
        height: 30px;
        width: 30px;
        color: white;
    }
    .clscustom {
        text-decoration: none;
    }

    

</style>

<div class="col-sm-12 col-md-12 col-xl-12 col-lg-12 col-12 pl-0 ml-0 pr-0 mr-0" id="mobileResponse">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-xl-12 col-lg-12 col-12 text-center">
            <h2 class="mt-3"><b>Police Phone Book</b></h2>
        </div>
        <div class="col-sm-12 col-md-12 col-xl-12 col-lg-12 pl-0 ml-0 pr-0 mr-0 row">
            <div class="col-sm-0 col-md-1 col-xl-1 col-lg-1 pl-0 ml-0 pr-0 mr-0 row"></div>
            <div class="col-sm-12 col-md-10 col-xl-10 col-lg-10 col-10 ml-0 pr-0 mr-0 row">
                <div class="col-sm-12 col-md-12 col-xl-12 col-lg-12 col-12 row">
                    <div class="col-sm-6 col-md-6 col-xl-6 col-lg-6 col-12 form-group">
                        <input class="form-control" placeholder="Search With Unit" id="txtUnit" />
                    </div>
                    <div class="col-sm-6 col-md-6 col-xl-6 col-lg-6 col-12 form-group">
                        <input class="form-control" placeholder="Search . . . ." id="txtSearch" />
                    </div>
                </div>
                
                <div class="col-sm-12 col-md-12 col-xl-12 col-lg-12 col-12 pl-0 ml-0 pr-0 mr-0">
                    @foreach (var unit in Model.jsonUnits.Where(x => x.ParentId == 0).OrderBy(x => x.Priority))
                    {
                        <div class="card ml-0 pr-0 mr-0">
                            <div class="card-header" id="id-@unit.Id" data-toggle="collapse" data-target="#collapse-@unit.Id" style="cursor:pointer">
                                <h5 class="mb-0">
                                    <a class="collapsed" style="color:black;text-decoration:none;font-size:1.2em;" data-toggle="collapse" href="" aria-expanded="false" aria-controls="collapse-jobHistory">
                                        &nbsp;&nbsp;<img style="width:24px;height:24px;" src="~/contact/unit_logo/@unit.Icon" />&nbsp;&nbsp; @unit.Name
                                    </a>
                                    <span class="float-right text-dark"> <i class="fa fa-chevron-right"></i></span>
                                </h5>
                            </div>

                            <div id="collapse-@unit.Id" class="collapse ml-0 pr-0 mr-0">
                                <div class="card-body">
                                    @foreach (var subUnit in Model.jsonUnits.Where(x => x.ParentId == unit.Id).OrderBy(x => x.Priority))
                                    {
                                        <div class="card-header" id="sid-@subUnit.Id" data-toggle="collapse" data-target="#collapse-@subUnit.Id" style="cursor:pointer">
                                            <h5 class="mb-0">
                                                <a class="collapsed" style="color:black;text-decoration:none;font-size:1em;" data-toggle="collapse" href="" aria-expanded="false" aria-controls="collapse-@subUnit.Id">
                                                    &nbsp;&nbsp;<img style="width:24px;height:24px;" src="~/contact/unit_logo/@subUnit.Icon" />&nbsp;&nbsp; @subUnit.Name
                                                </a>
                                                <span class="float-right text-dark"> <i class="fa fa-chevron-right"></i></span>
                                            </h5>
                                        </div>
                                        
                                        <div id="collapse-@subUnit.Id" class="collapse ml-0 pr-0 mr-0">
                                            <div class="card-body">
                                                @foreach (var subSubUnit in Model.jsonUnits.Where(x => x.ParentId == subUnit.Id).OrderBy(x => x.Priority))
                                                {
                                                    <div class="card-header" id="sid-@subSubUnit.Id" data-toggle="collapse" data-target="#collapse-@subSubUnit.Id" style="cursor:pointer">
                                                        <h5 class="mb-0">
                                                            <a class="collapsed" style="color:black;text-decoration:none;font-size:.9em;" data-toggle="collapse" href="" aria-expanded="false" aria-controls="collapse-@subSubUnit.Id">
                                                                &nbsp;&nbsp;<img style="width:24px;height:24px;" src="~/contact/unit_logo/@subSubUnit.Icon" />&nbsp;&nbsp; @subSubUnit.Name
                                                            </a>
                                                            <span class="float-right text-dark"> <i class="fa fa-chevron-right"></i></span>
                                                        </h5>
                                                    </div>

                                                    <div id="collapse-@subSubUnit.Id" class="collapse ml-0 pr-0 mr-0">
                                                        <div class="card-body">
                                                            @foreach (var subSubSubUnit in Model.jsonUnits.Where(x => x.ParentId == subSubUnit.Id).OrderBy(x => x.Priority))
                                                            {
                                                                <div class="card-header" id="sid-@subSubSubUnit.Id" data-toggle="collapse" data-target="#collapse-@subSubSubUnit.Id" style="cursor:pointer">
                                                                    <h5 class="mb-0">
                                                                        <a class="collapsed" style="color:black;text-decoration:none;font-size:.8em;" data-toggle="collapse" href="" aria-expanded="false" aria-controls="collapse-@subSubSubUnit.Id">
                                                                             &nbsp;&nbsp;<img style="width:24px;height:24px;" src="~/contact/unit_logo/@subSubSubUnit.Icon" />&nbsp;&nbsp; @subSubSubUnit.Name
                                                                        </a>
                                                                        <span class="float-right text-dark"> <i class="fa fa-chevron-right"></i></span>
                                                                    </h5>
                                                                </div>

                                                                <div id="collapse-@subSubSubUnit.Id" class="collapse ml-0 pr-0 mr-0">
                                                                    <div class="card-body">
                                                                        @foreach (var phoneBook in Model.jsonContacts.Where(x => x.lastplace == subSubSubUnit.Id.ToString()))
                                                                        {
                                                                            string icon = phoneBook.rank + ".png";
                                                                            <div class="card-header ml-0 pr-0 mr-0">
                                                                                <h5 class="mb-0">
                                                                                    <a style="color:black;text-decoration:none;font-size:.7em;" href="" aria-expanded="false">
                                                                                        &nbsp;&nbsp;<img style="width:24px;height:24px;" src="~/contact/rankbadge/@icon" />&nbsp;&nbsp;@phoneBook?.designation_name, Number:  @phoneBook?.phone_office, Telephone : @phoneBook?.telephone
                                                                                    </a>
                                                                                </h5>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                            @foreach (var phoneBook in Model.jsonContacts.Where(x => x.lastplace == subSubUnit.Id.ToString()))
                                                            {
                                                                string icon = phoneBook.rank + ".png";
                                                                <div class="card-header ml-0 pr-0 mr-0">
                                                                    <h5 class="mb-0">
                                                                        <a style="color:black;text-decoration:none;font-size:.7em;" href="" aria-expanded="false">
                                                                            &nbsp;&nbsp;<img style="width:24px;height:24px;" src="~/contact/rankbadge/@icon" />&nbsp;&nbsp;@phoneBook?.designation_name, Number:  @phoneBook?.phone_office, Telephone : @phoneBook?.telephone
                                                                        </a>
                                                                    </h5>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>

                                                }
                                                @foreach (var phoneBook in Model.jsonContacts.Where(x => x.lastplace == subUnit.Id.ToString()))
                                                {
                                                    string icon = phoneBook.rank + ".png";
                                                    <div class="card-header ml-0 pr-0 mr-0 pl-0">
                                                        <h5 class="mb-0">
                                                            <a  style="color:black;text-decoration:none;font-size:.7em;" href="" aria-expanded="false">
                                                                &nbsp;&nbsp;<img style="width:24px;height:24px;" src="~/contact/rankbadge/@icon" />&nbsp;&nbsp;@phoneBook?.designation_name, Number:  @phoneBook?.phone_office, Telephone : @phoneBook?.telephone
                                                            </a>
                                                        </h5>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        
                                    }


                                    </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
            <div class="col-sm-0 col-md-1 col-xl-1 col-lg-1 pl-0 ml-0 pr-0 mr-0 row"></div>
        </div>
    </div>
</div>
<script src="~/js/jquery-3.2.1.min.js"></script>

@section Scripts{
    <script>
        $(document).ready(function () {

            $('.card-header').click(function () {
                $(this).find('i').toggleClass(' fa-chevron-down')
            });

            $("#txtUnit").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $(".resource .unit").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);

                });
            });

            $("#txtSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $(".resource .search").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
                $(".resource .unit").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);

                });
            });
        })
    </script>
}
