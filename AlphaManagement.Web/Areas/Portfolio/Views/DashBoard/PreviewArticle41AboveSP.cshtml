@model DashBoardViewModel;
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "Article 47";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";

}

<div>

    <h5>বাংলাদেশ ফরম নং-২৪০৩</h5>

    @if (Model.userRole.Contains("General User"))
    {
        @if (Convert.ToString(Model.assignment?.articleStatus) == "Ongoing")
        {<h2 style="color:red;text-align:right">অনুমোদনের জন্য অপেক্ষামান</h2>}
        else if (Convert.ToString(Model.assignment?.articleStatus) == "Rejected")
        { <h2 style="color:red;text-align:right">অনুমোদন প্রত্যাখ্যান</h2>}
    }
    else if (Model.userRole.Contains("Admin") || Model.userRole.Contains("Super Admin"))
    {
        @if (Convert.ToString(Model.assignment?.articleStatus) == "Approved")
        {<h2 style="color:red;text-align:right">অনুমোদিত</h2>}
        else
        {
             <div class="float-right">
                 <a class="btn btn-sm btn-success" style="text-align:right" onclick="approve(@Model.assignment?.Id)" href="#">Approve</a>
             </div>
        }
    }
    <h5 style="margin-top:10px">
        প্রতি
    </h5>

    <div class="row">
        <div class="col">
            <table class="">

                <tbody>
                    <tr>
                        <td><h5>(১)</h5></td>
                        <td style="width:50%"><h5>সিনিয়র সচিব, <br /> জনপ্রশাসন মন্ত্রণালয়, <br /> বাংলাদেশ সচিবালয়, ঢাকা।</h5></td>
                        <td><h5>(৪)</h5></td>
                        <td width="50%"><h5>অতিরিক্ত ডিআইজি (পার্সোনেল ম্যানেজমেন্ট-১/ ফিন্যান্স-১/লজিষ্টিকস্),<br /> বাংলাদেশ পুলিশ, <br /> পুলিশ হেডকোয়ার্টার্স, ঢাকা।</h5></td>
                    </tr>
                    <tr>
                        <td><h5>(২)</h5></td>
                        <td style="width:50%"><h5>সিনিয়র সচিব, <br /> জনপ্রশাসন মন্ত্রণালয়, <br /> বাংলাদেশ সচিবালয়, ঢাকা।</h5></td>
                        <td><h5>(৫)</h5></td>
                        <td width="50%"><h5>অতিরিক্ত ডিআইজি (পার্সোনেল ম্যানেজমেন্ট-১/ ফিন্যান্স-১/লজিষ্টিকস্),<br /> বাংলাদেশ পুলিশ, <br /> পুলিশ হেডকোয়ার্টার্স, ঢাকা।</h5></td>
                    </tr>
                    <tr>
                        <td><h5>(৩)</h5></td>
                        <td style="width:50%"><h5>সিনিয়র সচিব, <br /> জনপ্রশাসন মন্ত্রণালয়, <br /> বাংলাদেশ সচিবালয়, ঢাকা।</h5></td>
                        <td><h5>(৬)</h5></td>
                        <td width="50%"><h5>অতিরিক্ত ডিআইজি (পার্সোনেল ম্যানেজমেন্ট-১/ ফিন্যান্স-১/লজিষ্টিকস্),<br /> বাংলাদেশ পুলিশ, <br /> পুলিশ হেডকোয়ার্টার্স, ঢাকা।</h5></td>
                    </tr>
                </tbody>


            </table>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <h5>সূত্রঃ &nbsp;&nbsp; স্বরাষ্ট্র মন্ত্রণালয় স্মারক নং-@LanguageProcessing.EnglishToBangla(Model.assignment?.assignmentMaster?.memorandumNo), তারিখঃ @LanguageProcessing.BanglaDate(Model.assignment?.assignmentMaster?.refDate.ToString("dd-MMM-yyyy"))খ্রিঃ এবং পুলিশ হেডকোয়ার্টার্স, ঢাকা <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; স্মারক নং- @LanguageProcessing.EnglishToBangla(Model.assignment?.assignmentMaster?.memorandumNo), @LanguageProcessing.BanglaDate(Model.assignment?.assignmentMaster?.refDate.ToString("dd-MMM-yyyy"))খ্রিঃ। </h5>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-12">
            <h5>জনাব,</h5>
            <h5 class="ml-5">বেসামরিক হিসাব পদ্ধতির ৪৭নং অনুচ্ছেদের বিধি অনুযায়ী আমি নিন্মস্বাক্ষরকারী বিবরণ দিচ্ছি যে, @LanguageProcessing.EnglishToBangla(Model.assignment?.StartDate?.ToString("yyyy")) সালের @LanguageProcessing.BanglaMonth(Model.assignment?.StartDate?.ToString("MMM")) মাসের @LanguageProcessing.EnglishToBangla(Model.assignment?.StartDate?.ToString("dd")) তারিখ @LanguageProcessing.BanglaDays(Model.assignment?.StartDate) @LanguageProcessing.DayTime(Convert.ToString(Model.assignment?.joinDayTime)) @Model.assignment?.section?.NameBN, @Model.assignment?.specialBranchUnit?.branchUnitNameBN এর দায়িত্বভার গ্রহণ করলাম। </h5>

        </div>
    </div>
    <div class="row mt-5">
        <div class="col-6">
            <h5>@LanguageProcessing.EnglishToBangla(Model.assignment?.assignmentMaster?.memorandumNo)</h5>
        </div>
        <div class="col-6">
            <h5 class="text-center">তারিখঃ @LanguageProcessing.BanglaDate(Model.assignment?.assignmentMaster?.refDate)।</h5>
        </div>
    </div>
    <div class="row mt-5">
        <div class="col-6">
            <h5>
                অগ্রবর্তী করা হ’ল।
            </h5>
        </div>
        <div class="col-6">
            <h5 class="text-center">
                ...........................<br />
                মুক্ত কর্মকর্তা
            </h5>
        </div>
    </div>
    <div class="row mt-5">
        <div class="col-6 text-center">
            <h5>

                (@Model?.assignment?.supervisor?.nameBangla) <br />
                বিপি-@LanguageProcessing.EnglishToBangla(Model?.assignment?.supervisor?.employeeCode) <br />
                @Model?.assignment?.supervisor?.rank?.rankNameBN <br />
                ফোন-@LanguageProcessing.EnglishToBangla(Model?.assignment?.supervisor?.mobileNumberOffice), ফ্যাক্স-@LanguageProcessing.EnglishToBangla(Model?.assignment?.supervisor?.telephoneResidence) <br />
                E-mail: @Model?.assignment?.supervisor?.emailAddress
            </h5>
        </div>
        <div class="col-6">
            <h5 class="text-center">
                (@Model?.assignment?.employee?.nameBangla) <br />
                বিপি-@LanguageProcessing.EnglishToBangla(Model?.assignment?.employee?.employeeCode) <br />
                (@Model?.assignment?.employee?.rank?.rankNameBN) <br />
                গ্রহণকারী কর্মকর্তা

            </h5>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-12">
            <h5>............................................................................................................................................................................এবং বেসামরিক হিসাব পদ্ধতির ৭৮ নং বিধি অনুযায়ী আমি (গ্রহণকারী কর্মকর্তা) ............................................................................................./.......................................... সমুদয় স্থায়ী অগ্রিম লেনদেন এর টাকা গ্রহণের প্রাপ্তি স্বীকার করিলাম............................................. জেলা গ্রহণকারী কর্মকর্তা।</h5>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-8">
            <br />

            <h5 class="float-right">গ্রহণকারী কর্মকর্তা</h5>
        </div>
        <div class="col-4 vl">
            <h5>
                দস্তখত.......................... <br />
                পদবী.............................
            </h5>
        </div>
    </div>
    <h5>
        বিঃ দ্রঃ<br />
        নং-সওবি(বি)-২০৪/৭৫-৯৮৩, তারিখঃ-৩-২-৭৫।
    </h5>
</div>
@section Scripts{
    <script>
        function approve(id) {
            $.ajax({
                url: '@Url.Action("UpdateAssignmentForArticle47Admin", "DashBoard", new { area = "Portfolio" })',
                type: "Get",
                data: { id: id},
            })
                .done(function (response) {
                    if (response == "Done") {
                        swal('', 'Approved Successfully!', 'success').
                            then(function () {
                                location.reload();
                            })
                    }
                    else {
                        swal('', 'Unable to Approve!', 'warning');
                    }

                })
                .fail(function () {
                    swal('', 'Unable to Approve!', 'warning');
                });
        }
    </script>
}
