@model DashBoardViewModel;
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";
    var baseImageUrl = "http://portfolio.police.gov.bd";
}
<style>
    h5 {
        color: white;
    }

    a {
        color: white;
    }

        a:hover {
            color: aqua;
        }

    @@media screen and (max-width: 599px) {
        #desktopDiv{
            display:none;
        }
        #mobileDiv{
            display:block!important;
        }
    }
</style>
<div class="row">
    <div class="col-12 card p-0">
        <div class="card-header">
            <div class="col-12 row">
                <h3>Dashboard</h3>
            </div>
        </div>
        <div class="card-body">
            <div class="col-12 row p-0 pl-4 ml-5" id="desktopDiv">
                <div class="col-2 text-center p-0">
                    <img src="@baseImageUrl/@Model?.employeeInfo?.updatedBy" alt="Photo Not Found" height="120" width="120" style="border-radius:50%" />
                </div>
                <div class="col-9 row p-0">
                    <div class="col-12 row">
                        @Model?.employeeInfo?.nameEnglish
                    </div>
                    <div class="col-12 row">
                        @Model?.employeeInfo?.rank?.rankName
                    </div>
                    <div class="col-12 row">
                        @Model?.employeeInfo?.branch?.branchUnitName
                    </div>
                    <div class="col-12 row">
                        @Model?.employeeInfo?.bCSBatch?.batchName
                    </div>
                    <div class="col-12 row">
                        @Model?.employeeInfo?.emailAddressPersonal
                    </div>
                    <div class="col-12 row">
                        @Model?.employeeInfo?.mobileNumberPersonal
                    </div>
                </div>
            </div>
            <div class="col-sm-12 row text-center" id="mobileDiv" style="display:none">
                <div class="col-12">
                    <img src="@baseImageUrl/@Model?.employeeInfo?.updatedBy" alt="Photo Not Found" height="100" width="100" style="border-radius:50%" />
                </div>
                <div class="col-12">
                    @Model?.employeeInfo?.nameEnglish<br />
                    @Model?.employeeInfo?.rank?.rankName<br />
                    @Model?.employeeInfo?.branch?.branchUnitName<br />
                    @Model?.employeeInfo?.emailAddressPersonal<br />
                    @Model?.employeeInfo?.mobileNumberPersonal
                </div>
            </div>
            <hr />
            <div class="col-12 row">
                <div class="col-1 mr-5"></div>
                <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12 mb-2">
                    <div class="card text-center text-white" style="background-color:#2f3076">
                        <a href="/Employee/EmployeeInfo/Index?empIdentityUserSessionToken=@Model.employeeInfo?.Id">
                            <br />
                            <br />
                            <i class="fa fa-th-large fa-3x "></i><br />
                            <br />
                            <h5>My Portfolio</h5>
                            <br />
                        </a>
                    </div>
                </div>
                <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12 mb-2">
                    <div class="card text-center text-white" style="background-color:#2f3076">
                        <a href="/Portfolio/DashBoard/OfficersSearch">
                            <br />
                            <br />
                            <i class="fa fa-search fa-3x "></i><br />
                            <br />
                            <h5>Officer Search</h5>
                            <br />
                        </a>
                    </div>
                </div>
                <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12 mb-2">
                    <div class="card text-center text-white" style="background-color:#2f3076">
                        <a href="/Portfolio/DashBoard/TravelClearence">
                            <br />
                            <br />
                            <i class="fa fa-pencil fa-3x "></i><br />
                            <br />
                            <h5>Travel Clearence</h5>
                            <br />
                        </a>
                    </div>
                </div>
                <div class="col-1"></div>
            </div>
            <div class="col-12 row">
                <div class="col-1 mr-5"></div>
                <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12 mb-2">
                    <div class="card text-center text-white" style="background-color:#2f3076">
                        <a href="/Portfolio/DashBoard/ListForArticle47">
                            <br />
                            <br />
                            <i class="fa fa-check fa-3x "></i><br />
                            <br />
                            <h5>Article 47</h5>
                            <br />
                        </a>
                    </div>
                </div>
                <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12 mb-2">
                    <div class="card text-center text-white" style="background-color:#2f3076">
                        <a href="/Portfolio/DashBoard/OfficeOrder">
                            <br />
                            <br />
                            <i class="fa fa-refresh fa-3x "></i><br />
                            <br />
                            <h5>Office Order</h5>
                            <br />
                        </a>
                    </div>
                </div>
                <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12 mb-2">
                    <div class="card text-center text-white" style="background-color:#2f3076">
                        <a href="/Portfolio/DashBoard/PhoneBookIndex">
                            <br />
                            <br />
                            <i class="fa fa-address-book-o fa-3x "></i><br />
                            <br />
                            <h5>Phone Book</h5>
                            <br />
                        </a>
                    </div>
                </div>
                <div class="col-1"></div>
            </div>
            <div class="col-12 row">
                <div class="col-1 mr-5"></div>
                <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12 mb-2">
                    <div class="card text-center text-white" style="background-color:#2f3076">
                        <a href="#">
                            <br />
                            <br />
                            <i class="fa fa-check fa-3x "></i><br />
                            <br />
                            <h5>My Ration</h5>
                            <br />
                        </a>
                    </div>
                </div>
                <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12 mb-2">
                    <div class="card text-center text-white" style="background-color:#2f3076">
                        <a href="#">
                            <br />
                            <br />
                            <i class="fa fa-refresh fa-3x "></i><br />
                            <br />
                            <h5>Logistic Item</h5>
                            <br />
                        </a>
                    </div>
                </div>
                <div class="col-md-3 col-lg-3 col-xl-3 col-sm-6 col-12 mb-2">
                    
                </div>
                <div class="col-1"></div>
            </div>
            <div class="col-12 row">
                <div class="col-1 mr-5"></div>
                <div class="col-md-3 col-sm-3 col-xl-3 col-lg-3 col-12 mb-2"></div>
                <div class="col-md-3 col-sm-3 col-xl-3 col-lg-3 col-12 mb-2">
                    @{
                        int?[] rankId = { 1, 2, 4, 6, 8, 14 };
                        @if (rankId.Contains(Model.employeeInfo?.rank?.Id))
                        {
                            <div class="card text-center text-white" style="background-color:#2f3076">
                                <a href="/Portfolio/DashBoard/Article47ForSupervisor">
                                    <br />
                                    <br />
                                    <i class="fa fa-bell-slash fa-3x "></i><br />
                                    <br />
                                    <h5>Article 47 Request</h5>
                                    <br />
                                </a>
                            </div>
                        }

                    }

                </div>
                <div class="col-1"></div>
            </div>
        </div>
    </div>
</div>