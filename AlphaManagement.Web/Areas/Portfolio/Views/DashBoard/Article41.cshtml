@model DashBoardViewModel;
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "Article 47";
    Layout = "~/Views/Shared/_PrintView.cshtml";

}
<div>
    <h5>বাংলাদেশ ফরম নং-২৪০৩</h5>
    <qrcode content="Memorandum no : @AlphaManagement.Web.Helpers.LanguageProcessing.BanglaToEnglish(Model?.assignment?.assignmentMaster?.memorandumNo),Reference No :  @Model?.assignment?.assignmentMaster?.refNo,Posting Order Date :  @Model?.assignment?.assignmentMaster?.refDate.ToString("dd/MM/yyyy")" width="150" height="150"></qrcode>
    @if (Convert.ToString(Model.assignment?.articleStatus) == "Ongoing" || Convert.ToString(Model.assignment?.articleStatus) == "Suberviser")
    {
        <h2 style="color:red;text-align:right">অনুমোদনের জন্য অপেক্ষামান</h2>
    }
    else if (Convert.ToString(Model.assignment?.articleStatus) == "Rejected")
    { <h2 style="color:red;text-align:right">অনুমোদন প্রত্যাখ্যান</h2>}
    <h5 style="margin-top:10px">
        প্রতি
    </h5>

    <div class="row">
        <div class="col">
            <table>
                <tr>
                    <td><h5>১. </h5></td>
                    <td><h5>ইন্সপেক্টর জেনারেল অব পুলিশ, বাংলাদেশ, পুলিশ হেডকোয়ার্টার্স, ঢাকা।</h5></td>
                </tr>
                <tr>
                    <td><h5>২. </h5></td>
                    <td><h5>ডিআইজি (এঅ্যান্ডডি), বাংলাদেশ পুলিশ, পুলিশ হেডকোয়ার্টার্স, ঢাকা।</h5></td>
                </tr>
                <tr>
                    <td><h5>৩. </h5></td>
                    <td><h5>অতিরিক্ত ডিআইজি (পার্সোনেল ম্যানেজমেন্ট-১/ফিন্যান্স-১/লজিস্টিকস্), বাংলাদেশ পুলিশ, পুলিশ হেডকোয়ার্টার্স, ঢাকা।</h5></td>
                </tr>
                <tr>
                    <td><h5>৪. </h5></td>
                    <td><h5>চিফ একাউন্টস অ্যান্ড ফিন্যান্স অফিসার, স্বরাষ্ট্র মন্ত্রণালয়, হিসাব ভবন, সেগুনবাগিচা, ঢাকা।</h5></td>
                </tr>
                <tr>
                    <td><h5>৫. </h5></td>
                    <td><h5>এআইজি (ইন্সপেকশন-১/ড্রয়িং অ্যান্ড ডিসবার্সমেন্ট/পিআইএমএস), বাংলাদেশ পুলিশ, পুলিশ হেডকোয়ার্টার্স, ঢাকা।</h5></td>
                </tr>
                <tr>
                    <td><h5>৬. </h5></td>
                    <td><h5>উপ-পরিচালক, বাংলাদেশ ফরমস ও প্রকাশনা অফিস, তেজগাঁও, ঢাকা।</h5></td>
                </tr>
                <tr>
                    <td><h5>৭. </h5></td>
                    <td><h5>@Model?.assignment?.specialBranchUnit?.branchUnitNameBN</h5></td>
                </tr>
                <tr>
                    <td><h5>৮. </h5></td>
                    <td><h5>আরও-১, পুলিশ হেডকোয়ার্টার্স, ঢাকা।</h5></td>
                </tr>
                <tr>
                    <td><h5>৯. </h5></td>
                    <td><h5>অফিস নথি।</h5></td>
                </tr>
            </table>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-12">
            <h5>সূত্রঃ &nbsp;&nbsp;&nbsp; পুঃহেঃকোঃ স্মারক নং-@LanguageProcessing.EnglishToBangla(Model.assignment?.assignmentMaster?.memorandumNo), তারিখঃ @LanguageProcessing.BanglaDate(Model.assignment?.assignmentMaster?.refDate)।</h5>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-12">
            <h5>জনাব,</h5>
            <h5 class="ml-5">
                বেসামরিক হিসাব পদ্ধতির ৪৭নং অনুচ্ছেদের বিধি অনুযায়ী আমি নিন্মস্বাক্ষরকারী বিবরণ দিচ্ছি যে, @LanguageProcessing.EnglishToBangla(Model.assignment?.StartDate?.ToString("yyyy")) সালের @LanguageProcessing.BanglaMonth(Model.assignment?.StartDate?.ToString("MMM")) মাসের @LanguageProcessing.EnglishToBangla(Model.assignment?.StartDate?.ToString("dd")) তারিখ @LanguageProcessing.BanglaDays(Model.assignment?.StartDate) @LanguageProcessing.DayTime(Convert.ToString(Model.assignment?.joinDayTime))
                @Model.assignment?.section?.NameBN, @Model.assignment?.specialBranchUnit?.branchUnitNameBN এর দায়িত্বভার গ্রহণ করলাম।
            </h5>

        </div>
    </div>
    <div class="row mt-5">
        <div class="col-6">
            <h5>স্মারক নং-@LanguageProcessing.EnglishToBangla(Model.assignment?.assignmentMaster?.memorandumNo)-</h5>
        </div>
        <div class="col-6">
            <h5 class="text-center">তারিখঃ @LanguageProcessing.BanglaDate(Model.assignment?.assignmentMaster?.refDate)।</h5>
        </div>
    </div>
    <div class="row mt-5">
        <div class="col-6">
            <h5>
                অগ্রবর্তী করা হ’ল।
            </h5>
        </div>
        <div class="col-6">
            <h5 class="text-center">
                ...........................<br />
                মুক্ত কর্মকর্তা
            </h5>
        </div>
    </div>
    <div class="row mt-5">
        <div class="col-6 text-center">
            <h5>

                (@Model?.assignment?.supervisor?.nameBangla) <br />
                বিপি-@LanguageProcessing.EnglishToBangla(Model?.assignment?.supervisor?.employeeCode) <br />
                @Model?.assignment?.supervisor?.rank?.rankNameBN <br />
                ফোন-@LanguageProcessing.EnglishToBangla(Model?.assignment?.supervisor?.mobileNumberOffice), ফ্যাক্স-@LanguageProcessing.EnglishToBangla(Model?.assignment?.supervisor?.telephoneResidence) <br />
                ই-মেইল: @Model?.assignment?.supervisor?.emailAddress
            </h5>
        </div>
        <div class="col-6">
            <h5 class="text-center">
                (@Model?.assignment?.employee?.nameBangla) <br />
                বিপি-@LanguageProcessing.EnglishToBangla(Model?.assignment?.employee?.employeeCode) <br />
                (@Model?.assignment?.employee?.rank?.rankNameBN) <br />
                গ্রহণকারী কর্মকর্তা
            </h5>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-12">
            <h5>............................................................................................................................................................................ এবং বেসামরিক হিসাব পদ্ধতির ৭৮ নং বিধি অনুযায়ী আমি (গ্রহণকারী কর্মকর্তা) ................................................................................ ............./.......................................... সমুদয় স্থায়ী অগ্রিম লেনদেন এর টাকা গ্রহণের প্রাপ্তি স্বীকার করিলাম ...................................... ....... জেলা গ্রহণকারী কর্মকর্তা।</h5>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-8">
            <br />

            <h5 class="float-right">গ্রহণকারী কর্মকর্তা</h5>
        </div>
        <div class="col-4 vl">
            <h5>
                দস্তখত.......................... <br />
                পদবী.............................
            </h5>
        </div>
    </div>
    <h5>
        বিঃ দ্রঃ<br />
        নং-সওবি(বি)-২০৪/৭৫-৯৮৩, তারিখঃ-৩-২-৭৫।
    </h5>
</div>