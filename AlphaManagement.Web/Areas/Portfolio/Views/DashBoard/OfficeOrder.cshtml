@model PostingReportViewModel;
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";
    var baseImageUrl = "http://portfolio.police.gov.bd";
}
<link href="~/plugins/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<div style="height:10px;"></div>
<div class="card">
    <div class="card-header" style="background-color:#2A1067;color:white;">
        <div class="row">
            <div class="col-10">
                <span style="font-size:22px;">All Office Order's</span>
            </div>

            <div class="col-2">
                <a href="/Portfolio/Dashboard/Index" class="float-right text-dark ml-2" title="Dashboard"> <i style="font-size:30px;color:white" class="fa fa-home fa-3x"></i></a>
                <a class="float-right p-0 ml-2" id="profile-tab" onclick="fnViewChange('tabularView','cardView')" href="#"><i class="fa fa-align-justify " style="font-size:30px;color:white" aria-hidden="true"></i></a>&nbsp;&nbsp;
                <a class="float-right p-0 ml-2" id="home-tab" onclick="fnViewChange('cardView','tabularView')" href="#"> <i class="fa fa-th" style="font-size:30px;color:white" aria-hidden="true"></i></a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row" id="cardView" style="display:none;">
            <div class="col-12 row p-0 m-0">
                <div class="col-9 p-0 m-0"></div>
                <div class="col-3 row p-0 m-0">
                    <label class="col-4 col-form-label">Search:</label>
                    <input class="col-8 form-control" type="text" id="txtSearch" placeholder="Search . . ."/>
                </div>
            </div>
            <div class="col-12 row">
                @foreach (var item in Model.postingReportViews)
                {

                    <div class="col-md-3 col-12 p-0 searchDiv" style="border-radius:5px;color:#fff;border:1px solid #aaa;">
                        <div class="card-header border-0">
                            <div class="text-center">

                                @if (item.url == null)
                                {
                                    <img src="~/logo/pp.jpg" style="width:100px;height:100px" class="img-fluid rounded-circle" />
                                }
                                else
                                {
                                    <img src="@baseImageUrl/@item.url" style="width:100px;height:100px" class="img-fluid rounded-circle" />
                                }
                            </div>
                        </div>
                        <div class="card text-center border-0">
                            <div class="card-body">
                                <h6 class="text-dark font-weight-bold">Ref No : @item.refNo</h6>
                                <h6 class="text-dark font-weight-bold">Order No : @item.memorandumNo</h6>
                                <h6 class="text-dark font-weight-bold">Order Date : @item.refDate.ToString("dd-MMM-yyyy")</h6>
                                <h6 class="text-dark font-weight-bold">Posting Order Created By :</h6>
                                <h6 class="text-dark font-weight-bold">@item.nameEnglish</h6>

                            </div>

                        </div>

                        <div class="card-footer border-0 text-dark">
                            <div class="text-center">
                                <a class="btn btn-sm btn-info" target="_blank" href="/Employee/Report/PostingReportPdf/@item.assignMasterId">Order View</a>
                            </div>
                        </div>

                    </div>
                }
            </div>
        </div>

        <div class="row" id="tabularView">
            <div class="col-md-12 col-12">
                <table class="table table-bordered table-striped" style="width:100%" id="tblData">
                    <thead>
                        <tr class="text-light table-sm" style="background-color:#2A1067">
                            <td>Sl No</td>
                            <td>Rank</td>
                            <td>Order No</td>
                            <td>Order Date</td>
                            <td>Action</td>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var i = 1;}
                        @foreach (var item in Model.postingReportViews)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@item.rank</td>
                                <td>@item.memorandumNo</td>
                                <td>@item.refDate.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    <a class="btn btn-info btn-sm" target="_blank" href="/Employee/Report/PostingReportPdf/@item.assignMasterId">Order View</a>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
    <script>

        function fnViewChange(show, hide) {
            $('#' + hide).hide();
            $('#' + show).show();
        }

        $(document).ready(function () {
            $('#tblData').DataTable();

            $("#txtSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $(".searchDiv").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);

                });
            });
        });
    </script>
}

