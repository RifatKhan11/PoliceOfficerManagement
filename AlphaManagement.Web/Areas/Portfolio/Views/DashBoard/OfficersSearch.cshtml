@model DashBoardViewModel;
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";
    var baseImageUrl = "http://portfolio.police.gov.bd";
}
<link href="~/plugins/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<style>
    @@media screen and (max-width: 599px) {
        #listView {
            display: none;
        }

        #cardView {
            display: block !important;
        }

        #divTop {
            margin-top: 60px !important;
        }

        /*.backDiv {
            display:none;
        }*/
    }
</style>
<div class="card p-0 m-0">
    <div class="card-header">
        <div class="col-sm-12 col-md-12 col-12 row p-0 m-0" id="divTop">
            <div class="col-11 p-0">
                <h2>Officers' Search</h2>
            </div>
            <div class="col-1 p-0 backDiv">
                <a href="/Portfolio/Dashboard/Index" class="float-right text-dark" title="Dashboard"> <i class="fa fa-home fa-3x"></i></a>
                @*<a href="javascript:void(0)" class="btn btn-outline-info btn-sm float-right pull-right" onClick="javascript:history.go(-1)"><i class="fa fa-backward"></i></a>*@
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-4 col-md-4 row">
                <label class="col-4 form-check-label mt-2">Name/BP No</label>
                <input type="text" id="input" class="col-8 form-control" value="" />
            </div>
            <div class="col-sm-3 col-md-3 row">
                <label class="col-4 form-check-label mt-2">Rank</label>
                <select class="col-8 form-control" id="rank">
                    <option value="0">All Rank</option>
                    @foreach (var item in Model.rank.Where(x => x.Id < 14))
                    {
                        <option value="@item.Id">@item.rankName</option>
                    }
                </select>
            </div>
            <div class="col-sm-3 col-md-3 row">
                <label class="col-4 form-check-label mt-2">Unit</label>
                <select class="col-8 form-control" id="unit">
                    <option value="0">All Unit</option>
                    @foreach (var item in Model.specialBranchUnits)
                    {
                        <option value="@item.Id">@item.branchUnitName</option>
                    }
                </select>
            </div>

            <div class="col-sm-3 col-md-3 row">
                <label class="col-4 form-check-label mt-2">Batch</label>
                <select class="col-6 form-control" id="batch">
                    <option value="0">All Batch</option>
                    @foreach (var item in Model.batches)
                    {
                        <option value="@item.Id">@item.batchName</option>
                    }
                </select>
                <a class="btn btn-info col-2" href="#" onclick="loadSearch()"><i class="fa fa-search"></i></a>
            </div>
        </div>
        <div class="col-12 row m-3 p-0 m-0">
            <h2 class="col-12 text-center" style="color:antiquewhite;font-weight:bold;">Search Results</h2>
        </div>
        <div class="col-12 row p-0 m-0">
            <div class="table-responsive" id="listView">
                <table class="table table-striped" style="width:100%" id="serachTbl">
                    <thead>
                        <tr>
                            <th>Sl</th>
                            <th>Photo</th>
                            <th>Name(Eng)</th>
                            <th>Bp No</th>
                            <th>Gender</th>
                            <th>Religion</th>
                            <th>Blood Group</th>
                            <th>Rank</th>
                            <th>Unit</th>
                            <th>Batch</th>
                            <th>Address</th>
                            <th>Phone</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="col-12 row p-0 m-0" id="cardView" style="display:none">

            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/jquery-3.2.1.min.js"></script>
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
    <script>
        function loadSearch() {
            var input = $('#input').val();
            var rank = $('#rank').val();
            var unit = $('#unit').val();
            var batch = $('#batch').val();
            Common.Ajax('GET', '/Portfolio/DashBoard/SearchEmployee?input=' + input + '&rank=' + rank + '&unit=' + unit +'&batch='+batch, [], 'json', ajaxGetData, false);
        }

        function ajaxGetData(responce) {
            var tbl = $('#serachTbl tbody');
            var card = $('#cardView');
            var data = '';
            var data1 = '';
            $('#serachTbl').DataTable().destroy();
            //tbl.DataTable().destroy();
            $.each(responce, function (i, v) {
                var Photo = '';
                var Name = '';
                var NameBn = '';
                var BpNo = '';
                var Gender = '';
                var Religion = '';
                var BloodGroup = '';
                var Rank = '';
                var Unit = '';
                var Batch = '';
                var Address = '';
                var Phone = '';
                var Email = '';
                if (v.Photo == null) {
                    Photo = 'logo/defaultprofile.jpg'
                }
                else {
                    Photo = v.Photo;
                }
                if (v.Name == null) {
                    Name = ''
                }
                else {
                    Name = v.Name;
                }
                if (v.BpNo == null) {
                    BpNo = ''
                }
                else {
                    BpNo = v.BpNo;
                }
                if (v.Gender == null) {
                    Gender = ''
                }
                else {
                    Gender = v.Gender;
                }
                if (v.Religion == null) {
                    Religion = ''
                }
                else {
                    Religion = v.Religion;
                }
                if (v.BloodGroup == null) {
                    BloodGroup = ''
                }
                else {
                    BloodGroup = v.BloodGroup;
                }
                if (v.Rank == null) {
                    Rank = ''
                }
                else {
                    Rank = v.Rank;
                }
                if (v.Unit == null) {
                    Unit = ''
                }
                else {
                    Unit = v.Unit;
                }
                if (v.Batch == null) {
                    Batch = ''
                }
                else {
                    Batch = v.Batch;
                }
                if (v.Address == null) {
                    Address = ''
                }
                else {
                    Address = v.Address;
                }
                if (v.Phone == null) {
                    Phone = ''
                }
                else {
                    Phone = v.Phone;
                }
                if (v.Email == null) {
                    Email = ''
                }
                else {
                    Email = v.Email;
                }
                data += `<tr>
                            <td>${i+1}</td>
                            <td><img height="50" weight="50" src="@baseImageUrl/${Photo}"/></td>
                            <td>${Name}</td>
                            <td>${BpNo}</td>
                            <td>${Gender}</td>
                            <td>${Religion}</td>
                            <td>${BloodGroup}</td>
                            <td>${Rank}</td>
                            <td>${Unit}</td>
                            <td>${Batch}</td>
                            <td>${Address}</td>
                            <td>${Phone}</td>
                            <td>${Email}</td>
                        </tr>`;
                data1+=`<div class="col-sm-3 col-nd-3 row p-0 m-0 mt-2">
                        <div class="card p-0 m-0 text-left">
                            <div class="card-body col-sm-12 col-md-12 p-0 m-0 row">
                                <div class="col-sm-12 col-md-12 p-0 m-0 text-center">
                                    <img height="100" weight="100" style="border-radius:50%" src="@baseImageUrl/${Photo}" /><br />
                                </div>
                                <h3 class="col-12 p-0 m-0 text-center">${Rank}</h3>
                                <h4 class="col-12 p-0 m-0 text-center">${Name}</h4><br />
                                <label class="col-12 p-0 m-0 text-center">BP${BpNo}</label><br />
                                <table class="table col-12 p-0 m-0 mt-2" style="width:100%">
                                    <tr style="line-height: 0px">
                                        <td width="20%">Batch:</td>
                                        <td width="80%">${Batch}</td>
                                    </tr>
                                    <tr style="line-height: 0px">
                                        <td width="20%">Gender:</td>
                                        <td width="80%">${Gender}</td>
                                    </tr>
                                    <tr style="line-height: 0px">
                                        <td width="20%">Religion:</td>
                                        <td width="80%">${Religion}</td>
                                    </tr>
                                    <tr style="line-height: 0px">
                                        <td width="20%">Blood Group:</td>
                                        <td width="80%">${BloodGroup}</td>
                                    </tr>
                                    <tr style="line-height: 0px">
                                        <td width="20%">Unit:</td>
                                        <td width="80%">${Unit}</td>
                                    </tr>
                                    <tr style="line-height: 0px">
                                        <td width="20%">Phone:</td>
                                        <td width="80%">${Phone}</td>
                                    </tr>
                                    <tr style="line-height: 0px">
                                        <td width="20%">Email:</td>
                                        <td width="80%">${Email}</td>
                                    </tr>
                                    <tr style="line-height: 0px">
                                        <td width="20%">Address:</td>
                                        <td width="80%">${Address}</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>`
            })
            tbl.empty();
            card.empty();
            tbl.append(data);
            card.append(data1);
            $('#serachTbl').DataTable();
        }
    </script>
}