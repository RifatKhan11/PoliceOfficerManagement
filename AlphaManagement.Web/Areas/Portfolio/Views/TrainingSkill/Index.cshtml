@model DashBoardViewModel;
@using AlphaManagement.Domain.AuthService.Interfaces;
@using AlphaManagement.Domain.EmployeeService.interfaces;
@inject IUserInfoes userInfo;
@inject IEmployeeService emplyeeService;
@{
    var emp = await userInfo.GetUserInfoByUserName(User.Identity.Name);
}
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    var baseImageUrl = "http://portfolio.police.gov.bd";
}
<link rel="shortcut icon" href="~/images/favicon.ico">
<link href="~/plugins/morris-chart/morris.css" rel="stylesheet">
<!-- Theme Css -->
<link href="~/css/bootstrap.min.css" rel="stylesheet">
<link href="~/css/slidebars.min.css" rel="stylesheet">
<link href="~/css/icons.css" rel="stylesheet">
<link href="~/css/menu.css" rel="stylesheet" type="text/css">
<link href="~/css/style.css" rel="stylesheet">
<style>
    #barChart {
        height: 300px;
    }

    .textStyle {
        color: black;
        text-align: center;
    }

    @@media screen and (min-width: 2000px) {
        #dashHeight {
            height: 200px !important;
        }
    }
</style>


<section id="bodySection">

    <!-- body content start-->
    <div class="body-content" style="margin-top: -57px;margin-left: -28px;">
        <div class="container-fluid">
            <div class="row mt-5">

                <div class="col-lg-12 col-sm-12">
                    <div class="card m-b-30">
                        <div class="card-body">
                            <h5 class="header-title pb-3"></h5>
                            <div class="row">
                                <div class="col-sm-12 row pull-right">

                                    <div class="col-md-3 col-12">
                                        <div class="form-group">
                                            <label></label>
                                            <select class="select2 form-control form-control-sm mb-3 custom-select" id="rankId" style="width: 100%;">
                                                <option value="0">All Rank</option>
                                                @foreach (var item in Model.rank)
                                                {
                                                    <option value="@item.Id">@item.rankName</option>
                                                }

                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-12">
                                        <div class="form-group">
                                            <label></label>
                                            <select class="select2 form-control form-control-sm mb-3 custom-select" id="unitId" style="width: 100%;">
                                                >
                                                <option value="0">All Unit</option>
                                                @foreach (var item in Model.specialBranchUnits)
                                                {
                                                    <option value="@item.Id">@item.branchUnitName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-12">
                                        <div class="form-group">
                                            <label></label>
                                            <select class="select2 form-control form-control-sm mb-3 custom-select" id="batchId" style="width: 100%;">
                                                <option value="0">All Batch</option>
                                                @foreach (var item in Model.batches)
                                                {
                                                    <option value="@item.Id">@item.batchName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-12">
                                        <div class="form-group" style="margin-top:10px">
                                            <button class="btn btn-sm" style="background-color:#708ea0;color:white" onclick="loadOfficers()">Load</button>
                                            <a class="btn btn-success btn-sm pull-right mb-4" href="/Portfolio/TrainingSkill/EmployeeIndex">Add New</a>
                                        </div>
                                    </div>

                                    <div id="checkedList">

                                    </div>
                                    <div class="table-responsive" id="tblDiv">
                                        <table class="table table-hover m-b-0" id="tblMain" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <td width="7%">SL.NO</td>
                                                    <td width="8%">Photo</td>
                                                    <td width="20%">Name</td>
                                                    <td width="20%">BP No</td>
                                                    <td width="5%">Rank</td>
                                                    <td width="20%">Unit</td>
                                                    <td width="5%">BCS Batch</td>

                                                    <td width="15%">Action</td>
                                                </tr>
                                            </thead>
                                            <tbody id="tbEmplist">
                                               
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="col-12 row" id="divLoader" style="display:none">
                                        <div class="col-4"></div>
                                        <div class="col-4">
                                            <img height="400" width="400" src="~/images/Circles-loader.gif" />
                                        </div>
                                        <div class="col-4"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>



            </div>
        </div>
        <!--end container-->

    </div>
    <!--end body content-->
</section>

<div class="modal fade bd-example-modal-lg" id="employeeInformation" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="unitName" style="color:#008000"> Training Information</h5>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" style="color: red;">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="table-odd">
                        <table id="tblTraining" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Sl#</th>
                                    <th>Training Category</th>
                                    <th>Training Title</th>
                                    <th>Training Institute</th>
                                    <th>Special Skill</th>
                                    <th>From Date</th>
                                    <th>To Date</th>

                                </tr>
                            </thead>
                            <tbody id="dtTraining">
                                

                            </tbody>
                        </table>
                    </div>

                </div>

                
                <br />
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Close</button>
                </div>

            </div>

        </div>
    </div>
</div>


@section Scripts{
    <!-- Responsive and datatable js -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
    <script src="~/js/jquery.table2excel.js" type="text/javascript"></script>
    <link href="~/plugins/morris-chart/morris.css" rel="stylesheet">
    <script src="~/plugins/chart-js/Chart.bundle.js"></script>
    <script src="~/plugins/morris-chart/raphael-min.js"></script>
    <script src="~/plugins/morris-chart/morris.js"></script>
    <script>

        $(document).ready(function ($) {
            $('#tblMain').DataTable();
            $('#unitId').select2();
            $('#rankId').select2();
            $('#batchId').select2();
            //loadOfficers();
        });

        function loadOfficers() {

            var unitId = $('#unitId').val();
            var rankId = $('#rankId').val();
            var batchId = $('#batchId').val();
            //window.location.href="/Employee/EmployeeInfoHistory/AdminCheckedUpdatedEmployeeListForAdmin?unitId=" + unitId + '&rankId=' + rankId + '&batchId=' + batchId;
            //$('#checkedList').load("/Employee/EmployeeInfoHistory/CheckedEmployeeListForAdmin?unitId=" + unitId + '&rankId=' + rankId + '&batchId=' + batchId);
            //$('#tblTable').DataTable();
            //Common.Ajax('GET', '/global/api/GetEmployeeSearchByUnitId/' + unitId + '/' + rankId + '/' + batchId, [], 'json', ajaxUnit, false);
            Common.Ajax('GET', '/Portfolio/TrainingSkill/GetEmployeeListWithTrainingSkills?unitId=' + unitId + '&rankId=' + rankId + '&batchId=' + batchId, [], 'json', ajaxData, false);
            $('#tblTable').DataTable().destroy();
            $('#tblTable').DataTable();
        }

        function btnUpdateEmployeeStatus(employeeCode, status) {
            if (employeeCode == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }
            if (status == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }
            $('#tblDiv').hide();
            $('#divLoader').show();
            var url = "/Portfolio/PortfolioDashboard/UpdateEmployeeStatus?empCode=" + employeeCode + "&status=" + status;
            $.get(url, function (data) {
                if (data.Success) {
                    //swal('', data.Message, 'success').then(function () {
                        loadOfficers();
                        $('#tblDiv').show();
                        $('#divLoader').hide();
                    //})
                } else {
                    swal('Warning', data.Message, 'warning');
                }


            });
            
        }

        function ajaxData(responce) {
            var tbody = $('#tbEmplist');
            var data = '';
            var data1 = '';
            $('#tblMain').DataTable().destroy();
            $.each(responce, function (i, v) {
                var name = '';
                var rank = '';
                var bcs = '';
                var url = '';
                var bp = '';
                var unit = '';
                if (v.nameEnglish == null) {
                    name = ' '
                }
                else {
                    name = v.nameEnglish;
                }
                if (v.employeeCode == null) {
                    bp = ' '
                }
                else {
                    bp = v.employeeCode;
                }
                if (v.rankName == null) {
                    rank = ' '
                }
                else {
                    rank = v.rankName;
                }
                if (v.branchUnitName == null) {
                    unit = ' '
                }
                else {
                    unit = v.branchUnitName;
                }
                if (v.batchName == null) {
                    bcs = ' '
                }
                else {
                    bcs = v.batchName;
                }
                if (v.url == null) {
                    url = 'logo/defaultprofile.jpg'
                }
                else {
                    url = v.url;
                }
                data += `<tr><td>${i + 1}</td><td><img height="50px" weight="50px" src="@baseImageUrl/${url}"/></td><td>${name}</td><td>${bp}</td><td>${rank}</td><td>${unit}</td><td>${bcs}</td><td>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportViewPDF?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Report"><i class="fa fa-file"></i></a>
                            <a class="btn btn-sm btn-success" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportPreviousPDF?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Previous Report"><i class="fa fa-file"></i></a>
                            <a class="btn btn-sm btn-info" href="javascript:void(0)" onclick="btnUpdateEmployeeStatus('${bp}',4)" title="Verify"><i class="fa fa-check-square"></i></a>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfo/EditAdminEmployeeIndex?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Edit"><i class="fa fa-edit"></i></a>
                            </td></tr>`;
                data1 += `<tr><td>${i + 1}</td><td><img height="50px" weight="50px" src="@baseImageUrl/${url}"/></td><td>${name}</td><td>${bp}</td><td>${rank}</td><td>${unit}</td><td>${bcs}</td><td>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="GetTrainingInfo(${v.Id})" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                            
                            </td></tr>`;
            })
            tbody.empty();
            tbody.append(data1);
            @*if ("@emp.roleName" == "Admin" || "@emp.roleName" == "Super Admin") {
                tbody.append(data);
            }
            else {
                tbody.append(data1);
            }*@
            $('#tblMain').DataTable();
        }

        function GetTrainingInfo(empId) {
            Common.Ajax('GET', '/Portfolio/TrainingSkill/GetEmployeeTrainingLog?empId=' + empId, [], 'json', ajaxTrainingData, false);
            $('#tblTraining').DataTable().destroy();
            $('#tblTraining').DataTable();
            $('#employeeInformation').modal('show');
        }

        function ajaxTrainingData(response) {
            var tbody = $('#dtTraining');
            var data = '';
            $('#tblTraining').DataTable().destroy();
            $.each(response, function (i, v) {
                var category = '';
                var title = '';
                var institute = '';
                var skillType = '';
                var fromDate = '';
                var toDate = '';
                if (v.trainingCategory.trainingCategoryName == null) {
                    category = ' '
                }
                else {
                    category = v.trainingCategory.trainingCategoryName;
                }
                if (v.trainingTitle == null) {
                    title = ' '
                }
                else {
                    title = v.trainingTitle;
                }
                if (v.trainingInstitute.trainingInstituteName == null) {
                    institute = ' '
                }
                else {
                    institute = v.trainingInstitute.trainingInstituteName;
                }
                if (v.specialSkillType.name == null) {
                    skillType = ' '
                }
                else {
                    skillType = v.specialSkillType.name;
                }
                if (v.fromDate == null) {
                    fromDate = ' '
                }
                else {
                    fromDate = v.fromDate.replace('T00:00:00','');
                }
                if (v.toDate == null) {
                    toDate = ''
                }
                else {
                    toDate = v.toDate.replace('T00:00:00', '');
                }

                data += `<tr><td>${i + 1}</td><td>${category}</td><td>${title}</td><td>${institute}</td><td>${skillType}</td><td>${fromDate}</td><td>${toDate}</td></tr>`;
            })
            tbody.empty();
            tbody.append(data);

            $('#dtTraining').DataTable();
        }

    </script>
}


