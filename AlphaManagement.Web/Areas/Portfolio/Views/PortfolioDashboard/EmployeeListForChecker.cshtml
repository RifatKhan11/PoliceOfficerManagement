@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "EmployeeList";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";
}

<div class="mb-4">
    <input id="statusId" value="@ViewBag.status" hidden />
    <input id="periodType" value="@ViewBag.periodType" hidden />
    <h4 class="mb-4 float-left">Employee Information</h4>
    <div class="float-right">
        <ul class="nav nav-tabs mt-3" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active p-0 mr-2" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true"> <i class="fa fa-align-justify" style="font-size:30px;color:#13087E" aria-hidden="true"></i></a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link p-0" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false"><i class="fa fa-th " style="font-size:30px;color:#13087E" aria-hidden="true"></i></a>
            </li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="col-md-10 ">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 col-12">
                    <div class="form-group">
                        <label></label>
                        <select class="select2 form-control form-control-sm mb-3 custom-select" id="rankId" style="width: 100%;">
                            <option value="0">All Rank</option>
                            @foreach (var item in Model.ranks)
                            {
                                <option value="@item.Id">@item.rankName</option>
                            }

                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-12">
                    <div class="form-group">
                        <label></label>
                        <select class="select2 form-control form-control-sm mb-3 custom-select" id="unitId" style="width: 100%;">
                            >
                            <option value="0">All Unit</option>
                            @foreach (var item in Model.units)
                            {
                                <option value="@item.Id">@item.branchUnitName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-12">
                    <div class="form-group">
                        <label></label>
                        <select class="select2 form-control form-control-sm mb-3 custom-select" id="batchId" style="width: 100%;">
                            <option value="0">All Batch</option>
                            @foreach (var item in Model.bCSBatch)
                            {
                                <option value="@item.Id">@item.batchName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-12">
                    <div class="form-group" style="margin-top:10px">
                        <button class="btn btn-sm" style="background-color:#708ea0;color:white" onclick="loadOfficers()">Load</button>
                        <button class="btn btn-sm ml-3" style="background-color:green;color:white" onclick="loadOfficersPDF()">Print</button>
                        <a class="btn btn-success pull-right btn-sm ml-3" href="/">Dashboard</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card" style="background-color:#fff!important">
    <div class="card-body">
        <div>
            <a class="float-left btn btn-info" href="#" id="btnVerify"><i class="fa fa-check-square"></i>Verify</a>
            <a class="float-left btn btn-info" style="margin-left:10px" href="#" id="btnEdit"><i class="fa fa-edit"></i>Edit</a>
            <div class="float-right">
                <input type="text" class="form-control" name="keyword" id="myInput" placeholder="Search...">
                <span class="search-button"><i class="ti ti-search"></i></span>
            </div>
        </div>

        <form id="OfficersForm" method="post" enctype="multipart/form-data" data-parsley-validate="parsley">
            <div class="tab-content mt-4" id="myTabContent" style="height:600px;overflow-y:scroll;width:100%">
                <div>
                </div>
            </div>
        </form>
    </div>
</div>



@section Scripts{
    <script type="text/javascript">

        $(document).ready(function () {
            $('#rankId').select2();
            $('#unitId').select2();
            $('#batchId').select2();
            loadOfficers();

            $("#myInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#tblTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            $("#btnVerify").click(function (e) {
                let rowCount = $("#tblTable tbody>tr").length;
                if (rowCount < 1) {
                    swal('Warning', "Please check at least one Officer!!!", 'warning');
                    return false;
                }

                var selected = [];
                $('.checkbox input:checked').each(function () {
                    if ($(this).val() == "on") {
                        selected.push($(this).val());
                    }
                });

                if (selected < 1) {
                    swal('Warning', "Please check at least one Officer!!!", 'warning');
                    return false;
                }

                e.preventDefault();

                var form = $("#OfficersForm");
                swal({
                    title: 'Are you sure?', text: "Do you want to Verify " + selected.length + " officers' ?", type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, Verify!'
                }).then(function (res) {
                    if (res.value) {
                        $.ajax({
                            url: '/Portfolio/PortfolioDashboard/VarifiedEmployees',
                            data: form.serialize(),
                            type: 'POST',
                            success: function (records) {
                                if (records.Success) {
                                    swal({
                                        title: '', text: records.Message, type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                                    }).then(function () {
                                        loadOfficers();
                                    });
                                } else {
                                    swal('Warning',"Invalid Attempts!", 'warning');
                                }

                            }
                        });
                    }
                });

            });

            $("#btnEdit").click(function (e) {
                let rowCount = $("#tblTable tbody>tr").length;
                if (rowCount < 1) {
                    swal('Warning', "Please check at least one Officer!!!", 'warning');
                    return false;
                }

                var selected = [];
                $('.editcheckbox input:checked').each(function () {
                    if ($(this).val() == "on") {
                        selected.push($(this).val());
                    }
                });

                if (selected < 1) {
                    swal('Warning', "Please check at least one Officer!!!", 'warning');
                    return false;
                }

                e.preventDefault();

                var form = $("#OfficersForm");
                swal({
                    title: 'Are you sure?', text: "Do you want to give permission " + selected.length + " officers' ?", type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes!'
                }).then(function (res) {
                    if (res.value) {
                        $.ajax({
                            url: '/Portfolio/PortfolioDashboard/EditPermissionEmployees',
                            data: form.serialize(),
                            type: 'POST',
                            success: function (records) {
                                if (records.Success) {
                                    swal({
                                        title: '', text: records.Message, type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                                    }).then(function () {
                                        loadOfficers();
                                    });
                                } else {
                                    swal('Warning', "Invalid Attempts!", 'warning');
                                }

                            }
                        });
                    }
                });

            });

        })


        function changeValueCheckbox(element, sl) {
            if (element.checked) {
                element.value = 'on';
                $("#isCheck_" + sl).val('1');
            } else {
                element.value = 'off';
                $("#isCheck_" + sl).val('0');
            }
        }

        function changeValueEditCheckbox(element, sl) {
            if (element.checked) {
                element.value = 'on';
                $("#isEditCheck_" + sl).val('1');
            } else {
                element.value = 'off';
                $("#isEditCheck_" + sl).val('0');
            }
        }

        function AllCheckbox(element) {
            //if (element.checked) {
            //    element.value = 'on';
            //} else {
            //    element.value = 'off';
            //}

            ($(element).is(":checked") ? $('._checkbox').prop("checked", true).trigger("change") : $('._checkbox').prop("checked", false).trigger("change"))
        }

        function EditCheckBox(element) {
            ($(element).is(":checked") ? $('._editcheckbox').prop("checked", true).trigger("change") : $('._editcheckbox').prop("checked", false).trigger("change"))
        }

        function btnUpdateEmployeeStatus(employeeCode, status) {
            if (employeeCode == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }
            if (status == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }

            swal({
                title: 'Are you sure?', text: 'Do you want to Undo Verify this record?', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, Undo!'
            }).then(function (res) {
                if (res.value) {
                    var url = "/Portfolio/PortfolioDashboard/UpdateEmployeeStatusUndoByEditUser?empCode=" + employeeCode + "&status=" + status;
                    $.get(url, function (data) {
                        if (data.Success) {
                            swal('', data.Message, 'success').then(function () {
                                loadOfficers();
                            })
                        } else {
                            swal('Warning', data.Message, 'warning');
                        }


                    });
                }


            })
        }

        function loadOfficers() {

            var unitId = $('#unitId').val();
            var rankId = $('#rankId').val();
            var batchId = $('#batchId').val();
            var statusId = $('#statusId').val();
            var periodType = $('#periodType').val();

            $('#myTabContent').load("/Portfolio/PortfolioDashboard/EmployeePartialList?unitId=" + unitId + '&rankId=' + rankId + '&batchId=' + batchId + '&statusId=' + statusId + '&periodType=' + periodType);
            //$('#tblTable').DataTable();
            //Common.Ajax('GET', '/global/api/GetEmployeeSearchByUnitId/' + unitId + '/' + rankId + '/' + batchId, [], 'json', ajaxUnit, false);
            //$('#tblTable').DataTable().destroy();
            //$('#tblTable').DataTable();
        }

        function loadOfficersPDF() {

            var unitId = $('#unitId').val();
            var rankId = $('#rankId').val();
            var batchId = $('#batchId').val();
            var statusId = $('#statusId').val();
            var periodType = $('#periodType').val();

            window.open("/Employee/EmployeeInfoHistory/GetEmployeeListReportPdf?unitId=" + unitId + '&rankId=' + rankId + '&batchId=' + batchId + '&statusId=' + statusId + '&periodType=' + periodType);

        }
    </script>
}