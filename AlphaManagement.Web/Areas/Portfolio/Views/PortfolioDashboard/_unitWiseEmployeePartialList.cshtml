@using AlphaManagement.Domain.AuthService.Interfaces;
@using AlphaManagement.Domain.EmployeeService.interfaces;
@inject IUserInfoes userInfo;
@inject IEmployeeService emplyeeService;


@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "View";
    var baseImageUrl = "http://portfolio.police.gov.bd";
    var emp = await userInfo.GetUserInfoByUserName(User.Identity.Name);
}

<div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">


    <table class="table table-bordered responsive-table" id="tblTable" style="width:100%">
        <thead>
            <tr>
                <td width="3%">SL. No</td>
                <td>Photo</td>
                <td>Name</td>
                <td>BP No</td>
                <td>Rank</td>
                <td>Unit</td>
                <td>BCS Batch</td>
                <td>Status Mark</td>
                <td>Action</td>

            </tr>
        </thead>
        <tbody id="tbEmplist">
            @{
                var i = 1;

                var statusMessageColor = "gray";
                var fontcolor = "black";
                @foreach (var item in Model.UnitWiseEmployeeInfosViewModelFor_SP)
                {
                    <tr>
                        <td>@i</td>
                        @if (item.imageUrl == null)
                        {
                            <td> <img src="~/logo/defaultprofile.jpg" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                        }
                        else
                        {
                            <td> <img src="@baseImageUrl/@item.imageUrl" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                        }

                        <td>@item.nameEnglish</td>
                        <td>@item.employeeCode</td>
                        <td>@item.rankName</td>
                        <td>@item.sectionName</td>
                        <td>@item.batchName</td>



                        @if (item.statusMark >= 70)
                        {
                            statusMessageColor = "green";
                            fontcolor = "white";
                        }
                        else if (item.statusMark >= 50 && item.statusMark < 70)
                        {
                            statusMessageColor = "yellow";
                            fontcolor = "black";
                        }
                        else if (item.statusMark < 50)
                        {
                            statusMessageColor = "red";
                            fontcolor = "white";
                        }
                        <td>
                            <div class="" style="width:100%; background-color:@statusMessageColor;border-radius:5px">
                                <div style="text-align:center; color: @fontcolor" role="progressbar" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">@item.statusMark%</div>
                            </div>
                        </td>
                        <td>
                            @if (emp.roleName == "Portfolio Checker")
                            {
                                <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetailsForChecker?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                            }
                            else
                            {

                                <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                            }
                        </td>

                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            //$('#tblTable').DataTable();


        })




    </script>
}