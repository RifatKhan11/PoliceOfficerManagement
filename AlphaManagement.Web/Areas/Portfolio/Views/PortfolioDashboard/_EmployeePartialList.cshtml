@using AlphaManagement.Domain.AuthService.Interfaces;
@using AlphaManagement.Domain.EmployeeService.interfaces;
@inject IUserInfoes userInfo;
@inject IEmployeeService emplyeeService;

@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "View";
    var emp = await userInfo.GetUserInfoByUserName(User.Identity.Name);
    var baseImageUrl = "http://portfolio.police.gov.bd";
}

<div class="tab-pane fade show active p-0 m-0" id="home" role="tabpanel" aria-labelledby="home-tab">
    <div class="col-sm-12 col-md-12 col-lg-12 col-12 row p-0 m-0">
        <table class="table table-bordered responsive-table p-0 m-0" id="tblTable" style="width:100%">
            <thead>
                <tr>
                    <td style="width:5%">SL.No</td>
                    <td style="width:8%">
                        Is Verify
                        <div class="checkbox my-2">
                            <input type="checkbox" id="inactivelist" value="" onchange="AllCheckbox(this)" />
                        </div>
                    </td>
                    <td style="width:7%">
                        Is Edit
                        <div class="editcheckbox my-2">
                            <input type="checkbox" id="editlist" value="" onchange="EditCheckBox(this)" />
                        </div>
                    </td>
                    <td>Gradation</td>
                    <td>Photo</td>
                    <td>Name</td>
                    <td>BP No</td>
                    <td>Rank</td>
                    <td>Unit</td>
                    <td>BCS Batch</td>
                    <td>Status</td>
                    <td>Mark</td>
                    <td width="6%">Action</td>
                </tr>
            </thead>
            <tbody id="tbEmplist">
                @{
                    var i = 1;

                    var statusMessageColor = "gray";
                    var fontcolor = "black";
                    string currentStaus = "Ongoing";
                    string currentStausColor = "gray";
                    @foreach (var item in Model.employeeInfosViewModelFor_SPs)
                    {
                        <tr>
                            <td>@i</td>
                            <td>
                                <div class="checkbox my-2">
                                    <input type="checkbox" class="form-control input-group-sm _checkbox" name="isChecked" value="off" onchange="changeValueCheckbox(this,@i)" />
                                    <input type="text" name="isCheck" id="isCheck_@i" style="text-align:center" value="0" hidden />
                                    <input type="text" name="employeeCodes" class="form-control input-group-sm read text-left" value="@item.employeeCode" hidden />
                                </div>
                            </td>
                            <td>
                                <div class="editcheckbox my-2">
                                    <input type="checkbox" class="form-control input-group-sm _editcheckbox" name="isEdit" value="off" onchange="changeValueEditCheckbox(this,@i)" />
                                    <input type="text" name="isEditCheck" id="isEditCheck_@i" style="text-align:center;" value="0" hidden />
                                    @*<input type="text" name="employeeCodes" class="form-control input-group-sm read text-left" value="@item.employeeCode" hidden />*@
                                </div>
                            </td>
                            @* <td>@item.gradationSerial</td>*@
                            @if (item.imageUrl == null)
                            {
                                <td> <img src="~/logo/defaultprofile.jpg" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                            }
                            else
                            {
                                <td> <img src="@baseImageUrl/@item.imageUrl" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                            }

                            <td>@item.nameEnglish</td>
                            <td>@item.employeeCode</td>
                            <td>@item.rankName</td>
                            <td>@item.sectionName</td>
                            <td>@item.batchName</td>


                            <td>
                                @if (item.isApproved == 1)
                                {
                                    currentStaus = "Registered";
                                    currentStausColor = "gray";
                                }
                                else if (item.isApproved == 2)
                                {
                                    currentStaus = "On Going";
                                    currentStausColor = "#0094ff";
                                }
                                else if (item.isApproved == 3)
                                {
                                    currentStaus = "Final Submited";
                                    currentStausColor = "#1d9414";
                                }
                                else if (item.isApproved == 4)
                                {
                                    currentStaus = "Verified";
                                    currentStausColor = "#ff00dc";
                                }
                                else if (item.isApproved == 5)
                                {
                                    currentStaus = "Returned";
                                    currentStausColor = "#ffd800";
                                }
                                else if (item.isApproved == 6)
                                {
                                    currentStaus = "Checked By Checker";
                                    currentStausColor = "#ff006e";
                                }
                                else if (item.isApproved == 7)
                                {
                                    currentStaus = "Checked By Editor";
                                    currentStausColor = "#b6ff00";
                                }
                                else if (item.isApproved == 8)
                                {
                                    currentStaus = "Verify By Checker";
                                }
                                else
                                {
                                    currentStaus = "On Going";
                                    currentStausColor = "#0094ff";
                                }
                                <div class="" style="width:100%; background-color:@currentStausColor;border-radius:5px">
                                    <div style="text-align:center; color:ghostwhite" role="progressbar">@currentStaus</div>
                                </div>
                                <div style="margin:1px">
                                    @if (item.isApproved == 4)
                                    {
                                        <a style="background-color:red;border-radius:5px;color:white" href="#" onclick="btnUpdateEmployeeStatus(@item.employeeCode,8)">Undo</a>
                                    }
                                </div>

                            </td>

                            <td>

                                @if (item.statusMark >= 70)
                                {
                                    statusMessageColor = "green";
                                    fontcolor = "white";
                                }
                                else if (item.statusMark >= 50 && item.statusMark < 70)
                                {
                                    statusMessageColor = "yellow";
                                    fontcolor = "black";
                                }
                                else if (item.statusMark < 50)
                                {
                                    statusMessageColor = "red";
                                    fontcolor = "white";
                                }
                                <div class="" style="width:100%; background-color:@statusMessageColor;border-radius:5px">
                                    <div style="text-align:center; color: @fontcolor" role="progressbar" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">@item.statusMark%</div>
                                </div>
                            </td>

                            <td>
                                @if (emp.roleName == "Portfolio Checker")
                                {
                                    <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetailsForChecker?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                                    @*<a class="btn btn-sm btn-warning" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeInfoReportViewPDF?empIdentityUserSessionToken=@item.Id')"  target="_blank"  title="Preview"><i class="fa fa-print"></i></a>*@

                                    @if (item.isApproved != 4)
                                    {
                                        <a class="btn btn-sm btn-info" href="#" onclick="btnUpdateEmployeeStatus('@item.employeeCode',4)" title="Verify"><i class="fa fa-check-square"></i></a>
                                    }
                                }


                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">

    <div class="col-sm-12 col-md-12 col-lg-12 col-12 row" id="cards" style="margin-top:2%;">
        @{

            var statusColor = "gray";
            var fontcolor1 = "black";

            @foreach (var item in Model.employeeInfosViewModelFor_SPs)
            {
                <div class="col-lg-3 col-sm-12 searchdiv">
                    <div class="card bg-white m-b-30 zoom" style="height:450px!important">
                        <div class="card-body text-center">
                            @if (item.imageUrl == null)
                            {
                                <img src="@baseImageUrl/logo/defaultprofile.jpg" class="img-fluid rounded-circle" style="width:150px;height:150px;" alt="No Image" />
                            }
                            else
                            {
                                <img src="@baseImageUrl/@item.imageUrl" class="img-fluid rounded-circle" style="width:150px;height:150px;" alt="No Image" />
                            }
                        </div>
                        <div class="card-body">
                            <div class="card-title mb-0 text-center">
                            </div>
                        </div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">Name : @item.nameEnglish</li>
                            <li class="list-group-item">Rank : @item.rankName</li>

                            @if (item.statusMark >= 70)
                            {
                                statusColor = "green";
                                fontcolor1 = "white";
                            }
                            else if (item.statusMark >= 50 && item.statusMark < 70)
                            {
                                statusColor = "yellow";
                                fontcolor1 = "black";
                            }
                            else if (item.statusMark < 50)
                            {
                                statusColor = "red";
                                fontcolor1 = "white";
                            }
                            <li class="list-group-item">

                                <div class="row">
                                    <div class="col-md-9">
                                        <div style="width:90%; background-color:@statusColor;border-radius:5px">
                                            <div style="text-align:center; color:@fontcolor1" role="progressbar" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">@item.statusMark%</div>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <a href="/Portfolio/PortfolioDashboard/EmployeeDetails?id=@item.employeeCode" class="btn btn-primary tooltips text-white" data-placement="top" data-toggle="tooltip" data-original-title="Edit">
                                            <i class="fa fa-gift"></i>
                                        </a>
                                    </div>
                                </div>
                            </li>



                        </ul>
                        <div class="card-body">
                            <ul class="social-links list-inline mb-0"></ul>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>


<script type="text/javascript">
    $(document).ready(function () {
        $('#tblTable').DataTable();
        //$('#tblTable').DataTable({
        //    paging: true
        //});

    })
</script>