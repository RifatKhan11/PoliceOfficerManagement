@model DiseaseViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/plugins/responsive-table/css/rwd-table.min.css" rel="stylesheet" type="text/css" media="screen">
<link href="~/css/dropify.min.css" rel="stylesheet" />

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>BCS disease Information</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="Disease" asp-action="SaveDisease" method="post">
                        <input class="form-control" type="hidden" id="diseasId" name="diseasId" value="0">
                        @*<div class="form-group row">
                            <label for="diseasName" class="col-md-2 col-12 col-form-label">Disease Group<span style="color:red">*</span></label>
                            <div class="col-md-8 col-12">
                                <select class="form-control" name="groupId" id="groupId" data-parsley-required="true">
                                    <option value="">Select</option>
                                    @foreach (var item in Model.diseaseGroups)
                                    {
                                        <option value="@item.Id">@item.groupName</option>
                                    }
                                </select>
                            </div>
                        </div>*@
                        <div class="form-group row">
                            <label for="diseaseNameBn" class="col-md-2 col-sm-12 col-form-label">Disease Name(BN)</label>
                            <div class="col-md-8 col-sm-12">
                                <input class="form-control" type="text" id="diseaseNameBn" name="diseaseNameBn" placeholder="disease Name Bangla">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="diseaseNameBn" class="col-md-2 col-sm-12 col-form-label">Disease Name(EN)</label>
                            <div class="col-md-8 col-sm-12">
                                <input class="form-control" type="text" id="diseaseName" name="diseaseName" placeholder="Disease Name English">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-8 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" id="btnSave" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>All Disease Informations</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>Disease Name</th>
                            <th>Disease Bangla</th>
                            <th>Group</th>
                            <th>Status</th>
                            <th class="text-nowrap">Action</th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.diseases.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.diseaseName</td>
                                    <td>@data.diseaseNameBn</td>
                                    <td>@data.diseaseGroup?.groupName</td>
                                    @if (data.status == 0)
                                    {
                                        <td>Active</td>
                                    }
                                    else
                                    {
                                        <td>In-Active</td>
                                    }
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.diseaseName', '@data.diseaseNameBn','@data.diseaseGroupId')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>               <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
        });

        function Edit(Id, diseaseName, diseaseNameBn, diseaseGroupId) {
            $("#diseasId").val(Id);
            $("#diseaseName").val(diseaseName);
            $("#diseaseNameBn").val(diseaseNameBn);
            $("#groupId").val(diseaseGroupId);
        }
        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/MasterData/Disease/DeleteDisease/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

