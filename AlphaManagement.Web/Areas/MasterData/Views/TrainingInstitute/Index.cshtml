@model TrainingInstituteViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="TrainingInstitute" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="TrainingInstituteId" name="TrainingInstituteId">

                        <div class="form-group row">
                            <label for="trainingInstituteName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.trainingInstituteName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="trainingInstituteName" name="trainingInstituteName" placeholder="Training Institute Name English">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="trainingInstituteNameBn" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.trainingInstituteNameBn</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="trainingInstituteNameBn" name="trainingInstituteNameBn" placeholder="Training Institute Name Bangla">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="trainingInstituteShortName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.trainingInstituteShortName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="trainingInstituteShortName" name="trainingInstituteShortName" placeholder="Training Institute ShortName">
                            </div>
                        </div>

                        @*<div class="form-group row">
                            <label for="shortOrder" class="col-2 col-form-label">@Model.fLang.shortOrder</label>
                            <div class="col-10">
                                <input class="form-control" type="text" id="shortOrder" name="shortOrder" placeholder="Short Order">
                            </div>
                        </div>*@


                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.trainingInstituteName</th>
                            <th>@Model.fLang.trainingInstituteNameBn</th>
                            <th>@Model.fLang.trainingInstituteShortName</th>
                            <th class="text-nowrap"></th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.trainingInstitutes)
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.trainingInstituteName</td>
                                    <td>@data.trainingInstituteNameBn</td>
                                    <td>@data.trainingInstituteShortName</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.trainingInstituteName', '@data.trainingInstituteNameBn','@data.trainingInstituteShortName','@data.shortOrder')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
        <script>
            $(document).ready(function () {
                $('#tblData').DataTable();
            });

            

            function Edit(Id,trainingInstituteName,trainingInstituteNameBn,trainingInstituteShortName,shortOrder){
            $("#TrainingInstituteId").val(Id);
            $("#trainingInstituteName").val(trainingInstituteName);
            $("#trainingInstituteNameBn").val(trainingInstituteNameBn);
            $("#trainingInstituteShortName").val(trainingInstituteShortName);
            $("#shortOrder").val(shortOrder);
            }


            function Delete(Id) {
                swal({
                    title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
                }).then(function () {

                    $.ajax({
                        url: "/MasterData/TrainingInstitute/DeleteTrainingInstitute/" + Id,
                        data: { Id: Id },
                        type: 'POST',
                    })
                        .done(function () {
                            swal('', 'Deleted Successfully!', 'success');
                            window.location.reload();
                        })
                        .fail(function () {
                            swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                        });
                });
            }
        </script>
    }

