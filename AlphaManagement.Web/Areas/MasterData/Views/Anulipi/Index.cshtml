
@model AnulipiViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
@@import url('https://fonts.maateen.me/solaiman-lipi/font.css');
    body {
        font-family: 'SolaimanLipi', Arial, sans-serif !important;
    }
</style>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>Anulipi Information</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="Anulipi" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="anulipiId" name="anulipiId">

                        <div class="form-group row">
                            <label for="bankName" class="col-md-2 col-sm-12 col-form-label">Copy Name (EN)</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="copyName" name="copyName">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="shortOrder" class="col-md-2 col-sm-12 col-form-label">Copy Name (BN)</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="copyNameBn" name="copyNameBn">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger btn-sm">Cancel</button>
                                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>Anulipi List</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl NO</th>
                            <th>Copy Name (EN)</th>
                            <th>Copy Name (BN)</th>
                            <th>Action</th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.anulipiLists.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.copyName</td>
                                    <td>@data.copyNameBn</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id,'@data.copyName','@data.copyNameBn')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
        });


        function Edit(Id,copyName,copyNameBn) {
            $("#anulipiId").val(Id);
            $("#copyName").val(copyName);
            $("#copyNameBn").val(copyNameBn);
        }


        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/MasterData/Anulipi/DeleteAnulipi/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }

    </script>
}







