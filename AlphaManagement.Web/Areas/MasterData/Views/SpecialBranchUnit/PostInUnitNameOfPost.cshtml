
@model SpecialBranchUnitViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>Section</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="SpecialBranchUnit" asp-action="Section" method="post" data-parsley-validate="parsley">
                        <input class="form-control" type="hidden" id="postInUnitId" name="SectionitId" value="0">

                        <div class="form-group row">
                            <label for="branchUnitName" class="col-2 col-form-label">@Model.fLang.branchUnitNameBN</label>
                            <div class="col-10">
                                <select class="form-control" type="text" id="SpecialBranchUnitId" name="SpecialBranchUnitId" required>
                                    <option value="">Select One</option>
                                    @foreach (var data in Model.specialBranchUnits)
                                    {
                                        <option value="@data.Id">@data.branchUnitNameBN</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="branchUnitNameBN" class="col-2 col-form-label">@Model.fLang.rank</label>
                            <div class="col-10">
                                <select class="form-control" type="text" id="rankId" name="rankId" required>
                                    <option value="">Select One</option>
                                    @foreach (var data in Model.ranks)
                                    {
                                        <option value="@data.Id">@data.rankNameBN</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="branchCode" class="col-2 col-form-label">@Model.fLang.noOfPost</label>
                            <div class="col-10">
                                <input class="form-control" type="number" id="noOfPost" name="noOfPost" placeholder="Number of Post" readonly>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="branchCode" class="col-2 col-form-label">@Model.fLang.PostName</label>
                            <div class="col-10">
                                <input class="form-control" type="text" id="Name" name="Name" placeholder="Post Name (EN)" required>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="branchCode" class="col-2 col-form-label">@Model.fLang.PostNameBN</label>
                            <div class="col-10">
                                <input class="form-control" type="text" id="NameBN" name="NameBN" placeholder="Post Name (BN)">
                            </div>
                        </div>


                        <div class="form-group row">
                            <label for="shortName" class="col-2 col-form-label"></label>
                            <div class="col-10">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary row">
                <h5 class="col-md-2">Section</h5>
                <div class="col-md-4">
                    <select class="form-control" type="text" id="ddlSpecialBranchUnitId" name="ddlSpecialBranchUnitId" required>
                        <option value="">All Unit</option>
                        @foreach (var data in Model.specialBranchUnits)
                        {
                            <option value="@data.Id">@data.branchUnitNameBN</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <select class="form-control" type="text" id="ddlRankId" name="ddlRankId" required>
                        <option value="">All Rank</option>
                        @foreach (var data in Model.ranks)
                        {
                            <option value="@data.Id">@data.rankNameBN</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-info" onclick="fnLoadunit()">Load</button>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.branchUnitNameBN</th>
                            <th>@Model.fLang.rank</th>
                            <th>@Model.fLang.PostName</th>
                            <th>@Model.fLang.PostNameBN</th>
                            <th class="text-nowrap">@Model.fLang.action</th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.sections.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.specialBranchUnit?.branchUnitName</td>
                                    <td>@data.rank?.rankName</td>
                                    <td>@data.Name</td>
                                    <td>@data.NameBN</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.specialBranchUnitId', '@data.rankId','@data.Name','@data.NameBN')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
            $("#SpecialBranchUnitId").change(function () {
                NumberOfPost();
            });
            $("#rankId").change(function () {
                NumberOfPost();
            });
            $('#SpecialBranchUnitId').select2();
            $('#ddlSpecialBranchUnitId').select2();
            $('#ddlRankId').select2();
        });

        function NumberOfPost() {
            var UnitId = $("#SpecialBranchUnitId").val();
            var rankId = $("#rankId").val();
            Common.Ajax('GET', '/global/api/GetPostInUnitByRankAndUnit/' + UnitId + '/' + rankId, [], 'json', GetSalesDatatodayReserve);


        }
        function GetSalesDatatodayReserve(res) {
            
            $("#noOfPost").val(res.numOfPost);
        }

        function fnLoadunit() {
            var unitId = parseInt($('#ddlSpecialBranchUnitId').val());
            var rankId = parseInt($('#ddlRankId').val());
            var url = "/MasterData/SpecialBranchUnit/PostInUnitNameOfPost?rankId=" + rankId + "&unitId=" + unitId;
            window.location.href = url;
        }

        function Edit(Id, specialBranchUnitId, rankId, Name, NameBN) {
            $("#postInUnitId").val(Id);
            $("#SpecialBranchUnitId").val(specialBranchUnitId);
            $("#rankId").val(rankId);
            $("#Name").val(Name);
            $("#NameBN").val(NameBN);
            NumberOfPost();
        }


        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/MasterData/SpecialBranchUnit/Deletesection/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

