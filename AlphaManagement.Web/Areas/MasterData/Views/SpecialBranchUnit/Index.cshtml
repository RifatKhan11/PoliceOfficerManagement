@model SpecialBranchUnitViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@

  
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="SpecialBranchUnit" asp-action="Index" method="post" data-parsley-validate="parsley">
                        <input class="form-control" type="hidden" id="SpecialBranchUnitId" name="SpecialBranchUnitId">

                        <div class="form-group row">
                            <label for="branchUnitName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.branchUnitName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="branchUnitName" name="branchUnitName" placeholder="Branch Unit Name English">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="branchUnitNameBN" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.branchUnitNameBN</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="branchUnitNameBN" name="branchUnitNameBN" placeholder="Branch Unit Name Bangla">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="branchCode" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.branchCode</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="branchCode" name="branchCode" placeholder="Branch Code">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="shortOrder" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.shortOrder</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="shortOrder" name="shortOrder" placeholder="short Order">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="isdefault" class="col-md-2 col-sm-12 col-form-label">Is Parent?</label>
                            <div class="col-md-2 col-sm-12">
                                <input class="form-control" type="checkbox" value="1" id="isparent" name="isparent">
                            </div>
                        </div>

                        <div class="form-group row" id="SubUnitDiv">
                            <label for="isdefault" class="col-md-2 col-sm-12 col-form-label">Head Unit</label>
                            <div class="col-md-10 col-sm-12">
                                <select class="form-control" type="text" id="headUnitId" name="headUnitId">
                                    <option value="">Select One</option>
                                    @foreach (var data in Model.specialBranchUnits)
                                    {
                                        <option value="@data.Id">@data.branchUnitName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="districtId" class="col-md-2 col-sm-12 col-form-label">District </label>
                            <div class="col-md-10 col-sm-12">
                                <select class="form-control" name="districtId" id="districtId">
                                    <option value="">Select</option>

                                    @foreach (var item in Model.districts.OrderBy(x=>x.districtName))
                                    {
                                        <option value="@item.Id">@item.districtName</option>
                                    }

                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.branchCode</th>
                            <th>@Model.fLang.branchUnitName</th>
                            <th>Main Unit</th>
                            <th>District</th>
                            <th>@Model.fLang.shortOrder</th>
                            <th class="text-nowrap"></th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.specialBranchUnits.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.branchCode</td>
                                    <td>@data.branchUnitName</td>
                                    <td>@data.specialBranchUnit?.branchUnitName</td>
                                    <td>@data.districts?.districtName</td>
                                    <td>@data.shortOrder</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.branchCode', '@data.branchUnitName','@data.branchUnitNameBN','@data.shortOrder','@data.isdefault','@data.isParent','@data.specialBranchUnitId','@data.districtsId')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
            //$('#districtId').select2();

            $('#isparent').click(function () {
                if ($(this).prop('checked') == true) {
                    $('#SubUnitDiv').hide();
                } else {
                    $('#SubUnitDiv').show();
                }
            });
        });


        function Edit(Id, branchCode, branchUnitName, branchUnitNameBN, shortOrder, isdefault, isparent, sbuId, districtId) {
            $("#SpecialBranchUnitId").val(Id);
            $("#branchCode").val(branchCode);
            $("#branchUnitName").val(branchUnitName);
            $("#branchUnitNameBN").val(branchUnitNameBN);
            $("#shortOrder").val(shortOrder);
            $("#isdefault").val(isdefault);
            $("#isdefault").val(isdefault);
            if (isparent == 1) {
                $('#SubUnitDiv').hide();
                $("#isparent").click();
            } else {
                $('#SubUnitDiv').show();
            }
            $("#headUnitId").val(sbuId);
            $("#districtId").val(districtId).trigger('change');
        }


        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/MasterData/SpecialBranchUnit/DeleteSpecialBranchUnit/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

