@model OrganizationViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>Organization Information</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="Organaization" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="orgId" name="orgId">

                        <div class="form-group row">
                            <label for="bankNameBn" class="col-md-2 col-sm-12 col-form-label">Organization Type</label>
                            <div class="col-md-10 col-sm-12">
                                <select class="form-control" id="organizationType" name="organizationType">
                                    <option value="">Select</option>
                                    <option value="University">University</option>
                                    <option value="Board">Board</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="bankName" class="col-md-2 col-sm-12 col-form-label">Organization Name (EN)</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="organizationName" name="organizationName" required>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="shortOrder" class="col-md-2 col-sm-12 col-form-label">Organization Name (BN)</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="organizationNameBn" name="organizationNameBn">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger btn-sm">Cancel</button>
                                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>Organization List</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl NO</th>
                            <th>Organization Type</th>
                            <th>Organization Name (EN)</th>
                            <th>Organization Name (BN)</th>
                            <th>Action</th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.organizations.OrderByDescending(x=>x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.organizationType</td>
                                    <td>@data.organizationName</td>
                                    <td>@data.organizationNameBn</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id,'@data.organizationType','@data.organizationName','@data.organizationNameBn')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
        });


        function Edit(Id,organizationType,organizationName,organizationNameBn) {
            $("#orgId").val(Id);
            $("#organizationType").val(organizationType);
            $("#organizationName").val(organizationName);
            $("#organizationNameBn").val(organizationNameBn);
        }


        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/MasterData/Organaization/DeleteOrganization/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }

    </script>
}





