@model DegreeViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="Degree" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="DegreeId" name="DegreeId">

                        <div class="form-group row">
                            <label for="degreeName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.degreeName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="degreeName" name="degreeName" placeholder="degree name in english">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="degreeNameBn" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.degreeNameBn</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="degreeNameBn" name="degreeNameBn" placeholder="degree name Bangla">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="degreeShortName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.degreeShortName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="degreeShortName" name="degreeShortName" placeholder="degree Short Name">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="levelofeducationId" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.levelofeducation</label>
                            <div class="col-md-10 col-sm-12">
                                <select class="form-control" id="levelofeducationId" name="levelofeducationId">
                                    @foreach (var LevelofEducation in Model.LevelofEducations)
                                    {
                                        <option value="@LevelofEducation.Id">@LevelofEducation.levelofeducationName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="degreeShortName" class="col-md-2 col-sm-12 col-form-label">Short Order</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="shortOrder" name="shortOrder" placeholder="Short Order">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.degreeName</th>
                            <th>@Model.fLang.degreeNameBn</th>
                            <th>@Model.fLang.degreeShortName</th>
                            <th>Level of EducationName</th>
                            <th class="text-nowrap"></th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.degreeList.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.degreeName</td>
                                    <td>@data.degreeNameBn</td>
                                    <td>@data.degreeShortName</td>
                                    <td>@data.levelofeducation.levelofeducationName</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.degreeName', '@data.degreeNameBn','@data.degreeShortName',@data.levelofeducationId)" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
        <script>
            $(document).ready(function () {
                $('#tblData').DataTable();
            });
            

            function Edit(Id,degreeName,degreeNameBn,degreeShortName,levelofeducationId) {
                $("#DegreeId").val(Id);
                $("#degreeName").val(degreeName);
                $("#degreeNameBn").val(degreeNameBn);
                $("#degreeShortName").val(degreeShortName);
                $("#levelofeducationId").val(levelofeducationId);
            }
            function Delete(Id) {
                swal({
                    title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
                }).then(function () {

                    $.ajax({
                        url: "/MasterData/Degree/DeleteDegree/" + Id,
                        data: { Id: Id },
                        type: 'POST',
                    })
                        .done(function () {
                            swal('', 'Deleted Successfully!', 'success');
                            window.location.reload();
                        })
                        .fail(function () {
                            swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                        });
                });
            }
        </script>
}

