@model AlphaManagement.Web.Areas.Employee.Models.EmployeeInfoViewModel
@{
    ViewData["Title"] = "SectionWiseUnit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Place of posting</h5>
            </div>
            <div class="card-body">

                <form asp-area="MasterData" asp-controller="Section" asp-action="SectionWiseUnit" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="sectionId" name="sectionId" value="0" />

                    <div class="form-group row">
                        <label for="example-search-input" class="col-md-3 col-12 col-form-label">Unit <span style="color:red">*</span></label>
                        <div class="col-md-9 col-12">
                            <select class=" form-control mb-3 " name="branchId" style="width: 100%;" id="branchId" data-parsley-required="true">
                                <option value="">Select</option>

                                @foreach (var item in Model.specialBranchUnits)
                                {
                                    if (item.Id == Model.employeeInfo?.branchId)
                                    {
                                        <option value="@item.Id" selected>@item.branchUnitName</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Id">@item.branchUnitName</option>
                                    }
                                }

                            </select>
                            <input type="hidden" name="specialBranchUnitId" id="specialBranchUnitIdFinal" value="" />
                        </div>
                    </div>

                    <div class="form-group row" id="DivSubbranch" style="display:none">
                        <label for="example-search-input" class="col-md-3 col-12 col-form-label"> Sub Unit <span style="color:red">*</span></label>
                        <div class="col-md-9 col-12">
                            <select class="form-control mb-3" name="SubbranchId" style="width: 100%;" id="SubbranchId"></select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="name" class="col-3 col-form-label">Place of Posting Name(EN)</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="nameEnglish" name="nameEnglish" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="name" class="col-3 col-form-label">Place of Posting Name(BN)</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="nameBangla" name="nameBangla">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded btn-sm">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded btn-sm">Cancel</button>
                            </div>
                        </div>
                    </div>


                </form>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Posting List</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>Unit Name</th>
                            <th>Place of posting Name (EN)</th>
                            <th>Place of posting Name (BN)</th>
                            <td>Action</td>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.sections.OrderByDescending(p => p.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.specialBranchUnit?.branchUnitName</td>
                                    <td>@data.Name</td>
                                    <td>@data.NameBN</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded btn-sm" onclick="Edit(@data.Id, '@data.specialBranchUnitId','@data.Name','@data.NameBN')" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger btn-sm" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script type="text/javascript">

        function Edit(Id, specialBranchUnitId, Name, NameBN) {
            $('#sectionId').val(Id);
            //$('#branchId').val(specialBranchUnitId);
            //$('#branchId').trigger('change');
            Common.Ajax('GET', '/global/api/GetSpecialBranchUnitById/' + specialBranchUnitId, [], 'json', ajaxBranchUnit, false);
            $('#nameEnglish').val(Name);
            $('#nameBangla').val(NameBN);
        }

        function ajaxBranchUnit(res) {
            if (res.specialBranchUnitId == null) {
                $('#branchId').val(res.Id);
                $('#DivSubbranch').hide();
            } else {
                Common.Ajax('GET', '/global/api/GetSpecialBranchUnitChild/' + res.specialBranchUnitId, [], 'json', ajaxSubBranchList, false);
                $('#branchId').val(res.specialBranchUnitId);
                $('#SubbranchId').val(res.Id);
            }
        }

        function ajaxSubBranchList(res) {
            var options = '<option value="">Select</option>';
            $('#DivSubbranch').show();
            $.each(res, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.branchUnitName + '</option>';
            });

            $('#SubbranchId').empty();
            $('#SubbranchId').append(options);
        }

        $(document).ready(function () {

       $('#tblData').DataTable();

            $("#branchId").change(function () {
                var id = $(this).val();
                Common.Ajax('GET', '/global/api/GetSpecialBranchUnitChild/' + id, [], 'json', ajaxSubBranch);
                $('#specialBranchUnitIdFinal').val(id);
            });

            $("#SubbranchId").change(function () {
                var id = $(this).val();
                Common.Ajax('GET', '/global/api/GetSpecialBranchUnitChild/' + id, [], 'json', ajaxSubSubBranch);
                $('#specialBranchUnitIdFinal').val(id);
            });

        })

        $("#SubSubbranchId").change(function () {
            var id = $(this).val();
            $('#specialBranchUnitIdFinal').val(id);
        });

        function ajaxSubBranch(response) {
            var options = '<option value="">Select</option>';
            if (response.length > 0) {
                $('#DivSubbranch').show();
            } else {
                $('#DivSubbranch').hide();
            }

            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.branchUnitName + '</option>';
            });

            $('#SubbranchId').empty();
            $('#SubbranchId').append(options);
        }


        function ajaxSubSubBranch(response) {
            var options = '<option value="">Select</option>';

            if (response.length > 0) {
                $('#DivSubSubbranch').show();
            } else {
                $('#DivSubSubbranch').hide();
            }

            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.branchUnitName + '</option>';
            });

            $('#SubSubbranchId').empty();
            $('#SubSubbranchId').append(options);
        }

       // $('#branchId').select2();
        //$('#SubbranchId').select2();


        function ajaxSubBranchUnit(response) {
            if (response.Id == null) {
                $('#DivSubSubbranch').hide();
            } else {
                $('#specialBranchUnitIdFinal').val(response.Id);
                $('#SubSubbranchId').val(response.Id);
                $('#SubSubbranchId').trigger('change');
                $('#DivSubSubbranch').show();
            }
        }

         function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/MasterData/Section/DeletePostedUnit/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }

    </script>
}