@model ActivityStatusViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="ActivityStatus" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="ActivityStatusId" name="ActivityStatusId">

                        <div class="form-group row">
                            <label for="statusName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.statusName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="statusName" name="statusName" placeholder="Status Name">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="statusNameBn" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.statusNameBn</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="statusNameBn" name="statusNameBn" placeholder="status Name Bangla">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.shortName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="shortName" name="shortName" placeholder="short Name">
                            </div>
                        </div>


                        <div class="form-group row">
                            <label for="" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.statusName</th>
                            <th>@Model.fLang.statusNameBn</th>
                            <th>@Model.fLang.shortName</th>
                            <th class="text-nowrap"></th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.activityStatusList.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.statusName</td>
                                    <td>@data.statusNameBn</td>
                                    <td>@data.shortName</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.statusName', '@data.statusNameBn','@data.shortName')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
        });


        function Edit(Id,statusName,statusNameBn,shortName) {
            $("#ActivityStatusId").val(Id);
            $("#statusName").val(statusName);
            $("#statusNameBn").val(statusNameBn);
            $("#shortName").val(shortName);
        }


        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/MasterData/ActivityStatus/DeleteActivityStatus/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }

    </script>
}
