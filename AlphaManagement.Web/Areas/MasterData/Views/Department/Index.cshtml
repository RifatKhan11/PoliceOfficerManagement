@model DepartmentViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="Department" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="DepartmentId" name="DepartmentId">

                        <div class="form-group row">
                            <label for="deptCode" class="col-md-2 col-sm-12 col-form-label">Section Code</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="deptCode" name="deptCode" placeholder="Section Code">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="deptName" class="col-md-2 col-sm-12 col-form-label">Section Name</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="deptName" name="deptName" placeholder="Section Name English">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="deptNameBn" class="col-md-2 col-sm-12 col-form-label">Section Name(BN)</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="deptNameBn" name="deptNameBn" placeholder="Section Name Bangla">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label">Short Name</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="shortName" name="shortName" placeholder="Short Name">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="startDate" class="col-md-2 col-sm-12 col-form-label">Start Date</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="startDate" name="startDate" placeholder="Start Date">
                            </div>
                        </div>


                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.deptCode</th>
                            <th>@Model.fLang.deptName</th>
                            <th>@Model.fLang.deptNameBn</th>
                            <th>@Model.fLang.shortName</th>
                            <th>@Model.fLang.startDate</th>
                            <th class="text-nowrap"></th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.departments.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.deptCode</td>
                                    <td>@data.deptName</td>
                                    <td>@data.deptNameBn</td>
                                    <td>@data.shortName</td>
                                    <td>@data.startDate</td>
                                    <td class="text-nowrap">
                                        <a href="#" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.deptCode', '@data.deptName','@data.deptNameBn','@data.shortName','@data.startDate')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></a>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
        <script>
            $(document).ready(function () {
                $('#tblData').DataTable();

              $('#startDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false });
            });

            
            function Edit(Id,deptCode,deptName,deptNameBn,shortName,startDate) {
                $("#DepartmentId").val(Id);
                $("#deptCode").val(deptCode);
                $("#deptName").val(deptName);
                $("#deptNameBn").val(deptNameBn);
                $("#shortName").val(shortName);
                $("#startDate").val(startDate);
            }

            function Delete(Id) {
                swal({
                    title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
                }).then(function () {

                    $.ajax({
                        url: "/MasterData/Department/DeleteDepartment/" + Id,
                        data: { Id: Id },
                        type: 'POST',
                    })
                        .done(function () {
                            swal('', 'Deleted Successfully!', 'success');
                            window.location.reload();
                        })
                        .fail(function () {
                            swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                        });
                });
            }
        </script>
    }


