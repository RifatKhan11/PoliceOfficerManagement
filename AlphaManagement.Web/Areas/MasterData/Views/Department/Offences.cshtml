@model DepartmentViewModel
@{
    ViewData["Title"] = "Offences";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">
                    <form role="form" id="fromID">
                        <input class="form-control" type="hidden" id="offenseId" name="offenseId">

                        <div class="form-group row">
                            <label for="branchUnitName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.name</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="name" name="name" placeholder="Offence">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="branchUnitNameBN" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.description</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="description" name="description" placeholder="Description">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="branchCode" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.shortOrder</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="shortOrder" name="shortOrder" placeholder="Short Order">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" id="btnSubmit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>List</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.name</th>
                            <th>@Model.fLang.description</th>
                            <th>@Model.fLang.shortOrder</th>
                            <th>@Model.fLang.action</th>
                           
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.offenses.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr id="td_@data.Id">
                                    <td>@sl</td>
                                    <td>@data.offense</td>
                                    <td>@data.description</td>
                                    <td>@data.shortOrder</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id)" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
            //$('#districtId').select2();
            $('#isparent').click(function () {
                if ($(this).prop('checked') == true) {
                    $('#SubUnitDiv').hide();
                } else {
                    $('#SubUnitDiv').show();
                }
            });
        });

        $('#btnSubmit').click(function () {
            var oname = $('#name').val();
            var desc = $('#description').val();
         
            if (oname == '' || oname == null) {
                swal('', 'Enter Natural Punishments Name', 'warning');
                return false;
            }
            if (desc == '' || desc == null) {
                swal('', 'Please Give a Short Discription', 'warning');
                return false;
            }
            var data = $('#fromID').serialize();
            swal({
                title: 'Are you sure?', text: 'Do you want to Save this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, Save it!'
            }).then(function (res) {
                if (res.value == true) {
                    $.ajax({
                        url: "/MasterData/Department/Offences",
                        data: data,
                        type: 'POST',
                    })
                        .done(function () {
                            swal('', 'Saved Successfully!', 'success');
                            window.location.reload();
                        })
                        .fail(function () {
                            swal('Cancelled', 'It will not be Saved. Please try again later !!!', 'error');
                        });
                }
                return false;
            });
            return false;
        });

        function Edit(Id) {
            Common.Ajax('GET', '/MasterData/Department/GetOffenceById?Id=' + Id, [], 'json', ajaxGetImage, false);
        }
        function ajaxGetImage(res) {
            //   console.log(res);
            $("#offenseId").val(res.Id);
            $("#name").val(res.offense);
            $("#description").val(res.description);
            $("#shortOrder").val(res.shortOrder);
            $('#name').focus();
        }
        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!',
                closeOnConfirm: false,
                closeOnCancel: false
            }).then(function (res) { 
                if (res.value == true) {
                    Common.Ajax('GET', '/MasterData/Department/DeleteOffenceById?Id=' + Id, [], 'json', ajaxDeleteData, false);  
                }
                return false;
            });
          
        }

        function ajaxDeleteData(res) {
            $('#td_' + res).hide();

        }
    </script>
}



