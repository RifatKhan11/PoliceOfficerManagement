@model ResultViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="Result" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="ResultId" name="ResultId">

                        <div class="form-group row">
                            <label for="resultName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.resultName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="resultName" name="resultName" placeholder="Result Name">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="resultNameBn" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.resultNameBn</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="resultNameBn" name="resultNameBn" placeholder="Result Name Bangla">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="resultShortName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.resultShortName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="resultShortName" name="resultShortName" placeholder="Result Short Name">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="resultMaxValue" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.resultMaxValue</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="resultMaxValue" name="resultMaxValue" placeholder="Result Max Value">
                            </div>
                        </div>


                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.resultName</th>
                            <th>@Model.fLang.resultNameBn</th>
                            <th>@Model.fLang.resultShortName</th>
                            <th>@Model.fLang.resultMaxValue</th>
                            <th class="text-nowrap"></th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.results.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.resultName</td>
                                    <td>@data.resultNameBn</td>
                                    <td>@data.resultShortName</td>
                                    <td>@data.resultMaxValue</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.resultName', '@data.resultNameBn','@data.resultShortName','@data.resultMaxValue')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
        <script>
            $(document).ready(function () {
                $('#tblData').DataTable();
            });

            function Edit(Id,resultName,resultNameBn,resultShortName,resultMaxValue){
               $("#ResultId").val(Id);
               $("#resultName").val(resultName);
               $("#resultNameBn").val(resultNameBn);
               $("#resultShortName").val(resultShortName);
               $("#resultMaxValue").val(resultMaxValue);
            
            }

            function Delete(Id) {
                swal({
                    title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
                }).then(function () {

                    $.ajax({
                        url: "/MasterData/Result/DeleteResult/" + Id,
                        data: { Id: Id },
                        type: 'POST',
                    })
                        .done(function () {
                            swal('', 'Deleted Successfully!', 'success');
                            window.location.reload();
                        })
                        .fail(function () {
                            swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                        });
                });
            }
        </script>
    }

