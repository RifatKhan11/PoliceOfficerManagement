@model SubjectViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="Subject" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="SubjectId" name="SubjectId" value="0">

                        <div class="form-group row">
                            <label for="subjectName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.subjectName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="subjectName" name="subjectName" placeholder="subject Name English">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="subjectNameBn" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.subjectNameBn</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="subjectNameBn" name="subjectNameBn" placeholder="subject Name Bangla">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="subjectShortName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.subjectShortName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="subjectShortName" name="subjectShortName" placeholder="subject Short Name">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="shortOrder" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.shortOrder</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="shortOrder" name="shortOrder" placeholder="short Order">
                            </div>
                        </div>


                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.subjectName</th>
                            <th>@Model.fLang.subjectNameBn</th>
                            <th>@Model.fLang.subjectShortName</th>
                            <th>@Model.fLang.shortOrder</th>
                            <th class="text-nowrap"></th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.subjects.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.subjectName</td>
                                    <td>@data.subjectNameBn</td>
                                    <td>@data.subjectShortName</td>
                                    <td>@data.shortOrder</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.subjectName', '@data.subjectNameBn','@data.subjectShortName','@data.shortOrder')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
        <script>
            $(document).ready(function () {
                $('#tblData').DataTable();
            });

            function Edit(Id,subjectName,subjectNameBn,subjectShortName,shortOrder){
                $("#SubjectId").val(Id);
                $("#subjectName").val(subjectName);
                $("#subjectNameBn").val(subjectNameBn);
                $("#subjectShortName").val(subjectShortName);
                $("#shortOrder").val(shortOrder);
            }


            function Delete(Id) {
                swal({
                    title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
                }).then(function () {

                    $.ajax({
                        url: "/MasterData/Subject/DeleteSubject/" + Id,
                        data: { Id: Id },
                        type: 'POST',
                    })
                        .done(function () {
                            swal('', 'Deleted Successfully!', 'success');
                            window.location.reload();
                        })
                        .fail(function () {
                            swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                        });
                });
            }
        </script>
    }

