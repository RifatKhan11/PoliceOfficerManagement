@model RelDegreeSubjectViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="RelDegreeSubject" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="RelDegreeSubjectId" name="RelDegreeSubjectId">

                        <div class="form-group row">
                            <label for="degreeId" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.degreeName</label>
                            <div class="col-md-10 col-sm-12">
                                <select class="form-control" id="degreeId" name="degreeId">
                                    @foreach (var data in Model.degreeList.OrderBy(x=>x.degreeName))
                                    {
                                        <option value="@data.Id">@data.degreeName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="subjectId" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.subjectName</label>
                            <div class="col-md-10 col-sm-12">
                                <select class="form-control" id="subjectId" name="subjectId">
                                    @foreach (var data in Model.subjects.OrderBy(x=>x.subjectName))
                                    {
                                        <option value="@data.Id">@data.subjectName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.degreeName</th>
                            <th>@Model.fLang.subjectName</th>
                            <th class="text-nowrap"></th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.relDegreeSubjects.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.degree.degreeName</td>
                                    <td>@data.subject.subjectName</td>
                                    <td class="text-nowrap">

                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.subjectId', '@data.degreeId')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
        <script>
            $(document).ready(function () {
                $('#tblData').DataTable();
            });


         function Edit(Id,subjectId,degreeId){
            $("#RelDegreeSubjectId").val(Id);
            $("#subjectId").val(subjectId);
            $("#degreeId").val(degreeId);
            }

            function Delete(Id) {
                swal({
                    title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
                }).then(function () {

                    $.ajax({
                        url: "/MasterData/RelDegreeSubject/DeleteRelDegreeSubject/" + Id,
                        data: { Id: Id },
                        type: 'POST',
                    })
                        .done(function () {
                            swal('', 'Deleted Successfully!', 'success');
                            window.location.reload();
                        })
                        .fail(function () {
                            swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                        });
                });
            }
        </script>
    }

