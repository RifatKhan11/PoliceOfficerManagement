@model DesignationViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@section Style{
        <style>
        </style>
    }*@

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="MasterData" asp-controller="Designation" asp-action="Index" method="post">
                        <input class="form-control" type="hidden" id="DesignationId" name="DesignationId">

                        <div class="form-group row">
                            <label for="designationCode" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.designationCode</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="designationCode" name="designationCode" placeholder="Designation Code">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="designationName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.designationName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="designationName" name="designationName" placeholder="Designation Name English">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="designationNameBN" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.designationNameBN</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="designationNameBN" name="designationNameBN" placeholder="Designation Name Bangla">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="shortName" class="col-md-2 col-sm-12 col-form-label">@Model.fLang.shortName</label>
                            <div class="col-md-10 col-sm-12">
                                <input class="form-control" type="text" id="shortName" name="shortName" placeholder="short Name">
                            </div>
                        </div>

                        @*<div class="form-group row">
                        <label for="shortOrder" class="col-2 col-form-label">@Model.fLang.shortOrder</label>
                        <div class="col-10">
                            <input class="form-control" type="text" id="shortOrder" name="shortOrder" placeholder="short Order">
                        </div>
                    </div>*@


                        <div class="form-group row">
                            <label for="" class="col-md-2 col-sm-12 col-form-label"></label>
                            <div class="col-md-10 col-sm-12">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>@Model.fLang.designationCode</th>
                            <th>@Model.fLang.designationName</th>
                            <th>@Model.fLang.designationNameBN</th>
                            <th>@Model.fLang.shortName</th>
                            <th class="text-nowrap"></th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.designationList.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.designationCode</td>
                                    <td>@data.designationName</td>
                                    <td>@data.designationNameBN</td>
                                    <td>@data.shortName</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id, '@data.designationCode', '@data.designationName','@data.designationNameBN','@data.shortName')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
            $(document).ready(function () {
                $('#tblData').DataTable();
            });


            function Edit(Id,designationCode,designationName,designationNameBN,shortName) {
                $("#DesignationId").val(Id);
                $("#designationCode").val(designationCode);
                $("#designationName").val(designationName);
                $("#designationNameBN").val(designationNameBN);
                $("#shortName").val(shortName);
            }

            function Delete(Id) {
                swal({
                    title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
                }).then(function () {

                    $.ajax({
                        url: "/MasterData/Designation/DeleteDesignation/" + Id,
                        data: { Id: Id },
                        type: 'POST',
                    })
                        .done(function () {
                            swal('', 'Deleted Successfully!', 'success');
                            window.location.reload();
                        })
                        .fail(function () {
                            swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                        });
                });
            }
    </script>
}





