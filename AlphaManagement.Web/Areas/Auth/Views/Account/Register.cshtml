
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .short {
        color: red;
    }

    .Weak {
        color: orangered;
    }

    .Good {
        color: forestgreen;
    }

    .Strong {
        color: darkgreen;
    }
</style>

<link href="~/css/jquery-ui.css" rel="stylesheet" />
<div class="container p-0 m-0">
    <div class="row p-0 m-0">
        <div class="col-12 p-0 m-0 offset-1" style="margin-top:50px;">
            <div class="row no-gutters">
                <div class="col-4">
                    <img src="~/logo/Untitled-1.png" style="width:100%;height:555px;" class="img-fluid" />
                </div>
                <div class="col-8" style="background-color:#040825;width:100%;height:555px;">

                    <form id="formId">
                        <div class="col-10 offset-1" style="margin-top:25px;">

                            <div class="form-group row">
                                <label for="" class="col-4 text-light">BP No Or Name</label>
                                <div class="col-8">
                                    <input type="text" id="searchEmp" style="background-color:#292E44;color:white;" class="form-control form-control-sm" placeholder="BP No Or Name..." value="" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="" class="col-4 text-light">Name</label>
                                <div class="col-8">
                                    <input type="text" id="nameId" style="background-color:#292E44;color:white;" class="form-control form-control-sm" name="Name" placeholder="Name..." value="" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="" class="col-4 text-light">BP No</label>
                                <div class="col-8">
                                    <input type="text" id="empCodeId" style="background-color:#292E44;color:white;" class="form-control form-control-sm" name="BPNo" placeholder="Name..." value="" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="" class="col-4 text-light">Rank</label>
                                <div class="col-8">
                                    @*<input type="text" id="rankId" style="background-color:#292E44;color:white;" class="form-control form-control-sm" name="rank" placeholder="Rank..." value="" />*@
                                    <select id="rankId" style="background-color:#292E44;color:white;" class="form-control form-control-sm" name="rankId">
                                        <option>Select</option>
                                        @foreach (var item in Model.ranks)
                                        {
                                            <option value="@item.Id">@item.rankName</option>
                                        }

                                    </select>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="" class="col-4 text-light">Email</label>
                                <div class="col-8">
                                    <input type="text" id="emailId" style="background-color:#292E44;color:white;" class="form-control form-control-sm" name="Email" placeholder="Email..." value="" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="" class="col-4 text-light">Phone</label>
                                <div class="col-8">
                                    <input type="text" id="phoneId" style="background-color:#292E44;color:white;" class="form-control form-control-sm" name="PhoneNumber" placeholder="Phone..." value="" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="" class="col-4 text-light">User Name</label>
                                <div class="col-8">
                                    <input type="text" id="userId" style="background-color:#292E44;color:white;" class="form-control form-control-sm" name="UserName" placeholder="User Name..." value="" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="" class="col-4 text-light">Role</label>
                                <div class="col-8">
                                    <select id="roleId" style="background-color:#292E44;color:white;" class="form-control form-control-sm" name="RoleId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.roleViewModels)
                                        {
                                            <option value="@item.RoleName">@item.RoleName</option>
                                        }

                                    </select>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="" class="col-4 text-light">Password</label>
                                <div class="col-8">
                                    <input type="password" style="background-color:#292E44;color: white;" class="form-control form-control-sm" name="Password" id="Password" placeholder="Password..." value="" />
                                    <span id="strength_message"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="" class="col-4 text-light">Confirm Password</label>
                                <div class="col-8">
                                    <input type="password" style="background-color:#292E44;color: white;" class="form-control form-control-sm" name="ConfirmPassword" id="ConfirmPassword" placeholder="Confirm Password..." value="" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-4">

                                </div>
                                <div class="col-8">
                                    <input type="submit" class="btn btn-block" style="border-radius:15px;background-color:#A93370;color:#fff;font-weight:bold" name="name" value="Register" />

                                </div>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/jquery-ui.js"></script>
    <script>
        $(document).ready(function () {
            Common.Ajax('GET', '/global/api/GetEmployeeApi', [], 'json', ajaxEmployeeInfo);
        })

        function ajaxEmployeeInfo(response) {
            var listPostCode = [];
            $.each(response.employeeInfos, function (i, option) {
                console.log(option)
                var obj = new Object();
                obj.key = option.Id;
                obj.value = option.nameEnglish+' (BP-' + option.employeeCode+')';
                obj.employeeCode = option.employeeCode;
                obj.nameEnglish = option.nameEnglish;
                obj.email = option.emailAddressPersonal;
                obj.phone = option.mobileNumberPersonal;
                obj.rank = option.rankId;
                listPostCode[listPostCode.length] = obj;
            });
            $('#searchEmp').autocomplete({
                source: listPostCode,
                select: function (event, ui) {
                    $('#searchEmp').val(ui.item.value);
                    $('#nameId').val(ui.item.nameEnglish);
                    $('#emailId').val(ui.item.email);
                    $('#phoneId').val(ui.item.phone);
                    $('#empCodeId').val(ui.item.employeeCode);
                    if (ui.item.rank != null) {
                        $('#rankId').val(ui.item.rank);
                        $('#rankId').trigger('change');
                    }
                }
            })
        }

        $('#formId').submit(function (e) {
            e.preventDefault();
            var pass = $('#Password').val();
            var conPass = $('#ConfirmPassword').val();
            var role = $('#roleId').val();
            var userName = $('#userId').val();
            var bpNo = $('#empCodeId').val();
            if (userName != null) {
                if (userName.indexOf(' ') != -1) {
                    swal({
                        title: "", text: `There is a space in your username!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok!`
                    })
                    return false;
                }
            }
            if (bpNo.length < 10) {
                swal({
                    title: "", text: `BP No length must be 6 character!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok!`
                })
                return false;
            }
            if (pass.length<6) {
                swal({
                    title: "", text: `Password length must be 6 character!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok!`
                })
                return false;
            }
            if (pass != conPass || pass == null || pass == '') {
                swal({
                    title: "Wrong Password", text: `Doesn't Match Confirm Password!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok!`
                })
                return false;
            }
            if (role == null || role=='') {
                swal({
                    title: "", text: `Please Select Role!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok!`
                })
                return false;
            }
            var form = $('#formId');
            swal({
                title: 'Are you sure?', text: `Do you want to save this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Save!`
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '/Auth/Account/Register',
                        data: form.serialize(),
                        type: 'POST',
                        success: function (res) {
                            if (res == "Email") {
                                swal('', 'This email already in user list!', 'warning')
                            }
                            else if (res == "UserName") {
                                swal('', 'This user name already in user list!', 'warning')
                            }
                            else if (res == "BpNo") {
                                swal('', 'This BP No already in user list!', 'warning')
                            }
                            else if (res == "User Created") {
                                swal('', 'User Created!', 'success').
                                    then(function () {
                                        location.reload();
                                    })
                            }
                            else if (res == "Failed") {
                                swal('', 'Unable to Save!', 'warning');
                            }
                            else {
                                swal('', 'User Created!', 'success').
                                    then(function () {
                                        location.reload();
                                    })
                            }
                        },
                        error: function (erro) {
                            console.log(erro);
                            swal('', 'Unable to Save!', 'warning');
                        }
                    });
                }
                else if (result.dismiss === 'cancel') {
                    return false;
                }
            });
        })
    </script>
}

