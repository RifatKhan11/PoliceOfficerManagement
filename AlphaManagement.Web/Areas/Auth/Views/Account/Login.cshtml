@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Init_Layout.cshtml";
}

<section class="bg-login">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-sm-12">
                <div class="wrapper-page">
                    <div class="account-pages">
                       
                        <div class="row" style="border-radius:20px">
                            
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 offset-3" style="background-color:#E0F7FA;border-radius:20px!important">
                                <form asp-area="Auth" asp-controller="Account" asp-action="Login" method="post">

                                    <div class="col-10 offset-1" style="margin-top:30px;margin-bottom:50px;border-radius:30px!important;">
                                        <div class="text-center mb-4">                                           
                                            @* <img src="~/logo/goldPolice.PNG" style="width:110px;height:100px;" class="img-fluid rounded-circle mb-2" /> <br /> *@
                                            <h1 class="text-center" id="brandtext" style="color:#ff6a00;font-family:Arial;font-weight:bold">Employee Management</h1>

                                            <div asp-validation-summary="All" class="text-danger"></div>
                                        </div>
                                        <div class="input-group form-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text" style="background-color:#E6E6FA;border:1px solid #4800ff; border-right:none"><i class="fa fa-user"></i></span>
                                            </div>
                                            <input type="text" name="Name" style="background-color:#E6E6FA;border:1px solid #4800ff;border-left:none" class="form-control form-control-sm text-center pr-5" placeholder="User ID">

                                        </div>
                                        <div class="input-group form-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text" style="background-color:#E6E6FA;border:1px solid #4800ff"><i class="fa fa-key"></i></span>
                                            </div>
                                            <input type="password" name="Password" style="background-color:#E6E6FA;border:1px solid #4800ff; border-left:none" class="form-control form-control-sm text-center pr-5" placeholder="Password">
                                        </div>
                                        
                                        <div class="form-group">
                                            <input type="submit" class="btn btn-block" style="border-radius:15px;background-color:#483D8B;color:#fff;font-weight:bold" name="name" value="Login" />
                                        </div>
                                    </div>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

