@model UserListViewModel
@{
    ViewData["Title"] = "User Proxy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row clearfix">
    <div class="col-12">
        <div class="card mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold">User List</h6>
            </div>
            <br />
            <div class="card-body row">
                <div class="col-sm-6">
                    <div class="form-group row">
                        <label for="range" class="col-sm-4 col-form-label">User Role</label>
                        <div class="col-sm-8">
                            <select type="text" class="form-control" id="userRole" name="userRole" required>
                                <option value="NA">Select</option>
                                <option value="4737657d-4c6d-40be-a2d4-07238cf50e69">Super Admin</option>
                                <option value="bf5a87f8-4f0d-4dc2-97ea-7a0b2f59f7a1">Admin</option>
                                <option value="6b7ccf74-b656-4436-bf4e-0d10cdccf6e6">General User</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group row">
                        <label for="thana" class="col-sm-4 col-form-label">User Name</label>
                        <div class="col-sm-8">
                            <input id="userName" name="userName" class="form-control" />
                        </div>
                    </div>
                </div>


                <div class="col-sm-6">
                </div>
                <div class="col-sm-6">
                    <button class="btn btn-success" id="searchShip" style="float:right;margin-right:15px;">Search</button>
                </div>

            </div>
            <hr />
            <!-- Card Body -->
            <div class="card-body">
                <table class="table table-striped table-bordered" id="NomineeTable">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>User Name</th>
                            <th>Name</th>
                            <th>Roles</th>
                            <th>Section</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Switched User</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form asp-area="Auth" asp-controller="MasterRole" asp-action="SwitchedUser" method="post" data-parsley-validate="parsley" autocomplete="on">

                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group row">
                        <label for="Email" class="col-sm-4 col-form-label">User Name</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="userId" name="userId" value="" required readonly>
                        </div>
                    </div>


                    <div class="form-group row">
                        <label for="ConfirmPassword" class="col-sm-4 col-form-label">Security Code</label>
                        <div class="col-sm-8">
                            <input class="form-control" id="securityCode" name="securityCode">
                        </div>

                    </div>

                    <hr />
                    <button data-toggle="tooltip" title="Switch" type="submit" value="Submit" class="btn btn-success btn-sm" style="float:right; margin-top:5px;"><i class="fa fa-save"></i> Submit</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#NomineeTable').DataTable();

            $("#searchShip").click(function () {
                var userRole = $("#userRole").val();
                var userName = $("#userName").val();
                if (userName == '') {
                    userName = 'NA';
                }

                Common.Ajax('GET', '/api/Account/AllUserListByFiltering/' + userRole + '/' + userName, [], 'json', GetTokenDateRange);

            });


        });

        function GetTokenDateRange(response) {
            console.log(response)
            if (response == null) {
                return false;
            }
            $("#NomineeTable").DataTable().destroy();
            var table = $("#NomineeTable tbody");
            table.empty();
            for (var i = 0; i < response.length; i++) {
                var image = "../../images/users/userImage.jpg";
                if (response[i].imageUrl != null) {
                    image = "../../" + response[i].imageUrl;
                }

                table.append("<tr id='trId" + i + "'>" +
                    "<td><img src='" + image + "' height='80' width='80' alt='profile Image' /></td>"
                    + '<td>' + response[i]?.userName + '</td>'
                    + '<td>' + response[i]?.empName + '</td>'
                    + '<td>' + response[i]?.roleId + '</td>'
                    + '<td>' + response[i]?.mobileNo + '</td>'
                    + '<td>' +
                                '<a class="btn btn-info" title="Switched User" onclick="Edit(' + "'" + response[i].userName + "'" + ')" href="javascript:void(0)"><i class="fa fa-user-o"></i></a> '+
                    '</td></tr>');
            }
            $("#NomineeTable").DataTable();
        }

        function Edit(username) {

            $("#userId").val(username);

            $('#changePasswordModal').modal('show');

        }

    </script>
}
