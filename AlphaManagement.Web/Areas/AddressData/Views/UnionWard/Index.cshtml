@model UnionWardViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="card" style="width: 100%;">
    <div class="card-body">
        <h5 class="card-title" style="color: black">Union / Ward Information</h5>
        <hr>
        <div class="container">
            <form asp-area="AddressData" asp-controller="UnionWard" asp-action="Index" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" name="unionWardId" id="unionWardId" value="0" />
                <div class="form-group row">
                    <label for="divisionId" class="col-sm-3 col-form-label"> Division <span class="redStar">*</span></label>
                    <div class="col-sm-9">
                        <select class="form-control" name="divisionId" id="divisionId" data-parsley-required="true">
                            <option value="">Select</option>
                            @foreach (var data in Model.divisions)
                            {
                                <option value="@data.Id">@data.divisionName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-form-label col-md-3">District <span style="color:red">*</span></label>
                    <div class="col-md-9">
                        <select class="form-control" data-parsley-required="true" name="districtId" id="districtId"></select>
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-form-label col-md-3">Upazila / Thana <span style="color:red">*</span></label>
                    <div class="col-md-9">
                        <select class="form-control" data-parsley-required="true" name="thanaId" id="thanaId"></select>
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-form-label col-md-3">Union Code<span style="color:red">*</span></label>
                    <div class="col-md-9">
                        <input type="text" name="unionCode" id="unionCode" autocomplete="off" class="form-control" />
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-form-label col-md-3">Union / Ward Name (English)<span style="color:red">*</span></label>
                    <div class="col-md-9">
                        <input type="text" name="nameEnglish" id="nameEnglish" autocomplete="off" class="form-control" />
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-form-label col-md-3">Name of Union / Ward (Bangla)<span style="color:red">*</span></label>
                    <div class="col-md-9">
                        <input type="text" name="nameBangla" id="nameBangla" autocomplete="off" class="form-control" />
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-form-label col-md-3">Is Active<span style="color:red">*</span></label>
                    <div class="col-md-9">
                        <select class="form-control" name="isActive" id="isActive">
                            <option value="">Select One</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <hr>
                <button type="submit" value="Save" class="btn btn-success btn-lg" style="float:right; margin-top:5px;">Save</button>
            </form>
        </div>
    </div>
</div>

<br />
<hr />
<div class="row clearfix">
    <div class="col-12">
        <div class="card mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Union / Ward Information</h6>
            </div>
            <!-- Card Body -->
            <div class="card-body">
                <table id="tblVehicleList" class="table table-bordered table-striped" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Division</th>
                            <th>District</th>
                            <th>Upazila / Thana </th>
                            <th>Union / Ward Name (English)</th>
                            <th>Name of Union / Ward (Bangla)</th>
                            <th>Process</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts
    {
    <script type="text/javascript">

        $(document).ready(function () {

            GetUnionWard();
            $("#divisionId").change(function () {
                var id = $(this).val();
                Common.Ajax('GET', '/global/api/GetDistrictsByDivisonId/' + id, [], 'json', ajaxDistrict);
            });

            $("#districtId").change(function () {
                var id = $(this).val();
                Common.Ajax('GET', '/global/api/GetUpazillaByDistrictId/' + id, [], 'json', ajaxUpazilla);
            });

        });

        function ajaxDistrict(response) {
            var options = '<option value="">Select One</option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.districtName + '</option>';
            });
            $('#districtId').empty();
            $('#districtId').append(options);
        }

        function ajaxUpazilla(response) {
            var options = '<option value="">Select One</option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.thanaName + "(" + item.thanaNameBn + ")" + '</option>';
            });
            $('#thanaId').empty();
            $('#thanaId').append(options);
        }


        function Edit(id, thanaId, districtsId, divisionId, unionCode, unionName, unionNameBn, isActive) {
            $('#unionWardId').val(id);
            $("#divisionId").val(divisionId);
            Common.Ajax('GET', '/global/api/GetDistrictsByDivisonId/' + divisionId, [], 'json', ajaxDistrict, false);
            $("#districtId").val(districtsId);
            Common.Ajax('GET', '/global/api/GetUpazillaByDistrictId/' + districtsId, [], 'json', ajaxUpazilla, false);
            $('#thanaId').val(thanaId);
            $('#unionCode').val(unionCode);
            $('#nameEnglish').val(unionName);
            $('#nameBangla').val(unionNameBn);
            $('#isActive').val(isActive);

            document.body.scrollTop = 0; // For Safari
            document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
        }

        function Refresh() {
            location.reload();
        }

        function GetUnionWard() {
            table = $('#tblVehicleList').DataTable({
                ajax: {
                    url: "/global/api/GetAllUnionWard/",
                    dataSrc: ""
                },
                scrollX: true,
                destroy: true,
                columns: [
                    { data: "thana.district.division.divisionName" },
                    { data: "thana.district.districtName" },
                    { data: "thana.thanaName" },
                    { data: "unionName" },
                    { data: "unionNameBn" },
                    {
                        "render": function (data, type, e, meta) {
                            return '<a class="btn btn-info" href="javascript:void(0)" title="Edit" onclick="Edit(' + e.Id + ',' + e.thanaId + ',' + e.districtsId + ',' + e.thana.district.divisionId + ',' + "'" + e.unionCode + "'" + ',' + "'" + e.unionName + "'" + ',`' + e.unionNameBn + '`,`' + e.isActive + '`)"><i class="fa fa-edit"></i></a>&nbsp;&nbsp;<a class="btn btn-danger" href="javascript:void(0)" title="Delete" onclick="DeleteMaster(' + e.Id + ')"><i class="fa fa-trash"></i></a>';
                        }
                    },
                ],
                stateSave: true
            });
        }

        function DeleteMaster(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: '@Url.Action("DeleteUnionWardById", "Settings")',
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.href = "/MasterData/Settings/UnionWard";
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }

    </script>
}

