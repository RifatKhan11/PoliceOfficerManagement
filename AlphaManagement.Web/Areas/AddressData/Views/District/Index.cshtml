@model DistrictViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>District Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="District" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="DistrictId" name="DistrictId" value="0" />
                    <div class="form-group row">
                        <label for="districtCode" class="col-3 col-form-label">@Model.fLang.districtCode</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="districtCode" name="districtCode" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="districtName" class="col-3 col-form-label">@Model.fLang.districtName</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="districtName" name="districtName" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="districtNameBn" class="col-3 col-form-label">@Model.fLang.districtNameBn</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="districtNameBn" name="districtNameBn">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="shortName" class="col-3 col-form-label">@Model.fLang.shortName</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="shortName" name="shortName" >
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="divisionId" class="col-3 col-form-label">@Model.fLang.division</label>
                        <div class="col-9">
                            <select class="form-control" id="divisionId" name="divisionId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.divisionList)
                                {
                                    <option value="@data.Id">@data.divisionName</option>
                                }
                            </select>

                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>


                </form>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>District Information</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>@Model.fLang.districtName </th>
                            <th>@Model.fLang.districtNameBn </th>
                            <th>@Model.fLang.shortName </th>
                            <th>@Model.fLang.division </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.districtList.OrderByDescending(d=>d.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.districtName</td>
                                    <td>@data.districtNameBn</td>
                                    <td>@data.shortName</td>
                                    <td>@data.division?.divisionName</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id,'@data.districtCode','@data.districtName', '@data.districtNameBn', '@data.shortName',@data.divisionId)" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id,districtCode,districtName,districtNameBn, shortName,divisionId){
            $("#DistrictId").val(Id);
            $("#districtCode").val(districtCode);
            $("#districtName").val(districtName);
            $("#districtNameBn").val(districtNameBn);
            $("#shortName").val(shortName);
            $("#divisionId").val(divisionId);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/District/DeleteDistrict/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

