@model AddressTypeViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
<div class="col-lg-12">
    <div class="card m-b-30">
        <div class="card-header">
            <h5>Address Type Information</h5>
        </div>
        <div class="card-body">

            <form asp-area="AddressData" asp-action="Index" asp-controller="AddressType" method="post" id="frmData" data-parsley-validate="parsley">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" class="form-control" id="AddressTypeId" name="AddressTypeId" value="0" />
                <div class="form-group row">
                    <label for="typeName" class="col-3 col-form-label">Type Name</label>
                    <div class="col-9">
                        <input class="form-control" type="text" id="typeName" name="typeName" data-parsley-required="true" data-parsley-trigger="keyup">
                    </div>
                </div>

                <div class="form-group row">
                    <label for="" class="col-3 col-form-label"></label>
                    <div class="col-9">
                        <div>
                            <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                            <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                        </div>
                    </div>
                </div>


            </form>

        </div>
    </div>
</div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Address Type Information</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl NO</th>
                            <th>@Model.fLang.typeName </th>
                            <th>@Model.fLang.action </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.addressTypeList)
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.typeName</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id, '@data.typeName')" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id, typeName){
            $("#AddressTypeId").val(Id);
            $("#typeName").val(typeName);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/AddressType/DeleteAddressType/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}



