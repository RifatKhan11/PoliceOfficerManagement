@model PoliceUnitViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Police Unit Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="PoliceUnit" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="PoliceUnitId" name="PoliceUnitId" value="0" />

                    <div class="form-group row">
                        <label for="rangeMetroId" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.rangeMetro</label>
                        <div class="col-md-9 col-sm-12">
                            <select class="form-control" id="rangeMetroId" name="rangeMetroId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.rangeMetroList)
                                {
                                    <option value="@data.Id">@data.rangeMetroName</option>
                                }
                            </select>

                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="policeThanaId" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.policeThana</label>
                        <div class="col-md-9 col-sm-12">
                            <select class="form-control" id="policeThanaId" name="policeThanaId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.policeThanaList)
                                {
                                    <option value="@data.Id">@data.policeThanaName</option>
                                }
                            </select>

                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="unitName" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.unitName</label>
                        <div class="col-md-9 col-sm-12">
                            <input class="form-control" type="text" id="unitName" name="unitName" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="unitNameBn" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.unitNameBn</label>
                        <div class="col-md-9 col-sm-12">
                            <input class="form-control" type="text" id="unitNameBn" name="unitNameBn">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Police Unit Information</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>@Model.fLang.rangeMetro </th>
                            <th>@Model.fLang.policeThana </th>
                            <th>@Model.fLang.unitName </th>
                            <th>@Model.fLang.unitNameBn </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.policeUnitList.OrderByDescending(d => d.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.rangeMetro?.rangeMetroName</td>
                                    <td>@data.policeThana?.policeThanaName</td>
                                    <td>@data.unitName</td>
                                    <td>@data.unitNameBn</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id,@data.rangeMetroId,@data.policeThanaId, '@data.unitName', '@data.unitNameBn')" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id,rangeMetroId,policeThanaId,unitName,unitNameBn){
            $("#PoliceUnitId").val(Id);
            $("#rangeMetroId").val(rangeMetroId);
            $("#policeThanaId").val(policeThanaId);
            $("#unitName").val(unitName);
            $("#unitNameBn").val(unitNameBn);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/PoliceUnit/DeletePoliceUnit/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

