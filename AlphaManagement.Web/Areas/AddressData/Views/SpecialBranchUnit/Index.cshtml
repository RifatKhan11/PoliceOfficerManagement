@model SpecialBranchUnitViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Metropolitan Area Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="SpecialBranchUnit" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="MetropolitanAreaId" name="MetropolitanAreaId" value="0" />
                    <div class="form-group row">
                        <label for="branchUnitName" class="col-3 col-form-label">Branch Unit Name</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="branchUnitName" name="branchUnitName" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="branchUnitNameBN" class="col-3 col-form-label">Branch Unit Name(Bangla)</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="branchUnitNameBN" name="branchUnitNameBN" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="branchCode" class="col-3 col-form-label">Branch Code</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="branchCode" name="branchCode" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>



                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>


                </form>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Metropolitan Area Information</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>Branch Unit Name(English)</th>
                            <th>Branch Unit Name(Bangla)</th>
                            <th>Branch Code</th>
                            <th></th>

                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.specialBranchUnits.OrderByDescending(d => d.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.branchUnitName</td>
                                    <td>@data.branchUnitNameBN</td>
                                    <td>@Model.branchCode</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id,'@data.branchUnitName','@data.branchUnitNameBN','@data.branchCode')" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script type="text/javascript">

        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id, branchUnitName, branchUnitNameBN, branchCode) {
            $("#MetropolitanAreaId").val(Id);
            $("#branchUnitName").val(branchUnitName);
            $("#branchUnitNameBN").val(branchUnitNameBN);
            $("#branchCode").val(branchCode);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/SpecialBranchUnit/DeleteBranch/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}







