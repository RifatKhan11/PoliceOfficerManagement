@model ZoneCircleViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Zone Circle Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="ZoneCircle" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="ZoneCircleId" name="ZoneCircleId" value="0" />
                    <div class="form-group row">
                        <label for="zoneName" class="col-3 col-form-label">Zone Name(EN)</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="zoneName" name="zoneName" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="zoneName" class="col-3 col-form-label">Zone Name(BN)</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="zoneName" name="zoneName" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="districtId" class="col-3 col-form-label">Division District</label>
                        <div class="col-9">
                            <select class="form-control" id="divisionDistrictId" name="divisionDistrictId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.divisionDistrictList)
                                {
                                    <option value="@data.Id">@data.divisionDistrictName</option>
                                }
                            </select>

                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>


                </form>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Zone Circle Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>Zone Name </th>
                            <th>Zone Name(BN)</th>
                            <th>Division District</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.zoneCircleList.OrderByDescending(d => d.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.zoneName</td>
                                    <td>@data.zoneNameBn</td>
                                    <td>@Model.divisionDistrict?.divisionDistrictName</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id,'@data.zoneName','@data.zoneNameBn',@data.divisionDistrictId)" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id,zoneName,zoneNameBn,divisionDistrictId) {
            $("#ZoneCircleId").val(Id);
            $("#zoneName").val(zoneName);
            $("#zoneNameBn").val(zoneNameBn);
            $("#divisionDistrictId").val(divisionDistrictId);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/ZoneCircle/DeleteZoneCircle/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}







