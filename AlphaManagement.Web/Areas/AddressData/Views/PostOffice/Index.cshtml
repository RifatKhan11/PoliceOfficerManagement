@model PostOfficeViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Post Office Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="PostOffice" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="PostOfficeId" name="PostOfficeId" value="0" />
                    <div class="form-group row">
                        <label for="divisionCode" class="col-3 col-form-label">District</label>
                        <div class="col-9">
                            <select class="select2 form-control mb-3 custom-select" style="width: 100%;" id="distric_id" name="districtId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.districtList.OrderBy(e=>e.districtName))
                                    {
                                        <option value="@data.Id">@data.districtName</option>
                                    }
                            </select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="divisionName" class="col-3 col-form-label">Thana</label>
                        <div class="col-9">
                            <select class="form-control" id="thana_id" name="thanaId" data-parsley-required="true" data-parsley-trigger="keyup">
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="divisionNameBn" class="col-3 col-form-label">Post Code</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="postalCode" name="postalCode">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="shortName" class="col-3 col-form-label">Postal Name English</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="postalName" name="postalName">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="shortName" class="col-3 col-form-label">Postal Name Bangla</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="postalNameBn" name="postalNameBn">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="shortName" class="col-3 col-form-label">Postal Short Name</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="postalShortName" name="postalShortName">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Post Office Information</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>District Name</th>
                            <th>Thana Name</th>
                            <th>Post Code</th>
                            <th>Postal Name English</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.postOfficeList.OrderByDescending(d => d.Id))
                                {
                                    x = x + 1;
                                    <tr>
                                        <td>@x</td>
                                        <td>@data.district?.districtName</td>
                                        <td>@data.thana?.thanaName</td>
                                        <td>@data.postalCode</td>
                                        <td>@data.postalName</td>
                                        <td class="text-center text-nowrap">
                                            <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id,'@data.districtId','@data.thanaId', '@data.postalCode', '@data.postalName','@data.postalNameBn','@data.postalShortName')" href="#">Edit</a>
                                            <a class="btn btn-rounded btn-danger" onclick="Delete1(@data.Id)" href="#">Delete</a>
                                        </td>

                                    </tr>
                                }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">


        $('#distric_id').change(function () {
            var id = $(this).val();
            Common.Ajax('GET', '/global/api/GetThanasByDistrictId/' + id, [], 'json', ajaxThana);
        });

        function ajaxThana(response) {
            var options = '<option value="">Select</option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.thanaName + '</option>';
            });
            $('#thana_id').empty();
            $('#thana_id').append(options);
        }

        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id, districtId, thanaId, postalCode, postalName, postalNameBn, postalShortName) {
            $("#PostOfficeId").val(Id);
            $("#distric_id").val(districtId);
           // $("#distric_id").trigger('change');
            Common.Ajax('GET', '/global/api/GetThanasByDistrictId/' + districtId, [], 'json', ajaxThana1, false);
            $('#thana_id').val(thanaId);
            $('#thana_id').trigger('change');
            $("#postalCode").val(postalCode);
            $("#postalName").val(postalName);
            $("#postalNameBn").val(postalNameBn);
            $("#postalShortName").val(postalShortName);
        }

        //function ajaxDistrict1(response) {
        //    $('#distric_id').empty();
        //    $.each(response, function (i, v) {
        //        $("#distric_id").append('<option value="' + v.Id + '">' + v.districtName + '</option>')
        //    });
        //}

        function ajaxThana1(response) {
            $('#thana_id').empty();
            $.each(response, function (i, v) {
                $("#thana_id").append('<option value="' + v.Id + '">' + v.thanaName + '</option>')
            });
        }

        function Delete1(Id) {
            swal({
                title: 'Are you sure?',
                text: 'Do you want to delete this record!',
                type: 'warning', showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/PostOffice/DeletePostOffice?id=" + Id,
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }

        jQuery(".select2").select2({
            width: '100%'
        });

        $('#distric_id').select2();
    </script>
}





