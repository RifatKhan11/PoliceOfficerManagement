@model CountryViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@*@section Style{
        <style>
        </style>
    }*@


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5>@Model.fLang.Title</h5>
            </div>
            <div class="card-body">
                <div class="general-label">

                    <form role="form" asp-area="AddressData" asp-controller="Country" asp-action="Index" method="post" data-parsley-validate="parsley">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <input class="form-control" type="hidden" id="CountryId" name="CountryId">

                        <div class="form-group row">
                            <label for="countryCode" class="col-2 col-form-label">@Model.fLang.countryCode</label>
                            <div class="col-10">
                                <input class="form-control" data-parsley-required="true" data-parsley-trigger="keyup" type="text" id="countryCode" name="countryCode" placeholder="Country Code">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="countryName" data-parsley-required="true" data-parsley-trigger="keyup" class="col-2 col-form-label">@Model.fLang.countryName</label>
                            <div class="col-10">
                                <input class="form-control" type="text" id="countryName" name="countryName" placeholder="Country Name English">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="countryNameBn" class="col-2 col-form-label">@Model.fLang.countryNameBn</label>
                            <div class="col-10">
                                <input class="form-control" type="text" id="countryNameBn" name="countryNameBn" placeholder="Country Name Bangla">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="shortName" class="col-2 col-form-label">@Model.fLang.shortName</label>
                            <div class="col-10">
                                <input class="form-control" type="text" id="shortName" name="shortName" placeholder="Short Name">
                            </div>
                        </div>


                        <div class="form-group row">
                            <label for="" class="col-2 col-form-label"></label>
                            <div class="col-10">
                                <div class="float-right">
                                    <button type="reset" class="btn btn-danger">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header text-primary">
                <h5>@Model.fLang.Title</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl NO</th>
                            <th>@Model.fLang.countryCode</th>
                            <th>@Model.fLang.countryName</th>
                            <th>@Model.fLang.countryNameBn</th>
                            <th class="text-nowrap">@Model.fLang.action</th>
                    </thead>
                    <tbody>
                        @{
                            int sl = 0;
                            @foreach (var data in Model.countryList.OrderByDescending(x => x.Id))
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@data.countryCode</td>
                                    <td>@data.countryName</td>
                                    <td>@data.countryNameBn</td>
                                    <td class="text-nowrap text-center">
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" onclick="Edit(@data.Id,'@data.countryCode', '@data.countryName', '@data.countryNameBn','@data.shortName')" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" onclick="Delete(@data.Id)" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
        });

        function Edit(Id,countryCode,countryName,countryNameBn,shortName) {
            $("#CountryId").val(Id);
            $("#countryCode").val(countryCode);
            $("#countryName").val(countryName);
            $("#countryNameBn").val(countryNameBn);
            $("#shortName").val(shortName);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/Country/DeleteCountry/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}





