@model OccupationViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Occupation Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="Occupation" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="OccupationId" name="OccupationId" value="0" />
                    <div class="form-group row">
                        <label for="name" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.name</label>
                        <div class="col-md-9 col-sm-12">
                            <input class="form-control" type="text" id="name" name="name" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="nameBn" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.nameBn</label>
                        <div class="col-md-9 col-sm-12">
                            <input class="form-control" type="text" id="nameBn" name="nameBn" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>


                </form>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Occupation Information</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>@Model.fLang.name </th>
                            <th>@Model.fLang.nameBn </th>
                            <th>@Model.fLang.action </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.occupationList.OrderByDescending(n => n.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.name</td>
                                    <td>@data.nameBn</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id, '@data.name','@data.nameBn')" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id, name, nameBn) {
            $("#OccupationId").val(Id);
            $("#name").val(name);
            $("#nameBn").val(nameBn);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/Occupation/DeleteOccupation/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}






