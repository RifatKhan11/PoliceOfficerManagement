@model PoliceThanaViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Police Thana Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="PoliceThana" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="PoliceThanaId" name="PoliceThanaId" value="0" />

                    <div class="form-group row">
                        <label for="rangeMetroId" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.rangeMetro</label>
                        <div class="col-md-9 col-sm-12">
                            <select class="form-control" id="rangeMetroId" name="rangeMetroId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.rangeMetroList)
                                {
                                    <option value="@data.Id">@data.rangeMetroName</option>
                                }
                            </select>

                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="divisionDistrictId" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.divisionDistrict</label>
                        <div class="col-md-9 col-sm-12">
                            <select class="form-control" id="divisionDistrictId" name="divisionDistrictId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.divisionDistrictList)
                                {
                                    <option value="@data.Id">@data.divisionDistrictName</option>
                                }
                            </select>

                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="zoneCircleId" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.zoneCircle</label>
                        <div class="col-md-9 col-sm-12">
                            <select class="form-control" id="zoneCircleId" name="zoneCircleId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.zoneCircleList)
                                {
                                    <option value="@data.Id">@data.zoneName</option>
                                }
                            </select>

                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="upazillaId" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.upazilla</label>
                        <div class="col-md-9 col-sm-12">
                            <select class="form-control" id="upazillaId" name="upazillaId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.thanaList)
                                {
                                    <option value="@data.Id">@data.thanaName</option>
                                }
                            </select>

                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="policeThanaName" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.policeThanaName</label>
                        <div class="col-md-9 col-sm-12">
                            <input class="form-control" type="text" id="policeThanaName" name="policeThanaName" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="policeThanaNameBn" class="col-md-3 col-sm-12 col-form-label">@Model.fLang.policeThanaNameBn</label>
                        <div class="col-md-9 col-sm-12">
                            <input class="form-control" type="text" id="policeThanaNameBn" name="policeThanaNameBn">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Police Thana Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-responsive table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>@Model.fLang.rangeMetro </th>
                            <th>@Model.fLang.divisionDistrict </th>
                            <th>@Model.fLang.zoneCircle </th>
                            <th>@Model.fLang.upazilla </th>
                            <th>@Model.fLang.policeThanaName </th>
                            <th>@Model.fLang.policeThanaNameBn </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.policeThanaList.OrderByDescending(d => d.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.rangeMetro?.rangeMetroName</td>
                                    <td>@data.divisionDistrict?.divisionDistrictName</td>
                                    <td>@data.zoneCircle?.zoneName</td>
                                    <td>@data.upazilla?.thanaName</td>
                                    <td>@data.policeThanaName</td>
                                    <td>@data.policeThanaNameBn</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id,@data.rangeMetroId,@data.divisionDistrictId, @data.zoneCircleId, @data.upazillaId, '@data.policeThanaName', '@data.policeThanaNameBn')" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id,rangeMetroId,divisionDistrictId,zoneCircleId,upazillaId,policeThanaName,policeThanaNameBn) {
            $("#PoliceThanaId").val(Id);
            $("#rangeMetroId").val(rangeMetroId);
            $("#divisionDistrictId").val(divisionDistrictId);
            $("#zoneCircleId").val(zoneCircleId);
            $("#upazillaId").val(upazillaId);
            $("#policeThanaName").val(policeThanaName);
            $("#policeThanaNameBn").val(policeThanaNameBn);

        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/PoliceThana/DeletePoliceThana/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}



