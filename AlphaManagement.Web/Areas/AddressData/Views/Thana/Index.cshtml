@model ThanaViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Thana Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="Thana" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="ThanaId" name="ThanaId" value="0" />
                    <div class="form-group row">
                        <label for="thanaCode" class="col-3 col-form-label">@Model.fLang.thanaCode</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="thanaCode" name="thanaCode" @*data-parsley-required="true" data-parsley-trigger="keyup"*@>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="thanaName" class="col-3 col-form-label">@Model.fLang.thanaName</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="thanaName" name="thanaName" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="thanaNameBn" class="col-3 col-form-label">@Model.fLang.thanaNameBn</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="thanaNameBn" name="thanaNameBn" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="shortName" class="col-3 col-form-label">@Model.fLang.shortName</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="shortName" name="shortName">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="districtId" class="col-3 col-form-label">@Model.fLang.district</label>
                        <div class="col-9">
                            <select class="form-control" id="districtId" name="districtId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.districtList)
                                {
                                    <option value="@data.Id">@data.districtName</option>
                                }
                            </select>

                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="rangeMetroId" class="col-3 col-form-label">@Model.fLang.rangeMetro</label>
                        <div class="col-9">
                            <select class="form-control" id="rangeMetroId" name="rangeMetroId" @*data-parsley-required="true" data-parsley-trigger="keyup"*@>
                                <option value="">Select</option>
                                @foreach (var data in Model.rangeMetroList)
                                {
                                    <option value="@data.Id">@data.rangeMetroName</option>
                                }
                            </select>

                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>


                </form>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Thana Information</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>Thana Code </th>
                            <th>@Model.fLang.thanaName </th>
                            <th>@Model.fLang.thanaNameBn </th>
                            <th>@Model.fLang.district </th>
                            <th>@Model.fLang.rangeMetro </th>
                            <th>@Model.fLang.action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.thanaList.OrderByDescending(d => d.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.thanaCode</td>
                                    <td>@data.thanaName</td>
                                    <td>@data.thanaNameBn</td>
                                    <td>@data.district?.districtName</td>
                                    <td>@data.rangeMetro?.rangeMetroName</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id,'@data.thanaCode','@data.thanaName', '@data.thanaNameBn', '@data.shortName','@data.districtId','@data.rangeMetroId')" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id,thanaCode, thanaName, thanaNameBn, shortName, districtId, rangeMetroId){
            $("#ThanaId").val(Id);
            $("#thanaCode").val(thanaCode);
            $("#thanaName").val(thanaName);
            $("#thanaNameBn").val(thanaNameBn);
            $("#shortName").val(shortName);
            $("#districtId").val(districtId);
            $("#rangeMetroId").val(rangeMetroId);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/Thana/DeleteThana/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}



