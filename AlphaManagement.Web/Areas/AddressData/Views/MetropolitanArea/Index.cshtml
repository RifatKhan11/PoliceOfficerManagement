@model MetropolitanAreaViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}





<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Metropolitan Area Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="MetropolitanArea" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="MetropolitanAreaId" name="MetropolitanAreaId" value="0" />
                    <div class="form-group row">
                        <label for="areaName" class="col-3 col-form-label">@Model.fLang.areaName</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="areaName" name="areaName" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="areaNameBn" class="col-3 col-form-label">@Model.fLang.areaNameBn</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="areaNameBn" name="areaNameBn" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="districtId" class="col-3 col-form-label">@Model.fLang.district</label>
                        <div class="col-9">
                            <select class="form-control" id="districtId" name="districtId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.DistrictList)
                                {
                                    <option value="@data.Id">@data.districtName</option>
                                }
                            </select>

                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>


                </form>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Metropolitan Area Information</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>@Model.fLang.areaName </th>
                            <th>@Model.fLang.areaNameBn </th>
                            <th>@Model.fLang.district </th>
                            <th></th>
                        
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.metropolitanAreaList.OrderByDescending(d => d.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.areaName</td>
                                    <td>@data.areaNameBn</td>
                                    <td>@Model.DistrictList.Where(d=>d.Id==data.districtId).FirstOrDefault().districtName</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id,'@data.areaName','@data.areaNameBn',@data.districtId)" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id,areaName,areaNameBn,districtId) {
            $("#MetropolitanAreaId").val(Id);
            $("#areaName").val(areaName);
            $("#areaNameBn").val(areaNameBn);
            $("#districtId").val(districtId);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/MetropolitanArea/DeleteMetropolitanArea/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}





