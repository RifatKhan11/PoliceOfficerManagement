@model DivisionViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Division Information</h5>
            </div>
            <div class="card-body">

                <form asp-area="AddressData" asp-controller="Division" asp-action="Index" id="frmData" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" class="form-control" id="DivisionId" name="DivisionId" value="0" />
                    <div class="form-group row">
                        <label for="divisionCode" class="col-3 col-form-label">@Model.fLang.divisionCode</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="divisionCode" name="divisionCode" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="divisionName" class="col-3 col-form-label">@Model.fLang.divisionName</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="divisionName" name="divisionName" data-parsley-required="true" data-parsley-trigger="keyup">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="divisionNameBn" class="col-3 col-form-label">@Model.fLang.divisionNameBn</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="divisionNameBn" name="divisionNameBn">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="shortName" class="col-3 col-form-label">@Model.fLang.shortName</label>
                        <div class="col-9">
                            <input class="form-control" type="text" id="shortName" name="shortName">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="divisionId" class="col-3 col-form-label">@Model.fLang.country</label>
                        <div class="col-9">
                            <select class="form-control" id="countryId" name="countryId" data-parsley-required="true" data-parsley-trigger="keyup">
                                <option value="">Select</option>
                                @foreach (var data in Model.countryList)
                                {
                                    <option value="@data.Id">@data.countryName</option>
                                }
                            </select>

                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="" class="col-3 col-form-label"></label>
                        <div class="col-9">
                            <div>
                                <button type="submit" class="btn btn-outline-primary btn-rounded">Save</button>
                                <button type="reset" class="btn btn-outline-warning btn-rounded">Cancel</button>
                            </div>
                        </div>
                    </div>


                </form>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h5>Division Information</h5>
            </div>
            <div class="card-body">


                <table class="table table-responsive-sm table-striped table-bordered" id="tblData">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>@Model.fLang.divisionCode </th>
                            <th>@Model.fLang.divisionName </th>
                            <th>@Model.fLang.divisionNameBn </th>
                            <th>@Model.fLang.shortName </th>
                            <th>@Model.fLang.country </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int x = 0;
                            @foreach (var data in Model.divisionList.OrderByDescending(d => d.Id))
                            {
                                x = x + 1;
                                <tr>
                                    <td>@x</td>
                                    <td>@data.divisionCode</td>
                                    <td>@data.divisionName</td>
                                    <td>@data.divisionNameBn</td>
                                    <td>@data.shortName</td>
                                    <td>@data.country?.countryName</td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-info btn-rounded" onclick="Edit(@data.Id,'@data.divisionCode','@data.divisionName', '@data.divisionNameBn', '@data.shortName',@data.countryId)" href="#">Edit</a>
                                        <a class="btn btn-rounded btn-danger" onclick="Delete(@data.Id)" href="#">Delete</a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblData').DataTable()

        });

        function Edit(Id,divisionCode,divisionName,divisionNameBn, shortName,countryId) {
            $("#DivisionId").val(Id);
            $("#divisionCode").val(divisionCode);
            $("#divisionName").val(divisionName);
            $("#divisionNameBn").val(divisionNameBn);
            $("#shortName").val(shortName);
            $("#countryId").val(countryId);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/AddressData/Division/DeleteDivision/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}



