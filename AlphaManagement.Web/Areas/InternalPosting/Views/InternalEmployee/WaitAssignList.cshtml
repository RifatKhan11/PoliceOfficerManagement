@model PostingReportViewModel
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_PrintViewPolice.cshtml";
}



<h4 style="text-align:center">Posted Offices' List</h4>
<h4 style="text-align:center">Reference Number- @Model.internalEnlistAssignments?.FirstOrDefault()?.reqNo</h4>
<h4 style="text-align:center">Date @Model.internalEnlistAssignments?.FirstOrDefault()?.date?.ToString("dd-MMM-yyyy")</h4>

<div class="row">
    <table class="" style="width:100%;font-size:160%">
        @{ var i = 1;}
        @foreach (var item in Model.internalEnlistAssignments)
        {
            <tr>
                <td>@i</td>
                <td>
                    <h6>@item.Name (BP-@item.Bp) <br /> @item?.deptName <br />@item?.rankName </h6>                 
                </td>
                <td>
                    <h6> @item?.NewPostringPlace <br /> @item?.rankName  </h6>             
                </td>
            </tr>
            i++;
        }

    </table>
</div>

