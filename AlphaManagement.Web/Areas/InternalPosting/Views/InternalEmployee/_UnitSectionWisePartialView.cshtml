@model InternalAssignmentViewModel
@{
    ViewData["Title"] = "Employee Posting";
    //Layout = "~/Views/Shared/_LayoutForPartial.cshtml";
}
<link href="~/plugins/nestable/jquery.nestable.css" rel="stylesheet" />
<link href="~/plugins/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/css/bootstrap.min.css" rel="stylesheet">
<link href="~/css/slidebars.min.css" rel="stylesheet">
<link href="~/css/icons.css" rel="stylesheet">
<link href="~/css/menu.css" rel="stylesheet" type="text/css">
<link href="~/css/style.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Zen+Dots&display=swap" rel="stylesheet">

<style>

    .nestable-color-2 .dd-handle {
        background-color: #0069D1;
        color: #fff;
    }

    .nestable-color-2 .dd-handle1 {
        background-color: red !important;
    }

    .sb-custom-toggle-right {
        top: 45%;
        position: fixed;
        right: 0%;
    }

    #divEmpList::-webkit-scrollbar {
        width: 0; /* Remove scrollbar space */
        background: transparent; /* Optional: just make scrollbar invisible */
    }

    .previewCls {
        color: black;
        font-weight: bolder;
        border-radius: 7px;
        padding: 8px;
        margin-top: 5px;
    }
    /*@@media screen and (max-width: 1400px){
        .empInfo{
            font-size:10px;
        }
    }*/
</style>
<div class="col-12" id="divEmpList" style="padding:0;height:850px;overflow-y:scroll;">
    <ol class="dd-list">
        @{
            if (Model.unitRankWiseEmployeeViewModels.Count() == 0)
            {
                <div style="padding-top:200px;text-align:center;">
                    <p style="font-size:24px;">No Data Found</p>
                </div>
            }
            else
            {
                foreach (var data in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 1).GroupBy(x => new { x.unitId, x.mainUnit }).Select(x => new { unitId = x.Key.unitId, mainUnit = x.Key.mainUnit }))
                {
                    <li class="dd-item" data-id="@data.unitId">
                        <div style="font-size:16px!important;padding:10px 25px 30px 20px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.mainUnit<span class="m-2" title="Total Officers"><a href="#" style="color:white" onclick="showAllSectionEmployee(@data.unitId)"><i class="fa fa-user text-info"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == data.unitId).FirstOrDefault().totalEmployee</a></span></div>
                        <ol class="dd-list">
                            @foreach (var sitem in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 1 && x.unitId == data.unitId && x.employeeId != 0))
                            {
                                <li class="dd-item empLi" id="emp-@sitem.employeeId" data-id="@sitem.unitId">
                                    <div class="dd-handle ui-state-default" style="background-color: @sitem.colorCode;color:black;font-weight:bolder;border-radius:7px">
                                        <span class="empInfo">@sitem.name</span>
                                        <span class="pull-right" style="margin:-3px" onclick="fnEmployeeShow(@sitem.employeeCode)"><a class="btn" href="javascript:void(0)"><i class="fa fa-user-circle-o"></i></a></span>
                                        <span class="pull-right" style="margin:-3px" onclick="moveToSection(@sitem.employeeId,'@sitem.name',@sitem.employeeCode,'@sitem.colorCode','@sitem.subUnit','@data?.mainUnit')"><a class="btn" href="javascript:void(0)"><i class="fa fa-level-up" title="Move" style="padding:2px;color:white;background-color:red;width:20px;height:20px;border-radius:50%" ></i></a></span>
                                        <input type="hidden" class="clsEmpId" id="txtEmpId-@sitem.employeeId" value="@sitem.employeeId" />
                                        <input type="hidden" class="clsEmpName" value="@sitem.name" />
                                        <input type="hidden" class="clsEmpCode" value="@sitem.employeeCode" />
                                        <input type="hidden" class="clsEmpColor" value="@sitem.colorCode" />
                                        <input type="hidden" class="clsEmpImg" value="@sitem.subUnit" />
                                        <input type="hidden" class="clsEmpSection" value="@data?.mainUnit" />
                                        @if (sitem.expertise != "")
                                        {
                                            <img src="@sitem.expertise" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />
                                        }
                                        else
                                        {
                                        }
                                        &nbsp;
                                        @if (sitem.attachedUnit != "")
                                        {
                                            <img src="~/batch/attached.png" data-toggle="tooltip" data-placement="top" title="@sitem.attachedUnit" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />
                                        }
                                        &nbsp;
                                        @if (sitem.pHQTRTypeId > 0)
                                        {
                                            <img src="~/batch/unmission.png" title="UN Mission" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />

                                        }
                                        &nbsp;
                                        @if (sitem.lockedEmpId > 0)
                                        {
                                            @*<img src="~/batch/locked.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />*@

                                        }
                                        else { }
                                    </div>
                                </li>
                            }
                        </ol>
                    </li>
                }
            }


        }

    </ol>
</div>
<script src="~/js/jquery-3.2.1.min.js"></script>
<script src="~/js/bootstrap.min.js"></script>
<script src="~/js/jquery.slimscroll.min.js"></script>
<script src="~/js/slidebars.min.js"></script>
<script src="~/js/common.js"></script>
<!-- Responsive and datatable js -->
<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
<script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
<script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
<script src="~/plugins/nestable/jquery.nestable.js"></script>
<script src="~/plugins/nestable/nestable.js"></script>
<script src="~/js/dropify.min.js"></script>
<!--app js-->
<script src="~/js/jquery.app.js"></script>
<!--Swall-->
<script type="text/javascript" src="~/plugins/parsleyjs/dist/parsley.min.js"></script>
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/jquery-ui.min.js"></script>
<script>
    $(document).ready(function () {
        $('#olEmpList').show();
        $('#loaderDiv').hide();
        $(".empLi").sortable({
            connectWith: ['.deptBox'],
            appendTo: 'body',
            tolerance: 'pointer',
            revert: true,
            forceHelperSize: true,
            helper: function (event, element) {
                return element.clone().appendTo("body")
            },
            scroll: false,
            update: function (event, ui) {

            },
            start: function (e, ui) {
                window.grabbed = true;
                ui.item.startPos = ui.item.prevAll().length + 1;
                var div = ui.item.get(0);
                document.body.appendChild(div);
            },
            stop: function () {
                window.grabbed = false;
            }
        }).sortable("option", "scroll", false)
            .disableSelection();

        $(".deptBox").droppable({
            drop: function (event, ui) {
                var empId = ui.draggable.find('input.clsEmpId').val();
                var EmpName = ui.draggable.find('input.clsEmpName').val();
                var empCode = ui.draggable.find('input.clsEmpCode').val();
                var sectionId = $(this).find('input.clsSectionId').val();
                var newSectionName = $(this).find('input.clsSectionName').val();
                var oldSectionName = ui.draggable.find('input.clsEmpSection').val();
                var empColor = ui.draggable.find('input.clsEmpColor').val();
                var empIgm = ui.draggable.find('input.clsEmpImg').val();
                var data = `<li class="newLi" id="addedemp-${empId}" style="background-color:${empColor};"><a href="javascript:void(0)"><i class="fa fa fa-window-close pull-right" style="color:red" onclick=removeNewLi(${empId})></i></a>${EmpName}<input type="hidden" name="employeeId" value="${empId}" /><input type="hidden" name="sectionId" value="${sectionId}" /></li>`
                
                var assign = `<li id=assLi${empId} class="row previewCls" style="background-color:${empColor};padding-left:4%;margin-left: 0;">
                                <div class="col-11" style="padding:0">${EmpName}<label style="padding:0;margin: 0;">Previous Section: ${oldSectionName}</label><label style="padding:0;margin: 0;">New Section: ${newSectionName}</label></div>
                                <div class="col-1"><span style="color:red;cursor: pointer;" onclick="removeNewLi(${empId})"><i class="fa fa-times"></i></span></div></li>`
                if (oldSectionName.trim() == newSectionName.trim()) {
                    swal("Already in this section");
                    return false;
                }
                var count = $('#assignedEmpList1').find('li').length;
                //$('#section-' + sectionId).append(`<li class="newLi" id="addedemp-${empId}"><a href="javascript:void(0)"><i class="fa fa fa-window-close pull-right" style="color:red" onclick=removeNewLi(${empId})></i></a>${EmpName}<input type="hidden" name="employeeId" value="${empId}" /><input type="hidden" name="sectionId" value="${sectionId}" /></li>`);
                $('#section-' + sectionId).append(data);
                $('#assignedEmpList1').append(assign);
                if ((count+1) > 0) {
                    $('.fa-location-arrow').empty();
                    $('.fa-location-arrow').append(count + 1);
                }
                $('#emp-' + empId).hide();
                $('#empU-' + empId).hide();
                //var empId = ui.draggable.find('input.clsEmpId').val();
                //var EmpName = ui.draggable.find('input.clsEmpName').val();
                //var sectionId = $(this).find('input.clsSectionId').val();
                //$('#section-' + sectionId).append(`<li class="newLi" id="addedemp-${empId}"><a href="javascript:void(0)"><i class="fa fa fa-window-close pull-right" style="color:red" onclick=removeNewLi(${empId})></i></a>${EmpName}<input type="hidden" name="employeeId" value="${empId}" /><input type="hidden" name="sectionId" value="${sectionId}" /></li>`);
                //$('#emp-' + empId).hide();
            },
        });
    })
</script>
