<div class="modal fade" id="otpSendModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document" style="width:300px;max-height:500px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Confirm By OTP</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card" style="height:300px">
                    <div class="card-body m-0 p-0" id="div1">
                        <p class="text-center">
                            <img src="~/batch/message.png" style="width:50%; height:100px" class="img-fluid rounded-circle" />
                        </p>

                        <div class="col-md-12 text-center">
                            <div class="page-head m-0 p-0">
                                <h6 id="txtText" class="my-2" style="font-weight:900">
                                    <b style="font-weight:bolder;font-size:17px">Your Email : <span id="headerEmail"></span></b>  <br />
                                </h6>
                                <p>To complete your verification. Please press the button bellow.</p>
                            </div>
                        </div>

                    </div>

                    <div class="row" id="div2">
                        <form id="otpSendForm" style="width:100%;">
                            <div class="col-md-12">
                                <div class="col-xl-10 col-md-10 col-sm-10 pull-right">
                                    <div class="form-group row">
                                        <div class="col-md-9">
                                            <div class="radio my-2 form-inline" style="width:200%;">
                                                <label class="cr-styled" for="example-radio1">
                                                    <input type="radio" id="example-radio1" name="smsTypeId" value="2" checked>
                                                    <i class="fa"></i>&nbsp;&nbsp;
                                                    Mobile <span id="formMobile"></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-10 offset-1 ml-0 pl-0">
                                        <input class="btn btn-info btn-sm btn-block" id="btnNext" style="background-color:#25C38C!important;color:#fff; border-radius: 50px;" type="button" value="Next" />
                                    </div>
                                </div>

                                <div class="col-xl-1 col-md-1 col-sm-1">
                                    <input type="hidden" name="UserId" value="@Model?.userInfo?.bpNo" />

                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-12 card-body" id="div3" style="display:none">
                        <form asp-area="Auth" asp-controller="Account" asp-action="OTPVerificationLockInternal" method="post" style="width:100%;">
                            <p class="text-center">
                                <img src="~/batch/message.png" style="width:50%; height:100px" class="img-fluid rounded-circle" />
                            </p>
                            <label style="color:red;font-weight:bolder" class="col-12 text-center">Enter Your OTP Code</label>
                            <input type="hidden" class="form-control text-center" name="UserOTPCode" id="UserOTPCode" required />
                            <input type="hidden" class="form-control text-center" name="verifyMessage" id="verifyMessageInput" value="" />
                            <input type="hidden" class="form-control text-center" name="UserId" value="@Model.assignmentDetailsModals?.FirstOrDefault()?.masterId" />
                            <div class="form-group">
                                <div class="col-md-12 col-12 p-0 m-0" style="font-size:17px;">
                                    <input type="text" onkeyup="fnNextOTP(1)" id="opt1" maxlength="1" min="1" class="numeric text-center" style="border:solid 1px;border-color:black;width:50px;height:50px;" />
                                    <input type="text" onkeyup="fnNextOTP(2)" id="opt2" maxlength="1" min="1" class="numeric text-center" style="border:solid 1px;border-color:black;width:50px;height:50px;" />
                                    <input type="text" onkeyup="fnNextOTP(3)" id="opt3" maxlength="1" min="1" class="numeric text-center" style="border:solid 1px;border-color:black;width:50px;height:50px;" />
                                    <input type="text" onkeyup="fnNextOTP(4)" id="opt4" maxlength="1" min="1" class="numeric text-center" style="border:solid 1px;border-color:black;width:50px;height:50px;" />
                                    <input type="hidden" name="otpNumber" maxlength="4" id="otpNumber" required class="form-control" />
                                </div>
                            </div>
                            <div class="col-12 text-center">
                                <input type="submit" class="btn btn-success" value="Verify" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger btn-sm text-center" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

            $('#home-tab').click(function () {
                $('#profile').removeClass('show active');
                $('#home').addClass('show active');
            });

            $('#profile-tab').click(function () {
                $('#home').removeClass('show active');
                $('#profile').addClass('show active');
            });

            $("#moveModalSearchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#moveModalSearch ol li").not(".notsearch").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

        });

        @*function Edit(Id, trainingCategoryName, trainingCategoryNameBn, trainingCategoryShortName, shortOrder) {
            $("#TrainingCategoryId").val(Id);
            $("#trainingCategoryName").val(trainingCategoryName);
            $("#trainingCategoryNameBn").val(trainingCategoryNameBn);
            $("#trainingCategoryShortName").val(trainingCategoryShortName);
            $("#shortOrder").val(shortOrder);
        }

        function approve1(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to submit this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, submit it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/Assignment/AssignmentMasterUpdate/" + Id,
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Submitted Successfully!!', 'success');
                        window.location.href = "/Employee/Assignment/AssignmentMaster";
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be submit. Please try again later !!!', 'error');
                    });
            });
        }

        function LoadForMoveTo(empId, refNo, Id) {
            $("#moveToDiv").load("/Employee/Assignment/GetMoveToListOngoing?refNum=" + refNo + "&empId=" + empId);
            $('#divLoader').show();
            $('#moveToDiv').show();
            $('#moveToModal').modal('show');
            $('#AssignmentDetailsIdForChnage').val(Id);
        }


        function moveToPostingPlace(id) {
            var AssignmentDetailsIdForChnage = $('#AssignmentDetailsIdForChnage').val();
            var moveLiId = $('#unitId-' + id);
            var moveLi = $('#moveLi-' + id);
            var check = moveLiId.find('div.wosue').text();
            var postingPlace = moveLi.find('option:selected').val();
            var postingPlaceText = moveLi.find('option:selected').text();

            //alert(postingPlace);
            //alert(postingPlaceText);
            //alert(AssignmentDetailsIdForChnage);
            //return false;

            if (check != '') {
                swal({
                    title: 'Not Done', text: `Place Not Empty Now`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Save!`
                })
                return false;
            }
            else if (postingPlace == '') {
                swal({
                    title: 'Not Done', text: `Select Posting Place First`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok!`
                })
                return false;
            }
            else {
                swal({
                    title: 'Are you sure?', text: `Do you want to move this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Save!`
                }).then((result) => {
                    if (result.value) {
                        $.ajax({
