@model PostingReportViewModel
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "PostingReport";
    Layout = "~/Views/Shared/_PrintView.cshtml";
}
<style>
@@import url('https://fonts.maateen.me/bangla/font.css');
    body {
        font-family: 'Bangla', Arial, sans-serif !important;
    }
</style>
<div class="container-fluid">
    <div class="row">
        <div class="col-4">
            <qrcode content="Memorandum no : @AlphaManagement.Web.Helpers.LanguageProcessing.BanglaToEnglish(Model?.internalAssignments?.FirstOrDefault().assignmentMaster?.memorandumNo),Reference No :  @Model?.internalAssignments?.FirstOrDefault().assignmentMaster?.refNo,Posting Order Date :  @Model?.internalAssignments?.FirstOrDefault().assignmentMaster?.refDate.ToString("dd/MM/yyyy")" width="120" height="120"></qrcode>
        </div>
        <div class="col-4">

            <h5 class="text-center text-justify">গণপ্রজাতন্ত্রী বাংলাদেশ সরকার <br /> বাংলাদেশ পুলিশ<br /> পুলিশ হেডকোয়ার্টার্স <br /> ৬, ফিনিক্স রোড, ফুলবাড়িয়া <br /> ঢাকা-১০০০ <br />www.police.gov.bd</h5>
        </div>
        <div class="col-1">

        </div>
        <div class="col-3">
            <h5>
                <img src="~/images/sheikh100.png" style="height:130px;width:180px" />
            </h5>
        </div>
    </div>
    <div class="row">
        <div class="col-8">
            <h5>নং- @LanguageProcessing.EnglishToBangla(@Model.internalAssignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.memorandumNo)</h5>
        </div>
        <div class="col-4">
            &nbsp;   &nbsp;   <h5 style="float:right">তারিখঃ @LanguageProcessing.BanglaDate(@Model.internalAssignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.refDate.ToString("dd-MMM-yyyy")) খ্রিঃ</h5>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-12">
            <h5 class="text-center"><u>প্রজ্ঞাপন</u></h5>
            <h5 class="text-justify">&nbsp; &nbsp;&nbsp; &nbsp;  @Model.internalAssignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.title</h5>
        </div>
    </div>
    <input type="hidden" name="assignMasterId" id="assignMasterId" value="@ViewBag.Id" />

    <div class="row  mt-3" style="font-size:8px;">
        <div class="col-12">
            <table class="table table-bordered">
                @{ var i = 1;
                    var namef = "জনাব";

                    @foreach (var item in Model.internalAssignments)
                    {
                        <tr>
                            <td style="font-size:20px;padding:0;" width="3%"><span style="margin-left:10px">@LanguageProcessing.EnglishToBangla(i.ToString()+".")</span></td>
                            <td style="padding:0;">
                                <h5><span style="margin-left:10px">@namef @item.employee.nameBangla (বিপি-@LanguageProcessing.EnglishToBangla(@item.employee.employeeCode))</span></h5>
                                @if (item.employee?.section?.specialBranchUnit?.isdefault == 1)
                                {
                                    <h5 style="margin:0;padding:0;">
                                        <span style="margin-left:10px">
                                            @item.employee?.rank?.shortName
                                        </span>
                                    </h5>
                                }
                                else
                                {
                                    <h5 style="margin:0;padding:0;">
                                        <span style="margin-left:10px">
                                            @item.employee?.rank?.rankNameBN
                                        </span>
                                    </h5>
                                }
                                <h5 style="margin:0;padding:0;"><span style="margin-left:10px">@item?.updatedBy, @item?.createdBy</span></h5>
</td>
                            <td class="text-center" style="padding:0;">
                                @if (item?.section?.specialBranchUnit?.isdefault == 1)
                                {
                                    <h5>
                                        <span style="margin-left:10px">
                                            @item.employee?.rank?.shortName
                                        </span>
                                    </h5>
                                }
                                else
                                {
                                    <h5><span style="margin-left:10px">@item.employee?.rank?.rankNameBN</span></h5>
                                }
                                <h5 style="margin:0;padding:0;"><span style="margin-left:10px">@item?.department?.deptNameBn,@item?.createdBy</span></h5>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </table>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <h5 class="text-justify" style="line-height:30px">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; @Model.internalAssignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.description</h5>
        </div>
    </div><br />
    <div class="row mt-5 mb-5">
        <div class="col-7"></div>
        <div class="col-5 float-right">
            <h5 class="text-center"><u>স্বাক্ষর/-</u></h5>
            <h5 class="text-center">ড. বেনজীর আহমেদ, বিপিএম(বার) <br /> ইন্সপেক্টর জেনারেল অব পুলিশ, বাংলাদেশ <br /> পুলিশ হেডকোয়ার্টার্স, ঢাকা</h5>
            </div>
    </div>

    <div class="row mt-2">
        <div class="col-12">
            <h5 class="text-right pull-right float-right m-2">তারিখঃ @LanguageProcessing.BanglaDate(@Model.internalAssignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.refDate.ToString("dd-MMM-yyyy"))</h5>

            <h5 class="m-2">স্মারক নং-@LanguageProcessing.EnglishToBangla(@Model.internalAssignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.memorandumNo)</h5>
            <h5 class="mr-4 m-3 ml-5">অনুলিপি সদয় অবগতির ও প্রয়োজনীয় ব্যবস্থা গ্রহণের জন্য প্রেরণ করা হলো (জ্যেষ্ঠতার ভিত্তিতে নয়) :-</h5>
            @{
                var cnt = 0;
                @foreach (var item in Model.internalAssignmentAnulipis)
                {
                    cnt = cnt + 1;
                    <p style="font-size:20px;margin:0">@LanguageProcessing.EnglishToBangla(cnt.ToString()).@item.anulipiText</p>
                }
            }
        </div>
    </div>
    <br />

    <div class="row mt-5">
        <div class="col-7"></div>
        <div class="col-5 float-right">
            <h5 class="text-center">(মো. মাসুদুর রহমান )<br /> বিপি-৭০০১০২০৮৮৮  <br /> অতিরিক্ত ডিইজি(অ্যাডমিনিস্ট্রেশন)  <br />  বাংলাদেশ পুলিশ <br /> পুলিশ হেডকোয়ার্টার্স, ঢাকা</h5>
        </div>
    </div>
</div>




