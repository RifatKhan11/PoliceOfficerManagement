        <div class="row" style="background:#ccc; border-radius:30px!important;padding-top: 5px!important;padding-bottom: 5px!important;">
            <div class="col-1"></div>
            <div class="col-3">
                @if (Model.photograph?.url == "" || Model.photograph?.url == null)
                {

                    <img src="/images/error/No_image_available.png" style="width:180px;height:180px;" class="img-circle">
                }
                else
                {
                    <img src="/@Model.photograph?.url" style="width:180px;height:180px;margin-left: 30PX;border-radius:50%" class="img-circle">
                }
            </div>
            <div class="col-6" style="padding-top: 10px;font-family:'Varela Round',sans-serif!important;padding-left: 10px;">
                <h4 style="margin-left:100px; margin-top:10px;color:black;"><b>@Model.employeeInfo?.nameEnglish</b> <br /> @Model.employeeInfo.rank?.rankName,  @Model.employeeInfo?.branch?.branchUnitName</h4>
                <h5 style="margin-left:100px;color:black">@("BP" + Model.employeeInfo?.employeeCode)</h5>
                <h5 style="margin-left:100px;color:black">Batch- @Model.employeeInfo?.bCSBatch?.batchName</h5>

                @{
                    int?[] doctor = { 69 };
                    int?[] eng = { 59 };
                    int?[] llb = { 79 };
                    int?[] pharma = { 1528 };
                    int?[] liturature = { 2702 };

                    int? doctorInfo = Model.educationalQualifications?.Where(x => doctor.Contains(x.degreeId)).Count();
                    int? engInfo = Model.educationalQualifications?.Where(x => eng.Contains(x.degreeId)).Count();
                    int? llbInfo = Model.educationalQualifications?.Where(x => llb.Contains(x.degreeId)).Count();
                    int? pharmInfo = Model.educationalQualifications?.Where(x => pharma.Contains(x.reldegreesubjectId)).Count();
                    int? lituratureInfo = Model.educationalQualifications?.Where(x => liturature.Contains(x.reldegreesubjectId)).Count();

                    @if (doctorInfo > 0)
                    {
                        <img src="~/batch/doctor.png" class="img-fluid " title="Doctor" style="width:80px; height:80px;margin-left:100px;" />
                    }
                    else if (engInfo > 0)
                    {
                        <img src="~/batch/engineer.png" class="img-fluid" title="Engineer" style="width:80px; height:80px;margin-left:100px;" />

                    }

                    else if (llbInfo > 0)
                    {
                        <img src="~/batch/advocate.png" class="img-fluid" title="Advocate" style="width:80px; height:80px;margin-left:100px;" />

                    }
                    else if (pharmInfo > 0)
                    {
                        <img src="~/batch/pharmacist.png" class="img-fluid" title="Advocate" style="width:80px; height:80px;margin-left:100px;" />

                    }
                    else if (lituratureInfo > 0)
                    {
                        <img src="~/batch/literature.png" class="img-fluid" title="Advocate" style="width:80px; height:80px;margin-left:100px;" />

                    }
                    else
                    {
                        @*<img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:50px; height:50px" />*@
                    }
                }

            </div>

        </div>
