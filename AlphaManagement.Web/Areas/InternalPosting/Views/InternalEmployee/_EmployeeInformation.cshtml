<script type="text/javascript">

        function showReturnReason(id) {
            $('#returnEmpId').val(id);
            $('#modalReturnReason').modal('show');
        }

        function fnLoadReturnReason() {
            let returnTypeId = $('#returnTypeId').val();
            let returnType = $('#returnTypeId option:selected').text();
            let returnReason = $('#txtReturnReason').val();

            if (returnType == '') {
                swal('Attention', 'Please select return type', 'warning');
                return false;
            } else if (returnReason == '') {
                swal('Attention', 'Please Enter return reason', 'warning');
                return false;
            }

            index = $("#tblReturnReson tbody>tr").length;
            var dtTable = $("#tblReturnReson");
            var tableBody = dtTable.find('tbody');

            var RowCount = $("#tblReturnReson tbody>tr").length;
            var editOption = parseInt($('#IsEdit').val()) ? parseInt($('#IsEdit').val()) : 0;

            for (i = 0; i < RowCount; i++) {
                var _reasonType = $("#returnType" + i).val();
                if (_reasonType == returnTypeId && editOption == 0) {
                    //alert('You have already added this Reason!');
                    swal('Attention', 'Already added this Reason!', 'warning');
                    return false
                }
            }

            var trHtml = '<tr id=reasonTypeId' + index + '>' +
                '<td>' + returnType + '<input type="hidden" name="returnType" id="returnType' + index + '" value="' + returnTypeId + '" /></td>' +
                '<td>' + returnReason + '<input type="hidden" name="returnReason" value="' + returnReason + '" /></td>' +

                '<td><a href = "javascript:void(0)"  title = "Delete" class="btn btn-danger btn-xs" onclick = "DeleteReturn(' + index + ')" > <i class="fa fa-trash"></i></a > ' +
                //'<a onclick="EditTbl(' + index + ',' + returnTypeId + ', "' + returnType + '",'+ ')" href="javascript:void(0)" title="Edit" class="btn btn-success btn-xs" > <i class="fa fa-edit"></i></a >' +

                '</tr>';

            tableBody.append(trHtml);
            $('#returnTypeId').val('');
            $('#txtReturnReason').val('');
        }

        function DeleteReturn(index) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {
                $("#tblReturnReson #reasonTypeId" + index).remove();
                swal('', 'Deleted Successfully!', 'success')
            });

            return false;
        }

        $(document).ready(function () {


            let isApproved = $("#isApproved").val();
            if (isApproved == 5) {
                $("#btnHold").prop("disabled", true);
            } else if (isApproved == 4) {
                $("#btnVerify").prop("disabled", true);
            } else {
                $("#btnHold").prop("disabled", false);
                $("#btnVerify").prop("disabled", false);
            }

            $('html, body').animate({
                scrollTop: $("#bodySection").offset().top
            });  // }, 2000);

        });


        function btnUpdateEmployeeStatus(employeeCode, status) {
            if (employeeCode == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }
            if (status == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }

            swal({
                title: 'Are you sure?', text: 'Do you want to Update this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, Update!'
            }).then(function (res) {
                if (res.value) {
                    var url = "/Portfolio/PortfolioDashboard/UpdateEmployeeStatus?empCode=" + employeeCode + "&status=" + status;
                    $.get(url, function (data) {
                        if (data.Success) {
                            swal('', data.Message, 'success').then(function () {
                                location.reload();
                            })
                        } else {
                            swal('Warning', data.Message, 'warning');
                        }


                    });
                }


            })
        }


        function btnUpdateEmployeeStatusReturn(employeeCode, status) {
            if (employeeCode == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }
            if (status == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }

            swal({
                title: 'Are you sure?', text: 'Do you want to Update this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, Update!'
            }).then(function (res) {
                if (res.value) {
                    var url = "/Portfolio/PortfolioDashboard/UpdateEmployeeStatusChecked?empCode=" + employeeCode + "&status=" + status;
                    $.get(url, function (data) {
                        if (data.Success) {
                            swal('', data.Message, 'success').then(function () {
                                location.reload();
                            })
                        } else {
                            swal('Warning', data.Message, 'warning');
                        }


                    });
                }


            })
        }

</script>