@model AssignmentViewModel
@{
    ViewData["Title"] = "Employee Posting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .nestable-color-2 .dd-handle {
        background-color: #0069D1;
        color: #fff;
    }

    .nestable-color-2 .dd-handle1 {
        background-color: red !important;
    }

    .sb-custom-toggle-right {
        top: 45%;
        position: fixed;
        right: 0%;
    }

    .counterdeg {
        font-weight: bolder;
        color: white;
        background-color: #ff7d01;
        border-radius: 50%;
        padding: 10px;
    }

    #countTab {
        color: red;
        background-color: white;
        border-radius: 50%;
        /* width: 33px; */
        margin: 10px;
        padding: 6px;
    }

    .newLi {
        background-color: cadetblue;
        border-radius: 5px;
        padding: 5px;
        margin-bottom: 5px;
    }

    .moveLi {
        height: 30px;
        padding: 5px;
        border-radius: 5px;
        margin: 2px;
        color: white !important;
        font-weight: bold;
        background-color: rgb(5, 39, 103);
    }

    .divSection {
        font-size: 16px !important;
        border: 1px solid;
        padding: 6px;
        background-color: rgb(5, 39, 103);
        color: white;
        font-weight: bolder;
        border-radius: 7px;
    }

    .previewCls {
        color: black;
        font-weight: bolder;
        border-radius: 7px;
        padding: 8px;
        margin-top: 5px;
    }
</style>

<div class="row">
    <div class="col-lg-6 col-sm-12">
        <div class="card bg-white m-b-30">

            <div class="card-body new-user">
                <div class="row">
                    <div class="col-12 text-center">
                        <h5 class="header-title text-center float-left mb-2">Officers' List</h5>
                    </div>
                    <div class="col-12 row">
                        <div class="col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group row">
                                <div class="col-md-12 col-12 col-12">
                                    <select class="select2 form-control mb-3 select2-multiple" style="width: 100%" multiple="multiple" data-placeholder="All Rank" name="rankId" id="rankId">
                                        @*<select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="rankId" id="rankId" data-parsley-required="true">*@
                                        <option value="0" selected>All Rank</option>
                                        @foreach (var item in Model.ranks)
                                        {
                                            <option value="@item.Id">@item.rankName</option>

                                        }
                                    </select>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3 col-12">
                            <div class="form-group row">
                                <div class="col-md-12 col-12 col-12">
                                    <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="unitId" id="unitId" data-parsley-required="true">
                                        <option value="0">All Section</option>
                                        @foreach (var item in Model.phqSections)
                                        {
                                            <option value="@item.Id">@item.deptName</option>

                                        }
                                        @*<option value="0">All Unit</option>
                                            @foreach (var item in Model.specialBranchUnits)
                                            {
                                                <option value="@item.Id">@item.branchUnitName</option>

                                            }*@
                                    </select>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3 col-12">
                            <div class="form-group row">
                                <div class="col-md-12 col-12 col-12">
                                    <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="batchId" id="batchId" data-parsley-required="true">
                                        <option value="0">All Batch</option>
                                        @foreach (var item in Model.bCSBatches)
                                        {
                                            <option value="@item.Id">@item.batchName</option>

                                        }
                                    </select>

                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-12 row pb-0 mb-0">

                        <div class="col-lg-3 col-md-3 col-sm-3 col-12  mb-0 pb-0">
                            <div class="form-group row  mb-0 pb-0">
                                <div class="col-md-12 col-12 col-12  mb-0 pb-0">
                                    <select class="form-control mb-3 custom-select" style="width: 100%;" name="bandId" id="bandId" data-parsley-required="true">
                                        <option value="0">Expertise</option>
                                        <option value="69" style="background-image:url(~/batch/doctor.jpg);">Doctor</option>
                                        <option value="59" style="background-image:url(~/batch/engineer.png);">Engineer</option>
                                        <option value="79" style="background-image:url(~/batch/engineer.png);">Lawyer</option>
                                        <option value="1528">Pharmacist</option>
                                        <option value="2702">Literature</option>
                                    </select>
                                    @*<input type="hidden" id="bandId" />*@
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3 col-12  mb-0 pb-0">
                            <div class="form-group row  mb-0 pb-0">
                                <div class="col-md-12 col-12 col-12  mb-0 pb-0">
                                    <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="servicePeriodId" id="servicePeriodId" data-parsley-required="true">
                                        <option value="0">Duration Of Posting</option>
                                        <option value="1">0 to 1 Year</option>
                                        <option value="2">1 to 2 Years</option>
                                        <option value="3">2 to 3 Years</option>
                                        <option value="4">3+ Years</option>
                                    </select>
                                    @*<input type="hidden" id="servicePeriodId" />*@
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6 col-12 row  mb-0 pb-0">
                            <div class="col-lg-3 col-md-3 col-sm-6 col-12  mb-0 pb-0">
                                <button class="btn btn-info" onclick="loadEmployeeListByRankUnit()" id="btnLoadData">Load</button>
                            </div>
                            <div class="col-lg-9 col-md-9 col-sm-6 col-12 search-content float-right  mb-0 pb-0">
                                <input type="text" id="txtSearchEmployee" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search...">
                                <span class="search-button" style="cursor:pointer;" id="btnSearchEmployee"><i class="ti ti-search"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 row" style="padding:0;margin:0;padding-left:2%;">
                        <span class="rounded-circle p-0 m-0" onclick="iconLoad('period',1)" data-toggle="tooltip" data-placement="top" title="Up to 1 year" style="height:30px;width:30px;background-color:#00BCD2;border-color:black;border-style:ridge;border-width:0.5px;cursor:pointer;"></span>&nbsp;&nbsp;&nbsp;&nbsp;
                        <span class="rounded-circle p-0 m-0" onclick="iconLoad('period',2)" data-toggle="tooltip" data-placement="top" title="Up to 2 years" style="height:30px;width:30px;background-color:yellow;border-color:black;border-style:ridge;border-width:0.5px;cursor:pointer;"></span>&nbsp;&nbsp;&nbsp;&nbsp;
                        <span class="rounded-circle p-0 m-0" onclick="iconLoad('period',3)" data-toggle="tooltip" data-placement="top" title="More then 2 years" style="height:30px;width:30px;background-color:#f17878;border-color:black;border-style:ridge;border-width:0.5px;cursor:pointer;"></span>
                        <label style="font-size:26px;padding-top:5px;">&nbsp;&nbsp;||&nbsp;&nbsp;</label>
                        <img src="/batch/engineer.png" class="img-fluid rounded-circle p-0 m-0" onclick="iconLoad('expertise',59)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Engineer" />&nbsp;&nbsp;&nbsp;&nbsp;
                        <img src="/batch/doctor.png" class="img-fluid rounded-circle p-0 m-0" onclick="iconLoad('expertise',69)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Doctor" />&nbsp;&nbsp;&nbsp;&nbsp;
                        <img src="/batch/lawyer.PNG" class="img-fluid rounded-circle p-0 m-0" onclick="iconLoad('expertise',79)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Lawyer" />&nbsp;&nbsp;&nbsp;&nbsp;
                        <img src="/batch/pharmacist.png" class="img-fluid rounded-circle p-0 m-0" onclick="iconLoad('expertise',1528)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Pharmacist" />&nbsp;&nbsp;&nbsp;&nbsp;
                        <img src="/batch/literature.png" class="img-fluid rounded-circle p-0 m-0" onclick="iconLoad('expertise',2702)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Literature" />&nbsp;&nbsp;
                        <label style="font-size:26px;padding-top:5px;">&nbsp;&nbsp;||&nbsp;&nbsp;</label>
                        <img src="~/batch/unmission.png" class="img-fluid rounded-circle p-0 m-0" onclick="iconLoad('unmission',1)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Selected for UN Mission" />&nbsp;&nbsp;&nbsp;&nbsp;
                        <img src="/batch/attached.png" class="img-fluid rounded-circle p-0 m-0" onclick="iconLoad('attached',1)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Attached" />&nbsp;
                        <label style="font-size:26px;padding-top:5px;">&nbsp;&nbsp;||&nbsp;&nbsp;</label>
                        <img src="/batch/locked.png" class="img-fluid rounded-circle p-0 m-0" onclick="iconLoad('locked',1)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Locked" />&nbsp;&nbsp;&nbsp;&nbsp;

                        @*<div>
                                <button class="btn btn-info" onclick="loadEmployeeListByRankUnit()" id="btnLoadData">Load</button>
                            </div>&nbsp;&nbsp;&nbsp;&nbsp;
                            <div class="search-content float-right  mb-0 pb-0">
                                <input type="text" id="txtSearchEmployee" class="form-control" style="width:100%;" autocomplete="off" name="keyword" placeholder="Search...">
                                <span class="search-button" style="cursor:pointer;right:-95%!important;" id="btnSearchEmployee"><i class="ti ti-search"></i></span>
                            </div>*@
                    </div>
                </div>

                <div class="dd nestable_list_2 nestable-color-2" id="olEmpList">

                </div>

                <div class="col-12 row" id="loaderDiv" style="display:none">
                    <div class="col-1"></div>
                    <div class="col-6">
                        <img src="~/images/Circles-loader.gif" style="height:600px;width:500px" />
                    </div>
                    <div class="col-5"></div>
                </div>


            </div>
        </div>
    </div>

    <div class="col-lg-6 col-12">
        <div class="">
            <div class="new-user">
                <div class="col-sm-12 col-md-12 col-lg-12 col-12 row p-0 card">
                    <div class="card-header col-sm-12 col-md-12 col-lg-12 col-12 text-center">
                        <h3>Assign Employee To New Section</h3>
                    </div>
                    <div class="card-body col-sm-12 col-md-12 col-lg-12 col-12 m-0 row">
                        <div class="col-12 row">
                            <div class="col-md-9 col-sm-9 col-9 float-right mb-3 pb-0">
                                <input type="text" id="txtSectionEmployee" class="form-control" autocomplete="off" name="keyword" placeholder="Search Section...">

                            </div>
                            <div class="col-md-1 col-sm-1 col-1 float-right mb-0 pb-0">
                                <a href="javascript:void(0)" class="btn btn-info btn-lg sb-toggle-left"><i class="fa fa-location-arrow"></i></a>
                            </div>
                            <div class="col-md-2 col-sm-2 col-2 float-right mb-0 pb-0">
                                <a href="javascript:void(0)" class="btn btn-success ml-2" onclick="submitForm()">Next</a>
                            </div>
                        </div>
                        <form id="internalForm" class="row" style="height:888px;overflow-y:scroll">
                            @foreach (var item in Model.phqSections)
                            {
                                <div class="card col-sm-11 col-md-11 col-lg-11 p-0 m-3">
                                    <div class="card-header text-center" style="background-color:powderblue"><b>@item.deptName</b></div>
                                    <div class="card-body col-12 row p-0 deptBox ui-sortable-handle" style="min-height:50px">
                                        <input type="hidden" class="clsSectionId" value="@item.Id" />
                                        <input type="hidden" class="clsSectionName" value="@item.deptName" />
                                        <ul id="section-@item.Id" class="col-12 dd-list" style="list-style-type:none;padding-left:30px;">
                                            @if (Model.internalAssignments !=null)
                                            {
                                                @foreach (var emp in Model.internalAssignments.Where(x => x.departmentId == item.Id))
                                                {
                                                    var colorCode = "#00BCD2";
                                                    if (emp.employee.employeeTypeId == 2)
                                                    {
                                                        colorCode = "yellow";
                                                    }
                                                    else if (emp.employee.employeeTypeId == 3)
                                                    {
                                                        colorCode = "#f17878";
                                                    }
                                                    <li class="dd-item" id="empU-@emp.Id" data-id="@emp.sectionId">
                                                        <div class="dd-handle ui-state-default" style="background-color: @colorCode;color:black;font-weight:bolder;border-radius:7px">
                                                            <span class="empInfo">@emp?.employee?.rank?.rankName,@emp?.employee?.nameEnglish - @emp?.employee?.bCSBatch?.batchName</span>

                                                            <span class="pull-right" style="margin:-3px" onclick="Discharge(@emp.Id)"><a class="btn btn-danger" title="Discharge" href="javascript:void(0)"><i class="ti-trash"></i></a></span>
                                                        </div>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                            <input type="submit" hidden id="frmSbm" />
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<!--end row-->
<!--Sideber-->
<div class="sb-slidebar sb-left sb-style-overlay" style="margin-top: 60px;width:30%;">
    <div class="right-bar slimscroll">
        <div class="col-12 text-center btn-outline-light fixed-top" style="background-color:#2d3540;color:white">
            <span class="r-close-btn sb-close pr-0 mr-0" style="float:right;"><i class="fa fa-times"></i></span>
            <h4 style="font-weight: 700;padding: 5px;">Assigned List</h4>
        </div>

        <div class="col-12 pt-5" style="margin-top:30px;">
            <div class="online-chat">
                <div class="online-chat-container" id="assignedEmpDiv">
                    <div class="dd nestable_list_2 nestable-color-2">
                        <div class="col-12" style="padding:0">
                            <ul class="dd-list" id="assignedEmpList1" style="margin-bottom:100px;"></ul>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade bd-example-modal-lg" id="employeeInfoModal" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Profile Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalList">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade bd-example-modal-lg" id="moveToModal" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle"><span id="sectionName"></span>Section List</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="height:450px;overflow-y:scroll" id="moveInput">
                <input type="hidden" class="clsEmpId1" value="" />
                <input type="hidden" class="clsEmpName1" value="" />
                <input type="hidden" class="clsEmpCode1" value="" />
                <input type="hidden" class="clsEmpColor1" value="" />
                <input type="hidden" class="clsEmpImg1" value="" />
                <input type="hidden" class="clsEmpOldSec1" value="" />
                <input type="hidden" class="clsEmpNewSec1" value="" />
                <ol style="list-style-type: none;">
                    @foreach (var item in Model.phqSections)
                    {
                        <li class="moveLi" onclick="move(@item.Id,'@item.deptName')" style="cursor:pointer">
                            <a href="javascript:void(0)" style="color:white!important">@item.deptName</a>
                        </li>
                    }
                </ol>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/jquery-ui.js"></script>
    <script src="~/js/jquery-ui.min.js"></script>

    <script type="text/javascript">

        function fnEmployeeShow(id) {
            $("#modalList").load("/InternalPosting/InternalEmployee/GetPartialEmployeeInfo?id=" + id);
            //Common.Ajax('GET', '/Employee/EmployeeInfo/EmployeeInfoProfileView/' + id, [], 'json', ajaxEmployeeProfile, false);
            $('#employeeInfoModal').modal('show');
        }
        $(document).ready(function () {
            $('#tblData').DataTable();
            //loadEmployeeListByRankUnit();
            jQuery(".select2").select2({
                width: '100%'
            });

            $(".empLi").sortable({
                connectWith: '.deptBox',
                appendTo: 'body',
                tolerance: 'pointer',
                revert: true,
                forceHelperSize: true,
                helper: function (event, element) {
                    return element.clone().appendTo("body")
                },
                scroll: false,
                update: function (event, ui) {

                },
                start: function (e, ui) {
                    window.grabbed = true;
                    ui.item.startPos = ui.item.prevAll().length + 1;
                    var div = ui.item.get(0);
                    document.body.appendChild(div);
                },
                stop: function () {
                    window.grabbed = false;
                }
            }).sortable("option", "scroll", false)
                .disableSelection();

            $(".deptBox").droppable({
                drop: function (event, ui) {
                    dropped = true;
                    console.log(ui)
                    alert()
                }
            });

            var sld = 1;
            $('.sb-custom-toggle-right, #btnSlideClose').click(function () {

                let id = $(this).find('.clsEmpId').val();
                if (sld == 1) {
                    setTimeout(function () {
                        $('#enlistArr').removeClass('sb-custom-toggle-rightArrRem');
                        $('#enlistArr').addClass('sb-custom-toggle-rightArr');

                        $('#slideArray').removeClass('fa fa-chevron-left fa-4x');
                        $('#slideArray').addClass('fa fa-chevron-right fa-4x');
                        $('#enlistCounter').hide();
                    }, 200);

                    sld = 0;

                } else {
                    setTimeout(function () {
                        $('#enlistArr').removeClass('sb-custom-toggle-rightArr');
                        $('#enlistArr').addClass('sb-custom-toggle-rightArrRem');

                        $('#slideArray').removeClass('fa fa-chevron-right fa-4x');
                        $('#slideArray').addClass('fa fa-chevron-left fa-4x');
                        $('#enlistCounter').show();

                    }, 150);

                    sld = 1;
                }

            });

            $("#txtSearchEmployee").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                    //$('#olEmpList ol .dd-item').nestable('expandAll');
                });

            });

            $("#btnSearchEmployee").on("click", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);

                });
            });

            $("#txtSectionEmployee").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#internalForm b").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);

                });
            });

            $("#btnSearch").on("click", function () {
                var rankId = $("#rankId").val();
                //$.get("/Employee/Assignment/GetRankWiseEmployeInfo/?rankid=" + rankId, function (res) {
                //  //  var data = JSON.parse(data);
                //    var data = res;
                //});

                Common.Ajax('GET', '/Employee/Assignment/GetRankWiseEmployeInfo/?rankid=' + rankId, [], 'json', ajaxSpecialBranchUnit, false);
            });

            $("#txtSearchPP").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olPPList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

        });

        function loadEmployeeListByRankUnit() {
            $('#olEmpList').hide();
            $('#loaderDiv').show();
            var rankId = $('#rankId').val();
            var unitId = $('#unitId').val();
            var batch = $('#batchId').val();
            var servicePeriod = $('#servicePeriodId').val();
            var bandId = $('#bandId').val();
            //$("#olEmpList").load("/Employee/Assignment/GetRankUnitWisePartialEmployeeView?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId);
            $("#olEmpList").load("/InternalPosting/InternalEmployee/GetUnitRankWisePartialEmployeeView?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId + "&isLocked=" + 0 + "&isAttached=" + 0 + "&isUnMission=" + 0);
        }

        function iconLoad(type, id) {
            $('#olEmpList').hide();
            $('#loaderDiv').show();
            var rankId = 0;
            var unitId = 0;
            var batch = 0;
            var servicePeriod = 0;
            var bandId = 0;
            var isLocked = 0;
            var isAttached = 0;
            var isUnMission = 0;
            if (type == 'period') {
                servicePeriod = id;
            }
            else if (type == 'expertise') {
                bandId = id
            } else if (type == 'locked') {
                isLocked = id
            } else if (type == 'attached') {
                isAttached = id
            } else if (type == 'unmission') {
                isUnMission = id
            }

            $("#olEmpList").load("/InternalPosting/InternalEmployee/GetUnitRankWisePartialEmployeeView?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId + "&isLocked=" + isLocked + "&isAttached=" + isAttached + "&isUnMission=" + isUnMission);
        }

        function removeNewLi(id) {
            $('#addedemp-' + id).remove();
            $('#assLi' + id).remove();
            $('#emp-' + id).show();
        }

        function moveToSection(empId, name, employeeCode, colorCode, imgUrl, oldSection) {
            $('.clsEmpId1').val(empId);
            $('.clsEmpName1').val(name);
            $('.clsEmpCode1').val(employeeCode);
            $('.clsEmpColor1').val(colorCode);
            $('.clsEmpImg1').val(imgUrl);
            $('.clsEmpOldSec1').val(oldSection);
            $('#moveToModal').modal('show');
        }

        function move(sectionId, newSectionName) {
            var empId = $('#moveInput').find('input.clsEmpId1').val();
            var EmpName = $('#moveInput').find('input.clsEmpName1').val();
            var empCode = $('#moveInput').find('input.clsEmpCode1').val();
            var secId = sectionId;
            var empColor = $('#moveInput').find('input.clsEmpColor1').val();
            var empIgm = $('#moveInput').find('input.clsEmpImg1').val();
            var oldSectionName = $('#moveInput').find('input.clsEmpOldSec1').val();
            var data = `<li class="newLi" id="addedemp-${empId}" style="background-color:${empColor};"><a href="javascript:void(0)"><i class="fa fa fa-window-close pull-right" style="color:red" onclick=removeNewLi(${empId})></i></a>${EmpName}<input type="hidden" name="employeeId" value="${empId}" /><input type="hidden" name="sectionId" value="${sectionId}" /></li>`

            var assign = `<li id=assLi${empId} class="row previewCls" style="background-color:${empColor};padding-left:4%;margin-left: 0;">
                                        <div class="col-11" style="padding:0">${EmpName}<label style="padding:0;margin: 0;">Previous Section: ${oldSectionName}</label><label style="padding:0;margin: 0;">New Section: ${newSectionName}</label></div>
                                        <div class="col-1"><span style="color:red;cursor: pointer;" onclick="removeNewLi(${empId})"><i class="fa fa-times"></i></span></div></li>`

            //$('#section-' + sectionId).append(`<li class="newLi" id="addedemp-${empId}"><a href="javascript:void(0)"><i class="fa fa fa-window-close pull-right" style="color:red" onclick=removeNewLi(${empId})></i></a>${EmpName}<input type="hidden" name="employeeId" value="${empId}" /><input type="hidden" name="sectionId" value="${sectionId}" /></li>`);
            $('#section-' + secId).append(data);
            $('#assignedEmpList1').append(assign);
            $('#emp-' + empId).hide();
            $('#moveInput').find('input.clsEmpId').val('');
            $('#moveInput').find('input.clsEmpName').val('');
            $('#moveInput').find('input.clsEmpCode').val('');
            $('#moveInput').find('input.clsEmpColor').val('');
            $('#moveInput').find('input.clsEmpImg').val('');
            $('#moveToModal').modal('hide');
        }

        function submitForm() {
            $('#frmSbm').click();
        }

        $('#internalForm').submit(function () {
            var formData = $('#internalForm').serialize();
            if ($('#internalForm ul li').length = 0) {
                return false;
            }
            else {
                $.ajax({
                    url: '/InternalPosting/InternalEmployee/SaveInternalPostingAdditional',
                    data: formData,
                    type: 'POST',
                    success: function (records) {
                        if (records != "Fail") {
                            window.location.href = "/InternalPosting/InternalEmployee/InternalPostingDetails?enlistMasterId=" + records;
                        }
                        else {
                            swal('', 'Unable to Save!', 'warning');
                            console.log(erro);
                        }
                    },
                    error: function (erro) {
                        //console.log(erro);
                        swal('', 'Unable to Save!', 'warning');
                    }
                });
            }
        })


        function Discharge(id) {
            swal({
                title: 'Are you sure?', text: `Do you want to Discharge this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Discharge!`
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '/InternalPosting/InternalEmployee/DischargeInternalEmployee?id=' + id,
                        type: 'GET',
                        success: function (rec) {
                            swal({
                                title: 'Discharge', type: 'success', confirmButtonColor: '#007ACC', confirmButtonText: `OK!`
                            }).then(function () {
                                $('#empU-' + id).remove();
                            })
                        }
                    });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });
        }


    </script>
}
