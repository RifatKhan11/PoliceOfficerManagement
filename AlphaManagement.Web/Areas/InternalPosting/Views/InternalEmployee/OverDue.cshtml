@model PostingVacancy
@{
    ViewData["Title"] = "Over Due Posting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="tab-content mt-4" id="myTabContent">

    <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
        <div class="card-header mt-3 p-1 text-light" style="background-color:#2A1067">
            <h4 class="ml-2">OVER DUE POSITION</h4>
        </div>
        <div class="card bg-light">
            <div class="card-body">

                <div class="row">
                    <div class="col-sm-2">

                    </div>
                    <div class="col-sm-3">
                        <div class="form-group row">
                            <div class="col-md-12 col-12 col-12">
                                <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="ParentId" id="ParentId" data-parsley-required="true" onchange="loadEmployeeList()">
                                    <option value="0">All Section</option>
                                    @foreach (var item in Model.sections)
                                    {
                                        <option value="@item.Id">@item.deptName</option>
                                    }
                                </select>

                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group row">
                            <div class="col-md-12 col-12 col-12">
                                <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="rankId" id="rankId" data-parsley-required="true" onchange="loadEmployeeList()">
                                    <option value="0">All Rank</option>
                                    @foreach (var item in Model.ranks)
                                    {
                                        <option value="@item.Id">@item.rankName</option>

                                    }
                                </select>

                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group row">
                            <div class="col-md-12 col-12 col-12">
                                <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="batcheId" id="batcheId" data-parsley-required="true" onchange="loadEmployeeList()">
                                    <option value="0">All Batch</option>
                                    @foreach (var item in Model.batches)
                                    {
                                        <option value="@item.Id">@item.batchName</option>

                                    }
                                </select>

                            </div>
                        </div>
                    </div>
                    <div class="col-sm-1">
                        <a href="#" class="btn btn-success" id="PrintBtn">Print</a>
                    </div>
                    <div class="col-md-12 col-12">
                        <table class="table table-bordered table-striped" style="width:100%" id="tblData">
                            <thead>
                                <tr>
                                    <td>Sl No</td>
                                    <td>Name</td>
                                    <td>BP Number</td>
                                    <td>Rank</td>
                                    <td>Batch</td>
                                    <td>Section</td>
                                    <td>Place of Posting</td>
                                    <td>Joining date of current Unit</td>
                                    <td>Duration</td>
                                    <td>Joining date of Police</td>

                                </tr>
                            </thead>

                            <tbody>
                                @{var i = 1;}
                                @foreach (var item in Model.employeeInfos)
                                {
                                    var duration = AlphaManagement.Web.Helpers.CalDateDifference.DateDifference(DateTime.Now, Convert.ToDateTime(item.joiningDatePresentWorkstation));

                                    <tr onclick="detailInfoModalOpen(@item?.employeeCode)">
                                        <td>@i</td>
                                        <td>@item.nameEnglish</td>
                                        <td>@item.employeeCode</td>
                                        <td>@item.rank?.rankName </td>
                                        <td>@item.bCSBatch?.batchName </td>
                                        <td>@item.department?.deptName</td>
                                        <td>@item.section?.Name</td>
                                        <td>@item.joiningDatePresentWorkstation?.ToString("dd-MMM-yyyy")</td>
                                        <td>@duration</td>
                                        <td>@item.joiningDateGovtService?.ToString("dd-MMM-yyyy")</td>
                                    </tr>
                                    i++;
                                }

                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>


</div>


<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1250px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"> Officers' List </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <table class="table table-bordered table-striped" style="width:100%" id="tblDataEmp">
                    <thead>
                        <tr>
                            <td>Sl No</td>
                            <td>Name</td>
                            <td>BP Number</td>
                            <td>Rank</td>
                            <td>Unit</td>
                            <td>Place of Posting</td>
                            <td>Joining date of current Unit</td>
                            <td>Joining date of Police</td>
                        </tr>
                    </thead>

                    <tbody></tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg" id="empDetailsModal" role="dialog" aria-labelledby="empDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1300px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Details Info</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="col-12 row" id="empDetails" style="overflow: scroll; height: 800px;margin:0">
                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts{
    <script>


        function detailInfoModalOpen(id) {
            $("#empDetails").load("/Employee/EmployeeInfo/GetEmployeeInfoPartialViewById?id=" + id);
            $('#empDetailsModal').modal('show')
        }

        $(document).ready(function () {
            $('#tblData').DataTable();

            jQuery(".select2").select2({
                width: '100%'
            });

            $('#ParentId').select2();
            $('#rankId').select2();


            $('#PrintBtn').click(function () {
                var id = $('#rankId').val();
                var parent = $('#ParentId').val();
                var batch = $('#batcheId').val();
                window.open("/InternalPosting/InternalEmployee/GetOverDuePositionReportPdf?Id=" + id + "&&branch=" + parent + "&&batch=" + batch);
            });
        });

        function loadEmployeeList() {
            var id = $('#rankId').val();
            var parent = $('#ParentId').val();
            var batch = $('#batcheId').val();
            Common.Ajax('GET', '/InternalPosting/InternalEmployee/GetOverDueEmployeeInfoListFilter?Id=' + id + '&&branch=' + parent + '&&batch=' + batch, [], 'json', ajaxGetPositionVacency, false);
        }

        function ajaxGetPositionVacency(response) {
            $('#tblData').DataTable().destroy();
            var option = "";
            var count = 0;
            $.each(response, function (i, item) {
                var rank = '';
                var rank = '';
                if (item.rank == null) {
                    rank = '';
                }
                else {
                    rank = item.rank ?.rankName;
                }
                if (item.bCSBatch ?.batchName == null) {
                    batchName = '';
                }
                else {
                    batchName = item.bCSBatch ?.batchName
                }
                option += `<tr>
                                <td>${++count}</td>
                                <td>${item.nameEnglish}</td>
                                <td>${item.employeeCode}</td>
                                <td>${rank}</td>
                                <td>${batchName}</td>
                                <td>${item.branch?.branchUnitName}</td>
                                <td>${item.section?.Name}</td>
                                <td>${formatDate2(item.joiningDatePresentWorkstation)}</td>
                                <td>${CalDate(item.joiningDatePresentWorkstation)}</td>
                                <td>${formatDate2(item.joiningDateGovtService)}</td>
                          </tr>`
            });
            $('#tblData tbody').empty();
            $('#tblData tbody').append(option);
            $('#tblData').DataTable();
        }

        function EmpDetails(unit,rank) {
            Common.Ajax('GET', '/Employee/Posting/GetEmpDetails?Id=' + unit + '&&branch=' + rank, [], 'json', ajaxEmpDetails, false);
        }

        function ajaxEmpDetails(res) {
            $('#tblDataEmp').DataTable().destroy();
            //console.log(res);
            var option = "";
            var count = 0;
            $.each(res, function (i, item) {
                option += `<tr>
                                <td>${++count}</td>
                                <td>${item.nameEnglish}</td>
                                <td>${item.employeeCode}</td>
                                <td>${item.rank?.rankName}</td>
                                <td>${item.branch?.branchUnitName}</td>
                                <td>${item.section?.Name}</td>
                                <td>${formatDate(item.joiningDatePresentWorkstation)}</td>
                                <td>${formatDate(item.joiningDateGovtService)}</td>
                          </tr>`
            });
            $('#tblDataEmp tbody').empty();
            $('#tblDataEmp tbody').append(option);
            $('#tblDataEmp').DataTable();
            $("#exampleModal").modal('show');
        }

        function formatDate2(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (month == 1) { month = "Jan" } else if (month == 2) { month = "Feb" } else if (month == 3) { month = "Mar" } else if (month == 4) { month = "Apr" } else if (month == 5) { month = "May" } else if (month == 6) { month = "Jun" } else if (month == 7) { month = "Jul" } else if (month == 8) { month = "Aug" } else if (month == 9) { month = "Sep" } else if (month == 10) { month = "Oct" } else if (month == 11) { month = "Nov" } else if (month == 12) { month = "Dec" }
            return day + "-" + month + "-" + year
        }

        function CalDate(bal) {
            var str = formatDate2(bal);
            if (/^\d{2}\-\D{0,3}\-\d{4}$/i.test(str)) {
                var parts = str.split("-");
                var m = 0;
                if (parts[1] == "Jan") { m = 1; } else if (parts[1] == "Feb") { m = 2; } else if (parts[1] == "Mar") { m = 3; } else if (parts[1] == "Apr") { m = 4; } else if (parts[1] == "May") { m = 5; } else if (parts[1] == "Jun") { m = 6; } else if (parts[1] == "Jul") { m = 7; } else if (parts[1] == "Aug") { m = 8; } else if (parts[1] == "Sep") { m = 9; } else if (parts[1] == "Oct") { m = 10; } else if (parts[1] == "Nov") { m = 11; } else if (parts[1] == "Dec") { m = 12; }
                var day = parts[0] && parseInt(parts[0], 10);
                var month = m;
                var year = parts[2] && parseInt(parts[2], 10);
                var duration = 59;

                if (day <= 31 && day >= 1 && month <= 12 && month >= 1) {

                    var expiryDate = new Date();


                    var a = moment();
                    var b = moment(str, 'DD-MMM-YYYY');

                    var years = a.diff(b, 'year');
                    b.add(years, 'years');

                    var months = a.diff(b, 'months');
                    b.add(months, 'months');

                    var days = a.diff(b, 'days') + 1;

                    return (years + ' years ' + months + ' months ' + days + ' days');

                } else {
                    // display error message
                }
            }
        }

    </script>
}
