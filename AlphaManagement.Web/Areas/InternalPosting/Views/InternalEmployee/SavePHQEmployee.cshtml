            $("#fileinput").change(function () {
                    var fileInput =
                        document.getElementById('fileinput');
                    var filePath = fileInput.value;
                    var allowedExtensions =
                        /(\.jpg|\.jpeg|\.png|\.gif|\.JPG|\.JPEG|\.PNG|\.GIF)$/i;
                    if (!allowedExtensions.exec(filePath)) {
                        alert('Invalid file type');
                        fileInput.value = '';
                        return false;
                    }
                    // alert(this.files[0].size);
                if (Math.round(this.files[0].size / 1024) > 1600) {
                        swal('', 'Photo Size Must less than 1.5MB!', 'warning');
                        //alert('Photo Size Must less than 1.5MB');
                        fileInput.value = '';
                        return false;
                    }
                    var reader = new FileReader();

                    //read the contents of image file.
                    reader.readAsDataURL($('#fileinput[type=file]')[0].files[0]);
                    reader.onload = function (e) {

                        //initiate the javascript image object.
                        var image = new Image();

                        //set the base64 string return from filereader as source.
                        image.src = e.target.result;

                        //validate the file height and width.
                        image.onload = function () {
                            var height = this.height;
                            var width = this.width;
