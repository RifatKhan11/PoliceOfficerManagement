@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";
}
<link href="~/plugins/responsive-table/css/rwd-table.min.css" rel="stylesheet" type="text/css" media="screen">
<link href="~/css/dropify.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.11.4/jquery-ui.css" rel="stylesheet" />
<style>

    .zoom {
        transition: transform .2s; /* Animation */
    }

    .zoom:hover {
            transform: scale(1.1); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
        }

    @@media screen and (max-width: 599px) {
        #jobHisListView, #proHisListView, #eduListView, #localTrListView, #forignTrListView, #awardListView, #medicalListView, #frnTrvlListView, #frnTrvlListViewUN, #familyListView, #displinaryListView, #preAddList, #parAddList, #inLawAddList, #spouseAddList {
            display: none;
        }

        #jobHisCardView, #proHisCardView, #eduCardView, #localTrCardView, #forignTrCardView, #awardCardView, #medicalCardView, #frnTrvlCardView, #frnTrvlCardViewUN, #familyCardView, #displinaryCardView, #preAddCard, #parAddCard, #inLowAddCard, #spouseAddCard {
            display: block;
            padding: 0;
            margin: 0;
        }


        #personlDiv {
            margin-top: 140px;
        }

        #fnt {
            font-size: 27px;
        }

        #local-Training-Main-Div, #foreign-Training-Main-Div {
            padding: 0
        }

        #finalBtnDiv {
            margin-bottom: 40px;
        }
    }

    @@media screen and (min-width: 600px) {
        #jobHisListView, #proHisListView, #eduListView, #localTrListView, #forignTrListView, #awardListView, #medicalListView, #frnTrvlListView, #frnTrvlListViewUN, #familyListView, #displinaryListView, #preAddList, #parAddList, #inLawAddList, #spouseAddList {
            display: block;
        }

        #jobHisCardView, #proHisCardView, #eduCardView, #localTrCardView, #forignTrCardView, #awardCardView, #medicalCardView, #frnTrvlCardView, #frnTrvlCardViewUN, #familyCardView, #displinaryCardView, #preAddCard, #parAddCard, #inLowAddCard, #spouseAddCard {
            display: none;
        }
    }

    .mobCardHeader {
        padding: 0;
        padding-top: 5px;
        text-align: center;
        background-color: oldlace;
    }

    .mobCard {
        border-radius: 50%;
        background-color: #2A1067;
        font-size: 23px;
        height: 30px;
        width: 30px;
        color: white;
    }

    .select2-selection__rendered {
        line-height: 31px !important;
    }

    .select2-container .select2-selection--single {
        height: 35px !important;
    }

    .select2-selection__arrow {
        height: 34px !important;
    }


    label.cabinet {
        display: block;
        cursor: pointer;
    }

        label.cabinet input.file {
            position: relative;
            height: 100%;
            width: auto;
            opacity: 0;
            filter: progid:DXImageTransform.Microsoft.Alpha(opacity=0);
            margin-top: -30px;
        }

    #upload-demo {
        width: 500px;
        height: 500px;
        padding-bottom: 25px;
    }

    label.cabinetsign {
        display: block;
        cursor: pointer;
    }

        label.cabinetsign input.file {
            position: relative;
            height: 100%;
            width: auto;
            opacity: 0;
            -moz-opacity: 0;
            filter: progid:DXImageTransform.Microsoft.Alpha(opacity=0);
            margin-top: -30px;
        }

    #upload-demosign {
        width: 300px;
        height: 200px;
        padding-bottom: 25px;
    }

    #postingPlaceId {
        padding-left: 1px;
    }
</style>

<div class="col-md-12 col-12 ">
    <div class="card-header fixed-top" id="heading-0" style="cursor:pointer;background-color:#040158;top: 31px;margin:30px ;padding: 5px;z-index: 991 !important;">
        <h2 class="mb-0 text-center " id="fnt" style="font-family:'Times New Roman';color:white">
            <span>Employee's Portfolio, Bangladesh Police</span>

            <a href="/" class="pull-right" style="font-size:25px;"><i class="fa fa-home fa-2x"></i></a>
        </h2>

    </div>
</div>


<div class="row">
    @{
        var inactive = "";
    }

    @if (Model.employeeInfo?.isApproved == 3 || Model.employeeInfo?.isApproved == 4 || Model.employeeInfo?.isApproved == 8)
    {
        inactive = "disabled";
    }


    <div class="col-xl-12 col-lg-12 col-md-12 col-12">
        <div id="accordion" role="tablist" class="m-b-30">
            <div class="card" id="personlDiv">

                <div class="card-header" id="heading-1" style="cursor:pointer;padding-top:5%">
                    <h5 class="mb-0 d-flex justify-content-between">
                        <a href="#" class="text-muted">
                            <i class="fa fa-user-circle-o mr-2" style="color:#4B0080"></i>  @Model.fLang.title
                        </a>

                        <a href="javascript:void(0)" id="btnEmpSearch" data-toggle="modal" data-target="#basicModal" class="btn btn-success btn-sm zoom" style="border-radius:20px;height:30px;"><i class="fa fa-envelope"></i>&nbsp;Load Data from PIMS </a>
                    </h5>
                </div>
                <div class="container">

                    <!-- basic modal -->
                    <div class="modal fade" id="basicModal" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header text-center">
                                    <h6 class="modal-title " id="myModalLabel">Please Enter Your BP/CIV Number!!</h6>

                                </div>
                                <div class="modal-body">
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <select class="form-control" id="civbp">
                                                <option value="BP">BP</option>
                                                <option value="CIV">CIV</option>
                                            </select>
                                        </div>
                                        <input type="number" class="form-control" id="bpnumber" placeholder="BP Number" aria-label="BP Number" aria-describedby="basic-addon1">
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <img src="~/images/loder.gif" id="gifimage" style="display:none" />

                                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                    <button type="button" id="loadData" class="btn btn-primary">Load Data</button>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div id="collapse-1" class="collapse show">
                        <div class="card-body">
                            <div class="general-label">
                                <form id="FormId" enctype="multipart/form-data">
                                    <input type="hidden" id="empId" name="empId" value="" />
                                    <div class="row">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-xl-6 col-lg-6 col-md-6 col-12">
                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.nameBangla <span style="color:red">*</span></label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" value="" data-parsley-required="true" id="nameBangla" name="nameBangla" required>
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.nameEnglish <span style="color:red">*</span></label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" value="" data-parsley-required="true" id="nameEnglish" name="nameEnglish" required>
                                                         
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.bpNo <span style="color:red">*</span></label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" id="bpNo" data-parsley-required="true" name="bpNo" value="@Model.applicationUser?.bpNo" required>
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.rankId <span style="color:red">*</span></label>
                                                        <div class="col-md-8 col-12">
                                                            <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="rankId" id="rankId" data-parsley-required="true" required>
                                                                <option value="">@Model.fLang.select</option>
                                                                @foreach (var item in Model.rank)
                                                                {
                                                                    if (item.Id == Model.employeeInfo?.rankId)
                                                                    {
                                                                        <option value="@item.Id" selected>@item.rankNameBN</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="@item.Id">@item.rankNameBN</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">Unit <span style="color:red">*</span></label>
                                                        <div class="col-md-8 col-12">
                                                            <select class="select2 form-control mb-3 custom-select" id="branchId" name="specialBranchUnitId" onchange="getSectionInfoByBranchId()" data-parsley-required="true" required>
                                                                <option value="">Select</option>
                                                                @foreach (var item in Model.specialBranchUnits.OrderBy(x => x.branchUnitName))
                                                                {
                                                                    if (item.Id == Model.employeeInfo?.branchId)
                                                                    {
                                                                        <option value="@item.Id" selected>@item.branchUnitNameBN</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="@item.Id">@item.branchUnitNameBN</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                         

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.designation</label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" id="designationsId" data-parsley-required="true" name="designation" required />
                                                        </div>

                                                    </div>
                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">Section</label>
                                                        <div class="col-md-8 col-12">
                                                            <select class="select2 form-control mb-3 custom-select" style="width: 100%;" id="sectionId" required name="sectionId">
                                                                <option value="">Select</option>
                                                                @*@foreach (var item in Model.department)
                                                                {
                                                                    if (item.Id == Model.employeeInfo?.departmentId)
                                                                    {
                                                                        <option value="@item.Id" selected>@item.deptNameBn</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="@item.Id">@item.deptNameBn</option>
                                                                    }
                                                                }*@
                                                            </select>
                                                        </div>

                                                    </div>
                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">Email Address</label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" id="emailAddress" value="" required name="emailAddress">
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="modal fade clsexclude" id="cropImagePop" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                                                    <div class="modal-dialog modal-lg">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                                <h4 class="modal-title" id="myModalLabel"></h4>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="row">
                                                                    <div class="col-lg-12 col-md-12 col-sm-12 form-inline">
                                                                        <div class="col-lg-7 col-md-7 col-sm-7 p-0 m-0">
                                                                            <div id="upload-demo" class="center-block" style="max-width: 430px;">

                                                                            </div>
                                                                        </div>
                                                                        <div class="col-lg-5 col-md-5 col-sm-12 pl-5">
                                                                            <button type="button" id="btnRoute" data-deg="90" class="btn btn-outline-primary btn-sm"><i class="fa fa-rotate-right"></i></button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                                                <button type="button" id="cropImageBtn" class="btn btn-primary">Crop</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="modal fade clsexclude" id="cropImagePopsign" tabindex="-1" role="dialog" aria-labelledby="myModalLabelsign" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                                <h4 class="modal-title" id="myModalLabelsign"></h4>
                                                            </div>
                                                            <div class="modal-body">
                                                                @*<div id="upload-demosign" class="center-block"></div>*@
                                                                <div class="row">
                                                                    <div class="col-lg-12 col-md-12 col-sm-12 form-inline">
                                                                        <div class="col-lg-7 col-md-7 col-sm-7 p-0 m-0">
                                                                            <div id="upload-demosign" class="center-block">

                                                                            </div>
                                                                        </div>
                                                                        <div class="col-lg-5 col-md-5 col-sm-12 pl-5">
                                                                            <button type="button" id="btnRouteSign" data-deg="90" class="btn btn-outline-primary btn-sm"><i class="fa fa-rotate-right"></i></button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                                                <button type="button" id="cropImageBtnsign" class="btn btn-primary">Crop</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-6 col-12 clsexclude">
                                                    <div class="form-group row">
                                                        <div class="col-md-5 col-12"></div>                                                        
                                                        <div class="col-md-4 col-12">
                                                            @if (Model.photograph?.url == null || Model.photograph == null || Model.photograph?.url == "")
                                                            {
                                                                <img src="~/logo/PhotoLogo.JPG" style="height:250px;width:260px;border:1px solid #ddd;background-color:#eee;cursor:pointer!important" id="photoPicture" />
                                                                <label class="cabinet center-block">
                                                                    <figure>
                                                                        <figcaption  style="position: absolute;margin-top: -38px;margin-left: 10px;background: aliceblue;border: 1px solid blanchedalmond;    border-radius: 10px;width: 18px;height: 20px;"><i class="fa fa-camera"></i></figcaption>
                                                                    </figure>
                                                                    <input type="file" class="item-img file center-block" />
                                                                    <input type="hidden" id="photoPictures" name="photoPictures" />
                                                                    <input type="hidden" id="employeeCode" name="employeeCode" value="" />
                                                                </label>

                                                            }
                                                            else
                                                            {
                                                                <img src="/@Model.photograph?.url" style="height:250px;width:260px;border:1px solid #ddd;background-color:#eee;cursor:pointer!important" alt="" id="photoPicture" />
                                                                <input type="hidden" name="photographID" id="photographID" value="@Model.photograph?.Id" />
                                                                <label class="cabinet center-block">
                                                                    <figure>
                                                                        <figcaption class="zoom" style="position: absolute!important;margin-top: -38px!important;margin-left: 10px!important;background: aliceblue;border: 1px solid blanchedalmond;border-radius: 10px;width: 18px;height: 20px;">
                                                                            <i class="fa fa-camera"></i>
                                                                        </figcaption>
                                                                    </figure>
                                                                    <input type="file" class="item-img file center-block" />
                                                                </label>

                                                            }


                                                            <input type="hidden" name="employeeID" id="personalEmployeeID" value="" />
                                                            <input type="file" id="fileinput" class="d-none" />

                                                        </div>
                                                        <div class="col-md-1 col-12">

                                                        </div>
                                                        <div class="col-md-2 col-12">

                                                        </div>

                                                    </div>
                                                </div>



                                                <div class="col-xl-6 col-lg-6 col-md-6 col-12">
                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.dateOfBirth <span style="color:red">*</span></label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" id="mdate" data-parsley-required="true" name="dateOfBirth" value="" required readonly>
                                                            <input type="hidden" name="lprDate" id="hdnLPRDate" value="">
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">Father's Name <span style="color:red">*</span></label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" value="" data-parsley-required="true" id="fatherNameEnglish" name="fatherNameEnglish" required>
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">Mother's Name<span style="color:red">*</span></label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" value="" data-parsley-required="true" id="motherNameEnglish" name="motherNameEnglish" required>
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.gender</label>
                                                        <div class="col-md-8 col-12">
                                                            <select class="form-control" name="gender" id="gender" required>
                                                                <option value="Male">Select</option>
                                                                <option value="Male">পুরুষ</option>
                                                                <option value="Female">মহিলা</option>
                                                                <option value="Other">অন্যান্য</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.nationalID <span style="color:red">*</span></label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" maxlength="17" data-parsley-required="true" id="nationalID" required name="nationalID">
                                                        </div>
                                                    </div>


                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.retiredDate</label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" value="" data-parsley-required="true" required id="retirementdate" readonly name="retirementdate">
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.joiningDateGovtService</label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" value="" readonly id="policejoiningrank" name="policejoiningrank">
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.joiningDatePresentWorkstation</label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" value="" readonly id="dateofjoining" name="dateofjoining">
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">Gradation</label>
                                                        <div class="col-md-8 col-12">
                                                            <input class="form-control" type="text" value="" id="gradationSerial" name="gradationSerial">
                                                        </div>
                                                    </div>
                                                </div>


                                                <div class="col-xl-6 col-lg-6 col-md-6 col-12">
                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.religionId</label>
                                                        <div class="col-md-8 col-12">
                                                            <select class="form-control" name="religionId" id="religionId">
                                                                <option value="">@Model.fLang.select</option>
                                                                @foreach (var item in Model.religions)

                                                                {
                                                                    <option value="@item.Id">@item.nameBn</option>

                                                                }
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.maritalStatus</label>
                                                        <div class="col-md-8 col-12">
                                                            <select class="form-control" name="maritalStatus" id="maritalStatus">


                                                                <option value="">@Model.fLang.select</option>
                                                                <option value="Divorced">Divorced</option>
                                                                <option value="Married">Married</option>
                                                                <option value="Separated">Separated</option>
                                                                <option value="Single">Single</option>
                                                                <option value="Widow">Widow</option>
                                                                <option value="Widower">Widower</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.bloodGroup</label>
                                                        <div class="col-md-8 col-12">
                                                            <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="bloodGroup" id="bloodGroup">

                                                                <option value="A (A+)"> A (A+)</option>
                                                                <option value="A (A-)">A (A-)</option>
                                                                <option value="B (B+)">B (B+)</option>
                                                                <option value="B (B-)">B (B-)</option>
                                                                <option value="O (O+)">O (O+)</option>
                                                                <option value="O (O-)">O (O-)</option>
                                                                <option value="AB (AB+)">AB (AB+)</option>
                                                                <option value="AB (AB-)">AB (AB-)</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.height (cm)</label>
                                                        <div class="col-md-8 col-12">
                                                            <select id="height" name="height" class="select2 form-control mb-3 custom-select" style="width: 100%;" required>
                                                                <option>Select</option>
                                                                @for (int i = 131; i < 215; i++)
                                                                {
                                                                    <option value="@i">@i</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.weight (kg)</label>
                                                        <div class="col-md-8 col-12">
