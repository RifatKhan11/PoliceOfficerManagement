@model InternalAssignmentViewModel
@{
    ViewData["Title"] = "Waiting List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var baseUrl = "http://portfolio.police.gov.bd";
}
@*<div class="mt-3">
        <i class="fa fa-th mr-2" style="font-size:30px;color:#13087E" aria-hidden="true"></i>
        <i class="fa fa-align-justify " style="font-size:30px;color:#13087E" aria-hidden="true"></i>
    </div>*@

<style>
    .boxShadow {
        /*box-shadow: inset -2px -3px 3px 0px rgba(50, 50, 50, 0.75);*/
        /*-webkit-box-shadow: 7px 7px 7px 7px rgba(50, 50, 50, 0.75);
        -moz-box-shadow: 7px 7px 7px 7px rgba(50, 50, 50, 0.75);
        box-shadow: 7px 7px 7px 7px rgba(50, 50, 50, 0.75);*/
    }


    .newLi {
        background-color: cadetblue;
        border-radius: 5px;
        padding: 5px;
        margin-bottom: 5px;
    }

    .moveLi {
        height: 30px;
        padding: 5px;
        border-radius: 5px;
        margin: 2px;
        color: white !important;
        font-weight: bold;
        background-color: rgb(5, 39, 103);
    }

    @@media screen and (max-width: 599px) {
        .topDiv {
            margin-top: 59px !important;
            text-align: center
        }

        .tblInfo, .commentDiv, .btnForMob {
            display: none;
        }

        .tblDiv, .comDiv {
            display: block !important;
        }

        .padd0 {
            padding: 0;
        }

        .martop {
            margin-top: 40px !important;
        }
    }
</style>


<div class="card-header mt-3 border p-1 text-light topDiv" style="background-color:#2A1067">
    <h4 class="ml-2">Ongoing Proposed Officers' List for Posting</h4>
</div>


<div class="card-body">
    <div class="row col-10">
        <div class="col-md-6">
            <div class="form-group row">
                <label for="example-search-input" class="col-md-3 col-12 col-form-label">Alpha Id : </label>
                <div class="col-md-8 col-12">
                    <input type="text" class="form-control input-sm" id="refNo" readonly name="refNo" value="@Model.assignmentDetailsModals?.FirstOrDefault()?.reqNo" />
                </div>
            </div>
            <div class="form-group row">
                <label for="example-search-input" class="col-md-3 col-12 col-form-label">Created By : </label>
                <div class="col-md-8 col-12">
                    <input type="text" class="form-control input-sm" id="assignBy" readonly name="assignBy" value="@Model.employeeInfo?.nameEnglish" />
                </div>
            </div>
        </div>

        <div class="col-md-6">

            <div class="form-group row">
                <label for="example-search-input" class="col-md-3 col-12 col-form-label">Unit : </label>
                <div class="col-md-8 col-12">
                    <input type="text" class="form-control input-sm" id="Rank" readonly name="Rank" value="@Model?.assignmentDetailsModals?.FirstOrDefault()?.rankName" />
                </div>
            </div>

            <div class="form-group row">
                <label for="example-search-input" class="col-md-3 col-12 col-form-label">Date : </label>
                <div class="col-md-8 col-12">
                    <input type="text" class="form-control input-sm" id="assignDate" readonly name="assignDate" value="@Model?.assignmentDetailsModals?.FirstOrDefault().date?.ToString("dd-MMM-yyyy")" />
                </div>
            </div>


        </div>

    </div>
</div>
@if (Model.assignmentDetailsModals.FirstOrDefault().type == 2)
{
    <h5 class="text-center">Additional Incharge Posting Information</h5>
}
<div class="card bg-light">
    <div class="card-body">
        <input type="hidden" id="AssignmentDetailsIdForChnage" value="" />
        <div class="row">
            <div class="col-md-12 col-12">

                <table class="table table-bordered table-striped tblInfo" style="width:100%">
                    <thead>
                        <tr class="text-light  table-sm" style="background-color:#2A1067">
                            <td>Sl No</td>
                            <td>Photo</td>
                            <td>Bp No & Name </td>
                            <td>Details</td>
                            <td>Rank</td>
                            <td>Batch</td>
                            <td>Current Posting Place</td>
                            <td>Proposed Posting Place</td>
                            <td>Remarks</td>
                            <td>Action</td>
                        </tr>
                    </thead>

                    <tbody>
                        @{var i = 1;}
                        @foreach (var item in Model.assignmentDetailsModals)
                        {

                            var exprt = Model.badgeAndActivityModels.Where(x => x.employeeId == item.employeeId && x.expertise != "").FirstOrDefault();
                            var locked = Model.badgeAndActivityModels.Where(x => x.employeeId == item.employeeId && x.lockedEmpId > 0).FirstOrDefault();
                            var Unmiss = Model.badgeAndActivityModels.Where(x => x.employeeId == item.employeeId && x.pHQTRTypeId > 0).FirstOrDefault();

                            <tr>
                                <td>@i</td>
                                <td>
                                    @if (item.picture == null)
                                    {
                                        <img src="~/logo/pp.jpg" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" />
                                    }
                                    else
                                    {
                                        <img src="@baseUrl/@item.picture" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" />
                                    }
                                </td>
                                <td>
                                    <p>@item.Bp</p> <p>@item.Name</p>

                                    @if (exprt != null)
                                    {
                                        <img src="@exprt.expertise" class="img-fluid rounded-circle p-0 m-0" style="width:50px; height:50px" />
                                    }
                                    @if (locked != null)
                                    {
                                        <img src="~/batch/locked.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:50px; height:50px" />
                                    }
                                    @if (Unmiss != null)
                                    {
                                        <img src="~/batch/unmission.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:50px; height:50px" />
                                    }
                                </td>
                                <td>
                                    <ul>
                                        <li>Educational Qualification : @item.educationalQualification</li>
                                        <li>Date of Birth : @item.dateOfBirth?.ToString("dd-MMM-yyyy")</li>
                                        <li>Home District : @item.homeDistrict</li>
                                        @if (item.LastPromotionDate?.ToString("dd-MMM-yyyy") != "01-Jan-0001")
                                        {
                                            <li>Last promotion Date : @item.LastPromotionDate?.ToString("dd-MMM-yyyy")</li>
                                        }
                                        else
                                        {
                                            <li>Last promotion Date : </li>
                                        }
                                    </ul>
                                </td>
                                <td>@item?.rankName</td>
                                <td>@item?.batch</td>
                                <td>
                                    <p>@item?.currentPostringPlace </p>
                                    <p>@item?.deptName </p>
                                    <p>Working Period : @AlphaManagement.Web.Helpers.CalDateDifference.DateDifference(Convert.ToDateTime(item.joiningDateOfPresentunit), DateTime.Now)</p>

                                </td>
                                <td id="PlaceOfPostingForChnag-@item.Id">
                                    @item?.NewPostringPlace
                                </td>
                                <td id="result-@item.Id">
                                    @item.remarks
                                </td>
                                <td>
                                    <a class="btn btn-dark btn-sm" title="Remarks" href="#" onclick="addComment(@item.Id)"><i class="fa fa-envelope"></i></a>
                                    <a class="btn btn-primary btn-sm" title="Details" onclick="detailInfoModalOpen(@item?.Bp)" href="#"><i class="fa fa-user-circle"></i></a>
                                    <a class="btn btn-success btn-sm" href="#" onclick="LoadForMoveTo(@item.employeeId,'@item?.reqNo',@item.Id)"><i class="ti-reload" title="Move"></i></a>
                                    @*<a class="btn btn-info btn-sm float-right" title="Edit" onclick="editModalOpen(@item.employee?.employeeCode)" href="#"><i class="fa fa-edit"></i></a>*@
                                    @*<a class="btn btn-info btn-sm" title="Edit" href="/Employee/Assignment/EditEmployeePostingConfirm?assignDetailsId=@item.Id"><i class="fa fa-edit"></i></a>*@
                                    <a class="btn btn-danger btn-sm" href="#" onclick="DeleteTo(@item.Id)"><i class="ti-trash" title="Delete"></i></a>
                                </td>
                            </tr>
                            i++;
                        }

                    </tbody>
                </table>

                <div class="tblDiv padd0" style="display:none;margin:-5px!important">
                    <div class="col-12 text-center mb-2">
                        <h5 class="text-center d-inline">Posting Information : </h5>
                        <a href="javascript:void(0)" class="btn btn-sm btn-success pull-right" data-toggle="modal" data-target="#mobileViewModal">Details</a>
                    </div>

                    <div class="card padd0">
                        <table class="table table-bordered text-center p-0 m-0">
                            <thead>
                                <tr>
                                    <td><label>Image</label></td>
                                    <td><label>Current Place</label></td>
                                    <td><label>New Place</label></td>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.assignmentDetailsModals)
                                {
                                    <tr>
                                        <td width="33%">
                                            <div class="text-center col-12 p-0">
                                                <div class="col-12 text-center">
                                                    @if (item.picture == null)
                                                    {
                                                        <img src="~/logo/pp.jpg" class="col-12 img-fluid rounded-circle p-0 m-0" />
                                                    }
                                                    else
                                                    {
                                                        <img src="@baseUrl/@item.picture" class="col-12 img-fluid rounded-circle p-0 m-0" />
                                                    }
                                                </div>
                                                <div class="col-12 row">
                                                    @item.Name (@item.Bp)
                                                </div>
                                            </div>
                                        </td>
                                        <td width="34%">
                                            @item?.currentPostringPlace
                                        </td>
                                        <td width="33%">
                                            @item?.NewPostringPlace
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-8">
                        <div class="form-group row" id="DivSubbranch">
                            <label for="example-search-input" class="col-md-2 col-12 col-form-label">Comment<span style="color:red">*</span></label>
                            <div class="col-md-8 col-12">
                                <textarea class="form-control" id="reasonComment" name="reasonComment" onkeyup="comment()"></textarea>
                            </div>
                        </div>


                    </div>

                    <div class="col-sm-4">
                        <div class="form-group row" id="DivSubbranch">
                            <label for="example-search-input" class="col-md-4 col-12 col-form-label">Return To<span style="color:red">*</span></label>
                            <div class="col-md-8 col-12">
                                <select class="form-control" style="width: 100%;" id="UserId">
                                    <option value="">Select One</option>
                                    @foreach (var data in Model.aspNetUsersViewModels.Where(x => x.userName != "addldigpm1"))
                                    {
                                        <option value="@data.aspnetId">@data.empName-(@data.userName)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="mt-3 mb-3 mr-3">
                    <a class="btn btn-info btn-sm float-right mr-2" onclick="approve('@Model.assignmentDetailsModals?.FirstOrDefault()?.masterId')" href="#">Lock</a>
                    <a class="btn btn-success btn-sm float-right mr-2" href="#" onclick="returnMaster('@Model.assignmentDetailsModals?.FirstOrDefault()?.masterId')">Return</a>
                    @*<a class="btn btn-info float-right mr-2" title="Add" href="/Employee/Assignment/EmployeePosting?refNo=@Model.assignmentDetailsModals?.FirstOrDefault()?.reqNo"><i class="fa fa-plus"></i></a>*@
                    <a href="/InternalPosting/InternalEmployee/WaitAssignListpdf/@Model.assignmentDetailsModals?.FirstOrDefault()?.masterId" class="btn btn-sm btn-info float-right mr-2 btnForMob" target="_blank">Preview</a>
                </div>



                <div class="row martop commentDiv">
                    <div class="col-sm-3 mt-2"></div>
                    <div class="col-sm-7 mt-2">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <td>Image</td>
                                    <td>Name</td>
                                    <td>Date & Time</td>
                                    <td>Comments</td>
                                </tr>
                            </thead>
                            @foreach (var data in Model.postingReportViews.OrderBy(s => s.statusId))
                            {

                                <tbody>
                                    <tr>
                                        @if (data.url != null)
                                        {
                                            <td><img src="http://portfolio.police.gov.bd/@data.url" height="50" width="50" /></td>
                                        }
                                        else
                                        {
                                            <td><img src="~/logo/pp.jpg" class="img-fluid rounded-circle" style="width:50px;height:50px" /></td>
                                        }
                                        <td>@data.nameEnglish</td>
                                        <td>@data.refDate.ToString("dd-MMMM-yyyy HH:mm tt")</td>
                                        <td>@data.description</td>
                                    </tr>
                                </tbody>

                            }

                        </table>
                    </div>
                    <div class="col-sm-1 mt-2"></div>
                </div>
                <div class="comDiv" style="display:none;margin-top:50px">
                    <div class="col-12">
                        <div class="col-12 row">
                            <h4 class="col-12 float-left">Comments</h4>
                        </div>
                        <div class="col-12">
                            <table class="table table-bordered" style="width:100%">
                                @foreach (var data in Model.postingReportViews.OrderBy(s => s.assignMasterId))
                                {
                                    <tr>
                                        @if (data.url != null)
                                        {
                                            <td width="40%" style="text-align:center">
                                                <img class="col-12" src="http://portfolio.police.gov.bd/@data.url" style="border-radius:50%" />
                                                @data.nameEnglish
                                            </td>
                                        }
                                        else
                                        {
                                            <td width="40%" style="text-align:center">
                                                <img class="col-12 img-fluid rounded-circle" src="~/logo/pp.jpg" style="border-radius:50%" />
                                                @data.nameEnglish
                                            </td>
                                        }
                                        <td style="text-align:center">@data.description</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg" id="empDetailsModal" role="dialog" aria-labelledby="empDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1300px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Details Info</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="col-12 row" id="empDetails" style="overflow: scroll; height: 800px;margin:0">
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="moveToModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1250px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="col-4 modal-title" id="exampleModalLabel"> Move To New Section </h5>
                <input type="text" id="moveModalSearchInput" class="col-3 form-control" autocomplete="off" name="keyword" placeholder="Search by Unit . . .">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="dd mt-2 nestable_list_2 nestable-color-2 collapse show" style="max-height:800px; overflow-y:scroll">

                    <div class="modal-body" style="height:550px;overflow-y:scroll" id="moveInput">
                        <input type="hidden" class="clsEmpId1" value="" />
                        <input type="hidden" class="clsEmpName1" value="" />
                        <input type="hidden" class="clsEmpCode1" value="" />
                        <input type="hidden" class="clsEmpColor1" value="" />
                        <input type="hidden" class="clsEmpImg1" value="" />
                        <input type="hidden" class="clsEmpOldSec1" value="" />
                        <input type="hidden" class="clsEmpNewSec1" value="" />
                        <ol style="list-style-type: none;">
                            @foreach (var item in Model.phqSections)
                            {
                                <li class="moveLi" onclick="move(@item.Id,'@item.deptName')" style="cursor:pointer">
                                    <a href="javascript:void(0)" style="color:white!important">@item.deptName</a>
                                </li>
                            }
                        </ol>
                    </div>

                    @*<div class="col-12 row" style="display:none" id="divLoader">
                            <div class="col-3"></div>
                            <div class="col-6">
                                <img src="~/images/Circles-loader.gif" height="400" width="400" />
                            </div>
                            <div class="col-3"></div>
                        </div>*@
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg" id="postingEditModal" role="dialog" aria-labelledby="postingEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Change Posting Place</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="col-12 row">
                    <div class="col-md-6 row">
                        <h3 style="text-align:center">Previous Working Place</h3>
                    </div>
                    <div class="col-md-6 row">
                        <h3 style="text-align:center">Selected Working Place</h3>
                        <div class="col-12 form-group">
                            <select class="form-control">
                                <option value="">Select</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
