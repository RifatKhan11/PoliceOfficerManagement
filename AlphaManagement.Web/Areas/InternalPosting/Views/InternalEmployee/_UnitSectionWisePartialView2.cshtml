<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Zen+Dots&display=swap" rel="stylesheet">

<style>
    .grid__item {
        background-color: #fff;
        border-radius: 0.4rem;
        overflow: hidden;
        box-shadow: 0 3rem 6rem rgba(0, 0, 0, 0.1);
        cursor: pointer;
        transition: 0.2s;
    }

        .grid__item:hover {
            transform: translateY(-0.5%);
            box-shadow: 0 4rem 8rem rgba(0, 0, 0, 0.2);
        }

    .card__img {
        display: block;
        width: 100%;
        height: 5rem;
        width: 5rem;
        text-align: center;
    }

    .card__content {
        padding: 3rem 3rem;
    }

    .card__header {
        font-size: small;
    }

    .card__text {
        font-size: 0.8rem;
        letter-spacing: 0.1rem;
        color: #3d3d3d;
    }

    .card__btn {
        display: block;
        width: 100%;
        padding: 0.2rem;
        font-size: 1rem;
        text-align: center;
        color: #3363ff;
        background-color: #e6ecff;
        border: none;
        border-radius: 0.4rem;
        transition: 0.2s;
        cursor: pointer;
    }

        .card__btn span {
            margin-left: 1rem;
            transition: 0.2s;
        }

        .card__btn:hover, .card__btn:active {
            background-color: #dce4ff;
        }

            .card__btn:hover span, .card__btn:active span {
                margin-left: 1.5rem;
            }

    .divSection {
        font-size: 16px !important;
        border: 1px solid;
        padding: 6px;
        background-color: rgb(5, 39, 103);
        color: white;
        font-weight: bolder;
        border-radius: 7px;
    }

        .divSection > button:before {
            content: '⮞';
        }

        .divSection > button[data-action="collapse"]:before {
            content: '⮟';
        }

    .previewCls {
        color: black;
        font-weight: bolder;
        border-radius: 7px;
        padding: 8px;
        margin-top: 5px;
    }
</style>
<div class="col-12" id="divEmpList" style="padding:0;height:850px;overflow-y:scroll;">
    @{
        if (Model.unitRankWiseEmployeeViewModels.Count() == 0)
        {
            <div style="padding-top:200px;text-align:center;">
                <p style="font-size:24px;">No Data Found</p>
            </div>
        }
        else
        {
            foreach (var data in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 1).GroupBy(x => new { x.unitId, x.mainUnit }).Select(x => new { unitId = x.Key.unitId, mainUnit = x.Key.mainUnit }))
            {
                <div class="divSection" id="divHead-@data.unitId">
                    <button class="btn btn-link clsArrowBtn" style="padding-left:0px;text-decoration:none;" data-toggle="collapse" data-target="#collapseOne-@data.unitId" href="#collapseOne-@data.unitId" aria-expanded="true" aria-controls="collapseOne-@data.unitId"></button>@data?.mainUnit<span class="m-2" title="Total Officers"><a href="#" onclick="showAllSectionEmployee(@data.unitId)"><i class="fa fa-user text-info"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == data.unitId).FirstOrDefault().totalEmployee</a></span>
                </div>
                <div class="collapse show" id="collapseOne-@data.unitId">
                    <div class="col-sm-12 col-md-12 col-lg-12 col-12 row">
                        @foreach (var sitem in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 1 && x.unitId == data.unitId && x.employeeId != 0))
                        {
                            <div class="grid__item col-sm-3 col-md-3 col-lg-3 col-12 p-0" id="emp-@sitem.employeeId">
                                <div class="empLi">
                                    <div class="card ui-state-default row" style="margin:4px;min-height:11rem;">
                                        <div class="row">
                                            <div class="col-md-5">
                                                <img class="card__img" src="/@sitem.subUnit" alt="@sitem.name" style="border-radius: 50%">
                                            </div>
                                            <div class="col-md-7">
                                                @if (sitem.expertise != "")
                                                {
                                                    <img src="@sitem.expertise" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />
                                                }
                                                else
                                                {
                                                }
                                                &nbsp;
                                                @if (sitem.attachedUnit != "")
                                                {
                                                    <img src="~/batch/attached.png" data-toggle="tooltip" data-placement="top" title="@sitem.attachedUnit" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />
                                                }
                                                &nbsp;
                                                @if (sitem.pHQTRTypeId > 0)
                                                {
                                                    <img src="~/batch/unmission.png" title="UN Mission" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />

                                                }
                                                &nbsp;
                                                @if (sitem.lockedEmpId > 0)
                                                {
                                                    <img src="~/batch/locked.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />

                                                }
                                                else { }
                                            </div>
                                        </div>

                                        <div class="card-body p-0">
                                            <p class="card__header p-0">
                                                @sitem.name
                                                <input type="hidden" class="clsEmpId" id="txtEmpId-@sitem.employeeId" value="@sitem.employeeId" />
                                                <input type="hidden" class="clsEmpName" value="@sitem.name" />
                                                <input type="hidden" class="clsEmpCode" value="@sitem.employeeCode" />
                                                <input type="hidden" class="clsEmpColor" value="@sitem.colorCode" />
                                                <input type="hidden" class="clsEmpImg" value="@sitem.subUnit" />
                                                <input type="hidden" class="clsEmpSection" value="@data?.mainUnit" />
                                            </p>
                                            @*<p class="card__text"> </p>*@
                                        </div>
                                        <div class="bottom">
                                            <a class="card__btn" href="javascript:void(0)" style="background-color:@sitem.colorCode;"><i class="fa fa-user-circle-o" title="Profile" onclick="fnEmployeeShow(@sitem.employeeCode)"></i><i class="fa fa-level-up" title="Move" style="margin-left:10px;background-color:red;width:18px;border-radius:50%" onclick="moveToSection(@sitem.employeeId,'@sitem.name',@sitem.employeeCode,'@sitem.colorCode','@sitem.subUnit','@data?.mainUnit')"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            }
        }


    }
</div>
<script src="~/js/jquery-3.2.1.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.slimscroll.min.js"></script>
    <script src="~/js/slidebars.min.js"></script>
