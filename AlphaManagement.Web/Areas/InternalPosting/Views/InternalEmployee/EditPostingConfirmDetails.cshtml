@section Scripts{
    <script>
        function LoadSenderEmployee(sl) {
            var BpNum = $('#BPnumber' + sl).val();
            if (BpNum.length < 10 || BpNum.length > 10) {
                swal('BB number must be 10 digit');
            }
            $('#hdnEmpSl').val(sl);
            Common.Ajax('GET', '/Employee/Assignment/GetSignetureByBp?Bp=' + BpNum, [], 'json', ajaxPhotoData);
        }

        function ajaxPhotoData(res) {
            var sl = $('#hdnEmpSl').val();
            if (res != null) {
                $('#bPNumber' + sl + 'Sign').attr('src', 'http://portfolio.police.gov.bd/' + res.url);
                $('#bPNumber' + sl + 'Sign').show();
                $('#bPNumber' + sl + 'Name').append(res.remarks);
                $('#bPNumber' + sl + 'Name').show();
                $('#PoliceId' + sl).val(res.employeeId);
            }
            else {
                $('#bPNumber' + sl + 'Sign').attr('src', '#');
                $('#bPNumber' + sl + 'Sign').hide();
                $('#bPNumber' + sl + 'Name').append('');
                $('#bPNumber' + sl + 'Name').hide();
                $('#PoliceId' + sl).val('');
            }
        }

        $('#formId').submit(function (e) {
            e.preventDefault();
            var form = $('#formId');
            $.ajax({
                url: '/InternalPosting/InternalEmployee/SaveAssignMasterForNoteSheet',
                data: form.serialize(),
                type: 'POST',
                success: function (records) {
                    if (records == 'Save') {
                        window.location.href ="/InternalPosting/InternalEmployee/PostingConfirmNotePdf?id="+@ViewBag.AssignmentMasterId
                    }
                },
                error: function (erro) {
                    console.log(erro);
                    swal('', 'Unable to Save!', 'warning');
                }
            });
        });
    </script>
}
