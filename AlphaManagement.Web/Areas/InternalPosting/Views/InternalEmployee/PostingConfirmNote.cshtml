@model PostingReportViewModel
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "pdf";
    Layout = "~/Views/Shared/_PrintView.cshtml";
    var baseUrl = "http://portfolio.police.gov.bd";
}
<style>
    @@import url('https://fonts.maateen.me/solaiman-lipi/font.css');

    body {
        font-family: 'SolaimanLipi', Arial, sans-serif !important;
    }
</style>
<div class="row">
    <div class="col-12">
        <h5>@Model.assignments?.FirstOrDefault()?.assignmentMaster?.noteSheetTitle</h5>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <table class="table table-bordered">
            @{
                int i = 1;
                @foreach (var item in Model.aVM)
                {
                    <tr>
                        <td><h5>@AlphaManagement.Web.Helpers.LanguageProcessing.EnglishToBangla(i.ToString() + ".")</h5></td>
                        <td>
                            <h5>
                                @item?.nameBangla,  @LanguageProcessing.EnglishToBangla(item?.employeeCode)
                                <br /> @item?.currentPostingPlace
                                <br /> জন্মতারিখ : @LanguageProcessing.EnglishToBangla(item?.dateOfBirth)
                                <br /> জন্মজেলা : @item?.homeDistrict
                                <br /> শিক্ষাগত যোগ্যতা : @item?.EducationQualification
                                <br /> ক্যাডারে যোগদানের তারিখ :  @LanguageProcessing.EnglishToBangla(item?.joiningDate)
                                <br /> @item?.currentPostingPlace পদে পদোন্নতি : @LanguageProcessing.EnglishToBangla(item?.promotionDate)
                                <br /> বর্তমান কর্মস্থলে যোগদান : @LanguageProcessing.EnglishToBangla(item?.joiningDateCurrentPlace)
                                <br /> পূর্ববর্তী কর্মস্থল : @item?.PreviousPostingPlace
                            </h5>
                        </td>
                        <td>
                            <h5 class="text-center">
                                @item?.RankName <br />  @item?.NewPostingPlace
                            </h5>
                        </td>
                    </tr>
                    i++;
                }
            }

        </table>
    </div>
</div>
<div class="row">
    <div class="col-12 mt-2">
        <h5>সদয় আবেদনের জন্য পেশ করা হলো।</h5>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <h5>@Model.assignments?.FirstOrDefault()?.assignmentMaster?.noteSheetDescription</h5>
    </div>
</div>
<div class="row">
    <div class="col-12 mt-5">
        <div class="col-12 row">
            @foreach (var item in Model.internalApprovals)
            {
                if (item?.user?.Id != "04FA50C1-FD52-4A8C-98B9-020E43AD6B48")
                {
                    <div class="col-4">
                        <div>
                            <img height="80" width="100%" src="/@item?.updatedBy" />
                        </div>
                        <br />
                        <div class="text-center"><h5><u>@item?.createdBy</u></h5></div>
                    </div>
                    @*<div class="col-4 text-center" style="height:100px"><h5><u>@item?.createdBy</u></h5></div>*@
                }
            }
        </div>
        <div class="col-12 row">
            <div class="col-12 text-center"><img height="80" width="200" src="@baseUrl/@Model.internalApprovals.Where(x=>x.user?.Id=="04FA50C1-FD52-4A8C-98B9-020E43AD6B48").FirstOrDefault()?.updatedBy" /></div>
        </div>
        <div class="col-12 row">
            <div class="col-12 text-center"><h5><u>আইজিপি</u></h5></div>
        </div>
    </div>
</div>
<div style="height:150px;"></div>
<div class="row">
    <div class="col-4">
        <qrcode style="float:right;" content="Memorandum no : @Model?.internalAssignments?.FirstOrDefault()?.assignmentMaster?.memorandumNo,Reference No :  @Model?.internalAssignments?.FirstOrDefault()?.assignmentMaster?.refNo,Posting Order Date :  @Model?.internalAssignments?.FirstOrDefault()?.assignmentMaster?.refDate.ToString("dd/MM/yyyy")" width="100" height="100"></qrcode>
    </div>
    <div class="col-4 mt-5" style="text-align:center;">

    </div>
    <div class="col-4" style="text-align:center;">

        <h1>---------------</h1>
        @*<h3>Signature</h3>*@
    </div>
</div>


