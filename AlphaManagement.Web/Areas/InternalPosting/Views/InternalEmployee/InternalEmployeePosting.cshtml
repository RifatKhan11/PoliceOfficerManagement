        function loadEmployeeListByRankUnit() {
            $('#olEmpList').hide();
            $('#loaderDiv').show();
            var rankId = $('#rankId').val();
            var unitId = $('#unitId').val();
            var batch = $('#batchId').val();
            var servicePeriod = $('#servicePeriodId').val();
            var bandId = $('#bandId').val();
            var value = $('#rankId option:selected').text().toLowerCase();
            if (value != 'all rank') {
                $("#internalForm .grid__item").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            }
            //$("#olEmpList").load("/Employee/Assignment/GetRankUnitWisePartialEmployeeView?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId);
            $("#olEmpList").load("/InternalPosting/InternalEmployee/GetUnitRankWisePartialEmployeeView2?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId + "&isLocked=" + 0 + "&isAttached=" + 0 + "&isUnMission=" + 0);
        }

        function iconLoad(type, id) {
            $('#olEmpList').hide();
            $('#loaderDiv').show();
            var rankId = 0;
            var unitId = 0;
            var batch = 0;
            var servicePeriod = 0;
            var bandId = 0;
            var isLocked = 0;
            var isAttached = 0;
            var isUnMission = 0;
            if (type == 'period') {
                servicePeriod = id;
            }
            else if (type == 'expertise') {
                bandId = id
            } else if (type == 'locked') {
                isLocked = id
            } else if (type == 'attached') {
                isAttached = id
            } else if (type == 'unmission') {
                isUnMission = id
            }

            $("#olEmpList").load("/InternalPosting/InternalEmployee/GetUnitRankWisePartialEmployeeView2?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId + "&isLocked=" + isLocked + "&isAttached=" + isAttached + "&isUnMission=" + isUnMission);
        }

        function removeNewLi(id) {
            $('#addedemp-' + id).remove();
            $('#assLi' + id).remove();
            $('#emp-' + id).show();
        }

        function submitForm() {
            $('#frmSbm').click();
        }

        $('#internalForm').submit(function () {
            var formData = $('#internalForm').serialize();
            if ($('#internalForm ul li').length = 0) {
                return false;
            }
            else {
                $.ajax({
                    url: '/InternalPosting/InternalEmployee/SaveInternalPosting',
                    data: formData,
                    type: 'POST',
                    success: function (records) {
                        if (records != "Fail") {
                            window.location.href = "/InternalPosting/InternalEmployee/InternalPostingDetails?enlistMasterId=" + records;
                        }
                        else {
                            swal('', 'Unable to Save!', 'warning');
                            console.log(erro);
                        }
                    },
                    error: function (erro) {
                        //console.log(erro);
                        swal('', 'Unable to Save!', 'warning');
                    }
                });
            }
        })

        function showAllSectionEmployee(id) {
            $.ajax({
                url: "/InternalPosting/InternalEmployee/GetEmployeeListBySectionId/",
                type: 'GET',
                async: false,
                data: { id: id },
                success: function (response) {
                    var data = '';
                    var section = '';
                    var img = '';
                    var tbl = $('#tblSection tbody');
                    $.each(response, function (i, v) {
                        if (v.updatedBy == null) {
                            img = 'logo/defaultprofile.jpg';
                        }
                        else {
                            img = v.updatedBy;
                        }
                        data += `<tr>
                            <td>${i + 1}</td>
                            <td>
                                <img src="@baseImageUrl/${img}" height="50" width="50" style="border-radius: 50%"/>
                            </td>
                            <td>${v.nameEnglish}</td>
                            <td>${v.rank ?.rankName}</td>
                        </tr>`;
                        section = '';
                        section = `${v.department ?.deptName}`;
                    })
                    tbl.empty();
                    $('#sectionName').empty();
                    tbl.append(data);
                    $('#sectionName').append(section);
                    $('#tblSection').DataTable().destroy();
                    $('#tblSection').DataTable();
                }
            })
            $('#sectioEmpListModal').modal('show');
        }

        function moveToSection(empId, name, employeeCode, colorCode, imgUrl, oldSection) {
            $('.clsEmpId1').val(empId);
            $('.clsEmpName1').val(name);
            $('.clsEmpCode1').val(employeeCode);
            $('.clsEmpColor1').val(colorCode);
            $('.clsEmpImg1').val(imgUrl);
            $('.clsEmpOldSec1').val(oldSection);
            $('#moveToModal').modal('show');
        }

        function move(sectionId, newSectionName) {
            var empId = $('#moveInput').find('input.clsEmpId1').val();
            var EmpName = $('#moveInput').find('input.clsEmpName1').val();
            var empCode = $('#moveInput').find('input.clsEmpCode1').val();
            var secId = sectionId;
            var empColor = $('#moveInput').find('input.clsEmpColor1').val();
            var empIgm = $('#moveInput').find('input.clsEmpImg1').val();
            var oldSectionName = $('#moveInput').find('input.clsEmpOldSec1').val();
            var data = `<div class="grid__item col-sm-3 col-md-3 col-lg-3 col-12 p-0"id="addedemp-${empId}">
                                <div class="empLi">
                                    <div class="card ui-state-default" style="margin:4px;min-height:11rem;">
                                        <img class="card__img" src="/${empIgm}" alt="${empId}"  style="border-radius: 50%">
                                        <div class="card-body p-0">
                                            <p class="card__header p-0">
                                            ${EmpName}
                                            <input type="hidden" name="employeeId" value="${empId}" />
                                            <input type="hidden" name="sectionId" value="${sectionId}" />
                                            </p>
                                        </div>
                                        <div class="bottom">
                                            <a class="card__btn" href="javascript:void(0)" style="background-color:${empColor};"><i class="fa fa-user-circle-o" title="Profile" onclick="fnEmployeeShow('${empCode}')"></i><i class="fa fa fa-window-close" style="color:red;margin-left:5px" onclick=removeNewLi(${empId})></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>`;
            var assign = `<li id=assLi${empId} class="row previewCls" style="background-color:${empColor};padding-left:4%;margin-left: 0;">
                                <div class="col-11" style="padding:0">${EmpName}<label style="padding:0;margin: 0;">Previous Section: ${oldSectionName}</label><label style="padding:0;margin: 0;">New Section: ${newSectionName}</label></div>
                                <div class="col-1"><span style="color:red;cursor: pointer;" onclick="removeNewLi(${empId})"><i class="fa fa-times"></i></span></div></li>`

            //$('#section-' + sectionId).append(`<li class="newLi" id="addedemp-${empId}"><a href="javascript:void(0)"><i class="fa fa fa-window-close pull-right" style="color:red" onclick=removeNewLi(${empId})></i></a>${EmpName}<input type="hidden" name="employeeId" value="${empId}" /><input type="hidden" name="sectionId" value="${sectionId}" /></li>`);
            $('#section-' + secId).append(data);
            $('#assignedEmpList1').append(assign);
            $('#emp-' + empId).hide();
            $('#moveInput').find('input.clsEmpId').val('');
            $('#moveInput').find('input.clsEmpName').val('');
            $('#moveInput').find('input.clsEmpCode').val('');
            $('#moveInput').find('input.clsEmpColor').val('');
            $('#moveInput').find('input.clsEmpImg').val('');
            $('#moveToModal').modal('hide');
        }
    </script>
}
