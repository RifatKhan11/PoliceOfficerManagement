@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "PRLEmployeeList";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var baseImageUrl = "http://portfolio.police.gov.bd";
}

<section id="bodySection">

    <!-- body content start-->
    <div class="body-content" style="margin-top: -57px;margin-left: -28px;">
        <div class="container-fluid">
            <div class="row mt-5">

                <div class="col-lg-12 col-sm-12">
                    <div class="card m-b-30">
                        <div class="card-body">
                            <h5 class="header-title pb-3"></h5>
                            <div class="row">
                                <div class="col-sm-12 row pull-right">

                                    <div class="col-md-3 col-12">
                                        <div class="form-group">
                                            <label></label>
                                            <select class="select2 form-control form-control-sm mb-3 custom-select" id="rankId" style="width: 100%;">
                                                <option value="0">All Rank</option>
                                                @foreach (var item in Model.rank)
                                                {
                                                    <option value="@item.Id">@item.rankName</option>
                                                }

                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-12">
                                        <div class="form-group">
                                            <label></label>
                                            <select class="select2 form-control form-control-sm mb-3 custom-select" id="unitId" style="width: 100%;">
                                                >
                                                <option value="0">All Unit</option>
                                                @foreach (var item in Model.specialBranchUnits)
                                                {
                                                    <option value="@item.Id">@item.branchUnitName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-12">
                                        <div class="form-group">
                                            <label></label>
                                            <select class="select2 form-control form-control-sm mb-3 custom-select" id="batchId" style="width: 100%;">
                                                <option value="0">All Batch</option>
                                                @foreach (var item in Model.bCSBatch)
                                                {
                                                    <option value="@item.Id">@item.batchName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-12">
                                        <div class="form-group" style="margin-top:10px">
                                            <button class="btn btn-sm" style="background-color:#708ea0;color:white" onclick="loadOfficers()">Load</button>
                                            <button class="btn btn-sm ml-3" style="background-color:green;color:white" onclick="loadOfficersPDF()">Print</button>
                                            <a class="btn btn-success pull-right mb-4" href="/">Dashboard</a>
                                        </div>
                                    </div>

                                    <div id="checkedList">

                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-hover m-b-0" id="tblMain">
                                            <thead>
                                                <tr>
                                                    <td>SL.NO</td>
                                                    <td>Photo</td>
                                                    <td>Name</td>
                                                    <td>BP No</td>

                                                    <td>Rank</td>
                                                    <td>Unit</td>
                                                    <td>BCS Batch</td>
                                                    <td>Joining Date</td>
                                                    <td>PRL Date</td>

                                                    <td width="10%">Action</td>
                                                </tr>
                                            </thead>
                                            <tbody id="tbEmplist">
                                                @{
                                                    var i = 1;

                                                    @foreach (var item in Model.employeeListVMs)
                                                    {
                                                        <tr>
                                                            <td>@i</td>
                                                            @if (item.url == null)
                                                            {
                                                                <td> <img src="~/logo/defaultprofile.jpg" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                                                            }
                                                            else
                                                            {
                                                                <td> <img src="@baseImageUrl/@item.url" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                                                            }
                                                            <td>@item.name</td>
                                                            <td>@item.employeeCode</td>
                                                            <td>@item.rank</td>
                                                            <td>@item.unit</td>
                                                            <td>@item.bcsBatch</td>
                                                            <td>@item.joiningDate?.ToString("dd-MM-yyyy")</td>
                                                            <td>@item.PRLDate?.ToString("dd-MM-yyyy")</td>
                                                            <td>
                                                                <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportViewPDF?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Report"><i class="fa fa-file"></i></a>
                                                        </tr>
                                                        i++;
                                                    }

                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>



            </div>
        </div>
        <!--end container-->

    </div>
    <!--end body content-->
</section>


@section Scripts{
    <!-- Responsive and datatable js -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
    <script src="~/js/jquery.table2excel.js" type="text/javascript"></script>
    <link href="~/plugins/morris-chart/morris.css" rel="stylesheet">
    <script src="~/plugins/chart-js/Chart.bundle.js"></script>
    <script src="~/plugins/morris-chart/raphael-min.js"></script>
    <script src="~/plugins/morris-chart/morris.js"></script>
    <script>

        $(document).ready(function ($) {
            $('#tblMain').DataTable();
            $('#unitId').select2();
            $('#rankId').select2();
            $('#batchId').select2();
        });

        function loadOfficers() {

            var unitId = $('#unitId').val();
            var rankId = $('#rankId').val();
            var batchId = $('#batchId').val();
            window.location.href = "/Employee/EmployeeProfile/PRLEmployeeList?unitId=" + unitId + '&rankId=' + rankId + '&batchId=' + batchId;
            //$('#checkedList').load("/Employee/EmployeeInfoHistory/LoadCheckedOfficerList?unitId=" + unitId + '&rankId=' + rankId + '&batchId=' + batchId);
            //$('#tblTable').DataTable();
            //Common.Ajax('GET', '/global/api/GetEmployeeSearchByUnitId/' + unitId + '/' + rankId + '/' + batchId, [], 'json', ajaxUnit, false);
            $('#tblTable').DataTable().destroy();
            $('#tblTable').DataTable();
        }

        function btnUpdateEmployeeStatus(employeeCode, status) {
            if (employeeCode == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }
            if (status == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }

            swal({
                title: 'Are you sure?', text: 'Do you want to Verify this record?', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, Verify!'
            }).then(function (res) {
                if (res.value) {
                    var url = "/Portfolio/PortfolioDashboard/UpdateEmployeeStatus?empCode=" + employeeCode + "&status=" + status;
                    $.get(url, function (data) {
                        if (data.Success) {
                            swal('', data.Message, 'success').then(function () {
                                loadOfficers();
                            })
                        } else {
                            swal('Warning', data.Message, 'warning');
                        }


                    });
                }


            })
        }

    </script>
}
