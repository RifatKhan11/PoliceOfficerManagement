@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var type = "profile";
}
<link href="~/plugins/responsive-table/css/rwd-table.min.css" rel="stylesheet" type="text/css" media="screen">
<link href="~/css/dropify.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.11.4/jquery-ui.css" rel="stylesheet" />
<style>
    .zoom {
        transition: transform .2s; /* Animation */
    }

        .zoom:hover {
            transform: scale(1.1); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
        }

</style>


<html>
<head>
    <title></title>
</head>
<body>
    <div class="row">
        <div class="col-md-12 mt-1">
            <h4 class="font-weight-bold;margin-left: -21px;">
                Personal Information
                <a class='btn btn-outline-info float-right mr-4 mb-0' style="" data-toggle='tooltip' title='Go Back' href='/Employee/EmployeeProfile/Employeelist'><i class="fa fa-step-backward"></i></a>
                @*@if (Model.applicationUser?.userType?.userTypeName == "Organization")
                    {
                        <a class='btn btn-outline-info float-right mr-4 mb-0' style="" data-toggle='tooltip' title='Go Back' href='/FAMSDB/MenuforOrg/MenuOrg/@Model.organizationInfo?.Id'><i class="fas fa-backward"></i></a>
                    }
                    else
                    {
                        <a class='btn btn-outline-info float-right mr-4 mb-0' style="" data-toggle='tooltip' title='Go Back' href='/FAMSDB/FinancialOrganization/menu/@Model.organizationInfo?.Id'><i class="fas fa-backward"></i></a>

                    }*@
            </h4>


            <div class="card-header border-0">
                <h5></h5>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="mt-4 mb-2 pb-2 pt-4">
                        <div class="row">
                            <div class="col-md-2">
                                <p class="text-center">
                                    @if (Model.employeeInfo?.Photographs?.Where(x=>x.type== "profile")?.FirstOrDefault()?.url == null)
                                    {
                                        <img src="~/logo/pp.jpg" class="img-fluid rounded-circle" style="width:150px; height:150px" />
                                        <figure>
                                            <figcaption class="zoom float-right" style="position: absolute!important;margin-top: -38px!important;margin-left: 135px!important;background: aliceblue;border: 1px solid blanchedalmond;border-radius: 10px;width: 18px;height: 20px;">
                                                <a href="/Employee/EmployeeInfo/CustomCrop"><i class="fa fa-camera"></i></a>
                                            </figcaption>
                                        </figure>
                                    }
                                    else
                                    {                                        
                                        <img src="http://portfolio.police.gov.bd/@Model.employeeInfo?.Photographs?.Where(x=>x.type==@type)?.FirstOrDefault()?.url" class="img-fluid rounded-circle" style="width:150px; height:150px" />
                                        <figure>
                                            <figcaption class="zoom" style="position: absolute!important;margin-top: -38px!important;margin-left: 135px!important;background: aliceblue;border: 1px solid blanchedalmond;border-radius: 10px;width: 18px;height: 20px;">
                                                <a href="/Employee/EmployeeInfo/CustomCrop"><i class="fa fa-camera"></i></a> 
                                            </figcaption>
                                        </figure>
                                    }
                                </p>
                            </div>
                            <div class="col-md-10 mb-1">
                                <p class="pt-0 pb-0 mb-1"><strong>Name  : </strong> @Model.employeeInfo?.nameEnglish</p>
                                <p class="pt-0 pb-0 mb-1"><strong>BP No : </strong>  @Model.employeeInfo?.employeeCode</p>
                                <p class="pt-0 pb-0 mb-1"><strong>Rank : </strong> @Model.employeeInfo?.rank?.rankName</p>
                                <p class="pt-0 pb-0 mb-1"><strong>Email : </strong> @Model.employeeInfo?.emailAddressPersonal</p>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                @if (Model.userRoles.Where(x => x.roleName == "Disciplinary Action Entry Operator").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Admin").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Super Admin").Count() > 0)
                                {
                                    <div class="col-md-2 col-sm-6 col-xs-12 p-1 ml-1 zoom">
                                        <div class="form-group text-center card" style="background-color:#efecee;border-color:lightgray;">
                                            <a class="text-center btn btn-default h" href="/Employee/DisciplinaryAction/Index?id=@Model.employeeInfo?.Id" style="text-decoration:none;">
                                                <i class="fa fa-tint fa-3x "></i>
                                                <br /><span class="d">Disciplinary</span>
                                            </a>
                                        </div>
                                    </div>
                                }
                                @if (Model.userRoles.Where(x => x.roleName == "ACR Entry Operator").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Admin").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Super Admin").Count() > 0)
                                {
                                    <div class="col-md-2 col-sm-6 col-xs-12 p-1 ml-1 zoom">
                                        <div class="form-group text-center card" style="background-color:#efecee;border-color:lightgray;">
                                            <a class="text-center btn btn-default h" href="/Employee/DisciplinaryAction/ACRInfo?id=@Model.employeeInfo?.Id" style="text-decoration:none;">
                                                <i class="fa fa-archive fa-3x"></i>
                                                <br /><span class="d">ACR</span>
                                            </a>
                                        </div>
                                    </div>
                                }
                                @if (Model.userRoles.Where(x => x.roleName == "Intel Report Entry Operator").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Admin").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Super Admin").Count() > 0)
                                {
                                    <div class="col-md-2 col-sm-6 col-xs-12 p-1 ml-1 zoom">
                                        <div class="form-group text-center card" style="background-color:#efecee;border-color:lightgray;">
                                            <a class="text-center btn btn-default h" href="#" style="text-decoration:none;">
                                                <i class="fa fa-renren  fa-3x "></i>
                                                <br /><span class="d">Intel Report</span>
                                            </a>
                                        </div>
                                    </div>
                                }
                                @if (Model.userRoles.Where(x => x.roleName == "Traning1").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Admin").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Super Admin").Count() > 0)
                                {
                                    <div class="col-md-2 col-sm-6 col-xs-12 p-1 ml-1 zoom">
                                        <div class="form-group text-center card" style="background-color:#efecee;border-color:lightgray;">
                                            <a class="text-center btn btn-default h" href="/Employee/DisciplinaryAction/Traninginfo?id=@Model.employeeInfo?.Id" style="text-decoration:none;">
                                                <i class="fa fa-users  fa-3x "></i>
                                                <br /><span class="d">Traning Information</span>
                                            </a>
                                        </div>
                                    </div>
                                }
                                @if (Model.userRoles.Where(x => x.roleName == "BPA").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Admin").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Super Admin").Count() > 0)
                                {
                                    <div class="col-md-2 col-sm-6 col-xs-12 p-1 ml-1 zoom">
                                        <div class="form-group text-center card" style="background-color:#efecee;border-color:lightgray;">
                                            <a class="text-center btn btn-default h" href="/Employee/DisciplinaryAction/BPAinfo?id=@Model.employeeInfo?.Id" style="text-decoration:none;">
                                                <i class="fa fa-users  fa-3x "></i>
                                                <br /><span class="d">BPA Information</span>
                                            </a>
                                        </div>
                                    </div>
                                }
                                @if (Model.userRoles.Where(x => x.roleName == "SB").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Admin").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Super Admin").Count() > 0)
                                {
                                    <div class="col-md-2 col-sm-6 col-xs-12 p-1 ml-1 zoom">
                                        <div class="form-group text-center card" style="background-color:#efecee;border-color:lightgray;">
                                            <a class="text-center btn btn-default h" href="/Employee/DisciplinaryAction/SBinfo?id=@Model.employeeInfo?.Id" style="text-decoration:none;">
                                                <i class="fa fa-users  fa-3x "></i>
                                                <br /><span class="d">SB Report</span>
                                            </a>
                                        </div>
                                    </div>
                                }
                                @if (Model.userRoles.Where(x => x.roleName == "Medical").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Admin").Count() > 0 || Model.userRoles.Where(x => x.roleName == "Super Admin").Count() > 0)
                                {
                                    <div class="col-md-2 col-sm-6 col-xs-12 p-1 ml-1 zoom">
                                        <div class="form-group text-center card" style="background-color:#efecee;border-color:lightgray;">
                                            <a class="text-center btn btn-default h" href="/Employee/DisciplinaryAction/Medicalinfo?id=@Model.employeeInfo?.Id" style="text-decoration:none;">
                                                <i class="fa fa-users  fa-3x "></i>
                                                <br /><span class="d">Medical History Report</span>
                                            </a>
                                        </div>
                                    </div>
                                }
                                @*else if (Model.userRoles.Where(x => x.roleName == "ACR Entry Operator").Count() > 0)
                                {
                                    <div class="col-md-2 col-sm-6 col-xs-12 p-1 ml-1 zoom">
                                        <div class="form-group text-center card" style="background-color:#efecee;border-color:lightgray;">
                                            <a class="text-center btn btn-default h" href="/Employee/PromotionLog/Index/@Model.employeeInfo?.Id" style="text-decoration:none;">
                                                <i class="fa fa-share-alt fa-3x "></i>
                                                <br /><span class="d">Promotion</span>
                                            </a>
                                        </div>
                                    </div>
                                }*@

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>





