                var employeeList = "";

                var baseImageUrl = "http://portfolio.police.gov.bd/";
                $.each(data, function (key, v) {
                    var imageUrl = "";
                    var img = '<img src="~/logo/defaultprofile.jpg" style="width:150px;height:150px;" class="img - fluid" alt="" />';
                    if (v.imageUrl !== null) {
                        imageUrl = baseImageUrl + v.imageUrl;
                        img =`<img src="${imageUrl}" class="img-fluid rounded-circle" style="width:150px;height:150px;" alt="No Image"/>`
                    }
                        employeeList += `<tr id="fiId${v.employeeId}">
                        <td>${key + 1}</td>
                        <td>${img} </td>
                        <td>${v.nameEnglish}</td>
                        <td>${v.unit}</td>
                        <td>${v.rank}</td>
                        <td>${v.bcsBatch}</td>
                        <td>${v.gender}</td>
                        <td>${v.religion}</td>
                        <td>
                                <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeProfile/Index?id=${v.employeeId}')"  target="_blank"  title="Info"><i class="mdi mdi-account-card-details"></i></a>

                            </td>
                       </tr>`;
                });


                //<a class="btn btn-sm btn-primary" target="_blank" href="/Portfolio/PortfolioDashboard/EmployeeDetails?id=${v.employeeCode}" title="Details"><i class="mdi mdi-account-card-details"></i></a>


                $('#tbEmplist').empty();
                $('#tbEmplist').append(employeeList);
                $('#allEmployeeListTable').DataTable().destroy();
                $('#allEmployeeListTable').DataTable();
