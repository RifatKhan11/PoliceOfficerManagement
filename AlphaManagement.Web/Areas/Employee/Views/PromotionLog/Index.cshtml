@model PromotionLogViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";
}

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="pt-2 pb-2 mt-2">
                    @Model.fLang.Title
                      <span class="ml-3"> @Model.employeeInfo?.nameEnglish</span>
                      @*<span class="ml-3"> @Model.promotionLogs?.FirstOrDefault()?.designationNew?.designationName</span>*@
                </h5>
            </div>
            <div class="card-body">
                <form role="form" asp-area="Employee" asp-controller="PromotionLog" asp-action="Index">
                    <input type="hidden" name="PromotionLogId" id="PromotionLogId" value="" />
                    <input type="hidden" name="employeeId" id="employeeId" value="@ViewBag.employeeId" />

                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="designationNewId">@Model.fLang.designationNew</label>
                                <div class="col-md-8 col-12">

                                    <select class="form-control" name="designationNewId" id="designationNewId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.newDesignations)
                                        {
                                            <option value="@item.Id">@item.designationName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="designationOldId">@Model.fLang.designationOld</label>
                                <div class="col-md-8 col-12">

                                    <select class="form-control" name="designationOldId" id="designationOldId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.oldDesignations)
                                        {
                                            <option value="@item.Id">@item.designationName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="date">@Model.fLang.date</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="date" name="date" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="goDate">@Model.fLang.goDate</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="goDate" name="goDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="goNumber">@Model.fLang.goNumber</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="goNumber" name="goNumber" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                       
                    </div>

                    <div class="row">
                        <div class="col-md-12 col-12">
                            <div class="form-group row">
                                <label class="col-md-2 col-12" for="remark">@Model.fLang.remark</label>

                                <div class="col-md-10 col-12">
                                    <textarea required="" class="form-control" id="remark" name="remark" rows="5" data-parsley-id="24"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger btn-sm">Close</button>
                                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">@Model.fLang.Title</h4>
            </div>
            <div class="card-body table-responsive">

                <div class="table-odd">
                    <table id="tblData" class="table table-bordered  text-nowrap" style="width:100%">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>Name</th>
                                <th>Ref No</th>
                                <th>@Model.fLang.date</th>
                                <th>@Model.fLang.designationNew</th>
                                <th>@Model.fLang.designationOld</th>
                                <th>@Model.fLang.goDate</th>
                                <th>@Model.fLang.action</th>

                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int sl = 0;
                                @foreach (var item in Model.promotionLogs.OrderByDescending(x=>x.Id))
                                {
                                    sl = sl + 1;
                                    <tr>
                                        <td>@sl</td>
                                        <td>@item.employee?.nameEnglish</td>
                                        <td>@item.goNumber</td>
                                        <td>@item.goDate?.ToString("dd-MMM-yyyy")</td>
                                        <td>@item.designationNew?.designationName</td>
                                        <td>@item.designationOld?.designationName</td>                                    
                                        <td>@item.goDate?.ToString("dd-MMM-yyyy")</td>
                                        <td>
                                            <button type="button" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="Edit(@item.Id,@item.employeeId,'@item.date',@item.designationNewId,@item.designationOldId,'@item.goDate','@item.goNumber','@item.remark')"><span class="ti-pencil"></span></button>
                                            <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete(@item.Id)"><span class="ti-trash"></span></button>
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>

        $(document).ready(function () {
            $('#tblData').DataTable();

        });

        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (month < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }



        function Edit(Id, employeeId, date, designationNewId, designationOldId, goDate, goNumber,remark){
           $("#PromotionLogId").val(Id);
           $("#employeeId").val(employeeId);
          $("#date").val(formatDate(date));
           $("#designationNewId").val(designationNewId);
           $("#designationOldId").val(designationOldId);
          $("#goDate").val(formatDate(goDate));
          $("#goNumber").val(goNumber);
           $("#remark").val(remark);
        }

        $('#date').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
        $('#goDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/PromotionLog/DeletePromotionLog/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

