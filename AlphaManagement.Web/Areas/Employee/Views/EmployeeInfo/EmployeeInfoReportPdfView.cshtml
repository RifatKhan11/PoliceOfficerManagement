@model EmployeeSearchReport

@{
    ViewData["Title"] = "বিসিএস (পুলিশ) ক্যাডারভুক্ত কর্মকর্তাদের খসড়া গ্রেডেশন লিস্ট";
    //Layout = "~/Views/Shared/_PrintView.cshtml";
    Layout = "~/Views/Shared/_PrintViewPolice.cshtml";
}

@using System;
@using AlphaManagement.Web.Helpers
@section Style{
    <style>
       
    </style>
}

    <div class="card" style="width:100%;" id="tablelegatiy">
        <div class="cardheader" style="text-align:center;">
            <h2 style="margin-top:35px;margin-bottom:15px;">
                বিসিএস (পুলিশ) ক্যাডারভুক্ত কর্মকর্তাদের খসড়া গ্রেডেশন লিস্ট <br />
            </h2>
        </div>

        <div class="card-body">
            <div class="col-12">
                <table class="table table-striped table-bordered" style="vertical-align:top !important;" id="legalWeaponTable">

                    <thead>
                        <tr>

                            <th rowspan="2" style="width:3%;">
                                ক্রমিক নং
                            </th>
                            <th rowspan="2" style="width:20%">
                                কর্মকর্তার নাম,জন্ম তারিখ, জন্ম জেলা ও <br /> শিক্ষাগত যোগ্যতা
                            </th>
                            <th rowspan="2" style="width:8%">অভিজ্ঞতা (পদের <br /> নাম) নিয়োগের <br /> তারিখসহ</th>
                            <th rowspan="2" style="width:10%">পুলিশ ক্যাডারের <br /> প্রারম্ভিক পদে কমিশনের <br /> সুপারিশ অনুযায়ী <br /> নিয়মিত নিয়োগ <br /> (সরাসরি/পদোন্নতি)</th>
                            <th rowspan="2" style="width:8%">সিনিয়র স্কেলে <br /> নিয়মিত পদোন্নতির <br /> তারিখ</th>
                            <th rowspan="2" style="width:10%">
                                সামরিক কর্মকর্তাদের <br /> প্রাসঙ্গিক তথ্যঃ- <br />
                                ক) কমিশন প্রাপ্তির তারিখ<br />
                                খ) অবসর গ্রহণের তারিখ<br />
                                গ) সিভিল পদে নিয়োগ <br /> (পদের নাম ও তারিখসহ)
                            </th>
                            <th rowspan="2" style="width:8%">বর্তমান পদে <br /> নিয়মিত নিয়োগের <br /> তারিখ</th>
                            <th colspan="4" style="width:20%;border-bottom:hidden;">ক্যাডারে প্রথমে এ্যাডহক </th>
                            <th rowspan="2" style="width:11%">
                                মন্তব্য <br />তারিখ-
                            </th>
                        </tr>
                        <tr>
                            <th style="width:5%;border-right: hidden;"></th>
                            <th style="width:5%;border-right: hidden;"></th>
                            <th style="width:5%;border-right: hidden;"></th>
                            <th style="width:5% ;border-right:1px solid #dee2e6;"></th>
                        </tr>
                        <tr>
                            <th>১</th>
                            <th>২</th>
                            <th>৩</th>
                            <th>৪</th>
                            <th>৫</th>
                            <th>৬</th>
                            <th>৭</th>
                            <th>৮(ক)</th>
                            <th>৮(খ)</th>
                            <th>৮(গ)</th>
                            <th>৮(ঘ)</th>
                            <th></th>
                        </tr>
                    </thead>
                    @{
                        var sl = 0;
                    }
                    @foreach (var data in Model.employeeInfoReports)
                    {
                        sl++;
                        <tbody>
                            <tr style="vertical-align:top;page-break-after:always;page-break-inside:avoid;">
                                <td ‍style="padding-left:25px;">@LanguageProcessing.BanglaToEnglishConvert(sl.ToString())।</td>
                                <td>
                                    <span style="font-weight:bold;font-size:1em;">জনাব @data.nameBangla</span><br />
                                    <span>বিপি-</span><span>@LanguageProcessing.BanglaToEnglishConvert(data.BPNumberBn)</span><br />
                                    <span>জন্ম তারিখ : </span><span>@LanguageProcessing.EnlishToBanglaDateConvert(data.dateOfbirth)</span><br />
                                    <span>জন্ম জেলা : </span><span>@data.homeDistrict</span><br />
                                    <span>শিক্ষাগত যোগ্যতা : </span><span>@LanguageProcessing.EnlishToBanglaDegreeConvert(data.educationalQualifaction)</span><br />
                                </td>
                                <td></td>
                                <td style="text-align:center;">@LanguageProcessing.EnlishToBanglaDateConvert(data.joiningDateGovtService)<br />@data.joiningDesignation</td>
                                <td style="text-align:center;">@LanguageProcessing.EnlishToBanglaDateConvert(data.seniorScalePromotionDate)</td>

                                <td></td>
                                <td style="text-align:center;">@data.currentRankNameBn<br />@LanguageProcessing.EnlishToBanglaDateConvert(data.currentPositionJoiningDate)</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td style="text-align:center;"></td>
                            </tr>

                        </tbody>

                    }
                </table>

            </div>
        </div>

    </div>
