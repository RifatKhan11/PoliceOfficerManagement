@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "SearchEmployeeDetails";
    Layout = "~/Views/Shared/_PrintView.cshtml";
}
<!-- Latest compiled and minified CSS -->
<link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">

<!-- Optional theme -->
<link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap-theme.min.css">

<script src="https://code.jquery.com/jquery-2.1.1.min.js"></script>
<!-- Latest compiled and minified JavaScript -->
<script src="//maxcdn.bootstrapcdn.com/bootstrap/3.2.0/js/bootstrap.min.js"></script>
<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet">

@section Style{

    <style>
        body {
            background: #ededed;
        }

        .user-details .user-image {
            width: 100%;
            text-align: center;
        }

        .user-image img {
            clear: both;
            margin: auto;
        }

        .user-details .user-info-block {
            width: 100%;
            top: 55px;
            z-index: 0;
            padding-top: 5px;
            padding-bottom: 5px;
            border-radius: 40px;
            background: #EAEAEA;
            color: black;
            font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif
        }

        .user-info-block .user-heading {
            width: 100%;
            text-align: center;
            margin: 10px 0 0;
        }

        .user-info-block .navigation {
            float: left;
            width: 100%;
            margin: 0;
            padding: 0;
            list-style: none;
            border-bottom: 1px solid #428BCA;
            border-top: 1px solid #428BCA;
        }


        .user-info-block .user-body {
            float: left;
            padding: 5%;
            width: 90%;
        }

        .user-body .tab-content > div {
            float: left;
            width: 100%;
        }

        .user-body .tab-content h4 {
            width: 100%;
            margin: 10px 0;
            color: #333;
        }


        a {
            color: inherit;
            word-break: break-all;
            border-bottom: 1px solid #ccc;
        }

            a:hover {
                color: #ccc;
                text-decoration: none;
                border-bottom-color: currentColor;
            }

        #Education {
        }

        #demo1 {
            text-align: center;
            -webkit-box-shadow: 1px 3px 19px 0px rgba(0,0,0,0.71);
            box-shadow: 1px 3px 19px 0px rgba(0,0,0,0.71);
        }
    </style>

}

<body>


    <div class="container" id="drag">
        <div class="row">
            <div class="col-2">

            </div>
            <div class="col-8">
                <div class="text-center"> <img src="~/images/bd_police.png" style="width:15%" /></div>
                <h3 class="text-center" style="color:black">Bangladesh Police</h3>
                <h2 class="text-center" style="font-size:25px;"><b style="color:black;font-size:45px"> Officer's Portfolio </b></h2>
            </div>
            <div class="col-2"></div>
        </div><br />
        <div class="row" style="background:#ccc; border-radius:30px!important;padding-top: 15px!important;padding-bottom: 15px!important;">
            <div class="col-1"></div>
            <div class="col-3">
                @if (Model.photograph?.url == "" || Model.photograph?.url == null)
                {

                    <img src="http://portfolio.police.gov.bd/images/error/No_image_available.png" style="width:225px;height:225px;" class="img-circle">
                }
                else
                {
                    <img src="http://portfolio.police.gov.bd/@Model.photograph?.url" style="width:225px;height:225px;margin-left: 30PX;" class="img-circle">
                }
            </div>
            <div class="col-6" style="padding-top: 40px;font-family:'Varela Round',sans-serif!important;padding-left: 30px;">
                <h3 style="margin-left:100px; margin-top:10px;color:black;"><b>@Model.employeeInfo?.nameEnglish</b> <br /> @Model.employeeInfo.designations?.designationName,  @Model.employeeInfo?.branch?.branchUnitName</h3>
                <h4 style="margin-left:100px;color:black">@("BP" + Model.employeeInfo?.employeeCode)</h4>
                <h4 style="margin-left:100px;color:black">Batch- @Model.employeeInfo?.bCSBatch?.batchName</h4>
            </div>

        </div>
        <hr />
        <h1 class="pt-2 text-center" style="font-size:25px;">Personal Information</h1>
        <div style="font-size:18px!important;">
            <table class="table table-borderless" style="width:100%">
                <tbody>
                    <tr style="width:100%">
                        <td style="width:15%">Name English</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo?.nameEnglish</td>
                        <td style="width:4%;"></td>
                        <td style="width:10%">Name Bangla</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%;font-size:20px">@Model.employeeInfo?.nameBangla</td>
                    </tr>
                    <tr style="width:100%">
                        <td style="width:15%">Rank</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo.rank?.rankName</td>
                        <td style="width:4%;"></td>
                        <td style="width:10%">Designation</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.designations?.designationName</td>
                    </tr>
                    <tr>
                        <td style="width:15%">Posting Place</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo.section?.Name</td>
                        <td style="width:4%;"></td>
                        <td style="width:10%">Unit</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.branch?.branchUnitName</td>
                    </tr>
                    <tr>
                        <td style="width:15%">Father's Name</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo?.fatherNameEnglish</td>
                        <td style="width:4%"></td>
                        <td style="width:10%">Mother's Name</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.motherNameEnglish</td>
                    </tr>
                    <tr>
                        <td style="width:15%">Marital Status</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo?.maritalStatus</td>
                        <td style="width:4%"></td>
                        <td style="width:10%">Spouse Name</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.spouses.Where(x => x.spouseRelationId == 5)?.FirstOrDefault()?.spouseName</td>
                    </tr>
                    <tr>
                        <td style="width:12%">Gender</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo?.gender</td>
                        <td style="width:4%"></td>
                        <td style="width:10%">Religion</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.religion?.name</td>
                    </tr>
                    <tr>
                        <td style="width:15%">Date of Birth</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo?.dateOfBirth?.ToString("dd-MMM-yyyy")</td>
                        <td style="width:4%"></td>
                        <td style="width:10%">National ID</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.nationalID</td>
                    </tr>
                    <tr>
                        <td style="width:15%">Tribal</td>
                        <td style="width:2%">:</td>@if (@Model.employeeInfo?.tribal == "on")
                        {
                            <td style="width:36%">Yes</td>
                        }
                        else
                        {
                            <td style="width:36%">No</td>
                        }
                        <td style="width:4%"></td>
                        <td style="width:10%">Blood Group</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.bloodGroup</td>
                    </tr>
                    <tr>
                        <td style="width:15%">Height</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo?.height cm</td>
                        <td style="width:4%"></td>
                        <td style="width:10%">Weight</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.weight kg</td>
                    </tr>
                    <tr>
                        <td style="width:15%">Passport No</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo?.passportNo</td>
                        <td style="width:4%"></td>
                        <td style="width:10%">Identification Sign</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.identificationSign</td>
                    </tr>
                    <tr>
                        <td style="width:15%">Driving License</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo?.drivingLicense</td>
                        <td style="width:4%"></td>
                        <td style="width:10%">Ration Id</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.rationId</td>
                    </tr>

                    <tr>
                        <td style="width:15%">Present Address</td>
                        <td style="width:2%">:</td>
                        @if (Model.presentAddress?.thana?.thanaName == null)
                        {
                            <td></td>
                        }
                        else
                        {
                            <td colspan="5">@Model.presentAddress?.addressDetails Union/Ward: @Model.presentAddress?.unionWard?.unionName, Thana: @Model.presentAddress?.thana?.thanaName, District: @Model.presentAddress?.district?.districtName, Division: @Model.presentAddress?.division?.divisionName-@Model.presentAddress?.postCode </td>
                        }
                    </tr>
                    <tr>
                        <td style="width:15%">Permanent Address</td>
                        <td style="width:2%">:</td>
                        @if (Model.parmenantAddress?.thana?.thanaName == null)
                        {
                            <td></td>
                        }
                        else
                        {
                            <td colspan="5">@Model.parmenantAddress?.addressDetails Union/Ward: @Model.parmenantAddress?.unionWard?.unionName, Thana: @Model.parmenantAddress?.thana?.thanaName, District: @Model.parmenantAddress?.district?.districtName, Division: @Model.parmenantAddress?.division?.divisionName-@Model.parmenantAddress?.postCode </td>
                        }

                    </tr>
                    <tr>
                        <td style="width:15%">In-Laws Address</td>
                        <td style="width:2%">:</td>
                        @if (Model.inLawsAddress?.thana?.thanaName == null)
                        {
                            <td></td>
                        }
                        else
                        {
                            <td colspan="5">@Model.inLawsAddress?.addressDetails Union/Ward: @Model.inLawsAddress?.unionWard?.unionName, Thana: @Model.inLawsAddress?.thana?.thanaName, District: @Model.inLawsAddress?.district?.districtName, Division: @Model.inLawsAddress?.division?.divisionName-@Model.inLawsAddress?.postCode </td>
                        }

                    </tr>
                    <tr>
                        <td style="width:15%">Maternal Family Address</td>
                        <td style="width:2%">:</td>
                        @if (Model.meternalAddress?.thana?.thanaName == null)
                        {
                            <td></td>
                        }
                        else
                        {
                            <td colspan="5">@Model.meternalAddress?.addressDetails Union/Ward: @Model.meternalAddress?.unionWard?.unionName, Thana: @Model.meternalAddress?.thana?.thanaName, District: @Model.meternalAddress?.district?.districtName, Division: @Model.meternalAddress?.division?.divisionName-@Model.meternalAddress?.postCode </td>
                        }

                    </tr>
                </tbody>
            </table>
        </div>
        @*<p style="page-break-before: always"></p>*@
        <hr />
        <h2 class="text-center" style="font-size:25px; font-size:25px;">Bank Information</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped text-center">
                    <tr>
                        <td style="width:20%">Salary Bank Account</td>
                        <td style="width:50%;text-align:left">@Model?.employeeInfo?.banks?.bankName</td>
                        <td style="width:30%">@Model?.employeeInfo?.salaryAccountNo</td>
                    </tr>
                    <tr>
                        <td style="width:20%">Other Bank Account</td>
                        <td style="width:50%;text-align:left">@Model?.employeeInfo?.otherBanks?.bankName</td>
                        <td style="width:30%">@Model?.employeeInfo?.otherBankAccountNo</td>
                    </tr>
                </table>
            </div>
        </div>
        <h2 class="text-center" style="font-size:25px; font-size:25px;">Service Information</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped" style="width:100%">
                    <tbody>
                        <tr style="width:100%">
                            <td style="width:15%">Status</td>
                            <td style="width:2%">:</td>
                            <td style="width:36%">@Model.employeeInfo?.pabx</td>
                            <td style="width:10%">Batch</td>
                            <td style="width:2%">:</td>
                            <td style="width:36%">@Model.employeeInfo?.bCSBatch?.batchName</td>
                        </tr>
                        <tr>
                            <td style="width:15%">Joining Date Of Service</td>
                            <td style="width:2%">:</td>
                            <td style="width:36%">@Model.employeeInfo?.joiningDateGovtService?.ToString("dd-MMM-yyyy")</td>
                            <td style="width:10%">Service Period</td>
                            <td style="width:2%">:</td>
                            <td style="width:36%">@Model.employeeInfo?.servicePeriod</td>
                        </tr>
                        <tr>
                            <td style="width:15%">Joining Date of Present Unit</td>
                            <td style="width:2%">:</td>
                            <td style="width:31%">@Model.employeeInfo?.joiningDatePresentWorkstation?.ToString("dd-MMM-yyyy")</td>
                            <td style="width:10%">Date of Retirement</td>
                            <td style="width:2%">:</td>
                            <td style="width:36%">@Model.employeeInfo?.LPRDate?.ToString("dd-MMM-yyyy")</td>

                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <h2 class="text-center" style="font-size:25px; font-size:25px;">Contact Information</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped" style="width:100%">
                    <tbody>
                        <tr>
                            <td style="width:21%">Mobile Number Personal</td>
                            <td style="width:2%">:</td>
                            <td style="width:27%">@Model.employeeInfo?.mobileNumberPersonal</td>
                            <td style="width:21%">Mobile Number Office</td>
                            <td style="width:2%">:</td>
                            <td style="width:27%">@Model.employeeInfo?.mobileNumberOffice</td>
                        </tr>
                        <tr>
                            <td style="width:21%">Email Personal</td>
                            <td style="width:2%">:</td>
                            <td style="width:27%">@Model.employeeInfo?.emailAddressPersonal</td>
                            <td style="width:21%">Email Office</td>
                            <td style="width:2%">:</td>
                            <td style="width:27%">@Model.employeeInfo?.emailAddress</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <h2 class="text-center" style="font-size:25px; font-size:25px;">Social Media</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped" style="width:100%">
                    <tbody>

                        <tr>
                            <td style="width:15%">Instagram</td>
                            <td style="width:2%">:</td>
                            <td style="width:36%">@Model.employeeInfo?.extraActivity</td>
                            <td style="width:10%">Facebook</td>
                            <td style="width:2%">:</td>
                            <td style="width:36%">@Model.employeeInfo?.facebookId</td>
                        </tr>
                        <tr>
                            <td style="width:15%">Twitter</td>
                            <td style="width:2%">:</td>
                            <td style="width:36%">@Model.employeeInfo?.skypeId</td>
                            <td style="width:10%">Linkedin</td>
                            <td style="width:2%">:</td>
                            <td style="width:36%">@Model.employeeInfo?.linkdInId</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <h2 class="text-center" style="font-size:25px; font-size:25px;">Special Quality</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped text-center">
                    <tr>
                        <td style="width:15%">Skills</td>
                        <td style="width:2%">:</td>
                        <td style="width:31%">@Model.employeeInfo?.extraSkill</td>
                        <td style="width:15%">Extra Curricular Activities</td>
                        <td style="width:2%">:</td>
                        <td style="width:36%">@Model.employeeInfo?.extraActivitys</td>
                    </tr>
                </table>
            </div>
        </div>
        <hr />
        <h2 class="text-center" style="font-size:25px;font-size:25px;">Job History</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped">

                    <tr>
                        <th style="text-align:center;width:20%;font-size:15px">Unit</th>
                        <th style="text-align:center;width:10%;font-size:15px">Rank</th>
                        <th style="text-align:center;width:15%;font-size:15px">Joining Date</th>
                        <th style="text-align:center;width: 15%;font-size:15px">Release Date</th>
                        <th style="text-align:center;width:20%;font-size:15px">Reason Of Transfer</th>
                        <th style="text-align:center;width:20%;font-size:15px">Service Period</th>
                    </tr>

                    <tbody>
                        @{
                            int i6 = 1;
                            @foreach (var data in Model.assignments)
                            {
                                var duration = "";
                                var stillServing = "Still Serving";
                                if (data.isDelete == 1)
                                {
                                    var year = (DateTime.Now.Year - Convert.ToDateTime(data.StartDate).Year).ToString();
                                    var month = (DateTime.Now.Month - Convert.ToDateTime(data.StartDate).Month).ToString();
                                    var day = ((DateTime.Now.Day + 1) - Convert.ToDateTime(data.StartDate).Day).ToString();
                                    duration = year + " years " + month + " months " + day + " days";
                                }
                                <tr>
                                    <td style="text-align:center;font-size:15px">@data?.specialBranchUnit?.branchUnitName</td>
                                    <td style="text-align:center;font-size:15px">@data?.rank?.rankName</td>
                                    <td style="text-align:center;font-size:15px">@data?.StartDate?.ToString("dd-MMM-yyyy")</td>
                                    <td style="text-align:center;font-size:15px">
                                        @if (data?.isDelete == 1)
                                        {
                                            @stillServing
                                        }
                                        else
                                        {
                                            @data?.EndDate?.ToString("dd-MMM-yyyy")
                                        }
                                    </td>
                                    <td style="text-align:center;font-size:15px">@data?.Remarks</td>
                                    <td style="text-align:center;font-size:15px">
                                        @if (data?.isDelete == 1)
                                        {
                                            @duration
                                        }
                                        else
                                        {
                                            @data?.servicePeriod
                                        }
                                    </td>
                                </tr>
                                i6++;
                            }
                        }

                    </tbody>
                </table>
            </div>
        </div>
        <br />
        <h2 class="text-center" style="font-size:25px; font-size:25px;">Promotion Information</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped">

                    <tr>
                        <th style="text-align:center;width:20%;font-size:15px">Rank Name</th>
                        <th style="text-align:center;width:20%;font-size:15px">Promotion Date</th>
                        <th style="text-align:center;width:20%;font-size:15px">Joining Date</th>
                        <th style="text-align:center;width:20%;font-size:15px">Reference</th>
                        <th style="text-align:center;width:20%;font-size:15px">Remarks</th>
                    </tr>

                    <tbody>
                        @foreach (var data in Model.promotionLogs)
                        {
                            <tr>
                                <td style="text-align:center;font-size:15px">@data?.rank?.rankName</td>
                                <td style="text-align:center;font-size:15px">@data?.date.ToString("dd-MMM-yyyy")</td>
                                <td style="text-align:center;font-size:15px">@data?.goDate?.ToString("dd-MMM-yyyy")</td>
                                <td style="text-align:center;font-size:15px">@data?.goNumber</td>
                                <td style="text-align:center;font-size:15px">@data?.remark</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <br />
        <h2 class="text-center" style="font-size:25px; font-size:25px;">Educational Information</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped">

                    <tr>
                        <th style="text-align:center;width:10%;font-size:15px">Level of Education</th>
                        <th style="text-align:center;width:10%;font-size:15px">Degree</th>
                        <th style="text-align:center;width:15%;font-size:15px">Group/Subject</th>
                        <th style="text-align:center;width:22%;font-size:15px">Board/University</th>
                        <th style="text-align:center;width:23%;font-size:15px">Institution/College</th>
                        <th style="text-align:center;width:10%;font-size:15px">Passing Year</th>
                        <th style="text-align:center;width:10%;font-size:15px">Result</th>
                    </tr>

                    <tbody>
                        @{
                            int i = 1;
                            @foreach (var data in Model.educationalQualifications)
                            {

                                <tr>
                                    <td style="text-align:center;font-size:15px">@data.degree?.levelofeducation?.levelofeducationName</td>
                                    <td style="text-align:center;font-size:15px">@data.degree?.degreeName</td>
                                    <td style="text-align:center;font-size:15px">@data.reldegreesubject?.subject?.subjectName</td>
                                    <td style="text-align:center;font-size:15px">@data.organization?.organizationName</td>
                                    <td style="text-align:center;font-size:15px">@data.institution</td>
                                    <td style="text-align:center;font-size:15px">@data.passingYear</td>
                                    <td style="text-align:center;font-size:15px">
                                        @if (data.resultId == 1)
                                        {
                                            if (data.grade == "1")
                                            {
                                                <label>First Class</label>
                                            }
                                            else if (data.grade == "2")
                                            {
                                                <label>Second Class</label>
                                            }
                                            else if (data.grade == "3")
                                            {
                                                <label>Third Class</label>
                                            }
                                        }
                                        else if (data.resultId == 2)
                                        {
                                            <label>@data.grade<br /> Out of 4.00</label>
                                        }
                                        else if (data.resultId == 3)
                                        {
                                            <label>@data.grade<br /> Out of 5.00</label>
                                        }
                                        else if (data.resultId == 5)
                                        {
                                            <label>Pass</label>
                                        }
                                    </td>
                                </tr>
                                i++;
                            }
                        }

                    </tbody>
                </table>
            </div>
        </div>
        <br />
        <h2 class="text-center" style="font-size:25px; font-size:25px;">Domestic Training</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped">

                    <tr>
                        <th style="text-align:center;width:15%;font-size:15px">Training Category</th>
                        <th style="text-align:center;width:20%;font-size:15px">Training Title</th>
                        <th style="text-align:center;width:20%;font-size:15px">Training Institute</th>
                        <th style="text-align:center;width:15%;font-size:15px">From Date</th>
                        <th style="text-align:center;width:15%;font-size:15px">To Date</th>
                        <th style="text-align:center;width:15%;font-size:15px">Duration</th>
