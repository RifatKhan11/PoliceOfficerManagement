                    </tbody>
                </table>
            </div>
        </div>

        <br />

        <h2 class="text-center" style="font-size:25px; font-size:25px;">Medical History</h2>
        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-striped">
                    <tr>
                        <th style="text-align:center;width:15%;font-size:15px">Disease</th>
                        <th style="text-align:center;width:10%;font-size:15px">Hospitalised</th>
                        <th style="text-align:center;width:10%;font-size:15px">Under Treatment</th>
                        <th style="text-align:center;width:25%;font-size:15px">Vaccinated</th>
                        <th style="text-align:center;width:10%;font-size:15px">Year</th>
                        <th style="text-align:center;width:20%;font-size:15px">Observaton</th>
                    </tr>
                    <tbody>
                        @{

                            int a1 = 1;
                            @foreach (var data in Model.medicalInfo)
                            {
                                var Hospitalise = "No";
                                var Vaccinated = "No";
                                var UnderTreatment = "No";
                                if (data.isHospitalise == 1)
                                {
                                    Hospitalise = "Yes";
                                }
                                if (data.isDelete == 1)
                                {
                                    Vaccinated = "Yes (" + data.date?.ToString("dd-MMM-yyyy") + ")";
                                }
                                if (data.satatus == 1)
                                {
                                    UnderTreatment = "Yes";
                                }
                                <tr>
                                    <td style="text-align:center;width:15%;font-size:15px">@data?.medicalDisease?.disease?.diseaseName</td>
                                    <td style="text-align:center;width:10%;font-size:15px">@Hospitalise</td>
                                    <td style="text-align:center;width:10%;font-size:15px">@UnderTreatment</td>
                                    <td style="text-align:center;width:25%;font-size:15px">@Vaccinated</td>
                                    <td style="text-align:center;width:10%;font-size:15px">@data?.year</td>
                                    <td style="width:20%;font-size:15px">@data?.lastCheckupHistory</td>
                                </tr>
                                a1++;
                            }
                        }


                    </tbody>
                </table>
            </div>
        </div>

