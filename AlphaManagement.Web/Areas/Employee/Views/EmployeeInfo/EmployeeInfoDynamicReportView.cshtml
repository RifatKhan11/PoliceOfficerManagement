@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_PrintViewPolice.cshtml";
    var baseImageUrl = "http://portfolio.police.gov.bd";
}

<h4 style="text-align:center">Officers' List </h4>


<div class="tab-content mt-4" id="myTabContent">

    <div class="row">
        <div class="col-md-12 col-12">
            <table class="table table-bordered table-striped" style="width:100%" id="tblData">
                <thead>
                    <tr class="text-light  table-sm">
                        <td>Sl No</td>
                        <td>Photo</td>
                        <td>Name</td>
                        <td>BP No</td>
                        <td>Rank</td>
                        <td>Unit</td>
                        <td>Home District</td>
                        <td>Gradation</td>
                        <td>BCS Batch</td>
                        <td>Position</td>

                    </tr>
                </thead>

                <tbody>
                    @{var i = 1;}
                    @foreach (var item in Model.EmployeeReports)
                    {
                        <tr>
                            <td>@i</td>
                            <td><img src="@baseImageUrl/@item.imageUrl" style="width:100px;height:80px;border-radius:50%;" /> </td>
                            <td>@item.nameEnglish</td>
                            <td>@item.employeeCode</td>
                            <td>@item.rank</td>
                            <td>@item.unit </td>
                            <td>@item.homeDistrict </td>
                            <td>@item.gradationNo </td>
                            <td>@item.bcsBatch</td>
                            <td>@item.meritePosition</td>
                        </tr>
                        i++;
                    }

                </tbody>
            </table>

        </div>
    </div>
</div>
