        //// Word File Download
        function export2Word(element) {

            var html, link, blob, url, css;

            css = (
                '<style>' +
                '@@page WordSection1{size: 14in 8.5in;mso-page-orientation: landscape;}' +
                'div.WordSection1 {page: WordSection1;}' +
                'table th{border:1px gray solid;width:5em;padding:2px;vertical-align:top !important;}' +
                'table{border-collapse:collapse;}td{border:1px gray solid;width:5em;padding:2px;}' +
                '</style>'
            );

            html = element.innerHTML;
            blob = new Blob(['\ufeff', css + html], {
                type: 'application/msword'
            });
            url = URL.createObjectURL(blob);
            link = document.createElement('A');
            link.href = url;
            link.download = 'বিসিএস(পুলিশ) ক্যাডারভুক্ত কর্মকর্তাদের খসড়া গ্রেডেশন লিস্ট';  // default name without extension
            document.body.appendChild(link);
            if (navigator.msSaveOrOpenBlob) navigator.msSaveOrOpenBlob(blob, 'বিসিএস(পুলিশ) ক্যাডারভুক্ত কর্মকর্তাদের খসড়া গ্রেডেশন লিস্ট.doc'); // IE10-11
            else link.click();  // other browsers
            document.body.removeChild(link);
        };

