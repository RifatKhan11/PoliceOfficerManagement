    <script>

      

        var index = 1;
        function AddFilter() {

            var key = $('#key').val();
            var value = $('#value').val();
            var text = $('#value :selected').text();
            if (key == "Name" || key == "Bp") {
                value = $('#valueName').val();
                text = $('#valueName').val();
            }

            if (key != '' && value != '') {
                var hrml = '<span id="filter' + index + '" style="margin-right:15px;margin-bottom:5px;margin-left: 20px;"><div class="form-group row clsKeyVal">'
                    + "" +
                    '<input type="text" readonly style="border-radius:5px 0px 0px 5px;height:30.5px;width:300px;" class="form-control col-10 clsStringss" id="stringss' + index + '" value="' + key + '=' + text + '" name="stringss' + index + '">' + "" +
                    '<input type="hidden" id="strKey' + index + '" class="clsKey" value="' + key + '" /><input type="hidden" id="strVal' + index + '" class="clsValue" value="' + value + '" />' +
                    '<input type="text" hidden style="border-radius:5px 0px 0px 5px;height:30.5px;" class="form-control col-10 clsStrings" id="strings' + index + '" value="' + key + '=' + value + '" name="strings' + index + '">'

                    +"" + '<button type="button" style="border-radius: 0px 5px 5px 0px;margin-left: -5px;" id="button' + index + '" onclick="ClearbyID(' + index + ')" class="btn btn-danger btn-sm col-2"><i class="fa fa-times-circle"></i></button></div></span>';

                $('#allFilterString').append(hrml);
                index = index + 1;
            }
            $('#key').val('');
            $('#value').val('');
        }

        function AddRangeFilter() {
            var key = $('#dateKey').val();
            var valueFrom = $('#fromDate').val();
            var valueTo = $('#toDate').val();
            if (key != '' && valueFrom != '' && valueTo != '') {
                var html = '<span id="filter' + index + '" style="margin-right:15px;margin-bottom:5px;margin-left: 20px;"><div class="form-group row clsDateRange">'
                    + "" +
                    '<input type="text" readonly style="border-radius:5px 0px 0px 5px;height:30.5px;width:400px;" class="form-control col-10 clsStrings" id="stringsss' + index + '" value="' + key + '=' + valueFrom + '=' + valueTo + '" name="strings' + index + '">'
                    + "" +
                    '<input type="hidden" id="strDateKey' + index + '" class="clsDateKey" value="' + key + '" /><input type="hidden" id="strDateVal' + index + '" class="clsDFValue" value="' + valueFrom + '" /><input type="hidden" id="strDTVal' + index + '" class="clsDTValue" value="' + valueTo + '" />' +
                    + "" +
                    '<button type="button" style="border-radius: 0px 5px 5px 0px;margin-left: -5px;" id="button' + index + '" onclick="ClearbyID(' + index + ')" class="btn btn-danger btn-sm col-2"><i class="fa fa-times-circle"></i></button></div></span>';
                $('#allFilterString').append(html);
                index = index + 1;
            }
            $('#dateKey').val('');
            $('#fromDate').val('');
            $('#toDate').val('');
        }

        function ClearbyID(indx) {
           $('#allFilterString #filter' + indx).remove();
        }

        function LoadByFilter() {
            var queryString = "";
            var $allStrings = $("#allFilterString").find(".clsStrings");
            $allStrings.each(function () {
                queryString += '|' + $(this).val();
            });
        }


        $(document).ready(function () {

            $('#fromDate').datepicker({ dateFormat: "dd-M-yy", showAnim: "scale", changeMonth: true, changeYear: true, yearRange: "1960:2100" });
            $('#toDate').datepicker({ dateFormat: "dd-M-yy", showAnim: "scale", changeMonth: true, changeYear: true, yearRange: "1960:2100" });
            // $('#allEmployeeListTable').DataTable();
            $("#value").select2();
            $("#key").change(function () {
                $("#value option").remove();
                $("#value").append('<option value="">Select</option>');
                if ($('#key').val() == "HomeDistrict") {
                    $("#value").append('@foreach(var data in Model.districts)
                    { <option value="@data.Id">@data.districtName</option>}')

                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "Disability") {
                    $("#value").append('<option value="Yes">Yes</option><option value="No">No</option>')
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "Gender") {
                    $("#value").append('<option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option>')
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "Name") {
                    $("#valueSelect").hide();
                    $("#valueName").show();
                }
                else if ($('#key').val() == "Bp") {
                    $("#valueSelect").hide();
                    $("#valueName").show();
                }
                else if ($('#key').val() == "MaritalStatus") {
                    $("#value").append(`<option value="Divorced">Divorced</option>
                                                            <option value="Married">Married</option>
                                                            <option value="Separated">Separated</option>
                                                            <option value="Single">Single</option>
                                                            <option value="Widow">Widow</option>
                                                            <option value="Widower">Widower</option>`)
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "PostingStatus") {
                    $("#value").append(`<option value="1">Posting in Home District</option>
                                                            <option value="2">Posting in Spouse Address</option>
                                                            <option value="3">Posting in Maternal Address</option>`)
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "Expertise") {
                    $("#value").append(`<option value="/batch/doctor.png">Doctor</option>
                                        <option value="/batch/engineer.png">Engineer</option>
                                        <option value="/batch/lawyer.PNG">Lawyer</option>
                                        <option value="/batch/pharmacist.png">Pharmacist</option>
                                        <option value="/batch/literature.png">Literature</option>
                                        <option value="Locked">Locked</option>
                                        <option value="UN Mission">UN Mission</option>`)
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "Religion") {
                    $("#value").append('@foreach(var data in Model.religions)
                    { <option value="@data?.Id">@data?.name</option>}')
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "BloodGroup") {
                    $("#value").append(`<option value="A (A+)" selected="">A (A+)</option>
                        <option value = "A (A+)" > A(A +)</option >
                        <option value="A (A-)">A (A-)</option>
                        <option value="B (B+)">B (B+)</option>
                        <option value="B (B-)">B (B-)</option>
                        <option value="O (O+)">O (O+)</option>
                        <option value="O (O-)">O (O-)</option>
                        <option value="AB (AB+)">AB (AB+)</option>
                        <option value="AB (AB-)">AB (AB-)</option>`)
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "Division") {
                    $("#value").append('@foreach(var data in Model.Divisions)
                    { <option value="@data.Id">@data.divisionName</option>}')
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "District") {
                    $("#value").append('@foreach(var data in Model.districts)
                    { <option value="@data.Id">@data.districtName</option>}')
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "Thana") {
                    $("#value").append('@foreach(var data in Model.thanas)
                    { <option value="@data.Id">@data.thanaName</option>}')
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
                else if ($('#key').val() == "Status") {
                    $("#value").append('@foreach(var data in Model.statusInfos)
                    { <option value="@data.Id">@data.statusName</option>}')
                    $("#value").append('<option value="0">Final Submit and Checked by checker</option>')
                    $("#valueSelect").show();
                    $("#valueName").hide();
                }
