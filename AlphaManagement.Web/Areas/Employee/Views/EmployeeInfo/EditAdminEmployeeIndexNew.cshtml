@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "Employee Index";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";
    var baseImageUrl = "http://portfolio.police.gov.bd";
}
<link href="~/plugins/responsive-table/css/rwd-table.min.css" rel="stylesheet" type="text/css" media="screen">
<link href="~/css/dropify.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.11.4/jquery-ui.css" rel="stylesheet" />
<style>

    .zoom {
        transition: transform .2s; /* Animation */
    }

        .zoom:hover {
            transform: scale(1.6); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
        }

    @@media screen and (max-width: 599px) {
        #jobHisListView, #proHisListView, #eduListView, #localTrListView, #forignTrListView, #awardListView, #medicalListView, #frnTrvlListView, #frnTrvlListViewUN, #familyListView, #displinaryListView, #preAddList, #parAddList, #inLawAddList, #spouseAddList {
            display: none;
        }

        #jobHisCardView, #proHisCardView, #eduCardView, #localTrCardView, #forignTrCardView, #awardCardView, #medicalCardView, #frnTrvlCardView, #frnTrvlCardViewUN, #familyCardView, #displinaryCardView, #preAddCard, #parAddCard, #inLowAddCard, #spouseAddCard {
            display: block;
            padding: 0;
            margin: 0;
        }

        #jobhistoryCard, #inLowAddCard, #spouseAddCard, #parAddCard, #preAddCard, #promotionCardView, #eduCard, #domesticCard, #forCard, #awardCard, #medicalCardAdd, #foriegnTrvlCard, #familyCard {
            padding: 0;
            margin: 0;
        }

        #personlDiv {
            margin-top: 140px;
        }

        #fnt {
            font-size: 27px;
        }

        #local-Training-Main-Div, #foreign-Training-Main-Div {
            padding: 0
        }

        #finalBtnDiv {
            margin-bottom: 40px;
        }
    }

    @@media screen and (min-width: 600px) {
        #jobHisListView, #proHisListView, #eduListView, #localTrListView, #forignTrListView, #awardListView, #medicalListView, #frnTrvlListView, #frnTrvlListViewUN, #familyListView, #displinaryListView, #preAddList, #parAddList, #inLawAddList, #spouseAddList {
            display: block;
        }

        #jobHisCardView, #proHisCardView, #eduCardView, #localTrCardView, #forignTrCardView, #awardCardView, #medicalCardView, #frnTrvlCardView, #frnTrvlCardViewUN, #familyCardView, #displinaryCardView, #preAddCard, #parAddCard, #inLowAddCard, #spouseAddCard {
            display: none;
        }
    }

    .mobCardHeader {
        padding: 0;
        padding-top: 5px;
        text-align: center;
        background-color: oldlace;
    }

    .mobCard {
        border-radius: 50%;
        background-color: #2A1067;
        font-size: 23px;
        height: 30px;
        width: 30px;
        color: white;
    }

    .select2-selection__rendered {
        line-height: 31px !important;
    }

    .select2-container .select2-selection--single {
        height: 35px !important;
    }

    .select2-selection__arrow {
        height: 34px !important;
    }


    label.cabinet {
        display: block;
        cursor: pointer;
    }

        label.cabinet input.file {
            position: relative;
            height: 100%;
            width: auto;
            opacity: 0;
            filter: progid:DXImageTransform.Microsoft.Alpha(opacity=0);
            margin-top: -30px;
        }

    #upload-demo {
        width: 500px;
        height: 500px;
        padding-bottom: 25px;
    }

    label.cabinetsign {
        display: block;
        cursor: pointer;
    }

        label.cabinetsign input.file {
            position: relative;
            height: 100%;
            width: auto;
            opacity: 0;
            -moz-opacity: 0;
            filter: progid:DXImageTransform.Microsoft.Alpha(opacity=0);
            margin-top: -30px;
        }

    #upload-demosign {
        width: 300px;
        height: 200px;
        padding-bottom: 25px;
    }

    #postingPlaceId {
        padding-left: 1px;
    }
</style>

<div class="col-md-12 col-12 ">
    <div class="card-header fixed-top" id="heading-0" style="cursor:pointer;background-color:#040158;top: 31px;margin:30px ;padding: 5px;z-index: 991 !important;">
        <h2 class="mb-0 text-center " id="fnt" style="font-family:'Times New Roman';color:white">
            Officer's Portfolio, Bangladesh Police
        </h2>
    </div>
</div>


<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-12">
        <div id="accordion" role="tablist" class="m-b-30">
            <div class="card" id="personlDiv">
                <div class="card-header" id="heading-1" style="cursor:pointer;padding-top:5%">
                    <h5 class="mb-0">
                        <a href="#" class="text-muted">
                            <i class="fa fa-user-circle-o mr-2" style="color:#4B0080"></i>  @Model.fLang.title
                        </a>
                        @if (Model.employeeReturnReasons.Where(x => x.status == 2).Where(x => x.type == 1).FirstOrDefault() != null)
                        {
                            var message = "";
                            @foreach (var data in Model.employeeReturnReasons.Where(x => x.status == 2).Where(x => x.type == 1).ToList())
                            {
                                message += data.reason + " . ";
                            }
                            <span class="text-center text-danger font-weight-bold">Return Reason: @message</span>
                        }
                    </h5>

                </div>

                <div id="collapse-1" class="collapse show">
                    <div class="card-body">
                        <div class="general-label">
                            <form id="FormId" enctype="multipart/form-data">
                                <input type="hidden" id="empId" name="empId" value="@Model.employeeInfo?.Id" />
                                <div class="row">
                                    <div class="card-body">


                                        <div class="row">

                                            <div class="col-xl-6 col-lg-6 col-md-6 col-12">

                                                <div class="form-group row">
                                                    <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.nameBangla <span style="color:red">*</span></label>
                                                    <div class="col-md-8 col-12">
                                                        <input class="form-control" type="text" value="@Model.employeeInfo?.nameBangla" data-parsley-required="true" id="nameBangla" name="nameBangla" readonly>
                                                    </div>
                                                </div>

                                                <div class="form-group row">
                                                    <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.nameEnglish <span style="color:red">*</span></label>
                                                    <div class="col-md-8 col-12">
                                                        <input class="form-control" type="text" value="@Model.employeeInfo?.nameEnglish" data-parsley-required="true" id="nameEnglish" name="nameEnglish" readonly>
                                                        <input type="hidden" id="txtEnglishName" value="@Model.employeeInfo?.nameEnglish" />
                                                    </div>
                                                </div>

                                                <div class="form-group row">
                                                    <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.bpNo <span style="color:red">*</span></label>
                                                    <div class="col-md-8 col-12">
                                                        <input class="form-control" type="text" id="bpNo" data-parsley-required="true" name="bpNo" value="@Model.applicationUser?.bpNo" readonly>
                                                    </div>
                                                </div>

                                                <div class="form-group row">
                                                    <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.rankId <span style="color:red">*</span></label>
                                                    <div class="col-md-8 col-12">
                                                        <input class="form-control" type="text"  data-parsley-required="true" name="rankId" id="rankId" value="@Model.employeeInfo?.rank?.rankName" readonly>

                                                    </div>

                                                </div>

                                                <div class="form-group row">
                                                    <label for="example-search-input" class="col-md-4 col-12 col-form-label">@Model.fLang.dateOfBirth <span style="color:red">*</span></label>
                                                    <div class="col-md-8 col-12">
                                                        <input class="form-control" type="text" id="mdate" data-parsley-required="true" name="dateOfBirth" value="@Model.employeeInfo?.dateOfBirth?.ToString("dd-MMM-yyyy")" readonly>
                                                    </div>
                                                </div>

                                                <div class="form-group row" id="DivPostingPlace">
                                                    <label for="example-search-input" class="col-md-4 col-12 col-form-label">Posting Place</label>
                                                    <div class="col-md-8 col-12">
                                                        <input class="form-control" type="text" id="" data-parsley-required="true" name="" value="@Model.employeeInfo?.section?.Name" readonly>

                                                    </div>
                                                </div>


                                            </div>

                                            <div class="modal fade clsexclude" id="cropImagePop" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                                                <div class="modal-dialog modal-lg">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                            <h4 class="modal-title" id="myModalLabel"></h4>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="row">
                                                                <div class="col-lg-12 col-md-12 col-sm-12 form-inline">
                                                                    <div class="col-lg-7 col-md-7 col-sm-7 p-0 m-0">
                                                                        <div id="upload-demo" class="center-block">

                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-5 col-md-5 col-sm-12 pl-5">
                                                                        <button type="button" id="btnRoute" data-deg="90" class="btn btn-outline-primary btn-sm"><i class="fa fa-rotate-right"></i></button>
                                                                    </div>
                                                                </div>
                                                            </div>


                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                                            <button type="button" id="cropImageBtn" class="btn btn-primary">Crop</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="modal fade clsexclude" id="cropImagePopsign" tabindex="-1" role="dialog" aria-labelledby="myModalLabelsign" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                            <h4 class="modal-title" id="myModalLabelsign"></h4>
                                                        </div>
                                                        <div class="modal-body">
                                                            @*<div id="upload-demosign" class="center-block"></div>*@
                                                            <div class="row">
                                                                <div class="col-lg-12 col-md-12 col-sm-12 form-inline">
                                                                    <div class="col-lg-7 col-md-7 col-sm-7 p-0 m-0">
                                                                        <div id="upload-demosign" class="center-block">

                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-5 col-md-5 col-sm-12 pl-5">
                                                                        <button type="button" id="btnRouteSign" data-deg="90" class="btn btn-outline-primary btn-sm"><i class="fa fa-rotate-right"></i></button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                                            <button type="button" id="cropImageBtnsign" class="btn btn-primary">Crop</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-6 col-lg-6 col-md-6 col-12 clsexclude">
                                                <div class="form-group row">
                                                    <div class="col-md-5 col-12"></div>
                                                    <input type="hidden" id="ImageTypeId" value="0" />
                                                    <div class="col-md-6 col-12">
                                                        @if (Model.photograph?.url == null || Model.photograph == null || Model.photograph?.url == "")
                                                        {
                                                            <img src="@baseImageUrl/logo/PhotoLogo.JPG" style="height:250px;width:260px;border:1px solid #ddd;background-color:#eee;cursor:pointer!important" id="photoPicture" />
                                                            <label class="cabinet center-block">
                                                                <figure>
                                                                    <figcaption style="position: absolute;margin-top: -38px;margin-left: 10px;background: aliceblue;border: 1px solid blanchedalmond;    border-radius: 10px;width: 18px;height: 20px;"><i class="fa fa-camera"></i></figcaption>
                                                                </figure>
                                                                <input type="file" class="item-img file center-block" />
                                                            </label>
                                                        }
                                                        else
                                                        {
                                                            <img src="@baseImageUrl/@Model.photograph?.url" style="height:250px;width:260px;border:1px solid #ddd;background-color:#eee;cursor:pointer!important" alt="" id="photoPicture" />
                                                            <input type="hidden" name="photographID" id="photographID" value="@Model.photograph?.Id" />
                                                            <label class="cabinet center-block">
                                                                <figure>
                                                                    <figcaption class="zoom" style="position: absolute!important;margin-top: -38px!important;margin-left: 10px!important;background: aliceblue;border: 1px solid blanchedalmond;border-radius: 10px;width: 18px;height: 20px;">
                                                                        <i class="fa fa-camera"></i>
                                                                    </figcaption>
                                                                </figure>
                                                                <input type="file" class="item-img file center-block" />
                                                            </label>
                                                        }
                                                        @if (Model.signature?.url == null)
                                                        {
                                                            <img src="@baseImageUrl/logo/signature.png" style="height:60px;width:260px;border:1px solid #ddd;background-color:#eee;cursor:pointer!important" id="picture" />
                                                            <input type="hidden" name="signatureID" id="signatureID" value="@Model.signature?.Id" />
                                                            <label class="cabinetsign center-block" onclick="fnImageType(2)" style="width:30px;">
                                                                <figure>
                                                                    <figcaption class="zoom" style="position: absolute!important;margin-top: -38px!important;margin-left: 10px!important;background: aliceblue;border: 1px solid blanchedalmond;border-radius: 10px;width: 18px;height: 20px;">
                                                                        <i class="fa fa-camera"></i>
                                                                    </figcaption>
                                                                </figure>
                                                                <input type="file" class="item-imgsign file center-block" />
                                                            </label>
                                                        }
                                                        else
                                                        {
                                                            <img src="@baseImageUrl/@Model.signature?.url" style="height:60px;width:260px;border:1px solid #ddd;background-color:#eee;" alt="" id="picture" />
                                                            <input type="hidden" name="signatureID" id="signatureID" value="@Model.signature?.Id" />
                                                            <label class="cabinetsign center-block">
                                                                <figure>
                                                                    <figcaption class="zoom" style="position: absolute!important;margin-top: -38px!important;margin-left: 10px!important;background: aliceblue;border: 1px solid blanchedalmond;border-radius: 10px;width: 18px;height: 20px;">
                                                                        <i class="fa fa-camera"></i>
                                                                    </figcaption>
                                                                </figure>
                                                                <input type="file" class="item-imgsign file center-block" />
                                                            </label>
                                                        }
                                                        <input type="hidden" name="employeeID" id="employeeID" value="@Model.employeeInfo?.Id" />
                                                        <input type="file" id="fileinput" class="d-none" />
                                                        @*<input type="file" id="Photoinput" class="center-block d-none" name="file_photo" />*@
                                                    </div>
                                                    <div class="col-md-1 col-12">

                                                    </div>

                                                </div>
                                            </div>



                                        </div>
                                    </div>


                  
                                </div>
                               
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!--Promotion History-->
            <div class="card">
                <div class="card-header" id="heading-promotion" data-toggle="collapse" data-target="#collapse-promotion" style="cursor:pointer">
                    <h5 class="mb-0">
                        <a class="collapsed text-muted" data-toggle="collapse" href="#collapse-promotion" aria-expanded="false" aria-controls="collapse-promotion">
                            <i class="mdi mdi-radioactive mr-2" style="color:#4B0080"></i>  Promotion Information
                        </a>
                        <span class="float-right text-dark"> <i class="fa fa-chevron-right"></i></span>

                        @if (Model.employeeReturnReasons.Where(x => x.status == 2).Where(x => x.type == 3).FirstOrDefault() != null)
                        {
                            var message = "";
                            @foreach (var data in Model.employeeReturnReasons.Where(x => x.status == 2).Where(x => x.type == 3).ToList())
                            {
                                message += data.reason + " . ";
                            }
                            <span class="text-center text-danger font-weight-bold">Return Reason: @message</span>
                        }
                    </h5>


                </div>
                <div id="collapse-promotion" class="collapse">
                    <div class="card-body">

                        <div class="edit-table">
                            <div class="row">
                                <div class="col-lg-12 col-sm-12">
                                    <div class="card m-b-30">
                                        <div class="card-body">
                                            @*<h5 class="header-title">Edit Table With Button</h5>*@
                                            <div class="">
                                                <a class="btn float-right text-light btn-sm mb-2" style="background-color:#4B0080!important" data-toggle="modal" data-target="#promotion" href="#" data-backdrop="static" data-keyboard="false">Add Promotion Info</a>
                                                <a class="btn float-right text-light btn-sm mb-2" style="background-color:#4b0080;margin-right:10px" title="Refresh" onclick="refreshPromotion('@Model.employeeInfo?.Id')"><i class="fa fa-refresh"></i></a>
                                                <div class="bs-example" id="proHisListView">
                                                    <div class="table-responsive">
                                                        <table class="table" id="my-table">

                                                            <thead>
                                                                <tr>
                                                                    <th>Sl No</th>
                                                                    <th>Rank Name</th>
                                                                    <th>Promotion Date</th>
                                                                    <th>Joining Date</th>
                                                                    <th>Reference</th>
                                                                    <th>Remarks</th>
                                                                    <th class="text-nowrap"></th>


                                                                </tr>
                                                            </thead>
                                                            <tbody id="tblPromotion">
                                                                @{ var l = 1;}
                                                                @foreach (var item in Model.promotionLogs)
                                                                {
                                                                    <tr id="@("pi"+item.Id)">
                                                                        <td>@l</td>
                                                                        <td>@item.rank?.rankName</td>
                                                                        <td>@item.date.ToString("dd-MMM-yyyy")</td>
                                                                        <td>@item.goDate?.ToString("dd-MMM-yyyy")</td>
                                                                        <td>@item.goNumber</td>
                                                                        <td>@item.remark</td>
                                                                        <td class="text-nowrap">
                                                                            <button type="button" onclick="promotionUpdate(@item.Id,'@item.date','@item.rankId','@item.goDate','@item.remark','@item.goNumber')" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                                                            <button type="button" onclick="deletePromotion(@item.Id)" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                                                        </td>
                                                                    </tr>
                                                                    l++;
                                                                }

                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                                <div class="bs-example" id="proHisCardView">
                                                    <div class="col-12 row" id="promotionCardView">
                                                        @{ var proSl = 1;}
                                                        @foreach (var item in Model.promotionLogs)
                                                        {
                                                            <div class="col-12" id="proDel-@item.Id" style="padding:0;margin:0;">
                                                                <div class="card" style="margin-left:-20px;margin-right:-20px;font-size:20px;line-height:normal">
                                                                    <div class="card-header mobCardHeader">
                                                                        <label class="mobCard">@proSl</label>
                                                                    </div>
                                                                    <div class="card-body">
                                                                        <div><b>Rank Name:</b> @item.rank?.rankName</div>
                                                                        <div><b>Promotion Date</b>: @item.date.ToString("dd-MMM-yyyy")</div>
                                                                        <div><b>Joining Date:</b> @item.goDate?.ToString("dd-MMM-yyyy")</div>
                                                                        <div><b>Reference:</b> @item.goNumber</div>
                                                                        <div><b>Remarks:</b> @item.remark</div>
                                                                    </div>
                                                                    <div class="card-footer" style="text-align:center;padding: 0;">
                                                                        <button type="button" onclick="promotionUpdate(@item.Id,'@item.date','@item.rankId','@item.goDate','@item.remark','@item.goNumber')" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button> || <button type="button" onclick="deletePromotion(@item.Id)" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            proSl++;
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!--end row-->
                        </div>

                    </div>
                </div>
            </div>

            <!--Promotion Histroy Modal -->
            <div class="modal fade bd-example-modal-lg" id="promotion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">Promotion Information</h5>
                            <button type="button" class="close" data-dismiss="modal" onclick="promotionClear()" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>

                        <div class="modal-body">
                            <form id="promotionInfo">
                                <input type="hidden" name="empId" id="emId" value="@Model.employeeInfo.Id" />
                                <input type="hidden" name="promotionId" id="promotionId" value="0" />
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <div class="row">
                                    <div class="col-12 row">
                                        <div class="col-md-6 col-12">
                                            <div class="form-group row">
                                                <label for="refName" class="col-sm-4 col-form-label">Promotion Rank<span style="color:red">*</span></label>
                                                <div class="col-sm-8">
                                                    <select class="select2" data-width="100%" id="promotionrankId" name="promotionrankId" data-parsley-required="true">
                                                        <option value="">Select</option>
                                                        @foreach (var item in Model.rank)
                                                        {
                                                            <option value="@item.Id">@item.rankName</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-12">
                                            <div class="form-group row">
                                                <label for="Reference" class="col-sm-4 col-form-label">Reference</label>
                                                <div class="col-sm-8">
                                                    <input type="text" class="form-control" id="reference" name="referenceNum" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 row">
                                        <div class="col-md-6 col-12">
                                            <div class="form-group row">
                                                <label for="PromotionDate" class="col-sm-4 col-form-label">Promotion Date<span style="color:red">*</span></label>
                                                <div class="col-sm-8">
                                                    <input type="text" class="form-control datepicker" id="PromotionDate" name="PromotionDate" data-parsley-required="true">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-12">
                                            <div class="form-group row">
                                                <label for="refOrganization" class="col-sm-4 col-form-label">Joining Date <span style="color:red">*</span></label>
                                                <div class="col-sm-8">
                                                    <input type="text" class="form-control datepicker" id="PromotionjoiningDate" name="PromotionjoiningDate" data-parsley-required="true">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 row">
                                        <div class="col-md-12 col-12">
                                            <div class="form-group row">
