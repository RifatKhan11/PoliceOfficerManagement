        function sameAsPresent(empId) {
            swal({
                title: 'Are you sure?', text: `Save Your Permanent Address As Present Address!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Save!`
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '/Employee/EmployeeInfo/SavePermanentAddressAsPresent',
                        data: { empId: empId, type: 'Present Address' },
                        type: 'GET',
                        success: function (rec) {
                            var union = "";
                            var address = "";
                            if (rec.unionWardId == null || rec.unionWardId == 'undefined' || rec.unionWardId =='null') {
                                union = "";
                            } else {
                                union = rec.unionWard?.unionName;
                            }
                            if (rec.postCode == null || rec.postCode == 'undefined' || rec.postCode == 'null') {
                                rec.postCode = '';
                            }
                            if (rec.addressDetails == null || rec.addressDetails == 'undefined' || rec.addressDetails == 'null') {
                                address = "";
                            }
                            card = `<div class="col-12" id="preAddC-${rec.Id}">
                                                                <div class="card" style="margin-left:-35px;margin-right:-35px;font-size:20px;line-height:normal">
                                                                    <div class="card-body">
                                                                        <div><b>Address:</b> ${address}</div>
                                                                        <div><b>Union/Ward:</b> ${union}</div>
                                                                        <div><b>Thana/Upozila:</b> ${rec.thana.thanaName}</div>
                                                                        <div><b>District:</b> ${rec.district.districtName}</div>
                                                                        <div><b>Division:</b> ${rec.division.divisionName}</div>
                                                                        <div><b>Post Code:</b> ${rec.postCode}</div>
                                                                    </div>
                                                                    <div class="card-footer" style="text-align:center;padding: 0;">
                                                                        <button type="button" onclick="preAddEditOpen()" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button> || <button type="button" onclick="deletePreAdd(${rec.Id})" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                                                    </div>
                                                                </div>
                                                            </div>`;
                            list = `<tr id="preAddL-${rec.Id}">
                                                    <td>${address}</td>
                                                    <td>${rec.division.divisionName}</td>
                                                    <td>${rec.district.districtName}</td>
                                                    <td>${rec.thana.thanaName}</td>
                                                    <td>${union}</td>
                                                    <td>${rec.postCode}</td>
                                                    <td>
                                                        <button class="btn btn-success btn-sm" onclick="preAddEditOpen()"><i class="fa fa-edit"></i></button> || <button type="button" onclick="deletePreAdd(${rec.Id})" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                                    </td>
                                                </tr>`
                            $('#preAddList tbody').empty();
                            $('#preAddList tbody').append(list);
                            $('#preAddCard').empty();
                            $('#preAddCard').append(card);
                            $('#preAddEdit').hide();
                            if (window.matchMedia('(max-width: 600px)').matches) {
                                $('#preAddList').hide();
                                $('#preAddCard').show();
                            }
                            else {
                                $('#preAddList').show();
                                $('#preAddCard').hide();
                            }
                            document.getElementById("perAddCheck").checked = true;
                        }
                    });
                } else if (result.dismiss === 'cancel') {
                    document.getElementById("perAddCheck").checked = false;
                    $('#preAddList').hide();
                    $('#preAddEdit').show();
                    return false;
                }
            });
        }

