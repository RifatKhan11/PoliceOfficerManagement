        })


        function ajaxSpecialBranchUnit(res) {
            //console.log(res);
            $('#jobDivSubbranch').hide();
            $('#jobSubbranchId').val();
            $('#specialBranchUnitId').val("").trigger('change');
            if (res) {
                    if (res.specialBranchUnit != null) {
                        $('#specialBranchUnitId').val(res.specialBranchUnitId).change();
                        //$('#jobSubbranchId').val(res.Id).change();
                        $.get("/global/api/GetSpecialBranchUnitChild/" + res.specialBranchUnitId, function (data) {
                            var options = '<option value="">Select</option>';
                            $('#jobDivSubbranch').show();
                            $.each(data, function (i, item) {
                                options += '<option value="' + item.Id + '">' + item.branchUnitName + '</option>';
                            });
