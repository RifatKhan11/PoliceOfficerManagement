        function DateDifference(firstDate) {
            assdates = moment(new Date(), 'DD-MMM-YYYY');
            strs = moment(firstDate, 'DD-MMM-YYYY');

            var aj = assdates;
            var bj = strs;

            var yearj = aj.diff(bj, 'year');
            bj.add(yearj, 'years');

            var monthj = aj.diff(bj, 'months');
            bj.add(monthj, 'months');

            var dayj = aj.diff(bj, 'days') + 1;
            var result = yearj + ' years ' + monthj + ' months ' + dayj + ' days';
            return result;
