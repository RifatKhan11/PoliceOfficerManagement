            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: "/Employee/EmployeeInfo/DeleteMedicalInfoById/",
                        type: 'GET',
                        data: { id: id },
                        success: function (response) {
                            if (response == "Success") {
                                swal({
                                    title: 'Success!', text: `Deleted Successfully!`, type: 'success', confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                                }).then(function () {
                                    $('#md' + id).remove();
