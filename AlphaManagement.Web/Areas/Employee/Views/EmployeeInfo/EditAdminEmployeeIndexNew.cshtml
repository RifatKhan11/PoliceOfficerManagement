    <script type="text/javascript">



        $('.card-header').click(function () {
            $(this).find('i').toggleClass(' fa-chevron-down')
        });

         $("#resultId").change(function(){
          var resultType= $(this).val();
            if(resultType==1){
                $("#dropDownResultDiv").show();
               $("#GradeTextResultDiv").hide();
            }
            else if (resultType == 2 || resultType==3) {

                $("#dropDownResultDiv").hide();
                $("#GradeTextResultDiv").show();
            }
            else{
               $("#dropDownResultDiv").hide();
                $("#GradeTextResultDiv").hide();
            }
        })


        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
             var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (month < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }

        function formatDate2(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (month == 1) { month = "Jan" } else if (month == 2) { month = "Feb" }else if (month == 3) { month = "Mar" }else if (month == 4) { month = "Apr" }else if (month == 5) { month = "May" }else if (month == 6) { month = "Jun" }else if (month == 7) { month = "Jul" }else if (month == 8) { month = "Aug" }else if (month == 9) { month = "Sep" }else if (month == 10) { month = "Oct" }else if (month == 11) { month = "Nov" }else if (month == 12) { month = "Dec" }
            return day + "-" + month + "-" + year
        }

        function Edit(Id, spouseRelationId, spouseName, fatherName, motherName, bloodGroup, maritalStatus, districtId, birthCertificate, dateOfBirth, email, occupation, remarks, contact)
        {
            var dob = '';
            if (dateOfBirth != "") {
                if (dateOfBirth != "null") {
                    dob = formatDate2(dateOfBirth);
                }
            }
            $('#spouseId').val(Id);
            $('#spouseRelationId').val(spouseRelationId);
            $('#spouseRelationId').trigger('change');
            $('#Name').val(spouseName);
            $('#fatherName').val(fatherName);
            $('#motherName').val(motherName);
            $('#spouseBloodGroup').val(bloodGroup);
            $('#spouseBloodGroup').trigger('change');
            $('#spouseMaritalStatus').val(maritalStatus);
            $('#spouseMaritalStatus').trigger('change');
            $('#spousedistrictId').val(districtId);
            $('#spousedistrictId').trigger('change');
            $('#birthCertificate').val(birthCertificate);
            $('#spouseDateOfBirth').val(dob);
            $('#email').val(email);
            $('#occupation').val(occupation);
            $('#description').val(remarks);
            $('#mobile').val(contact);
            $('#exampleModal').modal('show');
        }


        var JobSectionIdGlobal = 0;
        function jobHistoryUpdate(Id, specialBranchUnitId, rankId, Remarks, StartDate, EndDate, servicePeriod,secId,running) {
            $('#empJobHistoryId').val(Id);

            JobSectionIdGlobal = secId;

            if (Remarks != null) {
                $('#reasonofTransfer').val(Remarks);
                $('#reasonofTransfer').trigger('change');
            }
            if (servicePeriod != '' || servicePeriod != "null") {
                $('#jobServicePeriod').val(servicePeriod);
            }
            if (EndDate != '') {
                if (EndDate != "null") {
                    $('#AssignresignDate').val(formatDate2(EndDate));
                }
            }
            if (StartDate != '') {
                if (StartDate != "null") {
                    $('#AssignjoiningDate').val(formatDate2(StartDate));
                }
            }
            
          
            $('#ranksId').val(rankId);
            $('#ranksId').trigger('change');
            $('#JobHistroy2').modal({ show: true,backdrop: 'static', keyboard: false});
            $('#jobDivSubbranch').hide();
            $('#jobSubbranchId').val();
            $('#specialBranchUnitId').val(specialBranchUnitId).trigger('change');
            Common.Ajax('GET', '/MasterData/SpecialBranchUnit/GetSpecialBranchUnit/' + specialBranchUnitId, [], 'json', ajaxSpecialBranchUnit, false);

            Common.Ajax('GET', '/global/api/GetPostingPlaceBySpecialBarnchId/' + specialBranchUnitId, [], 'json', ajaxPostingPlaceJob, false);


            //$.get("/MasterData/SpecialBranchUnit/GetSpecialBranchUnit/" + specialBranchUnitId, function (data) {
            //    alert(data);
            //});

        }

        function clearJobHistoryModal() {
            $('#empJobHistoryId').val('0');
            $('#jobSpecialBranchUnitIdFinal').val('');
            $('#specialBranchUnitId').val('');
            $('#specialBranchUnitId').trigger('change');
            $('#jobSubbranchId').val('');
            $('#jobSubbranchId').trigger('change');
            $('#jobDivSubSubbranch').val('');
            $('#jobDivSubSubbranch').trigger('change');
            $('#secId').val('');
            $('#secId').trigger('change');
            $('#ranksId').val('');
            $('#ranksId').trigger('change');
            $('#AssignjoiningDate').val('');
            $('#AssignresignDate').val('');
            $('#reasonofTransfer').val('');
            $('#reasonofTransfer').trigger('change');
            $('#jobServicePeriod').val('');
            document.getElementById('jobRunningCheckBox').checked = false;
        }

