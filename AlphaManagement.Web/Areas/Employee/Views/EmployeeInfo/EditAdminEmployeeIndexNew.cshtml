        $('.diseaseArr').click(function () {
            var diasesId = $(this).val();
            var tbl = $('#diseaseTbl tbody');
            var diseaseName = '';
            var data = '';
            $.ajax({
                url: "/Employee/EmployeeInfo/GetDiseasesInfoById/",
                type: 'GET',
                async: false,
                data: { id: diasesId },
                success: function (response) {
                    diseaseName = response.diseaseName;
                }
            })
            data = `<tr id="diseaseTr${diasesId}">
                           <td>${diseaseName}<input type="hidden" name="diseaseIdArr" id="diases${diasesId}" value="${diasesId}"><input type="hidden" name="medicalIdArr" id="medical${diasesId}" value="0"></td>
                           <td><input type="checkbox" id="isHospitalised${diasesId}" onclick="checkHospitalised(${diasesId})">
                                <input type="hidden" name="isHospitalisedArr" id="isHospitalisedArr${diasesId}" value="0"></td>
                           <td><input type="checkbox" id="isUnderTreat${diasesId}" onclick="checkUnderTreatment(${diasesId})">
                                <input type="hidden" name="isUnderArr" id="isUnderArr${diasesId}" value="0"></td>
                           <td><input type="checkbox" id="isVaccinated${diasesId}" onclick="checkVaccinedted(${diasesId})">
                                <input type="hidden" name="isVaccinatedArr" id="isVaccinatedArr${diasesId}" value="0"></td>
                           <td><input type="text" class="form-control form-control-sm" style="width:100px" readonly name="vaccinatedDateArr" id="vaccinatedDate${diasesId}"></td>
                           <td>
                                <select id="diseasesYear${diasesId}" name="yearArr" class="select2 form-control form-control-sm mb-3 custom-select" style="width: 80px;">
                                        <option value="">Select</option>
                                        @for(int i = 1990; i < 2030; i++)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                </select>
                            </td>
                            <td>
                                <textarea class="form-control" name="observationArr" id="underObservaton"></textarea>
                            </td>
                        </tr>`;
            var check = $(`#diases${diasesId}`).val();
            var tblLeanth = $('#diseaseTbl tbody tr')
            if (tblLeanth.length >= 0) {
                $('#diseaseTbl').show();
                if (check == diasesId) {
                    $('#diseaseTr' + diasesId).remove();
                }
                else {
                    tbl.append(data);
                    $('#vaccinatedDate' + diasesId).bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });

                }
            }
            else {
                $('#diseaseTbl').hide();
            }
        });

