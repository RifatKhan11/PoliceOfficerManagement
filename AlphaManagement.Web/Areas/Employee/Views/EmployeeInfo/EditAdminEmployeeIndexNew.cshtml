                    }
                }
            });


            $("#AssignjoiningDate, #AssignresignDate").change(function () {

                var strs = $('#AssignjoiningDate').val() == '' ? new Date() : $('#AssignjoiningDate').val();
                var assdates = $('#AssignresignDate').val() == '' ? new Date() : $('#AssignresignDate').val();
                var newStrDate = new Date(formatDate2(strs)).toISOString();
                var newEndDate = new Date(formatDate2(assdates)).toISOString();
                if (newStrDate > newEndDate) {
                    swal('', 'Joining Date Must Be Older Than Release Date', 'warning').then(function () {
                        $('#AssignresignDate').val('');
                        $('#AssignjoiningDate').val('');
                        $('#jobServicePeriod').val('');
                    })
                }
                if (strs == '' || assdates == '') {
                    return false;
                }

                if (/^\d{2}\-\D{0,3}\-\d{4}$/i.test(strs)) {
                    var parts = strs.split("-");
                    var m = 0;
                    if (parts[1] == "Jan") { m = 1; } else if (parts[1] == "Feb") { m = 2; } else if (parts[1] == "Mar") { m = 3; } else if (parts[1] == "Apr") { m = 4; } else if (parts[1] == "May") { m = 5; } else if (parts[1] == "Jun") { m = 6; } else if (parts[1] == "Jul") { m = 7; } else if (parts[1] == "Aug") { m = 8; } else if (parts[1] == "Sep") { m = 9; } else if (parts[1] == "Oct") { m = 10; } else if (parts[1] == "Nov") { m = 11; } else if (parts[1] == "Dec") { m = 12; }
                    var day = parts[0] && parseInt(parts[0], 10);
                    var month = m;
                    var year = parts[2] && parseInt(parts[2], 10);
                    var duration = 59;
                    if (day <= 31 && day >= 1 && month <= 12 && month >= 1) {

                        if (assdates == '' || assdates == null || assdates == 'undefined') {
                            assdates = moment();
                        } else {
                            assdates = moment(assdates, 'DD-MMM-YYYY');
                        }

                        if (strs == '' || strs == null || strs == 'undefined') {
                            strs = moment(new Date(),'DD-MMM-YYYY');
                        } else {
                            strs = moment(strs, 'DD-MMM-YYYY');
                        }
                        //var expiryDate = new Date();

                        var aj = assdates;
                        var bj = strs;

                        var yearj = aj.diff(bj, 'year');
                        bj.add(yearj, 'years');

                        var monthj = aj.diff(bj, 'months');
                        bj.add(monthj, 'months');

                        var dayj = aj.diff(bj, 'days')+1;
                        $("#jobServicePeriod").val(yearj + ' years ' + monthj + ' months ' + dayj + ' days');

                    } else {
                        // display error message
                    }
                }
            });

            $("#localTrStDate, #localTrEdDate").change(function () {

                var str = $('#localTrStDate').val() == '' ? new Date() : $('#localTrStDate').val();
                var assdate = $('#localTrEdDate').val() == '' ? new Date() : $('#localTrEdDate').val();;

