        function promotionInfoByEmpList(res) {
            var promotion = "";
            var promotionCard = "";
            var remarks = " ";
            $.each(res, function (key, value) {
                var proStDate = '';
                var proEdDate = '';
                var refNum = '';
                if (value.date != null) {
                    proStDate = formatDate2(value.date);
                }
                if (value.goDate != null) {
                    proEdDate = formatDate2(value.goDate);
                }
                if (value.remark != null) {
                    remarks = value.remark;
                }
                if (value.goNumber != null) {
                    refNum = value.goNumber;
                }
                promotion += `<tr id="pi${value.Id}">
                    <td>${key + 1}</td>
                    <td>${value.rank.rankName}</td>
                    <td>${proStDate}</td >
                    <td>${proEdDate}</td >
                    <td>${refNum}</td >
                    <td>${remarks}</td>
                        <td>
                         <button type="button" onclick="promotionUpdate(${value.Id},'${proStDate}','${value.rankId}','${proEdDate}','${remarks}','${refNum}')" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                          <button type="button" onclick="deletePromotion(${value.Id})" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                       </td>
                        </tr>`
                promotionCard += `<div class="col-12" id="proDel-${value.Id}">
                                    <div class="card" style="margin-left:-35px;margin-right:-35px;font-size:20px;line-height:normal">
                                        <div class="card-header mobCardHeader">
                                            <label class="mobCard">${key + 1}</label>
                                        </div>
                                        <div class="card-body">
                                            <div><b>Rank Name:</b> ${value.rank.rankName}</div>
                                            <div><b>Promotion Date</b>: ${proStDate}</div>
                                            <div><b>Joining Date:</b> ${proStDate}</div>
                                            <div><b>Reference:</b> ${refNum}</div>
                                            <div><b>Remarks:</b> ${remarks}</div>
                                        </div>
                                        <div class="card-footer" style="text-align:center;padding: 0;">
                                            <button type="button" onclick="promotionUpdate(${value.Id},'${proStDate}','${value.rankId}','${proEdDate}','${remarks}','${refNum}')" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button> || <button type="button" onclick="deletePromotion(${value.Id})" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                        </div>
                                    </div>
                                </div>`
            });
            $('#tblPromotion').empty();
            $('#tblPromotion').append(promotion);
            $('#promotionCardView').empty();
            $('#promotionCardView').append(promotionCard);
            $('#promotionId').val(0);
        };

