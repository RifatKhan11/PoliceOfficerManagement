        function medicalInfoUpdate(id, date, year,isDelete, isVaccineted, isHospitalise,observation) {
            if (date != '') {
                if (date != "null") {
                    $('#vaccinatedDate').val(formatDate2(date));
                    $('#vaccinatedDateDiv').show();
                }
            }
            if (isDelete == 1) {
                document.getElementById("isDelete").checked = true;
            }
            if (isVaccineted == 1) {
                document.getElementById("isVaccinated").checked = true;
            }
            else {
                document.getElementById("isVaccinated").checked = false;
                $('#vaccinatedDateDiv').hide();
            }
            if (isHospitalise == 1) {
                document.getElementById("isHospitalised").checked = true;
                $('#diseasesYear').val(year);
                $('#diseasesYear').trigger('change');
            }
            else {
                document.getElementById("isHospitalised").checked = false;
                $('#diseasesYear').val('');
                $('#diseasesYear').trigger('change');
            }
            $.ajax({
                url: '@Url.Action("GetDiseasesInfoByMedicalId", "EmployeeInfo", new { area = "Employee" })',
                type: 'GET',
                dataType: 'json',
                data: { id: id}
            })
            .done(function (response) {
                if (response != null) {
                    document.getElementsByClassName("diseaseArr").checked = true;
                    $.each(response, function (i, v) {
                        document.getElementById("diseases-"+v.diseaseId).checked = true;
                    })
                }
                else {

                }
            })
            $('#empMedicalId').val(id);
            $('#underObservaton').val(observation);
            $('#medical-Modal').modal('show');
        }

