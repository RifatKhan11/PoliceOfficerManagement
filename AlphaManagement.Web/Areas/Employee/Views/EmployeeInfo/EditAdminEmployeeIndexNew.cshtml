        function educationInfoByEmpList(res) {
            var edu = "";
            var eduCard = "";
            $.each(res, function (key, item) {
                var results = '';
                var institute = '';
                var group = '';
                var university = '';
                if (item.resultId == '1')
                {
                    if (item.grade == '1')
                    {
                        results = 'First Class';
                    }
                    else if (item.grade == '2')
                    {
                        results = 'Second Class';
                    }
                    else if (item.grade == '3')
                    {
                        results = 'Third Class';
                    }
                }
                else if (item.resultId == 2)
                {
                    results = `${item.grade} out of 4.00`;
                }
                else if (item.resultId == 3)
                {
                    results = `${item.grade} out of 5.00`;
                }
                else if (item.resultId == 5)
                {
                    results = 'Pass';
                }
                if (item.institution!=null) {
                    institute = item.institution;
                }
                if (item.reldegreesubject!=null) {
                    group = item.reldegreesubject ?.subject ?.subjectName;
                }
                if (item.organization!=null) {
                    university = item.organization ?.organizationName;
                }
                edu += `<tr id="eduId${item.Id}">
                    <td>${key+1}</td>
                    <td>${item.degree.levelofeducation.levelofeducationName}</td>
                    <td>${item.degree.degreeName}</td>
                    <td>${group}</td>
                    <td>${university}</td>
                    <td>${institute}</td>
                    <td>${item.passingYear}</td>
                    <td>${results}</td>
                    <td>
                        <button type="button" onclick="educationUpdate( ${item.Id},'${item.degree ?.levelofeducationId}','${item.degreeId}','${item.reldegreesubjectId}','${item.organizationId}','${institute}','${item.resultId}','${item.passingYear}','${item.grade}')" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                        <button type="button"  onclick="deleteEducation(${item.Id})" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                    </td>
                    </tr>`
                eduCard+=`<div class="col-12" id="eduCard-${item.Id}">
                            <div class="card" style="margin-left:-35px;margin-right:-35px;font-size:20px;line-height:normal">
                                <div class="card-header mobCardHeader">
                                    <label class="mobCard">${key+1}</label>
                                </div>
                                <div class="card-body">
                                    <div><b>Level of Education:</b> ${item.degree.levelofeducation.levelofeducationName}</div>
                                    <div><b>Degree</b>: ${item.degree.degreeName}</div>
                                    <div><b>Group/Subject:</b> ${group}</div>
                                    <div><b>Board/University:</b> ${university}</div>
                                    <div><b>Institution:</b> ${institute}</div>
                                    <div><b>Year:</b> ${item.passingYear}</div>
                                    <div>
                                        <b>Result:</b> ${results}
                                    </div>
                                </div>
                                <div class="card-footer" style="text-align:center;padding: 0;">
                                    <button type="button"  onclick="educationUpdate( ${item.Id},'${item.degree ?.levelofeducationId}','${item.degreeId}','${item.reldegreesubjectId}','${item.organizationId}','${item.institution}','${item.resultId}','${item.passingYear}','${item.grade}')" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button> || <button type="button" onclick="deleteEducation(${item.Id})" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                </div>
                            </div>
