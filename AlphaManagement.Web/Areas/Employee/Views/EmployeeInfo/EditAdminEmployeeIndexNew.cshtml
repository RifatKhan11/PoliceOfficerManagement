                }
                else {
                    end ='Still Serving'
                }
                if (value.servicePeriod != null) {
                    servicePre = value.servicePeriod;
                }
                if (value.Remarks != null) {
                    remark = value.Remarks;
                }
                if (value.sectionName != null) {
