            });
            //alert(queryString);
            //return false;
            $('#tbEmplist').empty();
            $('#allEmployeeListTable').DataTable().destroy();
            $.get("/Employee/EmployeeInfo/GetEmployeeInfos?queryString=" + queryString, function (data) {
                var employeeList = "";

                var baseImageUrl = "http://portfolio.police.gov.bd/";
                $.each(data, function (key, v) {
                    var imageUrl = "";
                    var img = '<img src="~/logo/defaultprofile.jpg" style="width:150px;height:150px;" class="img - fluid" alt="" />';
                    if (v.imageUrl !== null) {
                        imageUrl = baseImageUrl + v.imageUrl;
                        img = `<img src="${imageUrl}" class="img-fluid rounded-circle" style="width:150px;height:150px;" alt="No Image"/>`
                    }
                    employeeList += `<tr id="fiId${v.employeeId}">
                        <td>${key + 1}</td>
                        <td>${img} </td>
                        <td>${v.nameEnglish}</td>
                        <td>${v.employeeCode}</td>
                        <td>${v.unit}</td>
                        <td>${v.rank}</td>
                        <td>${v.bcsBatch}</td>
                        <td>${v.meritePosition}</td>
                        <td>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=${v.employeeId}')"  target="_blank"  title="Details"><i class="mdi mdi-account-card-details"></i></a>
                        </td>
                       </tr>`;
                });

                $('#tbEmplist').empty();
                $('#tbEmplist').append(employeeList);
                $('#allEmployeeListTable').DataTable().destroy();
                $('#allEmployeeListTable').DataTable();
            });


        }
        
