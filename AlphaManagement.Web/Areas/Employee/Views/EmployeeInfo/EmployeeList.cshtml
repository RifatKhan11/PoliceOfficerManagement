        function LoadByFilterOnThisPage() {
            var itemDetails = [];
            $("#allFilterString").find('.clsKeyVal').each(function () {
                itemDetails.push({
                    colName: $(this).find('.clsKey').val(),
                    colValue: $(this).find(".clsValue").val()
                });
            });

            $("#allFilterString").find('.clsDateRange').each(function () {
                itemDetails.push({
                    colName: $(this).find('.clsDateKey').val(),
                    fromDate: $(this).find(".clsDFValue").val(),
                    toDate: $(this).find(".clsDTValue").val(),
                });
            });
            var allTrx = new Object();
            allTrx.itemDetails = itemDetails;
            $.ajax({
                url: '/Employee/EmployeeInfo/GetMultipleEmployeeInfos',
                type: 'Post',
                data: allTrx
            })
                .done(function (data) {
                    var total = data.length;
                    if (total > 0) {
                        ajaxGetMultipleSearchResult(data);
                    }
                    else {
                        
                        $('#tbEmplist').empty();
                        $('#allEmployeeListTable').DataTable().destroy();
                        swal('Sorry!!', 'No data found!!', 'warning');
                    }
                })
                .fail(function () {
                    swal('Sorry!!', 'Unable to data load!!', 'warning');
                    $('#myDivloader').hide();
                    $('#legalWeaponTable').show();
                });
        }

        function ajaxGetMultipleSearchResult(data) {
            var employeeList = "";
            $('#tbEmplist').empty();
            $('#allEmployeeListTable').DataTable().destroy();
            var baseImageUrl = "http://portfolio.police.gov.bd/";
            $.each(data, function (key, v) {
                var imageUrl = "";
                var img = '<img src="~/logo/defaultprofile.jpg" style="width:100px;height:100px;" class="img-fluid" alt="" />';
                if (v.imageUrl !== null) {
                    imageUrl = baseImageUrl + v.imageUrl;
                    img = `<img src="${imageUrl}" class="img-fluid rounded-circle" style="width:100px;height:100px;" alt="No Image p-0 m-0"/>`
                }
                employeeList += `<tr id="fiId${v.employeeId}">
                        <td>${key + 1}</td>
                        <td>${img} </td>
                        <td>${v.nameEnglish}</td>
                        <td>${v.employeeCode}</td>
                        <td>${v.unit}</td>
                        <td>${v.rank}</td>
                        <td>${v.homeDistrict}</td>
                        <td>${v.gradationNo}</td>
                        <td>${v.bcsBatch}</td>
                        <td>${v.meritePosition}</td>
                        <td>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=${v.employeeId}')"  target="_blank"  title="Details"><i class="mdi mdi-account-card-details"></i></a>
                        </td>
                       </tr>`;
            });

            $('#tbEmplist').empty();
            $('#tbEmplist').append(employeeList);
            $('#allEmployeeListTable').DataTable().destroy();
            $('#allEmployeeListTable').DataTable();
        }

