<div class="card-body" style="display:block;">

    <form>
        <div class="row">
            <div class="col-5 card" style="padding: 15px 15px 10px 25px;">
                <div class="form-group row">
                    <h6 class="m-0 font-weight-bold text-primary">Select Value For Query</h6>
                </div>

                <div class="form-group row">
                    <label for="key" class="col-sm-3 col-form-label">Key</label>
                    <div class="col-sm-8">
                        <select class="form-control" id="key" value="" name="key">
                            <option value="">Select</option>
                            <option value="Bp">BP Number</option>
                            <option value="Name">Name</option>
                            <option value="unit">Unit</option>
                            <option value="rank">Rank</option>
                            <option value="batch">Batch</option>
                            <option value="Expertise">Expertise</option>
                            <option value="Gender">Gender</option>
                            <option value="MaritalStatus">Marital Status</option>
                            <option value="Religion">Religion</option>
                            <option value="BloodGroup">Blood Group</option>
                            <option value="Degree">Degree</option>
                            <option value="University">Board/University/Institution</option>
                            <option value="HomeDistrict">Home District</option>
                            <option value="SpouseHomeDistrict">Spouse Home District</option>
                            <option value="Status">Status</option>
                            <option value="PostingStatus">Posting Status</option>
                        </select>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="value" class="col-sm-3 col-form-label">Value</label>
                    <div class="col-sm-8">
                        <span id="valueSelect"><select class="form-control" id="value" name="value"></select></span>
                        <input class="form-control" id="valueName" name="value" style="display:none" />
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-sm-12">
                        <button type="button" onclick="AddFilter()" class="btn btn-success btn-sm" style="float:right;"><i class="fa fa-plus"></i></button>
                    </div>
                </div>
            </div>

            <div class="col-5 card" style="padding: 15px 15px 10px 25px;">
                <div class="form-group row">
                    <h6 class="m-0 font-weight-bold text-primary">Date Range For Query</h6>
                </div>

                <div class="form-group row">
                    <label for="dateKey" class="col-sm-3 col-form-label">Key</label>
                    <div class="col-sm-9">
                        <select class="form-control" id="dateKey" value="" name="dateKey">
                            <option value="">Select</option>
                            <option value="dateOfBirth">Date of Birth</option>
                            <option value="joiningDatePresentWorkstation">Date of Joining of Present Unit</option>
                            <option value="LPRDate">Date of Retirement</option>
                            <option value="dateOfPermanent">Joining Date of Service</option>
                            <option value="dateOfPromotion">Joining Date of Promotion</option>
                            <option value="ServiceFromDate">Service Joining Date</option>
                            <option value="ServiceToDate">Service Release Date</option>
                            <option value="TrainingFromDate">Training From Date</option>
                            <option value="TrainingToDate">Training To Date</option>
                            <option value="UNStart">UN Mission Start Date</option>
                            <option value="UNEnd">UN Mission End Date</option>
                            <option value="ForignStart">Foreign Travel Start Date</option>
                            <option value="ForignEnd">Foreign Travel End Date</option>
                            <option value="awardDate">Award Date</option>
                        </select>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="fromDate" class="col-sm-3 col-form-label">Date From</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="fromDate" readonly placeholder="From Date" value="" name="fromDate" />
                    </div>
                    <label for="fromDate" class="col-sm-1 col-form-label text-center">To</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="toDate" readonly value="" placeholder="To Date" name="toDate" />
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-sm-12">
                        <button type="button" onclick="AddRangeFilter()" class="btn btn-success btn-sm" style="float:right;"><i class="fa fa-plus"></i></button>
                    </div>
                </div>
            </div>

            <div class="col-2 card" style="padding: 43px 12px 7px 20px;">
                <div class="form-group row">
                    <div class="col-sm-6">
                        <button type="button" onclick="LoadByFilterOnThisPage()" class="btn btn-success mt-lg-5"><i class="fa fa-search"></i> Load</button>
                    </div>
                    <div class="col-sm-6">
                        <button type="button" onclick="LoadByFilterOnThisPagePrint()" class="btn btn-primary mt-lg-5"><i class="fa fa-search"></i> Print </button>
                    </div>
                </div>
            </div>

            <div class="col-12 card">
                <div class="form-group row" id="allFilterString"></div>
            </div>

        </div>
    </form>
    <div class="row">


        <div class="card-body">
            <table class="table table-striped table-bordered" style="width:100%;" id="allEmployeeListTable">
                <thead>
                    <tr>
                        <td>Sl.</td>
                        <td>Photo</td>
                        <td>Name</td>
                        <td>BP Number</td>
                        <td>Unit</td>
                        <td>Rank</td>
                        <td>Home District</td>
                        <td>Gradation</td>
                        <td>BCS Batch</td>
                        <td>Position</td>
                        <td>Action</td>
                    </tr>
                </thead>
                <tbody id="tbEmplist"></tbody>
            </table>
        </div>
    </div>



</div>




