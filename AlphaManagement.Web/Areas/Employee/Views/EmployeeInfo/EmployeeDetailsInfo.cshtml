@{
    ViewData["Title"] = "Employee Info";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row p-4">
    <h3>Employee Details Search</h3>
    <div class="col-12 row">
        <label class="col-3 col-form-label">Select Batch</label>
        <select class="col-3 form-control" id="bcsBatch">
            <option value="">Select</option>
            @foreach (var item in Model.bCSBatch)
            {
                <option value="@item.Id">@item.batchName</option>
            }
        </select>
        <div class="col-6 row pl-5">
            <a href="javascript:void(0)" class="btn btn-success" onclick="searchAllEmployee()"><i class="fa fa-search"></i></a>
            <a href="javascript:void(0)" class="btn btn-danger ml-3" onclick="pdfAllEmployee()"><i class="fa fa-download"></i></a>
            <a href="javascript:void(0)" class="btn btn-info ml-3" onclick="excelAllEmployee()"><i class="fa fa-file-excel-o"></i></a>
        </div>
    </div>
    <div class="col-12 row pt-4" style="height:1000px;overflow-y:scroll">
        <table class="table" id="tblData">
            <thead>
                <tr style="width:100%">
                    <th width="7%">নং</th>
                    <th width="21%">নাম ও বিপি নম্বর</th>
                    <th width="21%">পিতা ও মাতার নাম</th>
                    <th width="21%">বর্তমান কর্মস্থল</th>
                    <th width="30%">স্থায়ী ঠিকানা</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {

            $('#tblData').DataTable();
        })
        function searchAllEmployee() {
            bcsBatch = $('#bcsBatch').val();
            if (bcsBatch != '') {
                Common.Ajax('GET', '/Employee/EmployeeInfo/SearchEmployeeByBCSBatch?bcsBatchId=' + bcsBatch, [], 'json', ajaxEmployeeData);
            }
        }
        function ajaxEmployeeData(res) {
            $('#tblData tbody').empty();
            var text = '';
            $.each(res, function (i, v) {
                text += `<tr><td>${i + 1}</td><td>${v.fullName} (${v.empCode})</td><td>পিতার নাম: ${v.fatherName}</br>মাতার নাম: ${v.motherName}</td><td>${v.workingPlace}</td><td>${v.address}</td></tr>`;
            })
            $('#tblData tbody').append(text);
            $('#tblData').DataTable();
        }

        function pdfAllEmployee() {
            bcsBatch = $('#bcsBatch').val();
            if (bcsBatch != '') {
                window.open('/Employee/EmployeeInfo/SearchEmployeeByBCSBatchPdfAction?bcsBatchId=' + bcsBatch);
            }
        }

        function excelAllEmployee() {
            bcsBatch = $('#bcsBatch').val();
            if (bcsBatch != '') {
                window.open('/Employee/EmployeeInfo/SearchEmployeeByBCSBatchExcelAction?bcsBatchId=' + bcsBatch);
            }
        }
    </script>
}