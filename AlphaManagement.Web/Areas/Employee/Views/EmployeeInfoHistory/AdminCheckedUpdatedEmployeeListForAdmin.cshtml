                                                                {
                                                                    <td> <img src="~/logo/defaultprofile.jpg" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                                                                }
                                                                else
                                                                {
                                                                    <td> <img src="@baseImageUrl/@item.Photographs.Where(x=>x.type== "profile").LastOrDefault()?.url" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                                                                }
                                                                <td>@item.nameEnglish</td>
                                                                <td>@item.employeeCode</td>
                                                                <td>@item.rank?.rankName</td>
                                                                <td>@item.section?.Name</td>
                                                                <td>@item.bCSBatch?.batchName</td>
                                                                <td>
                                                                    <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                                                                    @if (emp.roleName == "Departmental User")
                                                                    {
                                                                        <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfo/AdminEmployeeIndex?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Edit"><i class="fa fa-edit"></i></a>
                                                                    }
                                                                    <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportViewPDF?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Report"><i class="fa fa-file"></i></a>

                                                                    <a class="btn btn-sm btn-success" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportPreviousPDF?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Previous Report"><i class="fa fa-file"></i></a>

                                                                    @if (item.isApproved != 4)
                                                                    {
                                                                        <a class="btn btn-sm btn-info" href="#" onclick="btnUpdateEmployeeStatus('@item.employeeCode',4)" title="Verify"><i class="fa fa-check-square"></i></a>
                                                                    }
                                                            </tr>
                                                            i++;
                                                        }
                                                    }


                                                }*@
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="col-12 row" id="divLoader" style="display:none">
                                        <div class="col-4"></div>
                                        <div class="col-4">
                                            <img height="400" width="400" src="~/images/Circles-loader.gif" />
                                        </div>
                                        <div class="col-4"></div>                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>



            </div>
        </div>
        <!--end container-->

    </div>
    <!--end body content-->
</section>

<div class="modal fade bd-example-modal-lg" id="employeeInformation" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="unitName" style="color:#008000"> </h5>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" style="color: red;">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <button class="btn btn-info btn-sm" onclick="exportToExcel()">Export To Excel</button>
                    </div>
                    <div class="col-md-6">
                        <div class="float-right">
                            <input type="text" class="form-control" name="keyword" id="search_employees" placeholder="Search...">
                            <span class="search-button"><i class="ti ti-search"></i></span>
                        </div>
                    </div>

                </div>

                <div class="tab-content" id="myTabContent" style="height:400px;overflow-y:scroll;width:100%">
                    <div></div>
                </div>
                <br />
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Close</button>
                </div>

            </div>

        </div>
    </div>
</div>


@section Scripts{
    <!-- Responsive and datatable js -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
    <script src="~/js/jquery.table2excel.js" type="text/javascript"></script>
    <link href="~/plugins/morris-chart/morris.css" rel="stylesheet">
    <script src="~/plugins/chart-js/Chart.bundle.js"></script>
    <script src="~/plugins/morris-chart/raphael-min.js"></script>
    <script src="~/plugins/morris-chart/morris.js"></script>
    <script>

        $(document).ready(function ($) {
            $('#tblMain').DataTable();
            $('#unitId').select2();
            $('#rankId').select2();
            $('#batchId').select2();
            //loadOfficers();
        });

        function loadOfficers() {

            var unitId = $('#unitId').val();
            var rankId = $('#rankId').val();
            var batchId = $('#batchId').val();
            //window.location.href="/Employee/EmployeeInfoHistory/AdminCheckedUpdatedEmployeeListForAdmin?unitId=" + unitId + '&rankId=' + rankId + '&batchId=' + batchId;
            //$('#checkedList').load("/Employee/EmployeeInfoHistory/CheckedEmployeeListForAdmin?unitId=" + unitId + '&rankId=' + rankId + '&batchId=' + batchId);
            //$('#tblTable').DataTable();
            //Common.Ajax('GET', '/global/api/GetEmployeeSearchByUnitId/' + unitId + '/' + rankId + '/' + batchId, [], 'json', ajaxUnit, false);
            Common.Ajax('GET', '/Employee/EmployeeInfoHistory/AdminCheckedUpdatedEmployeeListForAdminJson?unitId=' + unitId + '&rankId=' + rankId + '&batchId=' + batchId, [], 'json', ajaxData, false);
            $('#tblTable').DataTable().destroy();
            $('#tblTable').DataTable();
        }

        function btnUpdateEmployeeStatus(employeeCode, status) {
            if (employeeCode == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }
            if (status == "") {
                swal('Warning', 'please try again', 'warning');
                return false;
            }
            $('#tblDiv').hide();
            $('#divLoader').show();
            var url = "/Portfolio/PortfolioDashboard/UpdateEmployeeStatus?empCode=" + employeeCode + "&status=" + status;
            $.get(url, function (data) {
                if (data.Success) {
                    //swal('', data.Message, 'success').then(function () {
                        loadOfficers();
                        $('#tblDiv').show();
                        $('#divLoader').hide();
                    //})
                } else {
                    swal('Warning', data.Message, 'warning');
                }


            });

            //swal({
            //    title: 'Are you sure?', text: 'Do you want to Verify this record?', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, Verify!'
            //}).then(function (res) {
            //    $('#tblDiv').hide();
            //    $('#divLoader').show();
            //    if (res.value) {
            //        var url = "/Portfolio/PortfolioDashboard/UpdateEmployeeStatus?empCode=" + employeeCode + "&status=" + status;
            //        $.get(url, function (data) {
            //            if (data.Success) {
            //                swal('', data.Message, 'success').then(function () {
            //                    loadOfficers();
            //                    $('#tblDiv').show();
            //                    $('#divLoader').hide();
            //                })
            //            } else {
            //                swal('Warning', data.Message, 'warning');
            //            }


            //        });
            //    }
            //})
        }

        function ajaxData(responce) {
            var tbody = $('#tbEmplist');
            var data = '';
            var data1 = '';
            $('#tblMain').DataTable().destroy();
            $.each(responce.employeeInfos_SPs, function (i, v) {
                var name = '';
                var rank = '';
                var bcs = '';
                var url = '';
                var bp = '';
                var unit = '';
                if (v.nameEnglish == null) {
                    name = ' '
                }
                else {
                    name = v.nameEnglish;
                }
                if (v.employeeCode == null) {
                    bp = ' '
                }
                else {
                    bp = v.employeeCode;
                }
                if (v.rankName == null) {
                    rank = ' '
                }
                else {
                    rank = v.rankName;
                }
                if (v.branchUnitName == null) {
                    unit = ' '
                }
                else {
                    unit = v.branchUnitName;
                }
                if (v.batchName == null) {
                    bcs = ' '
                }
                else {
                    bcs = v.batchName;
                }
                if (v.url == null) {
                    url = 'logo/defaultprofile.jpg'
                }
                else {
                    url = v.url;
                }
                data += `<tr><td>${i + 1}</td><td><img height="50px" weight="50px" src="@baseImageUrl/${url}"/></td><td>${name}</td><td>${bp}</td><td>${rank}</td><td>${unit}</td><td>${bcs}</td><td>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportViewPDF?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Report"><i class="fa fa-file"></i></a>
                            <a class="btn btn-sm btn-success" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportPreviousPDF?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Previous Report"><i class="fa fa-file"></i></a>
                            <a class="btn btn-sm btn-info" href="javascript:void(0)" onclick="btnUpdateEmployeeStatus('${bp}',4)" title="Verify"><i class="fa fa-check-square"></i></a>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfo/EditAdminEmployeeIndex?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Edit"><i class="fa fa-edit"></i></a>
                            </td></tr>`;
                data1 += `<tr><td>${i + 1}</td><td><img height="50px" weight="50px" src="@baseImageUrl/${url}"/></td><td>${name}</td><td>${bp}</td><td>${rank}</td><td>${unit}</td><td>${bcs}</td><td>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportViewPDF?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Report"><i class="fa fa-file"></i></a>
                            <a class="btn btn-sm btn-success" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportPreviousPDF?empIdentityUserSessionToken=${v.Id}')" target="_blank" title="Previous Report"><i class="fa fa-file"></i></a>
                            </td></tr>`;
            })
            tbody.empty();
            if ("@emp.roleName" == "Admin" || "@emp.roleName" == "Super Admin") {
                tbody.append(data);
            }
            else {
                tbody.append(data1);
            }
            $('#tblMain').DataTable();
        }
    </script>
}
