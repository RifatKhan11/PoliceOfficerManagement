@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "Officer Details Report";
    Layout = "~/Views/Shared/_PrintView.cshtml";
    var nameE = "black";
    var nameB = "black";
    var Rank = "black";
    var Designation = "black";
    var PostingPlace = "black";
    var Unit = "black";
    var Father = "black";
    var Mother = "black";
    var Marital = "black";
    var Gender = "black";
    var Religion = "black";
    var Birth = "black";
    var National = "black";
    var Blood = "black";
    var Height = "black";
    var Weight = "black";
    var Passport = "black";
    var Driving = "black";
    var Ration = "black";
    var Batch = "black";
    var Joining = "black";
    var JoiningPresent = "black";
    var retirement = "black";
    var trType = "black";
    var countrytr = "black";
    var attachbranch = "black";

    if (Model.employeeInfoHistory != null)
    {
        if (Model.employeeInfoHistory.nameEnglish != Model.employeeInfo.nameEnglish)
        {
            nameE = "red !important";
        }
        if (Model.employeeInfoHistory.nameBangla != Model.employeeInfo.nameBangla)
        {
            nameB = "red !important";
        }
        if (Model.employeeInfoHistory.pHQTRTypeId != Model.employeeInfo.pHQTRTypeId)
        {
            trType = "red !important";
        }
        if (Model.employeeInfoHistory.attachmentBranchId != Model.employeeInfo.attachmentBranchId)
        {
            attachbranch = "red !important";
        }
        if (Model.employeeInfoHistory.countryId != Model.employeeInfo.countryId)
        {
            countrytr = "red !important";
        }
        if (Model.employeeInfoHistory.rankId != Model.employeeInfo.rankId)
        {
            Rank = "red !important";
        }
        if (Model.employeeInfoHistory.designationsId != Model.employeeInfo.designationsId)
        {
            Designation = "red !important";
        }
        if (Model.employeeInfoHistory.sectionId != Model.employeeInfo.sectionId)
        {
            PostingPlace = "red !important";
        }
        if (Model.employeeInfoHistory.branchId != Model.employeeInfo.branchId)
        {
            Unit = "red !important";
        }
        if (Model.employeeInfoHistory.fatherNameEnglish != Model.employeeInfo.fatherNameEnglish)
        {
            Father = "red !important";
        }
        if (Model.employeeInfoHistory.motherNameEnglish != Model.employeeInfo.motherNameEnglish)
        {
            Mother = "red !important";
        }
        if (Model.employeeInfoHistory.gender != Model.employeeInfo.gender)
        {
            Gender = "red !important";
        }
        if (Model.employeeInfoHistory.religionId != Model.employeeInfo.religionId)
        {
            Religion = "red !important";
        }
        if (Model.employeeInfoHistory.dateOfBirth != Model.employeeInfo.dateOfBirth)
        {
            Birth = "red !important";
        }
        if (Model.employeeInfoHistory.nationalID != Model.employeeInfo.nationalID)
        {
            National = "red !important";
        }
        if (Model.employeeInfoHistory.dateOfBirth != Model.employeeInfo.dateOfBirth)
        {
            Birth = "red !important";
        }
        if (Model.employeeInfoHistory.nationalID != Model.employeeInfo.nationalID)
        {
            National = "red !important";
        }
        if (Model.employeeInfoHistory.bloodGroup != Model.employeeInfo.bloodGroup)
        {
            Blood = "red !important";
        }
        if (Model.employeeInfoHistory.height != Model.employeeInfo.height)
        {
            Height = "red !important";
        }
        if (Model.employeeInfoHistory.weight != Model.employeeInfo.weight)
        {
            Weight = "red !important";
        }
        if (Model.employeeInfoHistory.passportNo != Model.employeeInfo.passportNo)
        {
            Passport = "red !important";
        }
        if (Model.employeeInfoHistory.drivingLicense != Model.employeeInfo.drivingLicense)
        {
            Driving = "red !important";
        }
        if (Model.employeeInfoHistory.rationId != Model.employeeInfo.rationId)
        {
            Ration = "red !important";
        }
        if (Model.employeeInfoHistory.bCSBatchId != Model.employeeInfo.bCSBatchId)
        {
            Batch = "red !important";
        }
        if (Model.employeeInfoHistory.joiningDateGovtService != Model.employeeInfo.joiningDateGovtService)
        {
            Joining = "red !important";
        }
        if (Model.employeeInfoHistory.joiningDatePresentWorkstation != Model.employeeInfo.joiningDatePresentWorkstation)
        {
            JoiningPresent = "red !important";
        }
        if (Model.employeeInfoHistory.LPRDate != Model.employeeInfo.LPRDate)
        {
            retirement = "red !important";
        }
    }

}

<!-- Latest compiled and minified CSS -->
<link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">

