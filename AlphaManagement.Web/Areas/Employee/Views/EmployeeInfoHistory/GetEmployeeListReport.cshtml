@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_PrintView.cshtml";
}

<div style="padding-bottom:3%">
    <h6 class="text-center text-justify"> Bangladesh Police<br /> Police Headquarters, Dhaka <br />6 Phoenix Rd, Dhaka 1000 <br /> Officers' List </h6>
</div>

<div class="tab-content mt-4" id="myTabContent">

    <div class="row">
        <div class="col-md-12 col-12">
            <table class="table table-bordered table-striped" style="width:100%" id="tblData">
                <thead>
                    <tr class="text-light  table-sm">
                        <td>Sl No</td>
                        <td>Name</td>
                        <td>BP No</td>
                        <td>Rank</td>
                        <td>Unit</td>
                        <td>BCS Batch</td>
                        @*<td>Position Vacancy</td>*@
                    </tr>
                </thead>

                <tbody>
                    @{var i = 1;}
                    @foreach (var item in Model.employeeInfosViewModelFor_SPs)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@item.nameEnglish</td>
                            <td>@item.employeeCode</td>
                            <td>@item.rankName</td>
                            <td>@item.branchUnitName </td>
                            <td>@item.batchName</td>
                            @*<td>@item.totalBlankPost</td>*@
                        </tr>
                        i++;
                    }

                </tbody>
            </table>

        </div>
    </div>
</div>
