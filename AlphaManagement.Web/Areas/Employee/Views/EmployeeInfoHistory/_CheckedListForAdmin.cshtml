@using AlphaManagement.Domain.AuthService.Interfaces;
@using AlphaManagement.Domain.EmployeeService.interfaces;
@inject IUserInfoes userInfo;
@inject IEmployeeService emplyeeService;
@{
    var emp = await userInfo.GetUserInfoByUserName(User.Identity.Name);
}

@model EmployeeInfoViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var baseImageUrl = "http://portfolio.police.gov.bd";
}
<link rel="shortcut icon" href="~/images/favicon.ico">
<link href="~/plugins/morris-chart/morris.css" rel="stylesheet">
<!-- Theme Css -->
<link href="~/css/bootstrap.min.css" rel="stylesheet">
<link href="~/css/slidebars.min.css" rel="stylesheet">
<link href="~/css/icons.css" rel="stylesheet">
<link href="~/css/menu.css" rel="stylesheet" type="text/css">
<link href="~/css/style.css" rel="stylesheet">
<style>
    #barChart {
        height: 300px;
    }

    .textStyle {
        color: black;
        text-align: center;
    }

    @@media screen and (min-width: 2000px) {
        #dashHeight {
            height: 200px !important;
        }
    }
</style>

<div class="table-responsive">
    <table class="table table-hover m-b-0" id="tblMain">
        <thead>
            <tr>
                <td>SL.NO</td>
                <td>Photo</td>
                <td>Name</td>
                <td>BP No</td>

                <td>Rank</td>
                <td>Unit</td>
                <td>BCS Batch</td>

                <td width="10%">Action</td>
            </tr>
        </thead>
        <tbody id="tbEmplist">
            @{
                                                    var i = 1;

                                                    if (Model.employeeId == 1)
                                                    {
                @foreach (var item in Model.employeeInfoList.Where(x => Convert.ToDateTime(x.updatedAt).Date == DateTime.Now.Date))
                                                        {
                <tr>
                    <td>@i</td>
                    @if (item.Photographs.Where(x => x.type == "profile").LastOrDefault()?.url == null)
                                                                {
                    <td> <img src="~/logo/defaultprofile.jpg" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                                                                }
                                                                else
                                                                {
                    <td> <img src="@baseImageUrl/@item.Photographs.Where(x=>x.type== "profile").LastOrDefault()?.url" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                                                                }
                    <td>@item.nameEnglish</td>
                    <td>@item.employeeCode</td>
                    <td>@item.rank?.rankName</td>
                    <td>@item.section?.Name</td>
                    <td>@item.bCSBatch.batchName</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                        @if (emp.roleName == "Departmental User")
                                                                    {
                        <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfo/AdminEmployeeIndex?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Edit"><i class="fa fa-edit"></i></a>
                                                                    }
                        <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportViewPDF?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Report"><i class="fa fa-file"></i></a>

                        <a class="btn btn-sm btn-success" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportPreviousPDF?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Previous Report"><i class="fa fa-file"></i></a>

                        @if (item.isApproved != 4)
                                                                    {
                        <a class="btn btn-sm btn-info" href="#" onclick="btnUpdateEmployeeStatus('@item.employeeCode',4)" title="Verify"><i class="fa fa-check-square"></i></a>
                                                                    }
                </tr>
                                                            i++;
                                                        }
                                                    }
                                                    else
                                                    {
                @foreach (var item in Model.employeeInfoList)
                                                        {
                <tr>
                    <td>@i</td>
                    @if (item.Photographs.Where(x => x.type == "profile").LastOrDefault()?.url == null)
                                                                {
                    <td> <img src="~/logo/defaultprofile.jpg" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                                                                }
                                                                else
                                                                {
                    <td> <img src="@baseImageUrl/@item.Photographs.Where(x=>x.type== "profile").LastOrDefault()?.url" style="width:70px;height:70px" class="img-fluid" alt="" /></td>
                                                                }
                    <td>@item.nameEnglish</td>
                    <td>@item.employeeCode</td>
                    <td>@item.rank?.rankName</td>
                    <td>@item.section?.Name</td>
                    <td>@item.bCSBatch.batchName</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Portfolio/PortfolioDashboard/EmployeeDetails?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Details"><i class="mdi mdi-account-card-details"></i></a>
                        @if (emp.roleName == "Departmental User")
                                                                    {
                        <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfo/AdminEmployeeIndex?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Edit"><i class="fa fa-edit"></i></a>
                                                                    }
                        <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportViewPDF?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Report"><i class="fa fa-file"></i></a>

                        <a class="btn btn-sm btn-success" href="javascript:void(0)" onclick="window.open('/Employee/EmployeeInfoHistory/EmployeeInfoReportPreviousPDF?empIdentityUserSessionToken=@item.Id')" target="_blank" title="Previous Report"><i class="fa fa-file"></i></a>

                        @if (item.isApproved != 4)
                                                                    {
                        <a class="btn btn-sm btn-info" href="#" onclick="btnUpdateEmployeeStatus('@item.employeeCode',4)" title="Verify"><i class="fa fa-check-square"></i></a>
                                                                    }
                </tr>
                                                            i++;
                                                        }
                                                    }


            }
        </tbody>
    </table>
</div>


@section Scripts{
    <!-- Responsive and datatable js -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
    <script src="~/js/jquery.table2excel.js" type="text/javascript"></script>
    <link href="~/plugins/morris-chart/morris.css" rel="stylesheet">
    <script src="~/plugins/chart-js/Chart.bundle.js"></script>
    <script src="~/plugins/morris-chart/raphael-min.js"></script>
    <script src="~/plugins/morris-chart/morris.js"></script>
    <script>

        $(document).ready(function ($) {
            $('#tblMain').DataTable();
            
        });

        

    </script>
}
