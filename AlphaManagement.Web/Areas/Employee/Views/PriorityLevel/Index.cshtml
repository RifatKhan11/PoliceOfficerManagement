@model PriorityLevelViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    @@import url('https://fonts.maateen.me/adorsho-lipi/font.css');

    body {
        font-family: 'AdorshoLipi', Arial, sans-serif !important;
    }
</style>

<link href="~/plugins/timepicker/bootstrap-material-datetimepicker.css" rel="stylesheet">
<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h4 class="pt-2 pb-2 mt-2">
                    Suggestion Prority
                </h4>

            </div>
            <div class="card-body">
                <form id="frmpriorityLevel" method="post">
                    <input type="hidden" name="prorityLevelId" id="prorityLevelId" value="0" />
                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label for="" class="col-sm-4 col-form-label">Priority Level Type</label>
                                <div class="col-sm-8">
                                    <select class="form-control" name="priorityLevelTypeId" id="priorityLevelTypeId">
                                        <option value="">select</option>
                                        @foreach (var item in Model.priorityLevelTypes)
                                        {
                                            <option value="@item.Id">@item.name</option>

                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="refDesignat" class="col-sm-4 col-form-label">Prority Level<span style="color:red">*</span></label>
                                <div class="col-sm-8">                                  
                                    <select class="form-control" name="prorityLevel" id="prorityLevel">
                                        <option value="">Select</option>
                                        <option value="Low">Low</option>
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>                                     
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="refName" class="col-sm-4 col-form-label">Rank</label>
                                <div class="col-sm-8">
                                    <select class="form-control" name="rankId" id="rankId" required>
                                        <option value="">select</option>
                                        @foreach (var item in Model.ranks)
                                        {
                                            <option value="@item.Id">@item.rankName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row" id="specialBranch">
                                <label for="refOrganization" class="col-sm-4 col-form-label">Special Branch Unit</label>
                                <div class="col-sm-8">
                                    <select class="select2 form-control" style="width:100%" id="specialBranchUnitId" name="specialBranchUnitId" required>
                                        <option value="">Select</option>
                                        @foreach (var item in Model.specialBranchUnits)
                                        {
                                            <option value="@item.Id">@item.branchUnitName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 col-12">
                            <div class="form-group row" id="employeeInfoSec" style="display:none">
                                <label for="Other" class="col-sm-4 col-form-label">BP Number</label>
                                <div class="col-sm-8">
                                    <div class="input-group mb-3">
                                        <input type="text" class="form-control" placeholder="BP Number" id="bpNumber" aria-label="Recipient's username" aria-describedby="basic-addon2">
                                        <div class="input-group-append">
                                            <button class="btn btn-outline-secondary" type="button" id="btnSearch"><i class="fa fa-search"></i> Search </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row" id="employeeInfoSec2" style="display:none">
                                <label for="Other" class="col-sm-4 col-form-label">Employee Name</label>
                                <div class="col-sm-8">
                                    <div class="input-group mb-3">
                                        <input type="text" class="form-control" id="employeeName" name="employeeName" readonly>
                                        <input type="hidden" class="form-control" id="employeeInfoId" name="employeeInfoId">
                                        <div class="input-group-append">
                                            <button class="btn btn-outline-secondary" style="display:none" type="button" id="btnEditSearch"><i class="fa fa-search"></i> Change </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row" id="ruleDes">
                                <label for="Other" class="col-sm-4 col-form-label">Rule Description</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="ruleDescription" name="ruleDescription">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="specialSkillTypeId" class="col-sm-4 col-form-label">Special Skill<span style="color:red">*</span></label>
                                <div class="col-sm-8">
                                    <select class="select2 form-control" style="width:100%" name="specialSkillTypeId" id="specialSkillTypeId" data-parsley-required="true">
                                        <option value="">Select</option>
                                        @foreach (var data in Model.specialSkillTypes)
                                        {
                                            <option value="@data.Id">@data.name</option>
                                        };
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="trainingCountryId" class="col-sm-4 col-form-label">District</label>
                                <div class="col-sm-8">
                                    <select class="select2 form-control" style="width:100%" name="districtId" id="districtId">
                                        <option value="">Select</option>
                                        @foreach (var data in Model.districts)
                                        {
                                            <option value="@data.Id">@data.districtName</option>
                                        };
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row" id="ruleDescription">
                                <label for="Other" class="col-sm-4 col-form-label">Sort Order</label>
                                <div class="col-sm-8">
                                    <input type="number" class="form-control" id="sortOrder" name="sortOrder">
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">Posting Priority Level List</h4>
            </div>
            <div class="card-body">
                <div class="table-odd">
                    <table id="tblData" class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>Prority Level</th>
                                <th>Rank</th>
                                <th>Priority Level Type</th>
                                @* <th>Special Branch Unit</th>
                                    <th>District</th>
                                    <th>Special Skill</th>
                                *@
                                <th>Rule Description</th>
                                <th>Special Skill Type</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sl = 0;
                                @foreach (var item in Model.postingPriorityLevels)
                                {
                                    sl = sl + 1;
                                    <tr>
                                        <td>@sl</td>
                                        <td>@item.prorityLevel</td>
                                        <td>@item.rank?.rankNameBN</td>
                                        <td>@item.priorityLevelType?.nameBn</td>
                                        @*   <td>@item.specialBranchUnit?.branchUnitNameBN</td>
                                            <td>@item.district?.districtNameBn</td>
                                            <td>@item.specialSkillType?.nameBn</td>
                                        *@
                                        <td>@item.ruleDescription</td>
                                        <td>@item.specialSkillType.nameBn</td>
                                        <td>
                                            <a href="#" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="Edit(@item.Id)"><span class="ti-pencil"></span></a>
                                            <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete('@item.Id')"><span class="ti-trash"></span></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/plugins/timepicker/bootstrap-material-datetimepicker.js"></script>
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
            $('#localTrStDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
            $('#localTrEdDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
        });
        $('#priorityLevelTypeId').change(function () {
            var id = $("#priorityLevelTypeId :selected").text();
            if (id == 'Individual') {
                $('#employeeInfoSec').show();
                $("#employeeName").attr("required", true);    
            } else {
                $('#employeeInfoSec').hide();
                $('#employeeInfoSec2').hide();
                $('#employeeName').val('');
                $('#employeeInfoId').val('');
                $('#bpNumber').val('');
                $("#employeeName").removeAttr('disabled');
            }
        });
        $('#btnSearch').click(function () {
            var bp = $('#bpNumber').val();
            Common.Ajax('GET', '/global/api/getEmployeedataById?id=' + bp, [], 'json', employeeData);
        });
        $('#btnEditSearch').click(function () {
            $('#employeeInfoSec2').hide();
            $('#employeeInfoSec').show();
        });
        function employeeData(res) {
            if (res != null) {
                $('#employeeName').val(res.nameEnglish);
                $('#employeeInfoId').val(res.Id);
                $('#employeeInfoSec2').show();
                $('#employeeInfoSec').hide();
            }
            else {
                $('#employeeName').val('');
                $('#employeeInfoId').val('');
                $('#bpNumber').val('');
                //$('#employeeInfoSec2').hide();
                $('#employeeInfoSec').show();
                swal('', 'Data Not Found', 'warning')
                return false;

            }

        }
        $('#frmpriorityLevel').parsley();
        $('#frmpriorityLevel').submit(function (e) {
            e.preventDefault();
            var form = $('#frmpriorityLevel')
            if ($(this).parsley().isValid()) {
                swal({
                    title: 'Are you sure?', text: `Do you want to save this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Save!`
                }).then((result) => {
                    if (result.value) {
                        $.ajax({
                            url: '/Employee/PriorityLevel/Index',
                            data: form.serialize(),
                            type: 'POST',
                            success: function (rec) {
                                swal({
                                    title: 'Saved', type: 'success', confirmButtonColor: '#007ACC', confirmButtonText: `OK!`
                                }).then(function () {
                                    window.location.reload();
                                })
                            }
                        });
                    } else if (result.dismiss === 'cancel') {
                        return false;
                    }
                });
            }
        });
        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (day < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }
        function Edit(Id) {
            Common.Ajax('GET', '/global/api/PostingPriorityLevelbyId?id=' + Id, [], 'json', getPostingPriorityData);
        }
        function getPostingPriorityData(res) {
          console.log(res);
            if (res != null) {
                $('#prorityLevelId').val(res.Id);
                $('#priorityLevelTypeId').val(res.priorityLevelTypeId);
                $(`#prorityLevel option:contains(${res.prorityLevel})`).attr('selected', 'selected');
                $('#ruleDescription').val(res.ruleDescription);
                $('#rankId').val(res.rankId);
                $('#specialSkillTypeId').val(res.specialSkillTypeId);
                $('#specialBranchUnitId').val(res.specialBranchUnitId);
                $('#districtId').val(res.districtId);
                $('#sortOrder').val(res.sortOrder);
                if (res.employeeInfoId != null) {
                    $('#employeeInfoId').val(res.employeeInfoId);
                    $('#employeeName').val(res ?.employeeInfo ?.nameEnglish);
                    $('#priorityLevelTypeId').trigger('change');
                    $('#employeeInfoSec2').show();
                    $('#btnEditSearch').show();
                    $('#employeeInfoSec').hide();

                } else {
                    $('#employeeInfoId').val('');
                    $('#employeeName').val('');
                    $('#btnEditSearch').hide();
                    $('#employeeInfoSec2').hide();
                }


            }


        }
        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/PriorityLevel/DeletePriorityLevelbyId/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

