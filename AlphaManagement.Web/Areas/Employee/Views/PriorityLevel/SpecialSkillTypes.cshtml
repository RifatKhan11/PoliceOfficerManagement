@model PriorityLevelViewModel
@{
    ViewData["Title"] = "Special Skill Types";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    @@import url('https://fonts.maateen.me/adorsho-lipi/font.css');

    body {
        font-family: 'AdorshoLipi', Arial, sans-serif !important;
    }
</style>

<link href="~/plugins/timepicker/bootstrap-material-datetimepicker.css" rel="stylesheet">
<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h4 class="pt-2 pb-2 mt-2">
                    Priority Level Type
                </h4>
            </div>
            <div class="card-body">
                <form id="frmpriorityLevel" method="post">
                    <input type="hidden" name="Id" id="prorityLevelId" value="0" />
                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row" id="ruleDescription">
                                <label for="Other" class="col-sm-4 col-form-label">Name</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="name" name="name">
                                </div>
                            </div>
                        </div>  <div class="col-md-6 col-12">
                            <div class="form-group row" id="ruleDescription">
                                <label for="Other" class="col-sm-4 col-form-label">Name Bangla</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="nameBn" name="nameBn">
                                </div>
                            </div>
                        </div>  <div class="col-md-6 col-12">
                            <div class="form-group row" id="ruleDescription">
                                <label for="Other" class="col-sm-4 col-form-label">Sort Order</label>
                                <div class="col-sm-8">
                                    <input type="number" class="form-control" id="sortOrder" name="sortOrder">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">Priority Level Type List</h4>
            </div>
            <div class="card-body">
                <div class="table-odd">
                    <table id="tblData" class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>Name</th>
                                <th>Name Bangla</th>
                                <th>short Order</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sl = 0;
                                @foreach (var item in Model.specialSkillTypes)
                                {
                                    sl = sl + 1;
                                    <tr>
                                        <td>@sl</td>
                                        <td>@item.name</td>
                                        <td>@item.nameBn</td>
                                        <td>@item.sortOrder</td>
                                        <td>
                                            <a href="#" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="Edit(@item.Id)"><span class="ti-pencil"></span></a>
                                            <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete('@item.Id')"><span class="ti-trash"></span></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/plugins/timepicker/bootstrap-material-datetimepicker.js"></script>
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
        });

        $('#frmpriorityLevel').parsley();
        $('#frmpriorityLevel').submit(function (e) {
            e.preventDefault();
            var form = $('#frmpriorityLevel')
            if ($(this).parsley().isValid()) {
                swal({
                    title: 'Are you sure?', text: `Do you want to save this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Save!`
                }).then((result) => {
                    if (result.value) {
                        $.ajax({
                            url: '/Employee/PriorityLevel/SpecialSkillTypes',
                            data: form.serialize(),
                            type: 'POST',
                            success: function (rec) {
                                swal({
                                    title: 'Saved', type: 'success', confirmButtonColor: '#007ACC', confirmButtonText: `OK!`
                                }).then(function () {
                                    window.location.reload();
                                })
                            }
                        });
                    } else if (result.dismiss === 'cancel') {
                        return false;
                    }
                });
            }
        });
        function Edit(Id) {
            Common.Ajax('GET', '/global/api/SpecialSkillsbyId?id=' + Id, [], 'json', getPostingPriorityData);
        }
        function getPostingPriorityData(res) {
          console.log(res);
            if (res != null) {
                $('#prorityLevelId').val(res.Id);
                $('#name').val(res.name);
                $('#nameBn').val(res.nameBn);
                $('#sortOrder').val(res.sortOrder);
            }


        }
        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/PriorityLevel/DeleteSpecialSkillTypebyId/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

