@model DisciplinaryActionViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/timepicker/bootstrap-material-datetimepicker.css" rel="stylesheet">

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="pt-2 pb-2 mt-2">
                    @Model.employee?.nameEnglish's FAT Information <a class="btn btn-sm btn-info float-right" href="javascript:history.go(-1)">Back</a>
                </h5>

            </div>
            <div class="card-body">
                <form id="frmForeignTravel" method="post">
                    <input type="hidden" name="employeeId" value="@Model.employee?.Id" />
                    <input type="hidden" name="ForeignTravelId" id="ForeignTravelId" value="0" />
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group row">
                        <label class="col-form-label col-md-3">Purpose<span style="color: red">*</span></label>
                        <div class="col-md-8">
                            <select class="select2 form-control" style="width:100%" name="travelPurpose" id="travelPurpose" data-parsley-required="true">
                                <option selected value="FAT">FAT</option>
                            </select>
                            @*<input type="text" id="travelPurpose" name="travelPurpose" class="form-control" value="" />*@
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="countryId" class="col-sm-3 col-form-label">Country<span style="color: red">*</span></label>
                        <div class="col-sm-8">
                            <select class="select2 form-control" style="width:100%" name="countryId" id="countryId" data-parsley-required="true">
                                <option value="">Select</option>
                                @foreach (var data in Model.countries)
                                {
                                    <option value="@data.Id">@data.countryName</option>
                                };
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="referenceNumber" class="col-sm-3 col-form-label">Reference Number</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" name="referenceNumber" id="referenceNumber" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-form-label col-md-3">Start Date<span style="color: red">*</span></label>
                        <div class="col-md-8">
                            <input type="text" id="travelDate" name="travelDate" class="form-control" value="" data-parsley-required="true" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-form-label col-md-3">End Date<span style="color: red">*</span></label>
                        <div class="col-md-8">
                            <input type="text" id="travelEndDate" name="travelEndDate" class="form-control" value="" data-parsley-required="true" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="travelDuration" class="col-sm-3 col-form-label">Duration</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" name="travelDuration" id="travelDuration" readonly />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-sm" id="saveForeignTravel">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">FAT Information</h4>
            </div>
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table" id="ForeignTravel-table">
                        <thead>
                            <tr>
                                <th>Sl NO</th>
                                <th>Country</th>
                                <th>Travel Purpose</th>
                                <th>Reference Number</th>
                                <th>Travel Date</th>
                                <th>Travel End Date</th>
                                <th>Duration</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sl = 1;}
                            @foreach (var item in Model.foreignTravels)
                            {

                                <tr id="@("ftTrvl"+item.Id)">
                                    <td>@sl</td>
                                    <td>@item.country?.countryName</td>
                                    <td>@item.travelPurpose</td>
                                    <td>@item.referenceNumber</td>
                                    <td>@item.travelDate?.ToString("dd-MMM-yyyy")</td>
                                    <td>@item.travelEndDate?.ToString("dd-MMM-yyyy")</td>
                                    <td>@item.travelDuration</td>
                                    <td class="text-nowrap">
                                        @if (item.createdBy != Model.employee.employeeCode)
                                        {
                                            <button type="button" onclick="foreignTravelUpdate(@item.Id,@item.countryId,'@item.referenceNumber','@item.travelPurpose','@item.travelDate?.ToString("dd-MMM-yyyy")','@item.travelEndDate?.ToString("dd-MMM-yyyy")','@item.travelDuration')" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;"><span class="ti-pencil"></span></button>
                                            <button type="button" onclick="deleteForeignTravel(@item.Id)" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;"><span class="ti-trash"></span></button>
                                        }
                                    </td>
                                </tr>
                                sl++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/plugins/timepicker/bootstrap-material-datetimepicker.js"></script>
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

            $('#travelDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
            $('#travelEndDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });

            $("#travelDate, #travelEndDate").change(function () {

                var str = $('#travelDate').val();
                var assdate = $('#travelEndDate').val();

                if (str == '' || assdate == '') {
                    return false;
                }
                if (str == '' || assdate == '') {
                    return false;
                }
                var newStrDate = new Date(formatDate2(str)).toISOString();
                var newEndDate = new Date(formatDate2(assdate)).toISOString();
                if (newStrDate > newEndDate) {
                    swal('', 'Start Date Must Be Older Than End Date', 'warning').then(function () {
                        $('#travelDate').val('');
                        $('#travelEndDate').val('');
                        $('#travelDuration').val('');
                    })
                }
                if (/^\d{2}\-\D{0,3}\-\d{4}$/i.test(str)) {
                    var parts = str.split("-");
                    var m = 0;
                    if (parts[1] == "Jan") { m = 1; } else if (parts[1] == "Feb") { m = 2; } else if (parts[1] == "Mar") { m = 3; } else if (parts[1] == "Apr") { m = 4; } else if (parts[1] == "May") { m = 5; } else if (parts[1] == "Jun") { m = 6; } else if (parts[1] == "Jul") { m = 7; } else if (parts[1] == "Aug") { m = 8; } else if (parts[1] == "Sep") { m = 9; } else if (parts[1] == "Oct") { m = 10; } else if (parts[1] == "Nov") { m = 11; } else if (parts[1] == "Dec") { m = 12; }
                    var day = parts[0] && parseInt(parts[0], 10);
                    var month = m;
                    var year = parts[2] && parseInt(parts[2], 10);
                    var duration = 59;

                    if (day <= 31 && day >= 1 && month <= 12 && month >= 1) {


                        if (assdate == '' || assdate == null || assdate == 'undefined') {
                            assdate = moment();
                        } else {
                            assdate = moment(assdate, 'DD-MMM-YYYY');
                        }

                        if (str == '' || str == null || str == 'undefined') {
                            str = moment();
                        } else {
                            str = moment(str, 'DD-MMM-YYYY');
                        }
                        //var expiryDate = new Date();


                        var a = moment(assdate, 'DD-MMM-YYYY');
                        var b = moment(str, 'DD-MMM-YYYY');

                        var years = a.diff(b, 'year');
                        b.add(years, 'years');

                        var months = a.diff(b, 'months');
                        b.add(months, 'months');

                        var days = a.diff(b, 'days') + 1;
                        $("#travelDuration").val(years + ' years ' + months + ' months ' + days + ' days');

                    } else {
                        // display error message
                    }
                }
            });

            $('#frmForeignTravel').parsley();
            $('#frmForeignTravel').submit(function (e) {
                e.preventDefault();
                var form = $('#frmForeignTravel')
                if ($(this).parsley().isValid()) {
                    swal({
                        title: 'Are you sure?', text: `Do you want to save this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Save!`
                    }).then((result) => {
                        if (result.value) {
                            var tbl = $('#ForeignTravel-table tbody');
                            var tblCard = $('#foriegnTrvlCard');
                            var data = '';
                            var dataDiv = '';
                            var sl = $('#ForeignTravel-table tbody tr').length + 1;
                            $.ajax({
                                url: '/Employee/EmployeeInfo/SaveForeignTravelData',
                                data: form.serialize(),
                                type: 'POST',
                                success: function (rec) {
                                    swal({
                                        title: 'Saved', type: 'success', confirmButtonColor: '#007ACC', confirmButtonText: `OK!`
                                    }).then(function () {
                                        window.location.reload();
                                    })
                                }
                            });
                        } else if (result.dismiss === 'cancel') {
                            return false;
                        }
                    });
                }
            });

        })

        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (day < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }

        function formatDate2(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (month == 1) { month = "Jan" } else if (month == 2) { month = "Feb" } else if (month == 3) { month = "Mar" } else if (month == 4) { month = "Apr" } else if (month == 5) { month = "May" } else if (month == 6) { month = "Jun" } else if (month == 7) { month = "Jul" } else if (month == 8) { month = "Aug" } else if (month == 9) { month = "Sep" } else if (month == 10) { month = "Oct" } else if (month == 11) { month = "Nov" } else if (month == 12) { month = "Dec" }
            return day + "-" + month + "-" + year
        }

        function foreignTravelUpdate(id, countryId, refNum, purpose, startDate, endDate, duration) {
            var start = '';
            var end = '';
            var ref = '';
            if (startDate != null) {
                start = formatDate2(startDate);
            }
            if (endDate != null) {
                end = formatDate2(endDate);
            }
            if (refNum != 'null' || refNum != '') {

                ref = refNum;
            }
            $('#ForeignTravelId').val(id);
            $('#countryId').val(countryId);
            $('#countryId').trigger('change');
            $('#travelPurpose').val(purpose);
            $('#travelDate').val(start);
            $('#travelEndDate').val(end);
            $('#referenceNumber').val(ref);
            $('#travelDuration').val(duration);
        }

        function deleteForeignTravel(id) {
            swal({
                title: 'Are you sure?', text: `Do you want to delete this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Yes!`
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: "/Employee/EmployeeInfo/DeleteForeignTravelDataById/",
                        type: 'GET',
                        data: { id: id },
                        success: function (response) {
                            if (response == "Success") {
                                swal({
                                    title: 'Success!', text: `Deleted Successfully!`, type: 'success', confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                                }).then(function () {
                                    window.location.reload();
                                });
                            }
                            else {
                                swal('', `Unable To Delete`, 'warning');
                                return false;
                            }
                        }
                    })
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });
        }
    </script>
}



