@model DisciplinaryActionViewModel
@{
    ViewData["Title"] = "Index";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/timepicker/bootstrap-material-datetimepicker.css" rel="stylesheet">

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="pt-2 pb-2 mt-2">
                    @Model.employeeInfo.nameEnglish's @Model.fLang.Title <a class="btn btn-sm btn-info float-right" href="javascript:history.go(-1)">Back</a>
                </h5>

            </div>
            <div class="card-body">
                <form role="form" asp-area="Employee" asp-controller="DisciplinaryAction" asp-action="Index">
                    <input type="hidden" name="DisciplinaryActionId" id="DisciplinaryActionId" value="" />
                    <input type="hidden" name="employeeId" id="employeeId" value="@ViewBag.employeeId" />

                    <div class="row">

                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="">@Model.fLang.Offense</label>
                                <div class="col-md-8 col-12">
                                    <input type="text" id="OffenseName" name="OffenseName" value="" class="form-control" />
                                    @*<select class="form-control" name="OffenseId" id="OffenseId">
                                            <option value="">Select</option>
                                            @foreach (var item in Model.offenses)
                                            {
                                                <option value="@item.Id">@item.offense</option>
                                            }
                                        </select>*@
                                </div>


                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="naturalPunishmentId">Satus</label>
                                <div class="col-md-8 col-12">
                                    <select class="form-control" name="goFileURL" id="status">
                                        <option value="">Select</option>
                                        <option value="On process">On process</option>
                                        <option value="Settled">Settled</option>
                                    </select>

                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row">

                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="">Punishment</label>
                                <div class="col-md-8 col-12">
                                    <input type="text" id="PunishmentName" name="PunishmentName" value="" class="form-control" />
                                </div>


                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="naturalPunishmentId">GO Number</label>
                                <div class="col-md-8 col-12">
                                    <input type="text" id="referenceNumber" name="referenceNumber" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="goNumberWithDate">GO Date</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="goNumberWithDate" name="goNumberWithDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="punishmentDate">@Model.fLang.punishmentDate</label>
                                <div class="col-md-8 col-12">
                                    <input type="text" id="punishmentDate" name="punishmentDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="startingDate">@Model.fLang.startingDate</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="startingDate" name="startingDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="endDate">@Model.fLang.endDate</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="endDate" name="endDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-12 col-12">
                            <div class="form-group row">
                                <label class="col-md-2 col-12" for="remarks">@Model.fLang.remarks</label>

                                <div class="col-md-10 col-12">
                                    <textarea required="" class="form-control" id="remarks" name="remarks" rows="5" data-parsley-id="24"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">@Model.fLang.Title</h4>
            </div>
            <div class="card-body">

                <div class="table-odd">
                    <table id="tblData" class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>@Model.fLang.employee</th>
                                <th>@Model.fLang.Offense</th>
                                <th>Status</th>
                                <th>Punishment</th>
                                <th>GO Number</th>
                                <th>GO Date</th>
                                <th>@Model.fLang.startingDate</th>
                                <th>@Model.fLang.endDate</th>
                                <th>@Model.fLang.punishmentDate</th>
                                <th>Approve Status</th>
                                <th>@Model.fLang.action</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sl = 0;
                                @foreach (var item in Model.disciplinaryActions)
                                {
                                    sl = sl + 1;
                                    <tr>
                                        <td>@sl</td>
                                        <td>@item.employee?.nameEnglish</td>
                                        <td>@item.OffenseName</td>
                                        <td>
                                            @item.goFileURL
                                        </td>
                                        <td>@item.PunishmentName</td>
                                        <td>@item.referenceNumber</td>
                                        <td>@item.goNumberWithDate?.ToString("dd-MMM-yyyy")</td>
                                        <td>@item.startingDate?.ToString("dd-MMM-yyyy")</td>
                                        <td>@item.endDate?.ToString("dd-MMM-yyyy")</td>
                                        <td>@item.punishmentDate?.ToString("dd-MMM-yyyy")</td>
                                        <td>@if (item.status == "0")
                                            {
                                                <label>Pending</label>
                                            }else if (item.status == "1")
                                            {
                                                <label>Pending</label>
                                            }
                                            else if (item.status == "2")
                                            {
                                                <label>Approved</label>
                                            }</td>
                                        <td>
                                            <button type="button" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="Edit(@item.Id,@item.employeeId,'@item.OffenseId','@item.naturalPunishmentId','@item.goNumberWithDate?.ToString("dd-MMM-yyyy")','@item.startingDate?.ToString("dd-MMM-yyyy")','@item.endDate?.ToString("dd-MMM-yyyy")','@item.punishmentDate?.ToString("dd-MMM-yyyy")','@item.remarks','@item.status','@item.referenceNumber','@item.PunishmentName','@item.OffenseName')"><span class="ti-pencil"></span></button>
                                            <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete(@item.Id)"><span class="ti-trash"></span></button>
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/plugins/timepicker/bootstrap-material-datetimepicker.js"></script>
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
            $('#tblData').removeClass("dataTable");
            $('#punishmentDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
            $('#startingDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
            $('#endDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
            $('#goNumberWithDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
        })

        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (day < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }

        function Edit(Id, employeeId, OffenseId, naturalPunishmentId, goNumberWithDate, startingDate, endDate, punishmentDate, remarks, status, referenceNumber, PunishmentName, OffenseName) {
            $("#DisciplinaryActionId").val(Id);
            $("#employeeId").val(employeeId);
            $("#OffenseId").val(OffenseId);
            $("#naturalPunishmentId").val(naturalPunishmentId);
            $("#goNumberWithDate").val(goNumberWithDate);
            $("#startingDate").val(startingDate);
            $("#endDate").val(endDate);
            $("#punishmentDate").val(punishmentDate);
            $("#remarks").val(remarks);
            $("#status").val(status);
            $("#referenceNumber").val(referenceNumber);
            $("#PunishmentName").val(PunishmentName);
            $("#OffenseName").val(OffenseName);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/DisciplinaryAction/DeleteDisciplinaryAction/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

