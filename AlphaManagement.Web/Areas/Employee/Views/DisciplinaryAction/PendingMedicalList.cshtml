@model DisciplinaryActionViewModel
@{
    ViewData["Title"] = "Pending Medical List";
}
<div class="container mt-4">
    <div class="col-12 row m-3">
        <div class="col-3 row">
            <label class="col-3 col-form-label">Unit</label>
            <select class="col-9 form-control-sm" id="unitId">
                <option value="0">Select</option>
                @foreach (var item in Model.specialBranchUnits)
                {
                    <option value="@item.Id">@item.branchUnitName</option>
                }
            </select>
        </div>
        <div class="col-3 row">
            <label class="col-4 col-form-label">Rank</label>
            <select class="col-8 form-control-sm" id="rankId">
                <option value="0">Select</option>
                @foreach (var item in Model.ranks)
                {
                    <option value="@item.Id">@item.rankName</option>
                }
            </select>
        </div>
        <div class="col-3 row">
            <label class="col-4 col-form-label">Batch</label>
            <select class="col-8 form-control-sm" id="bcsId">
                <option value="0">Select</option>
                @foreach (var item in Model.bCSBatches)
                {
                    <option value="@item.Id">@item.batchName</option>
                }
            </select>
        </div>
        <div class="col-3">
            <a href="/Employee/DisciplinaryAction/ApprovedMedicalList" class="btn btn-sm btn-success float-right ml-1">Approved List</a>
            <a href="javascript:void(0)" class="btn btn-sm btn-success float-right" onclick="searchMedicalList()">Search</a>

        </div>
    </div>
    <hr />
    <div class="col-12 row">
        <div class="col-12 text-center">
            <h4>Pending Medical List For Approve</h4>
        </div>
        <div class="col-12">
            <table class="table table-bordered table-striped" style="width:100%" id="tblData">
                <thead>
                    <tr>
                        <td>Sl</td>
                        <td>Employee</td>
                        <td>Rank</td>
                        <td>Unit</td>
                        <td>BCS</td>
                        <td>Category</td>
                        <td>Date</td>
                        <td></td>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
            searchMedicalList();
            $('#tblData').removeClass('dataTable');
            //$('#rankId').select2();
            //$('#bcsId').select2();
        })

        function searchMedicalList() {
            var unit = $('#unitId').val();
            var rank = $('#rankId').val();
            var bcs = $('#bcsId').val();
            Common.Ajax('GET', `/Employee/DisciplinaryAction/GetPendingMedicalList?unitId=${unit}&&rankId=${rank}&&bcsId=${bcs}`, [], 'json', ajaxGetMedicalData, false);
        }

        function ajaxGetMedicalData(res) {
            var tbl = $('#tblData tbody');
            var data = '';

            if (res != '') {
                $.each(res, function (i, v) {
                    var rank = '';
                    var unit = '';
                    var batch = '';
                    var category = '';
                    var date = '';
                    if (v.employeeInfo ?.rank != null) {
                        rank = v.employeeInfo ?.rank ?.rankName;
                    }
                    if (v.employeeInfo ?.branch != null) {
                        unit = v.employeeInfo ?.branch ?.branchUnitName;
                    }
                    if (v.employeeInfo.bCSBatch != null) {
                        batch = v.employeeInfo.bCSBatch ?.batchName;
                    }
                    if (v.medicalSubCategory != null) {
                        category = v.medicalSubCategory.name;
                    }
                    if (v.date != null) {
                        date = formatDate(v.date)
                    }
                    data += `<tr><td>${i + 1}</td><td>${v.employeeInfo.nameEnglish} (${v.employeeInfo.employeeCode})</td><td>${rank}</td><td>${unit}</td><td>${batch}</td><td>${category}</td><td>${date}</td><td><a class="btn btn-success" href="javascript:void(0)" onclick="approveMedical(${v.Id})">Approve</a></td></tr>`;

                })
                tbl.empty();
                tbl.append(data);
                $('#tblData').DataTable();
            }
            else {
                tbl.empty();
                $('#tblData').DataTable();
            }
        }

        function approveMedical(id) {
            swal({
                title: 'Are you sure?', text: `Do you want to approve this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Approve!`
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '/Employee/DisciplinaryAction/ApprovePendingMedicalList',
                        data: { id: id },
                        type: 'GET',
                        success: function (records) {
                            if (records == '1') {
                                swal('', 'Approved Successfully!', 'success').
                                    then(function () {
                                        location.reload();
                                    })
                            }
                            else {
                                swal('', 'Unable To Approve!', 'warning').
                                    then(function () {
                                        return false;
                                    })
                            }
                        },
                        error: function (erro) {
                            console.log(erro);
                            swal('', 'Unable to Save!', 'warning');
                        }
                    });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });
        }

        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (month < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }
    </script>
}