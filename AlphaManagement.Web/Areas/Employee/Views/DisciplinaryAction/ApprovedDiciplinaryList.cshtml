@model DisciplinaryActionViewModel
@{
    ViewData["Title"] = "Approved Disciplinary List";
}
<div class="container mt-4">
    <div class="col-12 row m-3">
        <div class="col-3 row">
            <label class="col-3 col-form-label">Unit</label>
            <select class="col-9 form-control-sm" id="unitId">
                <option value="0">Select</option>
                @foreach (var item in Model.specialBranchUnits)
                {
                    <option value="@item.Id">@item.branchUnitName</option>
                }
            </select>
        </div>
        <div class="col-3 row">
            <label class="col-4 col-form-label">Rank</label>
            <select class="col-8 form-control-sm" id="rankId">
                <option value="0">Select</option>
                @foreach (var item in Model.ranks)
                {
                    <option value="@item.Id">@item.rankName</option>
                }
            </select>
        </div>
        <div class="col-3 row">
            <label class="col-4 col-form-label">Batch</label>
            <select class="col-8 form-control-sm" id="bcsId">
                <option value="0">Select</option>
                @foreach (var item in Model.bCSBatches)
                {
                    <option value="@item.Id">@item.batchName</option>
                }
            </select>
        </div>
        <div class="col-3">
            <a href="javascript:history.go(-1)" class="btn btn-sm btn-success float-right ml-1">Back To List</a>
            <a href="javascript:void(0)" class="btn btn-sm btn-success float-right" onclick="searchDiciplinary()">Search</a>

        </div>
    </div>
    <hr />
    <div class="col-12 row">
        <div class="col-12 text-center">
            <h3>Approved Desciplinary Action List</h3>
        </div>
        <div class="col-12">
            <table class="table table-bordered table-striped" style="width:100%" id="tblData">
                <thead>
                    <tr>
                        <td>Sl</td>
                        <td>Employee</td>
                        <td>Rank</td>
                        <td>Unit</td>
                        <td>BCS</td>
                        <td>Reference Number</td>
                        <td>Offence</td>
                        <td>Status</td>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
            searchDiciplinary();
            //$('#unitId').select2();
            //$('#rankId').select2();
            //$('#bcsId').select2();
        })

        function searchDiciplinary() {
            var unit = $('#unitId').val();
            var rank = $('#rankId').val();
            var bcs = $('#bcsId').val();
            Common.Ajax('GET', `/Employee/DisciplinaryAction/GetApprovedDiciplinaryList?unitId=${unit}&&rankId=${rank}&&bcsId=${bcs}`, [], 'json', ajaxGetDiciplinaryData, false);
        }

        function ajaxGetDiciplinaryData(res) {
            var tbl = $('#tblData tbody');
            var data = '';

            if (res != '') {
                $.each(res, function (i, v) {
                    var rank = '';
                    var unit = '';
                    var batch = '';
                    var refNo = '';
                    var offence = '';
                    if (v.employee ?.rank != null) {
                        rank = v.employee ?.rank ?.rankName;
                    }
                    if (v.employee.branch != null) {
                        unit = v.employee ?.branch ?.branchUnitName;
                    }
                    if (v.employee.bCSBatch != null) {
                        batch = v.employee.bCSBatch ?.batchName;
                    }
                    if (v.referenceNumber != null) {
                        refNo = v.referenceNumber;
                    }
                    if (v.OffenseName != null) {
                        offence = v.OffenseName;
                    }
                    data += `<tr><td>${i + 1}</td><td>${v.employee.nameEnglish} (${v.employee.employeeCode})</td><td>${rank}</td><td>${unit}</td><td>${batch}</td><td>${refNo}</td><td>${offence}</td><td>Approved</td></tr>`;
                    
                })
                tbl.empty();
                tbl.append(data);
                $('#tblData').DataTable();
            }
            else {
                tbl.empty();
                $('#tblData').DataTable();
            }
        }
    </script>
}

