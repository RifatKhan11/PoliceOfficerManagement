@model DisciplinaryActionViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/timepicker/bootstrap-material-datetimepicker.css" rel="stylesheet">

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="pt-2 pb-2 mt-2">
                    @Model.employee?.nameEnglish's Traning Information <a class="btn btn-sm btn-info float-right" href="javascript:history.go(-1)">Back</a>
                </h5>

            </div>
            <div class="card-body">
                <form role="form" asp-area="Employee" asp-controller="DisciplinaryAction" asp-action="TrainingInfo" data-parsley-validate="parsley">
                    <input type="hidden" name="empTrainingId" id="DisciplinaryActionId" value="" />
                    <input type="hidden" name="empId" id="employeeId" value="@Model.employee.Id" />

                    <div class="row">
                        <div class="col-md-6 col-12">

                            <div class="form-group row">
                                <label for="refName" class="col-sm-4 col-form-label">Training Type</label>
                                <div class="col-sm-8">

                                    <select class="form-control" name="trainingTypes" id="trainingTypes">
                                        <option value="">select</option>
                                        <option value="local">Local Training</option>
                                        <option value="foreign">Foreign Training</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="refDesignation" class="col-sm-4 col-form-label">Training Title<span style="color:red">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="trainingName" name="trainingName" data-parsley-required="true">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="refName" class="col-sm-4 col-form-label">Training Category</label>
                                <div class="col-sm-8">
                                    <select class="form-control" name="trainingCategoryId" id="trainingCategoryId">
                                        <option value="">select</option>
                                        @foreach (var item in Model.trainingCategories.Where(x => x.isDelete == 0))
                                        {
                                            <option value="@item.Id">@item.trainingCategoryName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row" id="trainingInstituteDropdownDiv">
                                <label for="refOrganization" class="col-sm-4 col-form-label">Training Institute</label>
                                <div class="col-sm-8">
                                    <select class="select2 form-control" style="width:100%" id="trainingInstituteId" name="trainingInstituteId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.trainingInstitutes.OrderBy(x => x.trainingInstituteName))
                                        {
                                            <option value="@item.Id">@item.trainingInstituteName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row" style="display:none" id="OtherInstituteNameDiv">
                                <label for="Other" class="col-sm-4 col-form-label">InstituteName</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="Other" name="Other">
                                </div>
                            </div>


                            <div class="form-group row">
                                <label for="specialSkillTypeId" class="col-sm-4 col-form-label">Special Skill<span style="color:red">*</span></label>
                                <div class="col-sm-8">
                                    <select class="select2 form-control" style="width:100%" name="specialSkillTypeId" id="specialSkillTypeId" data-parsley-required="true">
                                        <option value="">Select</option>
                                        @foreach (var data in Model.specialSkillTypes)
                                        {
                                            <option value="@data.Id">@data.name</option>
                                        };
                                    </select>
                                </div>
                            </div>


                        </div>


                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label for="localRefId" class="col-sm-4 col-form-label">Reference Number</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="localRefId" name="referenceNum">
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="refContact" class="col-sm-4 col-form-label">Start Date</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="localTrStDate" name="fromDate" readonly>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="refEmail" class="col-sm-4 col-form-label">End Date</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" name="toDate" id="localTrEdDate" readonly>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="trainingCountryId" class="col-sm-4 col-form-label">Training Country</label>
                                <div class="col-sm-8">
                                    <select class="select2 form-control" style="width:100%" name="trainingCountryId" id="trainingCountryId">
                                        <option value="">Select</option>
                                        @foreach (var data in Model.countries)
                                        {
                                            <option value="@data.Id">@data.countryName</option>
                                        };
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">Traning Information</h4>
            </div>
            <div class="card-body">

                <div class="table-odd">
                    <table id="tblData" class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>Employee</th>
                                <th>Training Category</th>
                                <th>Training Title</th>
                                <th>Training Institute</th>
                                <th>Special Skill</th>
                                <th>From Date</th>
                                <th>To Date</th>
                                <th>Training Country</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sl = 0;
                                @foreach (var item in Model.traningLogs)
                                {
                                    sl = sl + 1;
                                    <tr>
                                        <td>@sl</td>
                                        <td>@item.employee?.nameEnglish</td>
                                        <td>@item.trainingCategory?.trainingCategoryName</td>
                                        <td>@item.trainingTitle</td>
                                        <td>@item.trainingInstitute?.trainingInstituteName</td>
                                        <td>@item.specialSkillType?.name</td>
                                        <td>@item.fromDate?.ToString("dd-MMM-yyyy")</td>
                                        <td>@item.toDate?.ToString("dd-MMM-yyyy")</td>
                                        <td>@item.country?.countryName</td>
                                        <td>
                                            @if (item.createdBy != Model.employee.employeeCode) 
                                            {
                                                <a href="#" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="Edit(@item.Id,@item.employeeId,'@item.trainingCategoryId','@item.trainingTitle','@item.trainingInstituteId','@item.referenceNumber','@item.fromDate?.ToString("dd-MMM-yyyy")','@item.toDate?.ToString("dd-MMM-yyyy")','@item.countryId','@item.trainingType','@item.specialSkillTypeId')"><span class="ti-pencil"></span></a>
                                                <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete('@item.Id')"><span class="ti-trash"></span></button>

                                            }
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/plugins/timepicker/bootstrap-material-datetimepicker.js"></script>
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

            $('#localTrStDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
            $('#localTrEdDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
        })

        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (day < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }

        function Edit(Id, employeeId, trainingCategoryId, trainingTitle, trainingInstituteId, referenceNumber, fromDate, toDate, countryId, trainingType, specialSkillTypeId) {
            $("#DisciplinaryActionId").val(Id);
            $("#employeeId").val(employeeId);
            $("#trainingName").val(trainingTitle);
            $("#trainingCategoryId").val(trainingCategoryId);
            $("#trainingInstituteId").val(trainingInstituteId);
            $("#referenceNum").val(referenceNumber);
            $("#localTrStDate").val(fromDate);
            $("#localTrEdDate").val(toDate);
            $("#trainingCountryId").val(countryId);
            $("#trainingTypes").val(trainingType);
            $("#specialSkillTypeId").val(specialSkillTypeId);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/DisciplinaryAction/DeleteTraining/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

