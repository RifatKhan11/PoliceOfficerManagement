@model DisciplinaryActionViewModel
@{
    ViewData["Title"] = "Medical Report Info";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/timepicker/bootstrap-material-datetimepicker.css" rel="stylesheet">

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="pt-2 pb-2 mt-2">
                    @Model.employee?.nameEnglish's Medical Report <a class="btn btn-sm btn-info float-right" href="javascript:history.go(-1)">Back</a>
                </h5>

            </div>
            <div class="card-body">
                <form role="form" asp-area="Employee" asp-controller="DisciplinaryAction" asp-action="Medicalinfo" data-parsley-validate="parsley">
                    <input type="hidden" name="DisciplinaryActionId" id="DisciplinaryActionId" value="" />
                    <input type="hidden" name="employeeId" id="employeeId" value="@Model.employee.Id" />

                    <div class="row">
                        @*<div class="col-md-6 col-12">

                            <div class="form-group row">
                                <label for="refName" class="col-sm-4 col-form-label">Main Category</label>
                                <div class="col-sm-8">
                                    <select class="form-control" name="mainCategoryId" id="mainCategoryId">
                                        <option value="">select</option>
                                        @foreach (var data in Model.medicalMainCategories)
                                        {
                                            <option value="@data.Id">@data.name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                        </div>*@


                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label for="refName" class="col-sm-4 col-form-label">Category</label>
                                <div class="col-sm-8">
                                    <select class="form-control" name="year" id="SubCategoryId" required>
                                        <option value="">select</option>
                                        @foreach (var data in Model.medicalSubCategories)
                                        {
                                            <option value="@data.Id">@data.name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                        </div>

                        <div class="col-md-12 col-12">
                            <div class="form-group row">
                                <label for="refContact" class="col-sm-2 col-form-label"> Details</label>
                                <div class="col-sm-10">
                                    <textarea type="text" rows="15" class="form-control" id="description" name="remarks"></textarea>
                                </div>
                            </div>

                        </div>


                    </div>

                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">Medical History Report</h4>
            </div>
            <div class="card-body">

                <div class="table-odd">
                    <table id="tblData" class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>Employee</th>
                                @*<th>Main Category</th>*@
                                <th>Sub Category</th>
                                <th>Details</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sl = 0;
                                @foreach (var item in Model.employeeMadicalInfos)
                                {
                                    sl = sl + 1;
                                    <tr>
                                        <td>@sl</td>
                                        <td>@item.employeeInfo?.nameEnglish</td>
                                        @*<td>@item.medicalSubCategory.medicalMainCategory.name</td>*@
                                        <td>@item.medicalSubCategory.name</td>
                                        <td>@item.medicalSubCategory.description</td>
                                        <td>
                                            <a href="#" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="Edit(@item.Id,@item.employeeInfoId,'@item.medicalSubCategoryId','@item.medicalSubCategory.medicalMainCategoryId','@Html.Raw(HttpUtility.JavaScriptStringEncode(@item.medicalSubCategory.description))')"><span class="ti-pencil"></span></a>
                                            <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete('@item.Id')"><span class="ti-trash"></span></button>

                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/plugins/timepicker/bootstrap-material-datetimepicker.js"></script>
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

            $('#localTrStDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
            $('#localTrEdDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });

            $("#mainCategoryId").change(function () {
                var id = $(this).val();
                Common.Ajax('GET', '/Employee/DisciplinaryAction/GetMedicalSubCatbyMainId?id=' + id, [], 'json', ajaxCategory, false);
            });

            $("#SubCategoryId").change(function () {
                var id = $(this).val();
                Common.Ajax('GET', '/Employee/DisciplinaryAction/GetMedicalSubCatbyId?id=' + id, [], 'json', ajaxSubCategory, false);
            });
        })

        function ajaxCategory(response) {
            var options = '';
            options += '<option value="">select</option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.name + '</option>';
            });
            $('#SubCategoryId').empty();
            $('#SubCategoryId').append(options);
        }

        function ajaxSubCategory(res) {
            $('#description').text("");
            $('#description').text(res.description);
        }

        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (day < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }

        function Edit(Id, employeeId, medicalSubCategoryId, medicalMainCategoryId, description) {
            $("#DisciplinaryActionId").val(Id);
            $("#employeeId").val(employeeId);
            $("#mainCategoryId").val(medicalMainCategoryId);
            Common.Ajax('GET', '/Employee/DisciplinaryAction/GetMedicalSubCatbyMainId?id=' + medicalMainCategoryId, [], 'json', ajaxCategory, false);
            $("#SubCategoryId").val(medicalSubCategoryId);
            $("#description").text(description);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/DisciplinaryAction/DeleteMedicalinfo/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

