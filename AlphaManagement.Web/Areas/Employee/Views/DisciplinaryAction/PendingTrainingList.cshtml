@model DisciplinaryActionViewModel
@{
    ViewData["Title"] = "Pending Training List";
}
<div class="container mt-4">
    <div class="col-12 row m-3">
        <div class="col-3 row">
            <label class="col-3 col-form-label">Unit</label>
            <select class="col-9 form-control-sm" id="unitId">
                <option value="0">Select</option>
                @foreach (var item in Model.specialBranchUnits)
                {
                    <option value="@item.Id">@item.branchUnitName</option>
                }
            </select>
        </div>
        <div class="col-3 row">
            <label class="col-4 col-form-label">Rank</label>
            <select class="col-8 form-control-sm" id="rankId">
                <option value="0">Select</option>
                @foreach (var item in Model.ranks)
                {
                    <option value="@item.Id">@item.rankName</option>
                }
            </select>
        </div>
        <div class="col-3 row">
            <label class="col-4 col-form-label">Batch</label>
            <select class="col-8 form-control-sm" id="bcsId">
                <option value="0">Select</option>
                @foreach (var item in Model.bCSBatches)
                {
                    <option value="@item.Id">@item.batchName</option>
                }
            </select>
        </div>
        <div class="col-3">
            <a href="/Employee/DisciplinaryAction/ApprovedTrainingList" class="btn btn-sm btn-success float-right ml-1">Approved List</a>
            <a href="javascript:void(0)" class="btn btn-sm btn-success float-right" onclick="searchDiciplinary()">Search</a>

        </div>
    </div>
    <hr />
    <div class="col-12 row">
        <div class="col-12 text-center">
            <h4>Pending Training List For Approve</h4>
        </div>
        <div class="col-12">
            <table class="table table-bordered table-striped" style="width:100%" id="tblData">
                <thead>
                    <tr>
                        <td>Sl</td>
                        <td>Employee</td>
                        <td>Rank</td>
                        <td>Unit</td>
                        <td>BCS</td>
                        <td>Reference Number</td>
                        <td>Title</td>
                        <td>Type</td>
                        <td>Institute</td>
                        <td>Category</td>
                        <td>Date</td>
                        <td></td>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
            searchDiciplinary();
            $('#tblData').removeClass('dataTable');
            //$('#rankId').select2();
            //$('#bcsId').select2();
        })

        function searchDiciplinary() {
            var unit = $('#unitId').val();
            var rank = $('#rankId').val();
            var bcs = $('#bcsId').val();
            Common.Ajax('GET', `/Employee/DisciplinaryAction/GetPendingTrainingList?unitId=${unit}&&rankId=${rank}&&bcsId=${bcs}`, [], 'json', ajaxGetTrainingData, false);
        }

        function ajaxGetTrainingData(res) {
            var tbl = $('#tblData tbody');
            var data = '';

            if (res != '') {
                $.each(res, function (i, v) {
                    var rank = '';
                    var unit = '';
                    var batch = '';
                    var refNo = '';
                    var title = '';
                    var institute = '';
                    var category = '';
                    var type = '';
                    var country = '';
                    var date = '';
                    if (v.employee ?.rank != null) {
                        rank = v.employee ?.rank ?.rankName;
                    }
                    if (v.employee?.branch != null) {
                        unit = v.employee ?.branch ?.branchUnitName;
                    }
                    if (v.employee.bCSBatch != null) {
                        batch = v.employee.bCSBatch ?.batchName;
                    }
                    if (v.referenceNumber != null) {
                        refNo = v.referenceNumber;
                    }
                    if (v.trainingTitle != null) {
                        title = v.trainingTitle;
                    }
                    if (v.trainingInstitute != null) {
                        institute = v.trainingInstitute.trainingInstituteName;
                    }
                    if (v.trainingCategory != null) {
                        category = v.trainingCategory.trainingCategoryName;
                    }
                    if (v.trainingType != null) {
                        if (v.trainingType == 'local') {
                            type = 'Local';
                        }
                        else if (v.trainingType == 'foreign') {
                            type = 'Foreign';
                            if (v.country!=null) {
                                country = ` (${v.country.countryName})`;
                            }                            
                        }
                    }
                    if (v.fromDate != null) {
                        if (v.toDate != null) {
                            date = formatDate(v.fromDate) + ' to ' + formatDate(v.toDate);
                        }
                        else {
                            date = formatDate(v.fromDate)
                        }
                    }
                    data += `<tr><td>${i + 1}</td><td>${v.employee.nameEnglish} (${v.employee.employeeCode})</td><td>${rank}</td><td>${unit}</td><td>${batch}</td><td>${refNo}</td><td>${title}</td><td>${type} ${country}</td><td>${institute}</td><td>${category}</td><td>${date}</td><td><a class="btn btn-success" href="javascript:void(0)" onclick="approveTraining(${v.Id})">Approve</a></td></tr>`;

                })
                tbl.empty();
                tbl.append(data);
                $('#tblData').DataTable();
            }
            else {
                tbl.empty();
                $('#tblData').DataTable();
            }
        }

        function approveTraining(id) {
            swal({
                title: 'Are you sure?', text: `Do you want to approve this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Approve!`
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '/Employee/DisciplinaryAction/ApprovePendingTrainingList',
                        data: { id: id },
                        type: 'GET',
                        success: function (records) {
                            if (records == '1') {
                                swal('', 'Approved Successfully!', 'success').
                                    then(function () {
                                        location.reload();
                                    })
                            }
                            else {
                                swal('', 'Unable To Approve!', 'warning').
                                    then(function () {
                                        return false;
                                    })
                            }
                        },
                        error: function (erro) {
                            console.log(erro);
                            swal('', 'Unable to Save!', 'warning');
                        }
                    });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });
        }

        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (month < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }
    </script>
}

