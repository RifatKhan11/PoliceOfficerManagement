@model DisciplinaryActionViewModel
@{
    ViewData["Title"] = "SB Report Info";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/timepicker/bootstrap-material-datetimepicker.css" rel="stylesheet">

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="pt-2 pb-2 mt-2">
                    @Model.employee?.nameEnglish's SB Report <a class="btn btn-sm btn-info float-right" href="javascript:history.go(-1)">Back</a>
                </h5>

            </div>
            <div class="card-body">
                <form role="form" asp-area="Employee" asp-controller="DisciplinaryAction" asp-action="SBinfo" data-parsley-validate="parsley">
                    <input type="hidden" name="DisciplinaryActionId" id="DisciplinaryActionId" value="" />
                    <input type="hidden" name="type" id="type" value="SB" />
                    <input type="hidden" name="employeeId" id="employeeId" value="@Model.employee.Id" />

                    <div class="row">
                        <div class="col-md-6 col-12">

                            <div class="form-group row">
                                <label for="refName" class="col-sm-4 col-form-label">Year</label>
                                <div class="col-sm-8">
                                    <select class="form-control" name="year" id="year">
                                        <option value="">select</option>
                                        @for (int i = 1970; i < 2050; i++)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    </select>
                                </div>
                            </div>

                        </div>


                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label for="refContact" class="col-sm-4 col-form-label"> Date</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="localTrStDate" name="startingDate" readonly>
                                </div>
                            </div>

                        </div>


                        <div class="col-md-12 col-12">
                            <div class="form-group row">
                                <label for="refContact" class="col-sm-2 col-form-label"> Details Report</label>
                                <div class="col-sm-10">
                                    <textarea type="text" rows="5" class="form-control" id="description" name="status"></textarea>
                                </div>
                            </div>

                        </div>


                    </div>

                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">SB Report</h4>
            </div>
            <div class="card-body">

                <div class="table-odd">
                    <table id="tblData" class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>Employee</th>
                                <th>Year</th>
                                <th>Date</th>
                                <th>Details Report</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sl = 0;
                                @foreach (var item in Model.employeeReportInfos)
                                {
                                    sl = sl + 1;
                                    <tr>
                                        <td>@sl</td>
                                        <td>@item.employeeInfo?.nameEnglish</td>
                                        <td>@item.year</td>
                                        <td>@item.date?.ToString("dd-MMM-yyyy")</td>
                                        <td>@item.description</td>
                                        <td>
                                            <a href="#" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="Edit(@item.Id,@item.employeeInfoId,'@item.year','@item.date?.ToString("dd-MMM-yyyy")','@Html.Raw(HttpUtility.JavaScriptStringEncode(@item.description))')"><span class="ti-pencil"></span></a>
                                            <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete('@item.Id')"><span class="ti-trash"></span></button>

                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/plugins/timepicker/bootstrap-material-datetimepicker.js"></script>
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

            $('#localTrStDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
            $('#localTrEdDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
        })

        function formatDate(date) {
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (day < 10) {
                month = '0' + month
            }
            return day + "-" + month + "-" + year
        }

        function Edit(Id, employeeId, year, date, description) {
            $("#DisciplinaryActionId").val(Id);
            $("#employeeId").val(employeeId);
            $("#year").val(year);
            $("#localTrStDate").val(date);
            $("#description").text(description);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/DisciplinaryAction/DeleteBPAinfo/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

