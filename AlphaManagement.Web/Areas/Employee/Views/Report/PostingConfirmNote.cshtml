@model PostingReportViewModel
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "pdf";
    Layout = "~/Views/Shared/_PrintView.cshtml";
    var baseUrl = "http://portfolio.police.gov.bd";
}
<style>
    @@import url('https://fonts.maateen.me/solaiman-lipi/font.css');

    body {
        font-family: 'SolaimanLipi', Arial, sans-serif !important;
    }

    .vertical {
        border-left: 1px solid black;
        height: 100%;
        position: absolute;
        left: 7%;
    }
</style>
<div class="vertical"></div>
<div class="row">
    <div class="col-1">

    </div>
    <div class="col-11 mr-5">
        <h5 class="">@Model.assignments?.FirstOrDefault()?.assignmentMaster?.noteSheetTitle</h5>
    </div>
</div>
<div class="row">
    <div class="col-1">

    </div>
    <div class="col-11">
        <table class="table table-bordered">
            @{
                int i = 1;
                @foreach (var item in Model.aVM)
                {
                    <tr>
                        <td><h5>@AlphaManagement.Web.Helpers.LanguageProcessing.EnglishToBangla(i.ToString() + ".")</h5></td>
                        <td>
                            <h5>
                                @item?.nameBangla, (বিপি-@LanguageProcessing.EnglishToBangla(item?.employeeCode))
                                <br /> @item?.currentPostingPlace
                                <br /> জন্ম তারিখ : @LanguageProcessing.EnglishToBangla(item?.dateOfBirth)
                                <br /> জন্ম জেলা : @item?.homeDistrict
                                <br /> শিক্ষাগত যোগ্যতা : @item?.EducationQualification
                                <br /> ক্যাডারে যোগদানের তারিখ :  @LanguageProcessing.EnglishToBangla(item?.joiningDate)
                                <br /> @item?.currentPostingPlace পদে পদোন্নতি : @LanguageProcessing.EnglishToBangla(item?.promotionDate)
                                <br /> বর্তমান কর্মস্থলে যোগদান : @LanguageProcessing.EnglishToBangla(item?.joiningDateCurrentPlace)
                                <br /> পূর্ববর্তী কর্মস্থল : @item?.PreviousPostingPlace
                            </h5>
                        </td>
                        <td>
                            <h5 class="text-center">
                                @item?.RankName <br />  @item?.NewPostingPlace
                            </h5>
                        </td>
                    </tr>
                    i++;
                }
            }

        </table>
    </div>
</div>
<div class="row">
    <div class="col-1"></div>
    <div class="col-11 mt-2 mr-2">
        <h5>সদয় আদেশের জন্য পেশ করা হলো।</h5>
    </div>
</div>
<div class="row">
    <div class="col-1"></div>
    <div class="col-11">
        <h5>@Model.assignments?.FirstOrDefault()?.assignmentMaster?.noteSheetDescription</h5>
    </div>
</div>
<div class="row mt-5">
    <div class="col-1"></div>
    <div class="col-11">
        <table class="ml-5">
            <tbody>
                <tr class="mt-5 mb-5">
                    <td class="text-center mb-5" style="width:33%">
                        <img class="text-center" height="80" style="width:70%" src="~/EmpImages/addldigpm1.png" />
                        <br />
                        <div class="text-center"><p style="font-size:18px;"><u>অ্যাডিশনাল ডিআইজি (পিএম-১)</u></p></div>
                    </td>
                    <td class="text-center mb-5"  style="width:33%">
                        <img class="text-center mr-4" height="80" width="70%" src="~/EmpImages/digadmin.png" />
                        <br />
                        <div class="text-center"> <p style="font-size:18px;"><u>ডিআইজি (এঅ্যান্ডডি)</u></p></div>
                    </td>
                    <td class="text-center mb-5"  style="width:33%">
                        <img class="text-center" height="80" width="70%" src="~/EmpImages/addligp.png" />
                        <br />
                        <div class="text-center"><p style="font-size:18px;"><u>অ্যাডিশনাল আইজিপি (এঅ্যান্ডআই)</u></p></div>
                    </td>
                </tr>
                <tr class="mt-5">
                    <td>
                        <br />
                        <br />
                        <br />
                        <qrcode style="float:right;" content="Memorandum no : @Model?.assignments?.FirstOrDefault()?.assignmentMaster?.memorandumNo,Reference No :  @Model?.assignments?.FirstOrDefault()?.assignmentMaster?.refNo,Posting Order Date :  @Model?.assignments?.FirstOrDefault()?.assignmentMaster?.refDate.ToString("dd/MM/yyyy")" width="100" height="100"></qrcode>
                    </td>
                    <td>
                        <br />
                        <br />
                        <img class="right" style="height:30%;" src="~/EmpImages/igp.png" />
                        <div class="text-left mt-2 ml-4 pl-4"><h5><u>আইজিপি</u></h5></div>
                    </td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>






