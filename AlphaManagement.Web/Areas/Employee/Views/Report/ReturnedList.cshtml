@model PostingReportViewModel
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "pdf";
    Layout = "~/Views/Shared/_PrintView.cshtml";
}


<div style="padding-bottom:3%">
    <h6 class="text-center text-justify">গণপ্রজাতন্ত্রী বাংলাদেশ সরকার <br /> বাংলাদেশ পুলিশ<br /> পুলিশ হেডকোয়ার্টার্স <br /> ৬, ফিনিক্স রোড, ফুলবাড়িয়া <br /> ঢাকা-১০০০<br /> www.police.gov.bd</h6>
</div>


<div class="row">
    <div class="col-6">
        <label for="example-search-input" class="col-md-4 col-12 col-form-label">Ref No- @Model.assignments?.FirstOrDefault()?.assignmentMaster?.refNo<span style="color:red"></span></label>
    </div>
    <div class="col-3">

    </div>
    <div class="col-3">
        <div class="form-group row">
            <label for="example-search-input" class="col-md-3 col-12 col-form-label">Date: @Model.assignments?.FirstOrDefault()?.assignmentMaster?.refDate.ToString("dd-MMM-yyyy")<span style="color:red"></span></label>

        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <table class="table table-bordered table-striped">
            <thead>
                <tr class="table-sm" style="background-color:#ff6a00;">
                    <td>Sl No</td>
                    <td>Bp No</td>
                    <td>Name</td>
                    <td>Rank</td>
                    <td>Batch</td>
                    <td>Working Period</td>
                    <td>Previous Posting Place</td>
                    <td>Posted Posting Place</td>
                    <td>Comment</td>
                </tr>
            </thead>
            <tbody>

                @{
                    int i = 1;
                    @foreach (var item in Model.assignments)
                    {
                        string colorCode = "";
                        if (Convert.ToDateTime(item.employee?.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-2))
                        {
                            colorCode = "#f17878";
                        }
                        else if (Convert.ToDateTime(item.employee?.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-1) && Convert.ToDateTime(item.employee?.joiningDatePresentWorkstation).Date > DateTime.Now.AddYears(-2))
                        {
                            colorCode = "yellow";
                        }
                        else
                        {
                            colorCode = "#00BCD2";
                        }
                        <tr style="background-color: @colorCode">
                            <td>@i</td>
                            <td>@item.employee?.employeeCode</td>
                            <td>
                                @item.employee?.nameEnglish
                                @{
                                    int?[] doctor = { 69 };
                                    int?[] eng = { 59 };
                                    int?[] llb = { 79 };

                                    int? doctorInfo = Model.educations.Where(x => doctor.Contains(x.degreeId) && x.employeeId == item.Id).Count();
                                    int? engInfo = Model.educations.Where(x => eng.Contains(x.degreeId) && x.employeeId == item.Id).Count();
                                    int? llbInfo = Model.educations.Where(x => llb.Contains(x.degreeId) && x.employeeId == item.Id).Count();

                                    @if (doctorInfo > 0)
                                    {
                                        <img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />
                                    }
                                    else if (engInfo > 0)
                                    {
                                        <img src="~/batch/engineer.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                    }

                                    else if (llbInfo > 0)
                                    {
                                        <img src="~/batch/advocate.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                    }
                                    else
                                    {
                                        @*<img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:50px; height:50px" />*@
                                    }
                                }
                            </td>
                            <td>@item.employee?.rank?.rankName</td>
                            <td>@item.employee?.bCSBatch?.batchName</td>
                            <td>@item.employee?.servicePeriod</td>
                            <td>@item.employee?.section?.Name, @item.employee?.section?.specialBranchUnit?.districts?.districtName</td>
                            <td>@item.section?.Name, @item.section?.specialBranchUnit?.districts?.districtName</td>
                            <td id="result-@item.Id">@item?.Remarks</td>
                        </tr>
                                        i++;

                                    }
                }
            </tbody>

        </table>
    </div>
</div>  <br />