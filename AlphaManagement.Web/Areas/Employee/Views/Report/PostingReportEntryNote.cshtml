@model PostingReportViewModel
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Style{
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        @@import url('https://fonts.maateen.me/adorsho-lipi/font.css');

        body {
            font-family: 'Source Sans Pro', sans-serif;
            font-family: 'AdorshoLipi', sans-serif;
        }

        li input:focus {
            outline: none;
        }
    </style>
}
<div class="card">
    <div class="card-body">

        <div class="row">
            <div class="col-2">
            </div>
            <div class="col-2">
                <qrcode style="float:right;margin-left:20px;" content="Memorandum no :@AlphaManagement.Web.Helpers.LanguageProcessing.BanglaToEnglish(Model?.assignments?.FirstOrDefault().assignmentMaster?.memorandumNo),Reference No :  @Model?.assignments?.FirstOrDefault().assignmentMaster?.refNo,Posting Order Date :  @Model?.assignments?.FirstOrDefault().assignmentMaster?.refDate.ToString("dd/MM/yyyy")" width="100" height="100"></qrcode>
            </div>
            <div class="col-4">
                <h5 class="text-center text-justify">গণপ্রজাতন্ত্রী বাংলাদেশ সরকার <br /> বাংলাদেশ পুলিশ<br /> পুলিশ হেডকোয়ার্টার্স <br /> ৬, ফিনিক্স রোড, ফুলবাড়িয়া <br /> ঢাকা-১০০০</h5>
            </div>
            <div class="col-2">
                <img src="~/images/sheikh100.png" style="height:80px;width:120px" />
            </div>
            <div class="col-2">
            </div>
        </div>
        <form action="/" method="post" id="fromId">
            <input type="hidden" name="assignMasterId" id="assignMasterId" value="@ViewBag.Id" />
            <input type="hidden" id="anulipiId" value="" />
            <div class="container">

                <div class="row">
                    <div class="col-6">
                        <div class="form-group row">
                            <label for="example-search-input" class="col-md-4 col-12 col-form-label">স্মারক নং<span style="color:red">*</span></label>
                            <div class="col-md-8 col-12">
                                <input type="text" name="refNo" id="refNo" value="" class="form-control" />
                                <input type="hidden" value="@Model.assignments?.FirstOrDefault()?.assignmentMaster?.refNo" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="col-2">

                    </div>
                    <div class="col-4">
                        <div class="form-group row">
                            <label for="example-search-input" class="col-md-3 col-12 col-form-label">তারিখঃ<span style="color:red">*</span></label>
                            <div class="col-md-9 col-12">
                                <input class="form-control" type="text" id="refDate" data-parsley-required="true" name="refDate" value="@Model.assignments?.FirstOrDefault()?.assignmentMaster?.refDate.ToString("dd-MMM-yyyy")">
                            </div>
                        </div>
                    </div>
                    <div class="col-12 mb-3">
                        <h6 class="text-center"><u>প্রজ্ঞাপন</u></h6>
                        <textarea class="form-control form-control-lg" style="font-size:17px" name="title" id="title">নিন্মবর্ণিত কর্মকর্তাগণকে পরবর্তী নির্দেশ না দেওয়া পর্যন্ত জনস্বার্থে তাদের নামের পাশে উল্লেখিত পদে/স্থানে বদলি/পদায়ন করা হলোঃ-</textarea>
                        @*<input class="form-control form-control-lg" style="font-size:17px" type="text" name="title" id="title" value="নিন্মবর্ণিত কর্মকর্তাগণকে পরবর্তী নির্দেশ না দেওয়া পর্যন্ত জনস্বার্থে তাদের নামের পাশে উল্লেখিত পদে/স্থানে বদলি/পদায়ন করা হলোঃ-" />*@
                    </div>
                    <div class="col-12">
                        <table class="table table-bordered">
                            @{ var i = 1;
                                var namef = "জনাব";

                                @foreach (var item in Model.assignments)
                                {
                                    <tr>
                                        <td style="font-size:20px">@LanguageProcessing.EnglishToBangla(i.ToString()+".")</td>
                                        <td>
                                            <h5>@namef @item.employee.nameBangla (@LanguageProcessing.EnglishToBangla(@item.employee.employeeCode))</h5>
                                            @if (item.employee?.section?.specialBranchUnit?.isdefault == 1)
                                            {
                                                <h5>@item.employee?.rank?.shortName</h5>
                                            }
                                            else
                                            {
                                                <h5>@item.employee?.rank?.rankNameBN</h5>
                                            }
                                            <h5>@item.employee?.section?.NameBN, @item.employee?.section?.specialBranchUnit?.districts?.districtNameBn</h5>
                                        </td>
                                        <td>
                                            @if (item?.section?.specialBranchUnit?.isdefault == 1)
                                            {
                                                <h5>@item.employee?.rank?.shortName</h5>
                                            }
                                            else
                                            {
                                                <h5>@item.employee?.rank?.rankNameBN</h5>
                                            }
                                            <h5>@item?.section?.NameBN, @item?.section?.specialBranchUnit?.districts?.districtNameBn</h5>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </table>
                    </div>
                    <div class="col-12">
                        <div class="form-group row">
                            <div class="col-md-12 col-12">
                                <textarea class="form-control" rows="5" name="description" id="description">পুলিশ হেটকোয়ার্টার্সের বিজ্ঞপ্তি নং- . . . . . . .  . . . . . . ., তারিখ-@LanguageProcessing.EnglishToBangla(DateTime.Now.Date.ToString("dd/MM/yyyy")) খ্রিঃ, মোতাবেক জারীকৃত ক্রমিক নং-১ এ বর্ণিত কর্মকর্তা জনাব আসিফ মহিউদ্দিন (বিপি-৮৩৯৪৮৯৩৪৮), অতিনিক্ত পুলিশ কমিশনার, সিএমপি, চ্ট্টগ্রাম এ  অতিরিক্ত পুলিশ সুপার, সদর সার্কেল, পটুয়াখালি হিসেবে বদলির আদেশ এত দ্বারা বাতিল করা হলো।</textarea>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <h6>
                            স্মারক নং-<span id="sNo"> . . . . . . .  . . . . . . .</span>
                        </h6>
                        <h6 class="mr-4">অনুলিপি সদয় অবগতির ও প্রয়োজনীয় ব্যবস্থা গ্রহণের জন্য প্রেরণ করা হলো (জ্যেষ্ঠতার ভিত্তিতে নয়) :-</h6> <hr />

                    </div>
                    <div class="col-12">
                        <ol class="item">
                            @{ int j = 0;}
                            @foreach (var item in Model.anulipiLists)
                            {
                                <li class="ui-state-default" id="li-@j">
                                    <input id="a-@item.Id" type="checkbox" name="anulipiIds" onclick="checkInput(@item.Id)" value="@item.Id" />
                                    <label id="anulipiLbl-@item.Id">@item.copyName</label>
                                    <input type="text" id="anulipi-@item.Id" style="display:none" size="@item.copyName.Length" onkeyup="updateLabel()" ondblclick="disableWriting(@item.Id)" value="@item.copyName" />
                                    <i class="fa fa-edit" onclick="editAulilipy(@item.Id)" title="Edit" style="color:red"></i>
                                    <i class="fa fa-plus" id="addNew-@j" onclick="addNewAulilipy(@j)" title="Add" style="color:green"></i>
                                </li>
                                j++;
                            }
                        </ol>
                    </div>
                </div>
                <input type="button" id="sub" class="btn btn-primary float-right" name="name" value="Submit" />
                @*@if (Model?.assignments?.FirstOrDefault()?.assignmentMaster?.statusId == 3)
                    {
                        <input type="button" id="sub" class="btn btn-primary float-right" name="name" value="Submit" />
                    }*@
                @*<a asp-action="PostingReport" asp-controller="Report" onclick="approve1('@Model.assignments?.FirstOrDefault()?.assignmentMasterId')"  class="btn btn-primary float-right" target="_blank">Submit</a>*@
            </div>

        </form>
    </div>
</div>
@section Scripts{
    <script src="~/js/jquery-ui.js"></script>
    <script src="~/js/jquery-ui.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pure.js/2.82/pure.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pure.js/2.82/pure.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            $("#refDate").flatpickr({enableTime: false,dateFormat: "d-M-Y"});
            $(".item").sortable({
                connectWith: '.item',
                appendTo: 'body',
                tolerance: 'pointer',
                revert: 'invalid',
                helper: function (event, element) {
                    return element.clone().appendTo("body")
                },
                forceHelperSize: true,
                scroll: false,
            }).disableSelection();

            $("#refNo").keyup(function () {
                var data = $('#refNo').val();
                $("#sNo").empty();
                $("#sNo").append(data);
            });

            function redirect() {
                var url = "/Employee/Report/PostingReportPdf";
                window.location(url);
            }

        });

        function editAulilipy(id) {
            var oldId = $('#anulipiId').val();
            if (oldId != id) {
                $('#anulipiLbl-' + oldId).removeAttr('style', 'display:none')
                $('#anulipi-' + oldId).attr('style', 'display:none')
            }
            $('#anulipiId').val(id);
            $('#anulipi-' + id).show();
            $('#anulipiLbl-' + id).attr('style','display:none');
        }

        function updateLabel(){
            var id = $('#anulipiId').val();
            var value = $('#anulipi-' + id).val();
            $('#anulipiLbl-' + id).empty();
            $('#anulipiLbl-' + id).append(value);
            $('#anulipi-' + id).attr('size',(value.length + 1));
        }

        $(document).on('keypress', function (e) {
            if (e.which == 13) {
                var id = $('#anulipiId').val();
                $('#anulipiLbl-' + id).removeAttr('style', 'display:none')
                $('#anulipi-' + id).attr('style', 'display:none')
            }
        });

        function disableWriting(id) {
            $('#anulipiLbl-' + id).removeAttr('style', 'display:none')
            $('#anulipi-' + id).attr('style', 'display:none')
        }

        function checkInput(id) {
            var check = document.getElementById('a-' + id)
            if (check.checked == true) {
                $('#anulipi-' + id).attr('name', 'newAnulipiTxt');
            }
            else {
                $('#anulipi-' + id).removeAttr('name');
            }
        }

        //$('#refDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });

        $("#sub").click(function (e) {

            var user = $("#refNo").val();
            if (user == null || user == '') {
                swal('Warning', 'Please Enter Memorandum No', 'warning');
                return false;
            }

            e.preventDefault();
            var form = $("#fromId");
            $.ajax({
                url: '/Employee/Report/PostingReportEntryUpdate',
                data: form.serialize(),
                type: 'POST',
                success: function (records) {
                    window.location.href = "/Employee/Assignment/CreatedReportList";
                    //window.location.href = "/Employee/Report/PostingReportPdf/" + @ViewBag.Id;
                    //SaveFileupload(records.assignMasterId);
                }
            });
        });

        function addNewAulilipy(liId) {
            var text = `<li class="ui-state-default" id="nLi-${liId}">
                                    <input id="newAnulipiInput_${liId}" type="text" value="" />
                                    <input type="button" class="btn btn-info btn-sm" value="Save" onclick="saveNewAnulili(${liId})" />
                                </li>`;
            $('#li-' + liId).after(text);
            $('#addNew-' + liId).hide();
        }

        function saveNewAnulili(liId) {
            var input = $('#newAnulipiInput_' + liId).val();
            $('#nLi-' + liId).remove();
            var newAnulipi = new Object();
            newAnulipi.anulipiId = 0;
            newAnulipi.copyName = input;
            $.ajax({
                url: "/MasterData/Anulipi/SaveNewAnulipi",
                type: 'GET',
                data: { anulipiName: input},
                success: function (response) {
                    if (response.Id != 0) {
                        $('#a-' + response.Id).closest('li').remove();
                    }
                    var newLi = `<li class="ui-state-default" id="li-${liId}">
                                    <input id="a-${response.Id}" type="checkbox" name="anulipiIds" onclick="checkInput(${response.Id})" value="${response.Id}" />
                                    <label id="anulipiLbl-${response.Id}">${response.copyName}</label>
                                    <input type="text" id="anulipi-${response.Id}" style="display:none" size="${1}" onkeyup="updateLabel()" ondblclick="disableWriting(${response.Id})" value="${response.copyName}" />
                                    <i class="fa fa-edit" onclick="editAulilipy(${response.Id})" title="Edit" style="color:red"></i>
                                    <i class="fa fa-plus" id="addNew-${liId}" onclick="addNewAulilipy(${liId})" title="Add" style="color:green"></i>
                                </li>`
                    $('#li-' + liId).after(newLi);
                    $('#addNew-' + liId).show();
                }
            })
        }
    </script>
}

