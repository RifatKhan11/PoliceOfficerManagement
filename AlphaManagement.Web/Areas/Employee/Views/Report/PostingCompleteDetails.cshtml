@model PostingReportViewModel
@using AlphaManagement.Web.Helpers;
@{
    ViewData["Title"] = "PostingReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <div class="row" style="margin-top:10px">
        <div class="col-4">
        </div>
        <div class="col-4">
            <h6 class="text-center text-justify">গণপ্রজাতন্ত্রী বাংলাদেশ সরকার <br /> বাংলাদেশ পুলিশ<br /> পুলিশ হেডকোয়ার্টার্স <br /> ৬, ফিনিক্স রোড, ফুলবাড়িয়া <br /> ঢাকা-১০০০</h6>
        </div>
        <div class="col-4">
        </div>
    </div>
    <div class="row">
        <div class="col-10">
            <h6>স্মারক নং :- @LanguageProcessing.EnglishToBangla(@Model.assignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.memorandumNo)</h6>
        </div>
        <div class="col-2">
            <h6>তারিখঃ @LanguageProcessing.BanglaDate(@Model.assignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.refDate.ToString("dd-MMM-yyyy"))</h6>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-center"><u>প্রাজ্ঞাপন</u></h6>
            <h6 class="text-center">@Model.assignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.title</h6>
        </div>

    </div>
    <input type="hidden" name="assignMasterId" id="assignMasterId" value="@ViewBag.Id" />

    <div class="row">
        <div class="col-12">
            <table class="table table-bordered">
                @{ var i = 1;}
                @foreach (var item in Model.assignments)
                {
                    var lastSection = Model.assignmentALL.Where(x => x.employeeId == item.employeeId && x.Id != item.Id).OrderByDescending(x => x.Id).FirstOrDefault();
                    <tr>
                        <td>@LanguageProcessing.EnglishToBangla(i.ToString())</td>
                        <td>
                            <h6>@item.employee?.nameBangla (@LanguageProcessing.EnglishToBangla(@item.employee?.employeeCode))</h6>
                            <h6>@item.employee?.rank?.rankNameBN</h6>
                            <h6>@lastSection?.section?.NameBN, @lastSection?.section?.specialBranchUnit?.branchUnitNameBN</h6>
                        </td>
                        <td>
                            <h6>@item.employee?.rank?.rankNameBN</h6>
                            <h6>@item?.section?.NameBN, @item.section?.specialBranchUnit?.branchUnitNameBN</h6>
                        </td>
                    </tr>
                    i++;
                }

            </table>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-12">
            <h6 class="text-justify mb-3">@Model.assignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.description</h6>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <h6>স্মারক নং-@LanguageProcessing.EnglishToBangla(@Model.assignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.memorandumNo)</h6>
            <h6 class="mr-4">অনুলিপি সদয় অবগতির ও প্রয়োজনীয় ব্যবস্থা গ্রহণের জন্য প্রেরণ করা হলো (জ্যেষ্ঠতার ভিত্তিতে নয়) :-</h6>
            @{
                var cnt = 0;
                @foreach (var item in Model.assignmentAnulipis)
                {
                    cnt = cnt + 1;
                    <p>@LanguageProcessing.EnglishToBangla(cnt.ToString()).@item.anulipiText</p>
                }
            }
        </div>
    </div>
    <div class="float-right">
        <a class="btn btn-success btn-sm" style="color:white" onclick="Complete(@Model.assignmentAnulipis?.FirstOrDefault()?.assignmentMaster?.Id)">Complete</a>

    </div>
</div>

@section Scripts{
<script>
    function Complete(id) {
        swal({
            title: 'Are you sure?', text: `Do you want to complete this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Yes!`
        }).then((result) => {
            if (result.value) {
                window.location.href = '/Employee/Assignment/CompletePostingByAssignMaster/' + id;
            } else if (result.dismiss === 'cancel') {
                return false;
            }
            else {
                return false;
            }
        });
    }
</script>
}


