<div id="listView" style="display: none;">

    <div class="row">
        <div class="col-lg-12">
            <h5 class="my-2 text-primary">User List</h5>
            <div class="card mb-3">
                <div class="card-body">
                    <div class="input-group">
                        <input type="text" id="Input" name="example-input1-group2" class="form-control" placeholder="Search">
                        <span class="input-group-append">
                            <button type="button" class="btn btn-effect-ripple btn-primary"><i class="fa fa-search"></i> Search </button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row" id="cards2">
        @foreach (var data in Model.EmpDetailList)
        {

            <div class="col-12 searchListdiv">
                <div class="card bg-white">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 col-xs-12 align-content-center">
                                @if (data.EmpPhotograph.url == null)
                                {

                                    <img src="~/logo/pp.jpg" class="img-fluid rounded-circle" style="width:150px;height:150px" alt="No Image" />

                                }
                                else
                                {
                                    <img src="http://portfolio.police.gov.bd/@data.EmpPhotograph.url" class="img-fluid rounded-circle" style="width:150px;height:150px" alt="Alternate Text" />
                                }

                            </div>
                            <div class="col-md-9 col-xs-12 align-content-center">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item"> <b> @Model.fLang.nameEnglish</b>:@data.Employee?.nameEnglish</li>
                                    <li class="list-group-item"><b>@Model.fLang.rankId</b>:@data.Employee?.rank?.rankName</li>
                                    <li class="list-group-item"><b>@Model.fLang.Department</b>:@data.Employee?.department?.deptName</li>
                                    <li class="list-group-item"><b>@Model.fLang.designation</b>:@data.Employee?.designations?.designationName</li>
                                    <li class="list-group-item"><b>Mobile</b>:@data.Employee?.mobileNumberPersonal</li>

                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
    <br />

</div>

<!-- Change Password Modal-->
<div class="modal fade" id="changePasswordModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Change Password </h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="changePasswordForm" data-parsley-validate="parsley">
                    <input type="hidden" id="userId" name="applicationUserId" />
                    <div id="passwordLabel">
                        <label class="col-12 text-center">Password minimum length 6 digit and must have 1 numeric number</label>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-4 col-lg-4 col-sm-12" style="color:black;" for="Password">New Password<span style="float:right;">:</span></label>
                        <div class="col-md-8 col-lg-8 col-sm-12">
                            <input type="password" class="form-control" id="Password" name="Password" autocomplete="off" data-parsley-required="true" />
                            <label class="errorMessage" style="color:red"></label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-4 col-lg-4 col-sm-12" style="color:black;" for="ConfirmPassword">Confirm Password<span style="float:right;">:</span></label>
                        <div class="col-md-8 col-lg-8 col-sm-12">
                            <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" autocomplete="off" data-parsley-required="true" />
                            <label class="errorMessage" style="color:red"></label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-12 col-lg-12 col-sm-12">
                            <button type="button" onclick="changePassBtnSubmit()" style="float:right;" class="btn btn-success ml-1">Change</button>
                            <button class="btn btn-secondary" type="button" style="float:right" data-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Role Assign Modal-->
<div class="modal fade" id="roleAssignModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-center" id="exampleModalLabel">Role Change</h4>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="roleChangeForm" data-parsley-validate="parsley">
                    <input type="hidden" id="userId1" name="userId" />
                    <div class="col-12 row">
                        <h3 class="col-10" style="display:inline" id="appUser"></h3>
                        <div class="col-2 text-right">
                            <input type="button" class="btn btn-info" onclick="multipleRoleAssign()" value="Update" />
                        </div>
                        <div class="col-12" id="roleListDiv">
                            <table class="table table-bordered" id="listRoleTable">
                                <thead>
                                    <tr>
                                        <th style="text-align:center;width:20%;">Sl.</th>
                                        <th style="text-align:center;width:60%;">Role Name</th>
                                        <th style="text-align:center;width:20%;">Select</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Paginathing/paginathing.js"></script>
    <script>
        $(document).ready(function () {
            $('#EmployeeInfoTable').DataTable({
                dom: "<'row'<'col-sm-12 col-md-2'l><'col-sm-12 col-md-3'B><'col-sm-12 col-md-7'f>>" +
                    "<'row'<'col-sm-12't>>" + "<'row'<'col-sm-12 col-md-6'i><'col-sm-12 col-md-6'pr>>",
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fa fa-file-excel"></i> Excel',
                        titleAttr: 'Excel',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5]
                        },
                        title: 'ERP',
                        messageTop: 'Status List',
                        class: 'btn btn-info'
                    },
                    {
                        extend: 'csvHtml5',
                        text: '<i class="fa fa-file-excel"></i> CSV',
                        titleAttr: 'CSV',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5]
                        },
                        title: 'ERP',
                        messageTop: 'Status List'
                    },
                    {
                        extend: 'print',
                        text: '<i class="fa fa-print"></i> Print',
                        titleAttr: 'Print',
                        title: 'ERP',
                        messageTop: 'Status List',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5]
                        },
                        customize: function (doc) {
                            $(doc.document.body).find('h1').css('font-size', '20pt');
                            $(doc.document.body).find('h1').css('font-family', "'Times New Roman', Times, serif");
                            $(doc.document.body).find('h1').css('text-align', 'center');
                        }
                    }
                ]
            });


            $('#gridView').show();
            $('#listView').hide();

            $('.fas').removeClass('active');
            $('.fa-th').addClass('active');

            $("#Input").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                if (value != "") {
                    $(".searchListdiv").filter(function () {
                        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                    });
                }
                else {


                }

            });

            $("#example-input1-group2").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                if (value != "") {
                    $(".searchdiv").filter(function () {
                        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                    });
                }
                else {
                    window.location.reload();

                }

            });

        });

        $('#roleid').change(function () {
            var id = $(this).val();
            Common.Ajax('GET', '/Employee/UserInfo/UserInfofromEmployee/' + id, [], 'json', GetUserList);

        });

        function GetUserList(response) {
            console.log(response);
            if (response == null) {
                return false;
            }

            var table = $("#NomineeTable");
            table.empty();
            $('.pagination-container').empty();
     
            for (var i = 0; i < response.length; i++) {
                var image = "../../logo/pp.jpg";
                var userstatus = ""
                var name ="";
                var des ="";
                if (response[i].Photo != null) {
                    image = "../../" + response[i].Photo;
                }

                if (response[i].name == null || response[i].name == 'undefined') {
                    name = '';
                } else {
                    name = response[i].name;
                }
                if (response[i].isActive == 1) {
                    userstatus = "Inactive User"
                } else {
                    userstatus = "Active User"
                };

                if (response[i].Designation == null || response[i].Designation == 'undefined') {
                    des = '';
                } else {
                    des = response[i].Designation;
                }
               
                table.append(`
                          <div class="card bg-white m-b-30 col-lg-3 col-sm-12 searchdiv">
                        <div class="card-body text-center" style="height:180px">
                            <img src="${image}" class="img-fluid rounded-circle" style="width:150px;height:150px" />
                        </div>
                        <div class="card-body">
                            <div class="card-title mb-0 text-center">
                                <b>${name}</b><br />
                                ${des}
                            </div>
                        </div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">Unit: ${response[i].unit} </li>
                            <li class="list-group-item">Contact: ${response[i].mobile}</li>
                            <li class="list-group-item">Type: ${response[i].roleId}</li>
                        </ul>
                        <div class="card-body">
                            <ul class="social-links list-inline mb-0">
                                <li class="col-12 pull-right btn-group-sm text-center">
                                    <a href="javascript:void(0)" onclick="roleAssign('${response[i].ID}')" class="btn btn-info tooltips text-white" data-placement="top" data-toggle="tooltip" data-original-title="Change role">
                                        <i class="fa fa-users"></i>
                                    </a>
                                    <a href="javascript:void(0)" onclick="changePassword('${response[i].ID}')" class="btn btn-success tooltips text-white" data-placement="top" data-toggle="tooltip" data-original-title="Change Password">
                                        <i class="fa fa-key"></i>
                                    </a>
                                   <a class="btn btn-warning" title="${userstatus}" onclick="userStatusChange('${response[i].ID}',${response[i].isActive})" href="javascript:void(0)"><i class="statusIcon fa fa-toggle-on"></i></a>
                                </li>
                            </ul>
                        </div>
                    </div>
            `);

            }
            $('#NomineeTable').paginathing({

                limitPagination: 4,
                perPage: 8,
                prevNext: true,
                firstLast: true,
                prevText: '&laquo;',
                nextText: '&raquo;',
                firstText: 'First',
                lastText: 'Last',
                containerClass: 'pagination-container',
                ulClass: 'pagination',
                liClass: 'page',
                activeClass: 'active',
                disabledClass: 'disabled',
                pageNumbers: true,
                insertAfter: '#NomineeTable'
            })

        }

        $('.fa-list').click(function () {
            $('#listView').show();
            $('#gridView').hide();
            $('.fa-th').removeClass('active');
            $('.fa-list').addClass('active');
        })
        $('.fa-th').click(function () {
            $('#listView').hide();
            $('#gridView').show();
            $('.fa-list').removeClass('active');
            $('.fa-th').addClass('active');
        })

        $('#cards').paginathing({

            limitPagination: 4,
            perPage: 8,
            prevNext: true,
            firstLast: true,
            prevText: '&laquo;',
            nextText: '&raquo;',
            firstText: 'First',
            lastText: 'Last',
            containerClass: 'pagination-container',
            ulClass: 'pagination',
            liClass: 'page',
            activeClass: 'active',
            disabledClass: 'disabled',
            pageNumbers: true,
            insertAfter: '#cards'
        })


        $('#cards2').paginathing({

            limitPagination: 4,
            perPage: 8,
            prevNext: true,
            firstLast: true,
            prevText: '&laquo;',
            nextText: '&raquo;',
            firstText: 'First',
            lastText: 'Last',
            containerClass: 'pagination-container',
            ulClass: 'pagination',
            liClass: 'page',
            activeClass: 'active',
            disabledClass: 'disabled',
            pageNumbers: true,
            insertAfter: '#cards2'
        })

        function changePassword(userId) {
            $('#userId').val(userId)
            $('#changePasswordModal').modal('show')
        }

        function changePassBtnSubmit() {

            var myData = $("#changePasswordForm").serialize();
            var pass = $("#Password").val();
            var confirmPass = $("#ConfirmPassword").val();
            if (pass == null || pass == '') {
                swal('Warning', 'Invalid Password!', 'warning');
                return false;
            }
            else if (confirmPass == null || confirmPass == '') {

                swal('Warning', 'Invalid Confirm Password!', 'warning');
                return false;
            }
            else if ((pass != '' && pass != null && confirmPass != '' && confirmPass != null)) {
                if (pass != confirmPass) {
                    $(".errorMessage").text("Password and Confirm password does't match");
                    $(".errorMessage").show();

                    swal('Warning', 'Password and Confirm Password Does Not Match!', 'warning');
                    return false;
                }
            }
            $.ajax({
                url: "/Auth/Account/ResetPassword/",
                type: "post",
                data: myData,
                success: function (response) {
                    if (response == "Success") {
                        swal({
                            title: 'Success!', text: 'Password Update Successfully', type: 'success', confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                        }).then(function () {
                            $('#changePasswordModal').modal('hide');
                        });
                    }
                    else {
                        swal('error', 'Something is Wrong Please Try Again !!!', 'error');
                        return false;
                    }

                }
            });
        }

        function userStatusChange(id, isActive) {
            var status = 'Deactive';
            var retStatus = 'Active';
            if (isActive == 1) {
                status = 'Active';
                retStatus = 'Deactive';
            }
            swal({
                title: 'Are you sure?', text: `Do you want to ${retStatus} this user!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `${retStatus} it!`
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: "/Auth/Account/UserStatusChange/",
                        type: 'GET',
                        data: { userId: id },
                        success: function (response) {
                            if (response == "Success") {
                                swal({
                                    title: 'Success!', text: `${retStatus} Successfully!`, type: 'success', confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                                }).then(function () {
                                    window.location.reload();
                                });
                            }
                            else {
                                swal('', `Unable to ${status}`, 'warning');
                                return false;
                            }

                        }
                    })
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });
        }

        function roleAssign(userId) {
            $('#userId1').val(userId);
            $.ajax({
                type: "Get",
                url: '/Employee/UserInfo/UserInfoByUserId',
                data: { id: userId },
                success: function (data) {
                    $('#appUser').empty();
                    $('#appUser').append(data.nameEnglish + '<br/> BP-' + data.employeeCode);
                },
                error: function (erro) {
                    console.log(erro)
                }
            });
            $.ajax({
                type: "Get",
                url: '/Employee/UserInfo/AllRoleWithUserRoleByUserId/',
                data: { id: userId },
                success: function (data) {
                    $('#listRoleTable tbody').empty();
                    var option = '';
                    var sl = 1;
                    $.each(data.roleViewModels, function (i, item) {
                        if (item.userStatus == 1) {
                            option += `<tr>
                                                          <td style="text-align:center;">${sl}</td>
                                                          <td style="text-align:left;">${item.RoleName}</td>
                                                          <td style="text-align:center;">
                                                             <input type="checkbox" checked class="UserRoleCheckBox" name="roleIdList" value="${item.RoleName}" id="${item.RoleId}" style="height:24px;width:24px;padding-top:0px;padding-bottom:0px;" />
                                                      </td>
                                                   </tr>`
                        }
                        else {
                            option += `<tr>
                                                          <td style="text-align:center;">${sl}</td>
                                                          <td style="text-align:left;">${item.RoleName}</td>
                                                          <td style="text-align:center;">
                                                             <input type="checkbox" class="UserRoleCheckBox" name="roleIdList" value="${item.RoleName}" id="${item.RoleId}" style="height:24px;width:24px;padding-top:0px;padding-bottom:0px;" />
                                                      </td>
                                                   </tr>`
                        }
                        sl++;
                    })
                    $('#listRoleTable tbody').append(option);
                },
                error: function (erro) {

                }
            });
            $('#roleAssignModal').modal('show');
        }

        function multipleRoleAssign() {
            var myData = $("#roleChangeForm").serialize();
            $.ajax({
                url: "/Auth/Account/AssaignMultipleRoleToUser/",
                type: "post",
                data: myData,
                success: function (response) {
                    if (response == "Success") {
                        swal({
                            title: 'Success!', text: 'Role Update Successfully', type: 'success', confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                        }).then(function () {
                            $('#roleAssignModal').modal('hide');
                            window.location.reload();
                        });
                    }
                    else {
                        swal('error', 'Something is Wrong Please Try Again !!!', 'error');
                        return false;
                    }
                }
            });
        }
    </script>
}


