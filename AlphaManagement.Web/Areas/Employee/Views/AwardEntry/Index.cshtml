@model AwardEntryViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="pt-2 pb-2 mt-2">@Model.fLang.Title</h5>
            </div>
            <div class="card-body">
                <form role="form" asp-area="Employee" asp-controller="AwardEntry" asp-action="Index">
                    <input type="hidden" name="AwardEntryId" id="AwardEntryId" value="" />
                    <input type="hidden" name="employeeId" id="employeeId" value="@ViewBag.employeeId" />

                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="awardDate">@Model.fLang.awardDate</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="awardDate" name="awardDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="awardName">@Model.fLang.awardName</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="awardName" name="awardName" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-6 col-12">

                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="purpose">@Model.fLang.purpose</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="purpose" name="purpose" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                       
                    </div>


                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">@Model.fLang.Title</h4>
            </div>
            <div class="card-body table-responsive">

                <div class="table-odd">
                    <table id="tblData" class="table table-bordered table-responsive text-nowrap">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>@Model.fLang.employee</th>
                                <th>@Model.fLang.awardName</th>
                                <th>@Model.fLang.awardDate</th>
                                <th>@Model.fLang.purpose</th>
                                <th>@Model.fLang.status</th>
                                <th>@Model.fLang.action</th>

                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int sl = 0;
                                @foreach (var item in Model.awardEntrys)
                                {
                                    sl = sl + 1;
                                    <tr>
                                        <td>@sl</td>
                                        <td>@item.employee.nameEnglish</td>
                                        <td>@item.awardName</td>
                                        <td>@item.awardDate</td>
                                        <td>@item.purpose</td>
                                        <td>@item.status</td>
                                        <td>
                                            <button type="button" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="EditAward(@item.Id,@item.employeeId,'@item.awardName','@item.awardDate','@item.purpose','@item.status')"><span class="ti-pencil"></span></button>
                                            <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete(@item.Id)"><span class="ti-trash"></span></button>
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

        });

        function EditAward(Id,employeeId,awardName,awardDate,purpose,status){
        $("#AwardEntryId").val(Id);
        $("#employeeId").val(employeeId);
        $("#awardName").val(awardName);
        $("#awardDate").val(awardDate);
        $("#purpose").val(purpose);
        }



        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/AwardEntry/DeleteAwardEntry/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}
