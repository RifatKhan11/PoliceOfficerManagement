@model TraningLogViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="pt-2 pb-2 mt-2">@Model.fLang.Title</h5>
            </div>
            <div class="card-body">
                <form role="form" asp-area="Employee" asp-controller="TraningLog" asp-action="Index">
                    <input type="hidden" name="TraningLogId" id="TraningLogId" value="" />
                    <input type="hidden" name="employeeId" id="employeeId" value="@ViewBag.employeeId" />
                    <div class="row">

                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="trainingTitle">@Model.fLang.trainingTitle</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="trainingTitle" name="trainingTitle" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="trainingInstituteId">@Model.fLang.trainingInstitute</label>
                                <div class="col-md-8 col-12">

                                    <select class="form-control" name="trainingInstituteId" id="trainingInstituteId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.trainingInstitutes)
                                        {
                                            <option value="@item.Id">@item.trainingInstituteName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="trainingCategoryId">@Model.fLang.trainingCategory</label>
                                <div class="col-md-8 col-12">

                                    <select class="form-control" name="trainingCategoryId" id="trainingCategoryId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.trainingCategories)
                                        {
                                            <option value="@item.Id">@item.trainingCategoryName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="countryId">@Model.fLang.country</label>
                                <div class="col-md-8 col-12">

                                    <select class="form-control" name="countryId" id="countryId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.countries)
                                        {
                                            @if (item.countryName.ToLower() =="bangladesh")
                                            {
                                                <option value="@item.Id" selected>@item.countryName</option>
                                            }
                                            else
                                            {
                                                <option value="@item.Id">@item.countryName</option>
                                            }


                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="fromDate">@Model.fLang.fromDate</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="fromDate" name="fromDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="toDate">@Model.fLang.toDate</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="toDate" name="toDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="sponsoringAgency">@Model.fLang.sponsoringAgency</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="sponsoringAgency" name="sponsoringAgency" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 col-12">
                            <div class="form-group row">
                                <label class="col-md-2 col-12" for="Remarks">@Model.fLang.remarks</label>

                                <div class="col-md-10 col-12">
                                    <textarea required="" class="form-control" id="remarks" name="remarks" rows="5" data-parsley-id="24"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">@Model.fLang.Title</h4>
            </div>
            <div class="card-body table-responsive">

                <div class="table-odd">
                    <table id="tblData" class="table table-bordered table-responsive text-nowrap">
                        <thead>
                            <tr>
                                <th>SL#</th>
                                <th>@Model.fLang.employee</th>
                                <th>@Model.fLang.trainingTitle</th>
                                <th>@Model.fLang.fromDate</th>
                                <th>@Model.fLang.toDate</th>
                                <th>@Model.fLang.trainingCategory</th>
                                <th>@Model.fLang.trainingInstitute</th>
                                <th>@Model.fLang.country</th>
                                <th>@Model.fLang.sponsoringAgency</th>
                                <th>@Model.fLang.action</th>

                            </tr>
                        </thead>

                        <tbody>
                            @{ 
                                int sl = 0;
                            @foreach (var item in Model.traningLogs)
                            {
                                sl = sl + 1;
                                <tr>
                                    <td>@sl</td>
                                    <td>@item.employee.nameEnglish</td>
                                    <td>@item.trainingTitle</td>
                                    <td>@item.fromDate?.ToString("dd-MMM-yyyy")</td>
                                    <td>@item.toDate?.ToString("dd-MMM-yyyy")</td>
                                    <td>@item.trainingCategory</td>
                                    <td>@item.trainingInstitute.trainingInstituteName</td>
                                    <td>@item.country.countryName</td>
                                    <td>@item.sponsoringAgency</td>
                                    <td>
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="Edit(@item.Id,@item.employeeId,'@item.trainingTitle','@item.fromDate','@item.toDate',@item.trainingCategoryId,@item.trainingInstituteId,@item.countryId,'@item.sponsoringAgency','@item.remarks')"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete(@item.Id)"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

        });

        function Edit(Id,employeeId,trainingTitle,fromDate,toDate,trainingCategoryId,trainingInstituteId,countryId,sponsoringAgency,remarks){
         $("#TraningLogId").val(Id);
         $("#employeeId").val(employeeId);
         $("#trainingTitle").val(trainingTitle);
         $("#fromDate").val(fromDate);
         $("#toDate").val(toDate);
         $("#trainingCategoryId").val(trainingCategoryId);
         $("#trainingInstituteId").val(trainingInstituteId);
         $("#countryId").val(countryId);
         $("#sponsoringAgency").val(sponsoringAgency);
         $("#Remarks").val(remarks);
        }



        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/TraningLog/DeleteTraningLog/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

