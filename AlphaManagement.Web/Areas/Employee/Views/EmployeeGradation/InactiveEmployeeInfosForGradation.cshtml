@model EmpViewModel
@{
    ViewData["Title"] = "InActiveEmployeeInfo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .fas {
        margin-top: 10px;
        font-size: 25px;
    }

    body {
        /*font-family: 'Josefin Sans', sans-serif;*/
    }

    .active {
        color: darkcyan;
    }

    .c {
        min-height: 450px;
        background-color: #FDF2E9;
    }

        .c .card-footer {
            height: 52px;
            background-color: #E9F7EF;
            display: flex;
            justify-content: center;
            align-items: center;
        }

    .cb {
        height: 400px;
    }

    .c .cb {
        transition: .3s all;
        cursor: pointer;
    }

    .c:hover .cb {
        background-color: #D6DBE9;
    }

    #myInput1 {
        width: 50%;
        position: absolute;
        right: 18px;
        box-shadow: none;
    }

    .pagination > li > a,
    .pagination > li > span {
        position: relative;
        float: left;
        padding: 6px 12px;
        margin-left: -1px;
        line-height: 1.42857143;
        color: #337ab7;
        text-decoration: none;
        background-color: #fff;
        border: 1px solid #ddd;
    }

    .pagination > .active > a,
    .pagination > .active > a:focus,
    .pagination > .active > a:hover,
    .pagination > .active > span,
    .pagination > .active > span:focus,
    .pagination > .active > span:hover {
        z-index: 3;
        color: #fff;
        cursor: default;
        background-color: #337ab7;
        border-color: #337ab7;
    }

    .pagination-container {
        margin: 20px 0;
        display: flex;
        justify-content: flex-end;
    }

    .card-title {
        min-height: 75px;
    }

    .form-control {
        border-radius: 5px !important;
    }

    .zoom {
        transition: transform .2s; /* Animation */
    }

        .zoom:hover {
            transform: scale(1.1); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
        }

    .zoom1 {
        transition: transform .2s; /* Animation */
    }

        .zoom1:hover {
            transform: scale(1.1); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
            background: darkcyan;
            border-radius: 50%;
            border: 1px solid darkcyan;
        }

    #legalWeaponTable thead th {
        vertical-align: top;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
    }


    @@page WordSection1 {
        mso-page-orientation: landscape;
        size: 14in 8.5in; /*US Letter*/
    }

    div.WordSection1 {
        page: WordSection1;
    }
</style>

<div class="card-body pl-1 pr-1" style="display:block;">

    <div style="height:10px;"></div>
    <div class="card row" style="width:auto;" id="tablelegatiy">
        <div class="cardheader border bg-gray-200 row" style="text-align:right;">
            <h4 class="col-md-8" style="margin-top:10px;text-align:left;">
               Inactive List
            </h4>
            <div class="col-md-2"></div>
            <div class="col-md-2 mt-2" style="float:right;">
                <input type="text" id="searchtxt" class="form-control" placeholder="Search..." />
            </div>
        </div>
        
        <div class="card-body">
            <div class="row" style="max-height:700px;overflow-y:scroll;">
                <table class="table table-striped table-bordered" style="" id="allEmployeeListTable">
                    <thead>
                        <tr style="text-align:center;">

                            <th rowspan="2" style="width:3%;vertical-align:top;">ক্রমিক নং</th>
                            <th rowspan="2" style="width:20%;vertical-align:top;">কর্মকর্তার নাম,জন্ম তারিখ, জন্ম জেলা ও <br /> স্পাউজ জেলা, শিক্ষাগত যোগ্যতা</th>
                            <th rowspan="2" style="width:8%;vertical-align:top;">অভিজ্ঞতা (পদের <br /> নাম) নিয়োগের <br /> তারিখসহ</th>
                            <th rowspan="2" style="width:10%;vertical-align:top;">পুলিশ ক্যাডারের <br /> প্রারম্ভিক পদে কমিশনের <br /> সুপারিশ অনুযায়ী <br /> নিয়মিত নিয়োগ <br /> (সরাসরি/পদোন্নতি)</th>
                            <th rowspan="2" style="width:8%;vertical-align:top;">সিনিয়র স্কেলে <br /> নিয়মিত পদোন্নতির <br /> তারিখ</th>
                            <th rowspan="2" style="width:10%;vertical-align:top;">
                                সামরিক কর্মকর্তাদের <br /> প্রাসঙ্গিক তথ্যঃ- <br />
                                ক) কমিশন প্রাপ্তির তারিখ<br />
                                খ) অবসর গ্রহণের তারিখ<br />
                            </th>
                            <th rowspan="2" style="width:8%;vertical-align:top;">বর্তমান পদে <br /> নিয়মিত নিয়োগের <br /> তারিখ</th>
                            <th colspan="4" style="width:25%;border-bottom:hidden;vertical-align:top;">মন্তব্য </th>
                            <th rowspan="2" style="width:11%;vertical-align:top;">@*মন্তব্য <br />তারিখ-*@বিসিএস ব্যাচ</th>
                            <th rowspan="2" style="width:4%;vertical-align:top;">@*রিপোর্ট*@পুরুষ/মহিলা</th>
                            <th rowspan="2" style="width:4%;vertical-align:top;">বর্তমান পদ</th>
                            <th rowspan="2" style="width:4%;vertical-align:top;" class="noExport" data-exclude="true">রিপোর্ট</th>
                        </tr>
                        <tr>
                            <th style="width:4%;border-right: hidden;"></th>
                            <th style="width:4%;border-right: hidden;"></th>
                            <th style="width:4%;border-right: hidden;"></th>
                            <th style="width:4% ;border-right:1px solid #dee2e6;"></th>
                        </tr>
                        <tr style="text-align:center;">
                            <th>১</th>
                            <th>২</th>
                            <th>৩</th>
                            <th>৪</th>
                            <th>৫</th>
                            <th>৬</th>
                            <th>৭</th>
                            <th colspan="4">৮</th>

                            <th>৯</th>
                            <th>১০</th>
                            <th>১১</th>
                            <th class="noExport" data-exclude="true">১২</th>
                        </tr>
                    </thead>
                    <tbody id="tBodyEmpAlpha">
                      

                    </tbody>
                </table>
            </div>
           
        </div>
    </div>

</div>



@section Scripts{

    <script src="https://code.jquery.com/jquery-migrate-3.3.2.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
    <script src="~/Paginathing/paginathing.js"></script>

    <script>

        $(document).ready(function () {
            GetGradatinoData();

           

        });

        function GetGradatinoData() {
        
            var rankId = $('#searchRankId').val();
            var batchId = $('#searchBatchId').val();
            var fromDate = $('#fromDate').val();
            var toDate = $('#toDate').val();
            var prlToDate = $('#prlToDate').val();
            var prlFromDate = $('#prlFromDate').val();
            var bpNoSearch = $('#bpNoSearch').val();
            Common.Ajax('GET', '/Employee/EmployeeGradation/GetInactiveEmployeeInfosForGradation?rankId=' + rankId + '&batchId=' + batchId + '&fromDate=' + fromDate + '&toDate=' + toDate + '&prlFromDate=' + prlFromDate + '&prlToDate=' + prlToDate + '&typeId=0' + '&bpNoSearch=' + bpNoSearch, [], 'json', ajaxGetMultipleSearchResult, false);
        }

        function ajaxGetMultipleSearchResult(data) {
          
            $('#allEmployeeListTable').DataTable().destroy();
            $('#allEmployeeListTable tbody').empty();
            var employeeList = "";
            var ssl = 0;
            var baseImageUrl = "http://portfolio.police.gov.bd/";

            var bgColor = '';
            $.each(data, function (i, item) {
                console.log(item);
                var education = '';
                if (item.IsPRL == 1) {
                    bgColor = '#FC8F84';
                } else {
                    bgColor = '';
                }
                if (item?.educationQualificationOld == null) {
                    education = item?.educationQualification;
                }
                else if (item?.educationQualification == null) {
                    education = item?.educationQualificationOld;
                }
                else {
                    education = "";
                }


                //var imageUrl = "";
                //var img = '<img src="~/logo/defaultprofile.jpg" style="width:100px;height:100px;" class="img-fluid" alt="" />';
                //if (v.imageUrl !== null) {
                //    imageUrl = baseImageUrl + v.imageUrl;
                //    img = `<img src="${imageUrl}" class="img-fluid rounded-circle" style="width:100px;height:100px;" alt="No Image p-0 m-0"/>`
                //}
                employeeList += `<tr style="background-color:${bgColor}">
                            <td>${item?.gradationSerial}।</td>
                            <td>
                            <span style="font-weight:bold;font-size:1em;">জনাব ${item?.nameBangla}</span><br />
                                        <span>বিপি-</span><span>${item?.bpNo}</span><br /><span style="display:none;">${item?.employeeCode}</span>
                                        <span>জন্ম তারিখ : </span><span>${item?.dateOfBirth}</span><br />
                                        <span>জন্ম জেলা : </span><span>${item?.homeDistrict}</span><br />
                                        <span>স্পাউজ জেলা : </span><span>${item?.SpouseAddress}</span><br />
                                        <span>শিক্ষাগত যোগ্যতা : </span><span>${education}</span><br />
                                        <span></span><span>${item?.batchNameBN}, মেধাক্রম- ${item?.bcsPosition}</span>
                            </td>
                            <td>${item?.experienceName}<br>${item?.expReqDate}</td>
                            <td style="text-align:center;">${item?.joiningDateGovtService}<br/>${item?.joiningRank}<br/>(${item?.regularJoin})</td>
                            <td style="text-align:center;">${item?.firstPromotionDate}</td>

                            <td><span>${item?.commissionReceiptDate} ${item?.commissionLPRDate}</span><br /><span>${item?.civilRank} ${item?.civilReqDate}</span></td>
                            <td style="text-align:center;">${item?.rankName}<br/>${item?.lastPromotionDate}</td>
                            <td colspan="4" style="text-align:center;">${item?.comments}</td>
                            @*<td>${item?.secondAdhoc}</td>
                            <td>${item?.thirdAdhoc}</td>
                            <td>${item?.forthAdhoc}</td>*@
                            <td style="text-align:center;">${item?.batchNameBN}</td>
                            <td style="text-align:center;">${item?.gender}</td>
                            <td style="text-align:center;">${item?.rankName}</td>
                            <td style="text-align:center;" class="noExport" data-exclude="true"><a href="javascript:void(0)" title="Update" onclick="fnGetEmpinfo(${item?.employeeId})" class="btn btn-sm btn-secondary"><i class="fa fa-pencil fa-fw"></i></a></td>
                           </tr>`;
            });

            $('#allEmployeeListTable tbody').append(employeeList);
            $('#allEmployeeListTable').DataTable();
        }
    </script>
}



