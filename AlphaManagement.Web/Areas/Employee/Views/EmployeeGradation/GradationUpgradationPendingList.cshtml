@model EmpViewModel
@{
    ViewData["Title"] = "GradationUpgradationPendingList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .fas {
        margin-top: 10px;
        font-size: 25px;
    }

    body {
        /*font-family: 'Josefin Sans', sans-serif;*/
    }

    .active {
        color: darkcyan;
    }

    .c {
        min-height: 450px;
        background-color: #FDF2E9;
    }

        .c .card-footer {
            height: 52px;
            background-color: #E9F7EF;
            display: flex;
            justify-content: center;
            align-items: center;
        }

    .cb {
        height: 400px;
    }

    .c .cb {
        transition: .3s all;
        cursor: pointer;
    }

    .c:hover .cb {
        background-color: #D6DBE9;
    }

    #myInput1 {
        width: 50%;
        position: absolute;
        right: 18px;
        box-shadow: none;
    }

    .pagination > li > a,
    .pagination > li > span {
        position: relative;
        float: left;
        padding: 6px 12px;
        margin-left: -1px;
        line-height: 1.42857143;
        color: #337ab7;
        text-decoration: none;
        background-color: #fff;
        border: 1px solid #ddd;
    }

    .pagination > .active > a,
    .pagination > .active > a:focus,
    .pagination > .active > a:hover,
    .pagination > .active > span,
    .pagination > .active > span:focus,
    .pagination > .active > span:hover {
        z-index: 3;
        color: #fff;
        cursor: default;
        background-color: #337ab7;
        border-color: #337ab7;
    }

    .pagination-container {
        margin: 20px 0;
        display: flex;
        justify-content: flex-end;
    }

    .card-title {
        min-height: 75px;
    }

    .form-control {
        border-radius: 5px !important;
    }

    .zoom {
        transition: transform .2s; /* Animation */
    }

        .zoom:hover {
            transform: scale(1.1); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
        }

    .zoom1 {
        transition: transform .2s; /* Animation */
    }

        .zoom1:hover {
            transform: scale(1.1); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
            background: darkcyan;
            border-radius: 50%;
            border: 1px solid darkcyan;
        }

    #legalWeaponTable thead th {
        vertical-align: top;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
    }


    @@page WordSection1 {
        mso-page-orientation: landscape;
        size: 14in 8.5in; /*US Letter*/
    }

    div.WordSection1 {
        page: WordSection1;
    }
</style>

<div class="card-body pl-1 pr-1" style="display:block;">

    <div style="height:10px;"></div>
    <div class="card row" style="width:auto;" id="tablelegatiy">
        <div class="cardheader border bg-gray-200 row" style="text-align:right;">
            <h4 class="col-md-7" style="margin-top:10px;text-align:left;">
                ALPHA Master Data Upgradation
            </h4>
            <div class="col-md-3 mt-2"><span style="font-weight:bold;">Total Data- @Model.employeeGradations.Count()</span>. &nbsp;<button id="btnApprove" onclick="AllUpdateGradationInfo()" class="btn btn-info">Approve All</button></div>
            <div class="col-md-2 mt-2" style="float:right;">
                <input type="text" id="searchtxt" class="form-control" placeholder="Search..." />
            </div>
        </div>

        <div class="card-body">

            <div class="row" style="max-height:600px;overflow-y:scroll;">
                <table class="table table-striped table-bordered" style="" id="allEmployeeListTable">
                    <thead>
                        <tr>
                            <th>SL</th>
                            <th>Name</th>
                            <th>Rank</th>
                            <th>New Rank</th>
                            <th>Batch</th>
                            <th>BCS Position</th>
                            <th>Posting Place</th>
                            <th>New Posting Place</th>
                            <th>Last Promotion Date</th>
                            <th>Promotion Date</th>
                            <th style="width:100px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tBodyEmpAlpha">
                        @{
                            int sl = 1;
                            @foreach (var item in Model.employeeGradations)
                            {
                                <tr id="@sl">
                                    <td>@sl<input type="hidden" class="clsGradationId" value="@item.Id" /></td>
                                    <td>@item.nameEnglish, @item.employeeCode</td>
                                    <td>@item.employee?.rank?.rankName</td>
                                    <td>@item.rank?.rankName</td>
                                    <td>@item.employee?.bCSBatch?.batchName</td>
                                    <td>@item.bcsPosition</td>
                                    <td>@item.employee?.branch?.branchUnitName</td>
                                    <td>@item.branch?.branchUnitName</td>
                                    <td>@item.employee?.promotionDate?.ToString("dd/MM/yyyy")</td>
                                    <td>@item.lastPromotionDate?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a href="javascript:void(0)" title="remove" onclick="removeGradationData(@sl)" class="btn btn-outline-danger btn-sm"><i class="fa fa-times"></i></a>
                                        <a href="javascript:void(0)" title="approve" onclick="SingleupdateGradationInfo(@item.Id)" class="btn btn-info btn-sm"><i class="fa fa-check"></i></a>
                                    </td>
                                </tr>
                                sl++;
                            }
                        }

                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>



@section Scripts{


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="https://code.jquery.com/jquery-migrate-3.3.2.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.blockUI/2.70/jquery.blockUI.min.js"></script>
    <script src="~/Paginathing/paginathing.js"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            $("#searchRankId").select2();

            $("#searchtxt").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#allEmployeeListTable tbody>tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });

        function removeGradationData(id) {
             swal({
                title: 'Are you sure?', text: 'Do you want to remove this!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, remove it!'
            }).then((result) => {
                if (result.value) {
                    $('#allEmployeeListTable tr#' + id).remove();
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });

        }

        function updateGradationInfo() {
            var form = $("#frmGradation");

            swal({
                title: 'Are you sure?', text: 'Do you want to update this!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, update it!'
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '@Url.Action("UpdateEmployeeGradationInfo", "EmployeeGradation")',
                        data: form.serialize(),
                        type: 'POST',
                    })
                        .done(function () {
                            swal({
                                title: '', text: 'Updated Successfully!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                            }).then(function () {
                                $('#gradationInfo').modal('hide');
                                GetGradatinoData();
                            });
                        })
                        .fail(function (ex) {
                            swal({
                                title: '', text: 'Unable To Update!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                            }).then(function () {
                                console.log(ex);
                            });
                        });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });

        }

        function SingleupdateGradationInfo(gradationId) {
            var obj = new Object();
            obj.gradationId = gradationId;

            swal({
                title: 'Are you sure?', text: 'Do you want to update this!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, update it!'
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '@Url.Action("IndividualApproveUpdateEmployeeGradationInfo", "EmployeeGradation")',
                        data: obj,
                        type: 'POST',
                    })
                        .done(function (data) {

                            swal({
                                title: '', text: 'Updated Successfully!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                            }).then(function () {
                                //console.log(data);
                                window.location.reload();
                            });
                        })
                        .fail(function (ex) {
                            swal({
                                title: '', text: 'Unable To Update!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                            }).then(function () {
                                console.log(ex);
                            });
                        });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });

        }

        function AllUpdateGradationInfo() {
            var obj = new Object();
            var itemDetails = [];

            //$("#allEmployeeListTable tbody").find('input').each(function () {
            //    itemDetails.push({
            //        gradationId: $(this).find(".clsGradationId").val()
            //    });
            //});

            $('.clsGradationId').each(function () {
                itemDetails[itemDetails.length] = $(this).val();

            });

            obj.lstGradationId = itemDetails;
            swal({
                title: 'Are you sure?', text: 'Do you want to update this!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, update it!'

                    
            }).then((result) => {
                $.blockUI({ message: '<h5>Saving.......</h5>'});
                if (result.value) {
                    $.ajax({
                        url: '@Url.Action("AllApproveUpdateEmployeeGradationInfo", "EmployeeGradation")',
                        data: obj,
                        type: 'POST',
                    })
                        .done(function (data) {
                            $.unblockUI();
                            swal({
                                title: '', text: 'Updated Successfully!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                            }).then(function () {
                                //console.log(data);
                                window.location.reload();
                            });
                        })
                        .fail(function (ex) {
                            $.unblockUI();
                            swal({
                                title: '', text: 'Unable To Update!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                            }).then(function () {
                                console.log(ex);
                            });
                        });
                   
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });

        }




    </script>
}



