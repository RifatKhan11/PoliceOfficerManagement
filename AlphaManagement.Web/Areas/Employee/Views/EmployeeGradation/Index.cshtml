        function ajaxGradationData(data) {
            $('#spnName').html(data.nameBangla);
            $('#spnRank').html(data.rank?.rankNameBN);
            $('#employeeId').val(data.employeeId);
            $('#nameBangla').val(data.nameBangla);
            $('.gender').val(data.gender).change();
            $('#dateOfBirth').val(formatDate2(data.dateOfBirth));
            $('#districtId').val(data.homeDistrict).change();
            $('#Id').val(data.Id);
            $('#employeeCode').val(data.employeeCode);
            $('#gradationSerial').val(data.gradationSerial);
            $('#rankId').val(data.rankId).change();
            $('#branchId').val(data.branchId).change();
            $('#batchId').val(data.bCSBatchId).change();
            $('#bcsPosition').val(data.bcsPosition);
            $('#educationQualification').val(data.educationQualification);
            $('#organizationId').val(data.organizationId).change();
            $('#degreeId').val(data.degreeId).change();
            $('#SpDistrictId').val(data.SpDistrictId).change();
            //$('#rankId :selected').text(data.rank?.rankNameBN);
            $('#lastPromotionDate').val(formatDate2(data.lastPromotionDate));
            $('#firstPromotionDate').val(formatDate2(data.firstPromotionDate));
            $('#joiningDateGovtService').val(formatDate2(data.joiningDateGovtService));
            $('#joiningDatePresentWorkstation').val(formatDate2(data.joiningDatePresentWorkstation));
            $('#experienceName').val(data.experienceName);
            $('#expReqDate').val(formatDate2(data.expReqDate));
            $('#firstAdhoc').val(data.firstAdhoc);
            $('#secondAdhoc').val(data.secondAdhoc);
            $('#thirdAdhoc').val(data.thirdAdhoc);
            $('#forthAdhoc').val(data.forthAdhoc);
            $('#comments').val(data.comments);
            getSectionInfoByBranchId();
            //$('#SpouseAddress').val(data.SpouseAddress);
            if (data.isDelete == null)
                data.isDelete = 0;

            $('#status').val(data.isDelete);
          
            if (data.regularJoin == null)
                data.regularJoin = 0;
            $('#regularJoin').val(data.regularJoin);


