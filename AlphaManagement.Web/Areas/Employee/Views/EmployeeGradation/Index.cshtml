        }

        function GetEmployeeGradationExcel() {
            var rankId = $('#searchRankId').val();
            var batchId = $('#searchBatchId').val();
            var gender = $('#gender').val();
            var fromDate = $('#fromDate').val();
            var toDate = $('#toDate').val();
            var prlToDate = $('#prlToDate').val();
            var prlFromDate = $('#prlFromDate').val();
            var bpNoSearch = $('#bpNoSearch').val();
            window.open('/Employee/EmployeeGradation/GetEmployeeGradationExcel?rankId=' + rankId + '&batchId=' + batchId + '&fromDate=' + fromDate + '&toDate=' + toDate + '&prlFromDate=' + prlFromDate + '&prlToDate=' + prlToDate + '&typeId=0' + '&bpNoSearch=' + bpNoSearch + '&gender=' + gender);
        }

        function ajaxGetMultipleSearchResult(data) {
            //$('#allEmployeeListTable').DataTable().destroy();
            $('#allEmployeeListTable tbody').empty();
            var employeeList = "";
            var ssl = 0;
            var baseImageUrl = "http://portfolio.police.gov.bd/";
          
            var bgColor = '';
            $.each(data, function (i, item) {
                
                var education = '';
                if (item.IsPRL == 1) {
                    bgColor = '#FC8F84';
                } else {
                    bgColor = '';
                }
                if (item?.educationQualificationOld == null) {
                    education = item?.educationQualification;
                }
                else if (item?.educationQualification == null) {
                    education = item?.educationQualificationOld;
                }
                else{
                    education = "";
                }


                //var imageUrl = "";
                //var img = '<img src="~/logo/defaultprofile.jpg" style="width:100px;height:100px;" class="img-fluid" alt="" />';
                //if (v.imageUrl !== null) {
                //    imageUrl = baseImageUrl + v.imageUrl;
                //    img = `<img src="${imageUrl}" class="img-fluid rounded-circle" style="width:100px;height:100px;" alt="No Image p-0 m-0"/>`
                //}
                employeeList += `<tr style="background-color:${bgColor}">
                            <td>${item?.gradationSerial}।</td>
                            <td>
                            <span style="font-weight:bold;font-size:1em;">জনাব ${item?.nameBangla}</span><br />
                                        <span>বিপি-</span><span>${item?.bpNo}</span><br /><span style="display:none;">${item?.employeeCode}</span>
                                        <span>জন্ম তারিখ : </span><span>${item?.dateOfBirth}</span><br />
                                        <span>জন্ম জেলা : </span><span>${item?.homeDistrict}</span><br />
                                        <span>স্পাউজ জেলা : </span><span>${item ?.SpouseAddress}</span><br />
                                        <span>শিক্ষাগত যোগ্যতা : </span><span>${education}</span><br />
                                        <span></span><span>${item?.batchNameBN}, মেধাক্রম- ${item?.bcsPosition}</span>
                            </td>
                            <td>${item?.experienceName}<br>${item?.expReqDate}</td>
                            <td style="text-align:center;">${item?.joiningDateGovtService}<br/>${item ?.joiningRank}<br/>(${item?.regularJoin})</td>
                            <td style="text-align:center;">${item?.firstPromotionDate}</td>

                            <td class="toHide" style="display:none"><span>${item?.commissionReceiptDate} ${item?.commissionLPRDate}</span><br /><span>${item?.civilRank} ${item?.civilReqDate}</span></td>
