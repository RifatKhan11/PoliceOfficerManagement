        function BanglatoEnglishConvert(number) {

            var en = "0123456789";
            var bn = "০১২৩৪৫৬৭৮৯";
           
            var bnNum = "";

            for (var i = 0; i < number.length; i++) {
                if (en.indexOf(number[i]) < 0) {
                    bnNum += number[i];
                }
                else {
                    var bnNumber = bn[en.indexOf(number[i])];
                    bnNum += bnNumber;
                }

            }
            return bnNum;

        }




