                        <th rowspan="2" style="width:10%;vertical-align:top;" id="tab6">বর্তমান পদ</th>
                        <th rowspan="2" style="width:10%;vertical-align:top;" id="tab7">বর্তমান কর্মস্থল</th>
                        <th rowspan="2" style="width:10%;vertical-align:top;" id="tab7">বর্তমান কর্মস্থলে যোগদানের তারিখ</th>
                        <th rowspan="2" style="width:4%;vertical-align:top;" class="noExport" data-exclude="true">রিপোর্ট</th>
                    </tr>
                    <tr id="tr1">
                    </tr>
                    <tr id="tr2" style="display:none">
                        <th style="width:4%;border-right: hidden;"></th>
                        <th style="width:4%;border-right: hidden;"></th>
                        <th style="width:4%;border-right: hidden;"></th>
                        <th style="width:4% ;border-right:1px solid #dee2e6;"></th>
                    </tr>
                    <tr style="text-align:center;">
                        <th>১</th>
                        <th>২</th>
                        <th>৩</th>
                        <th>৪</th>
                        <th>৫</th>
                        <th class="toHide" style="display:none">৬</th>
                        <th>৭</th>
                        <th colspan="4" class="toHide1" style="display:none">৮</th>
