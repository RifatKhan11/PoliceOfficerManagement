<div class="modal fade bd-example-modal-lg" id="gradationInfo" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1250px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">গ্রেডেশনের তথ্য</h5><span class="col-md-2"></span>
                <h5 class="col-md-6"><span id="spnName"></span>, <span id="spnRank"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form id="frmGradation" asp-area="" asp-controller="" asp-action="ActionAll" method="post" data-parsley-validate="parsley">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" name="employeeId" id="employeeId" />
                    <input type="hidden" name="Id" id="Id" />
                    <div class="row">

                        <div class="col-12 row">
                            <div class="col-md-6 col-12">
                                <div class="form-group row">
                                    <label for="refName" class="col-sm-4 col-form-label">কর্মকর্তার নাম<span style="color:red">*</span></label>
                                    <div class="col-sm-8">
                                        <input type="text" id="nameBangla" name="nameBangla" class="form-control input-sm" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="form-group row">
                                    <label for="gender" class="col-sm-4 col-form-label">লিঙ্গ </label>
                                    <div class="col-md-8 col-12">
                                        <select class="form-control gender" id="" name="gender">
                                            <option value="">নির্বাচন করুন </option>
                                            <option value="Male">পুরুষ </option>
                                            <option value="Female">মহিলা</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="col-12 row">
                            <div class="col-md-6 col-12">
                                <div class="form-group row">
                                    <label for="refName" class="col-sm-4 col-form-label">জন্ম জেলা</label>
                                    <div class="col-sm-8">
                                        <select id="districtId" name="homeDistrict" class="form-control" style="width:100%;">
                                            <option value="0">Select</option>
                                            @foreach (var item in Model.districtList)
                                            {
                                                <option value="@item.districtNameBn">@item.districtNameBn</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="form-group row">
                                    <label for="refName" class="col-sm-4 col-form-label">জন্ম তারিখ</label>
                                    <div class="col-sm-8">
                                        <input type="text" id="dateOfBirth" name="dateOfBirth" class="form-control input-sm" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 row">
                            <div class="col-md-6 col-12">
                                <div class="form-group row">
                                    <label for="refName" class="col-sm-4 col-form-label">বিপি<span style="color:red">*</span></label>
                                    <div class="col-sm-8">
                                        <input type="text" id="employeeCode" name="employeCode" class="form-control input-sm" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="form-group row">
                                    <label for="refName" class="col-sm-4 col-form-label">গ্রেডেশন ক্র: নং<span style="color:red">*</span></label>
                                    <div class="col-sm-8">
                                        <input type="number" id="gradationSerial" name="gradationSerial" class="form-control input-sm" required />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 row">
                            <div class="col-md-6 col-12">
                                <div class="form-group row">
                                    <label for="refName" class="col-sm-4 col-form-label">বর্তমান পদ</label>
                                    <div class="col-sm-8">
