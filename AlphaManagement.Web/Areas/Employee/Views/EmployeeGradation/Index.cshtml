            $('#sectionId').empty();
            $.each(res, function (i, item) {
                $('#sectionId').append(`<option value="${item.Id}">${item.NameBN}, ${item ?.specialBranchUnit ?.districts ?.districtNameBn}</option>`);
            });
        }

        function GetGradatinoData() {
            $(".singleEmp").hide();
            $(".allEmp").show();
            var rankId = $('#searchRankId').val();
            var batchId = $('#searchBatchId').val();
            var gender = $('#gender').val();
            var fromDate = $('#fromDate').val();
            var toDate = $('#toDate').val();
            var prlToDate = $('#prlToDate').val();
            var prlFromDate = $('#prlFromDate').val();
            var bpNoSearch = $('#bpNoSearch').val();
            //Common.Ajax('GET', '/Employee/EmployeeGradation/GetEmployeeInfosForGradation?rankId=' + rankId + '&batchId=' + batchId + '&fromDate=' + fromDate + '&toDate=' + toDate + '&prlFromDate=' + prlFromDate + '&prlToDate=' + prlToDate + '&typeId=0' + '&bpNoSearch=' + bpNoSearch + '&gender=' + gender, [], 'json', ajaxGetMultipleSearchResult, false);
            Common.Ajax('GET', '/Employee/EmployeeGradation/GetEmployeeInfosForGradationNew?rankId=' + rankId + '&batchId=' + batchId + '&fromDate=' + fromDate + '&toDate=' + toDate + '&prlFromDate=' + prlFromDate + '&prlToDate=' + prlToDate + '&typeId=0' + '&bpNoSearch=' + bpNoSearch + '&gender=' + gender, [], 'json', ajaxGetMultipleSearchResult, false);
        }

