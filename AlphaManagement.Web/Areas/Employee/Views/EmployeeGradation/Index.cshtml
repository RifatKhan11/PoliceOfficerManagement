                            <td style="text-align:center;">${item?.currentPostiongPlace}</td>
                            <td style="text-align:center;">${item ?.joiningDatePresentWorkstation}</td>
                            <td style="text-align:center;" class="noExport" data-exclude="true"><a href="javascript:void(0)" title="Update" id="btnEdit${item?.employeeId}" onclick="fnGetEmpinfo(${item?.employeeId})" class="btn btn-sm btn-secondary"><i class="fa fa-pencil fa-fw"></i></a></td>
                           </tr>`;
            });
            
            $('#allEmployeeListTable tbody').append(employeeList);
            //$('#allEmployeeListTable').DataTable();
