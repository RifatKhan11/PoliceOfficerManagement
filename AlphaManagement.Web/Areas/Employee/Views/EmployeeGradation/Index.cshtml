        function updateGradationInfo() {
            var form = $("#frmGradation");

            swal({
                title: 'Are you sure?', text: 'Do you want to update this!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, update it!'
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '@Url.Action("UpdateEmployeeGradationInfo", "EmployeeGradation")',
                        data: form.serialize(),
                        type: 'POST',
                    })
                        .done(function () {
                            swal({
                                title: '',
                                text: 'Updated Successfully!',
                                type: 'success',
                                showCancelButton: false,
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'Ok!',
                            }).then(function () {

                                GetEmpinfoById();

                            });
                        })
                        .fail(function (ex) {
                            swal({
                                title: '', text: 'Unable To Update!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                            }).then(function () {
                                console.log(ex);
                            });
                        });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });

        }

