        function ajaxGradationData(data) {
            $('#spnName').html(data.nameBangla);
            $('#spnRank').html(data.rank?.rankNameBN);
            $('#employeeId').val(data.employeeId);
            $('#Id').val(data.Id);
            $('#employeeCode').val(data.employeeCode);
            $('#gradationSerial').val(data.gradationSerial);
            $('#rankId').val(data.rankId).change();
            $('#branchId').val(data.branchId).change();
            //$('#rankId :selected').text(data.rank?.rankNameBN);
            $('#lastPromotionDate').val(formatDate2(data.lastPromotionDate));
            $('#joiningDatePresentWorkstation').val(formatDate2(data.joiningDatePresentWorkstation));
            $('#experienceName').val(data.experienceName);
            $('#expReqDate').val(formatDate2(data.expReqDate));
            $('#firstAdhoc').val(data.firstAdhoc);
            $('#secondAdhoc').val(data.secondAdhoc);
            $('#thirdAdhoc').val(data.thirdAdhoc);
            $('#forthAdhoc').val(data.forthAdhoc);
            $('#comments').val(data.comments);
            if (data.isDelete == null)
                data.isDelete = 0;

            $('#status').val(data.isDelete);
        }

        function updateGradationInfo() {
            var form = $("#frmGradation");

            swal({
                title: 'Are you sure?', text: 'Do you want to update this!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, update it!'
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '@Url.Action("UpdateEmployeeGradationInfo", "EmployeeGradation")',
                        data: form.serialize(),
                        type: 'POST',
                    })
                        .done(function () {
                            swal({
                                title: '', text: 'Updated Successfully!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                            }).then(function () {
                                $('#gradationInfo').modal('hide');
                                GetGradatinoData();
                            });
                        })
                        .fail(function (ex) {
                            swal({
                                title: '', text: 'Unable To Update!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                            }).then(function () {
                                console.log(ex);
                            });
                        });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });

        }

        function formatDate2(date) {
            if (!date) {
                return '';
            }
            date = new Date(date);
            var year = date.getFullYear();
            var month = date.getMonth() + 1;
            var day = date.getDate()
            if (day < 10) {
                day = '0' + day
            }
            if (month == 1) { month = "Jan" } else if (month == 2) { month = "Feb" } else if (month == 3) { month = "Mar" } else if (month == 4) { month = "Apr" } else if (month == 5) { month = "May" } else if (month == 6) { month = "Jun" } else if (month == 7) { month = "Jul" } else if (month == 8) { month = "Aug" } else if (month == 9) { month = "Sep" } else if (month == 10) { month = "Oct" } else if (month == 11) { month = "Nov" } else if (month == 12) { month = "Dec" }
            return day + "-" + month + "-" + year
        }

