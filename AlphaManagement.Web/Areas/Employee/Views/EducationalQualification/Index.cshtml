@model EducationalQualificationViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="pt-2 pb-2 mt-2">@Model.fLang.Title</h5>
            </div>
            <div class="card-body">
                <form role="form" asp-area="Employee" asp-controller="EducationalQualification" asp-action="Index">
                    <input type="hidden" name="EducationalQualificationId" id="EducationalQualificationId" value="" />
                    <input type="hidden" name="employeeId" id="employeeId" value="@ViewBag.employeeId" />
                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="degreeId">@Model.fLang.degree</label>
                                <div class="col-md-8 col-12">

                                    <select class="form-control" name="degreeId" id="degreeId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.degrees)
                                        {
                                            <option value="@item.Id">@item.degreeName</option>
                                        }

                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="">@Model.fLang.institution</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="institution" name="institution" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="reldegreesubjectId">@Model.fLang.reldegreesubject</label>
                                <div class="col-md-8 col-12">
                                    <select class="form-control" name="reldegreesubjectId" id="reldegreesubjectId"></select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="grade">@Model.fLang.grade</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="grade" name="grade" value="" class="form-control" />
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="majorGroup">@Model.fLang.majorGroup</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="majorGroup" name="majorGroup" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">

                                <label class="col-md-4 col-12" for="organizationId">@Model.fLang.organization</label>
                                <div class="col-md-8 col-12">
                                    <select class="form-control" name="organizationId" id="organizationId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.organizations)
                                        {
                                            <option value="@item.Id">@item.organizationName</option>
                                        }

                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="passingYear">@Model.fLang.passingYear</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="passingYear" name="passingYear" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">@Model.fLang.Title</h4>
            </div>
            <div class="card-body table-responsive">
                
                <div class="table-odd">
                    <table id="tblData" class="table table-bordered table-responsive text-nowrap">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>@Model.fLang.employee</th>
                                <th>@Model.fLang.institution</th>
                                <th>@Model.fLang.result</th>
                                <th>@Model.fLang.majorGroup</th>
                                <th>@Model.fLang.grade</th>
                                <th>@Model.fLang.passingYear</th>
                                <th>@Model.fLang.degree</th>
                                <th>@Model.fLang.organization</th>
                                <th>@Model.fLang.reldegreesubject</th>
                                <th>@Model.fLang.action</th>
                      
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int sl = 0;
                                @foreach (var item in Model.educationalQualifications)
                                {
                                    sl = sl + 1;
                                    <tr>
                                        <td>@sl</td>
                                        <td>@item.employee.nameEnglish</td>
                                        <td>@item.institution</td>
                                        <td>@item.result.resultName</td>
                                        <td>@item.majorGroup</td>
                                        <td>@item.grade</td>
                                        <td>@item.degree.degreeName</td>
                                        <td>@item.organization.organizationName</td>
                                        <td>@item.reldegreesubject.subject.subjectName</td>
                                        <td>
                                            <button type="button" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="EditData(@item.Id,@item.employeeId,'@item.institution',@item.resultId,'@item.majorGroup','@item.grade',@item.degreeId,@item.organizationId,@item.reldegreesubjectId)"><span class="ti-pencil"></span></button>
                                            <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete(@item.Id)"><span class="ti-trash"></span></button>
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

            //$("#degreeId").change(function () {
            //    var id = $(this).val();
            //    Common.Ajax('GET', '/global/api/relDegreeSubjects/' + id, [], 'json', ajaxRelDegreeSubjects);
            //});

        });




        function ajaxRelDegreeSubjects(response) {
            console.log(response);
            var options = '<option value="">Select </option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.subject.subjectName + '</option>';
            });
            $('#reldegreesubjectId').empty();
            $('#reldegreesubjectId').append(options);
        };

        function EditData(Id,employeeId,institution,resultId,majorGroup,grade,degreeId,organizationId,reldegreesubjectId){
           $("#EducationalQualificationId").val(Id);
           $("#employeeId").val(employeeId);
           $("#institution").val(institution);
           $("#degreeId").val(resultId);
           $("#majorGroup").val(majorGroup);
           $("#grade").val(grade);
           $("#degreeId").val(degreeId);
           $("#organizationId").val(organizationId);
           $("#reldegreesubjectId").val(reldegreesubjectId);
        }


        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/EducationalQualification/DeleteEducationalQualification/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}
