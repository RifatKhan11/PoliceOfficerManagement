@model PostingVacancy
@{
    ViewData["Title"] = "OverDue Joining";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="tab-content mt-4" id="myTabContent">

    <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
        <div class="card-header mt-3 p-1 text-light" style="background-color:#2A1067">
            <h4 class="ml-2">OVERDUE Joining</h4>
        </div>
        <div class="card bg-light">
            <div class="card-body">

                <div class="row">

                    <div class="col-md-12 col-12">
                        <table class="table table-bordered table-striped" style="width:100%" id="tblData">
                            <thead>
                                <tr>
                                    <td>Sl No</td>
                                    <td>Name</td>
                                    <td>BP Number</td>
                                    <td>Rank</td>
                                    <td>Batch</td>
                                    <td>Previous Place of Posting</td>
                                    <td>Proposed Place of Posting</td>
                                    <td>Date</td>
                                    <td>Duration</td>

                                </tr>
                            </thead>

                            <tbody>
                                @{var i = 1;}
                                @foreach (var item in Model.assignments.OrderBy(x => x.updatedAt))
                                {
                                    var duration = AlphaManagement.Web.Helpers.CalDateDifference.DateDifference(DateTime.Now, Convert.ToDateTime(item.updatedAt));

                                    <tr>
                                        <td>@i</td>
                                        <td>@item.employee?.nameEnglish</td>
                                        <td>@item.employee?.employeeCode</td>
                                        <td>@item.rank?.rankName </td>
                                        <td>@item.employee?.bCSBatch?.batchName </td>
                                        <td>@item.employee?.section?.Name, @item?.employee?.section?.specialBranchUnit?.districts?.districtName</td>
                                        <td>@item.section?.Name, @item?.section?.specialBranchUnit?.districts?.districtName</td>
                                        <td>@item.updatedAt?.ToString("dd-MMM-yyyy")</td>
                                        <td>@duration</td>
                                    </tr>
                                    i++;
                                }

                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>


</div>


@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();
            
        });
    </script>
}