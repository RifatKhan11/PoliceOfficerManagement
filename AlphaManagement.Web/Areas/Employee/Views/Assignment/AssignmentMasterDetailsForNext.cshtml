@model AssignmentViewModel

@using AlphaManagement.Domain.AuthService.Interfaces;
@using AlphaManagement.Domain.EmployeeService.interfaces;
@inject IUserInfoes userInfo;
@inject IEmployeeService emplyeeService;
@{
    var emp = await userInfo.GetUserInfoByUserName(User.Identity.Name);
}

@{
    ViewData["Title"] = "Assignment Master Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var baseUrl = "http://portfolio.police.gov.bd";
}

<div style="height:10px;"></div>
<div class="card">
    <div class="card-header" style="background-color:#2A1067;color:white;">
        <div class="row">
            <div class="col-11">
                <span style="font-size:22px;">Ongoing Posting Proposal </span>
            </div>

            @*<div class="col-1">
                    <a class="btn active p-0 mr-2" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true"> <i class="fa fa-align-justify" style="font-size:30px;color:#13087E" aria-hidden="true"></i></a>
                    <a class="btn p-0" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false"><i class="fa fa-th" style="font-size:30px;color:#13087E" aria-hidden="true"></i></a>
                </div>*@
        </div>

    </div>
    <div class="card-body">
        <div class="row col-10">
            <div class="col-md-6">
                <div class="form-group row">
                    <label for="example-search-input" class="col-md-3 col-12 col-form-label">Alpha Id : </label>
                    <div class="col-md-8 col-12">
                        <input type="text" class="form-control input-sm" id="refNo" readonly name="refNo" value="@Model.assignmentDetailsModals?.FirstOrDefault()?.reqNo" />
                    </div>
                </div>
                <div class="form-group row">
                    <label for="example-search-input" class="col-md-3 col-12 col-form-label">Created By : </label>
                    <div class="col-md-8 col-12">
                        <input type="text" class="form-control input-sm" id="assignBy" readonly name="assignBy" value="@Model.employeeInfo?.nameEnglish" />
                    </div>
                </div>
            </div>

            <div class="col-md-6">

                <div class="form-group row">
                    <label for="example-search-input" class="col-md-3 col-12 col-form-label">Rank : </label>
                    <div class="col-md-8 col-12">
                        <input type="text" class="form-control input-sm" id="Rank" readonly name="Rank" value="@Model?.assignmentDetailsModals?.FirstOrDefault()?.rankName" />
                    </div>
                </div>

                <div class="form-group row">
                    <label for="example-search-input" class="col-md-3 col-12 col-form-label">Date : </label>
                    <div class="col-md-8 col-12">
                        <input type="text" class="form-control input-sm" id="assignDate" readonly name="assignDate" value="@Model?.assignmentDetailsModals?.FirstOrDefault().date?.ToString("dd-MMM-yyyy")" />
                    </div>
                </div>


            </div>

        </div>
    </div>
    <div class="card">
        <div class="row">
            <div class="col-md-12 col-12">
                <input type="hidden" id="AssignmentDetailsIdForChnage" value="" />
                <table class="table table-bordered table-striped" style="width:100%">
                    <thead>
                        <tr class="text-light  table-sm" style="background-color:#2A1067">
                            <td>Sl No</td>
                            <td>Photo</td>
                            <td>Bp No & Name </td>
                            <td>Details</td>
                            <td>Rank</td>
                            <td>Batch</td>
                            <td>Current Posting Place</td>
                            <td>Proposed Posting Place</td>
                            <td>Action</td>
                        </tr>
                    </thead>

                    <tbody>
                        @{var i = 1;}
                        @foreach (var item in Model.assignmentDetailsModals)
                        {
                            var exprt = Model.badgeAndActivityModels.Where(x => x.employeeId == item.employeeId && x.expertise != null && x.expertise != "").FirstOrDefault();
                            var locked = Model.badgeAndActivityModels.Where(x => x.employeeId == item.employeeId && x.lockedEmpId > 0).FirstOrDefault();
                            var Unmiss = Model.badgeAndActivityModels.Where(x => x.employeeId == item.employeeId && x.pHQTRTypeId > 0).FirstOrDefault();

                            <tr>
                                <td>@i</td>
                                <td>
                                    @if (item.picture == null)
                                    {
                                        <img src="~/logo/pp.jpg" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" />
                                    }
                                    else
                                    {
                                        <img src="@baseUrl/@item.picture" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" />
                                    }
                                </td>
                                <td>
                                    <p>@item.Bp</p> <p>@item.Name</p>
                                    @if (exprt != null)
                                    {
                                        var title = exprt.expertise.Replace(".png", "").Replace("/batch/", "");
                                        <img src="@exprt.expertise" data-toggle="tooltip" data-placement="top" title="@title" class="img-fluid rounded-circle p-0 m-0" style="width:50px; height:50px" />
                                    }
                                    @if (locked != null)
                                    {
                                        <img src="~/batch/locked.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:50px; height:50px" />
                                    }
                                    @if (Unmiss != null)
                                    {
                                        <img src="~/batch/unmission.png" title="UN Mission" class="img-fluid rounded-circle p-0 m-0" style="width:50px; height:50px" />
                                    }
                                </td>
                                <td>
                                    <ul>
                                        <li>Educational Qualification : @item.educationalQualification</li>
                                        <li>Date of Birth : @item.dateOfBirth?.ToString("dd-MMM-yyyy")</li>
                                        <li>Home District : @item.homeDistrict</li>
                                        @if (item.LastPromotionDate?.ToString("dd-MMM-yyyy") != "01-Jan-0001")
                                        {
                                            <li>Last promotion Date : @item.LastPromotionDate?.ToString("dd-MMM-yyyy")</li>
                                        }
                                        else
                                        {
                                            <li>Last promotion Date : </li>
                                        }
                                    </ul>
                                </td>
                                <td>@item?.rankName</td>
                                <td>@item?.batch</td>
                                <td>
                                    <p>@item?.currentPostringPlace</p>
                                    <p>Working Period : @AlphaManagement.Web.Helpers.CalDateDifference.DateDifference(Convert.ToDateTime(item.joiningDateOfPresentunit), DateTime.Now)</p>

                                </td>
                                <td id="PlaceOfPostingForChnag-@item.Id">
                                    @item?.NewPostringPlace
                                </td>
                                <td>
                                    <a class="btn btn-success btn-sm" href="#" onclick="LoadForMoveTo(@item.employeeId,'@item?.reqNo',@item.Id)"><i class="fa fa-rotate-left (alias)" title="Change"></i></a>
                                    <a class="btn btn-primary btn-sm" title="Details" onclick="detailInfoModalOpen(@item?.Bp)" href="#"><i class="fa fa-user-circle"></i></a>
                                    <a class="btn btn-danger btn-sm" href="#" onclick="DeleteTo(@item.Id)"><i class="ti-trash" title="Delete"></i></a>
                                </td>
                            </tr>
                            i++;
                        }

                    </tbody>
                </table>
                <h5>Revised Posting Information : </h5>
                <button class="btn btn-success btn-sm pull-right mr-2" onclick="LoadLockedEmpList('@Model.assignmentDetailsModals.FirstOrDefault().masterId','@Model.assignmentDetailsModals.FirstOrDefault().rankId')" type="button">Add New</button>
                <table class="table table-bordered table-striped" style="width:100%" id="PriviousLockedListtbl">
                    <thead>
                        <tr class="text-light  table-sm" style="background-color:#2A1067">
                            <td>Sl No</td>
                            <td>Photo</td>
                            <td>Bp No </td>
                            <td>Name</td>
                            <td>Current Posting Place</td>
                            <td>Locked Posting Place</td>
                            <td>Action</td>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (Model.assignmentDetailsModals.FirstOrDefault().creator == Model.applicationUser.Id && Model.postingReportViews.Count() == 0)
                            {
                                int a = 1;
                                foreach (var data in Model.assignments)
                                {
                                    <tr>
                                        <td>
                                            @a
                                            <input class="ListOfEmpRevise" type="hidden" value="@data.Id" />
                                        </td>
                                        <td>
                                            @if (data?.employee?.Photographs.Where(x => x.employeeId == data.employeeId && x.type == "profile").Select(x => x.url).FirstOrDefault() == null)
                                            {
                                                <img src="~/logo/pp.jpg" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" />
                                            }
                                            else
                                            {
                                                <img src="@baseUrl/@data?.employee?.Photographs.Where(x => x.employeeId == data.employeeId && x.type == "profile").Select(x=>x.url).FirstOrDefault()" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" />
                                            }
                                        </td>
                                        <td>@data?.employee?.employeeCode </td>
                                        <td>@data?.employee?.nameEnglish</td>
                                        <td>@data?.employee?.section?.Name ,  @data?.employee?.section?.specialBranchUnit?.districts?.districtName</td>
                                        <td>@data?.section?.Name , @data?.section?.specialBranchUnit?.districts?.districtName</td>
                                        <td></td>
                                    </tr>
                                    a++;
                                }
                            }
                            else
                            {
                                int a = 1;
                                foreach (var data in Model.assignmentRevised)
                                {
                                    <tr>
                                        <td>
                                            @a
                                        </td>
                                        <td>
                                            @if (data?.employee?.Photographs.Where(x => x.employeeId == data.employeeId && x.type == "profile").Select(x => x.url).FirstOrDefault() == null)
                                            {
                                                <img src="~/logo/pp.jpg" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" />
                                            }
                                            else
                                            {
                                                <img src="@baseUrl/@data?.employee?.Photographs.Where(x => x.employeeId == data.employeeId && x.type == "profile").Select(x=>x.url).FirstOrDefault()" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" />
                                            }
                                        </td>
                                        <td>@data?.employee?.employeeCode </td>
                                        <td>@data?.employee?.nameEnglish</td>
                                        <td>@data?.employee?.section?.Name ,  @data?.employee?.section?.specialBranchUnit?.districts?.districtName</td>
                                        <td>@data?.section?.Name , @data?.section?.specialBranchUnit?.districts?.districtName</td>
                                        <td></td>
                                    </tr>
                                    a++;
                                }
                            }
                        }
                    </tbody>
                </table>

                <div class="mt-3 mb-3 mr-4 row">
                    <div class="col-sm-5">
                        <div class="form-group row" id="DivSubbranch">
                            <label for="example-search-input" class="col-md-2 col-12 col-form-label"></label>
                            <label for="example-search-input" class="col-md-3 col-12 col-form-label">Comment<span style="color:red">*</span></label>
                            <div class="col-md-7 col-12">
                                <textarea class="form-control" id="reasonComment" name="reasonComment"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group row" id="DivSubbranch">
                            <label for="example-search-input" class="col-md-4 col-12 col-form-label">Forward To<span style="color:red">*</span></label>
                            <div class="col-md-8 col-12">
                                <select class="form-control" style="width: 100%;" id="UserId">
                                    <option value="">Select One</option>
                                    @if (emp.roleName.Contains("Sub-Admin"))
                                    {
                                        @foreach (var data in Model.aspNetUsersViewModels.Where(x => x.userName == "addldigpm1"))
                                        {
                                            <option value="@data.aspnetId">@data.empName-(@data.userName)</option>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var data in Model.aspNetUsersViewModels)
                                        {
                                            <option value="@data.aspnetId">@data.empName-(@data.userName)</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <a href="/Employee/Report/WaitAssignListpdf/@Model.assignMasterId" class="btn btn-info btn-sm float-right " target="_blank">Preview</a>&nbsp;
                        <a class="btn btn-success btn-sm" onclick="approve('@Model.assignmentDetailsModals?.FirstOrDefault()?.masterId')" href="#">Forward</a>&nbsp;
                        <a class="btn btn-primary float-right mr-2 " title="Add" href="/Employee/Assignment/EmployeePosting?refNo=@Model.assignmentDetailsModals?.FirstOrDefault()?.reqNo"><i class="fa fa-plus"></i></a>
                    </div>

                </div>


                <div class="row">
                    <div class="col-sm-3 mt-2"></div>
                    <div class="col-sm-7 mt-2">
                        @if (Model.postingReportViews.Count() > 0)
                        {
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <td>Image</td>
                                        <td>Name</td>
                                        <td>Date & Time</td>
                                        <td>Comments</td>
                                    </tr>
                                </thead>
                                @foreach (var data in Model.postingReportViews.OrderBy(s => s.statusId))
                                {

                                    <tbody>
                                        <tr>
                                            @if (data.url != null)
                                            {
                                                <td><img src="http://portfolio.police.gov.bd/@data.url" height="50" width="50" /></td>
                                            }
                                            else
                                            {
                                                <td><img src="~/logo/pp.jpg" class="img-fluid rounded-circle" style="width:50px;height:50px" /></td>
                                            }
                                            <td>@data.nameEnglish</td>
                                            <td>@data.refDate.ToString("dd-MMMM-yyyy HH:mm tt")</td>
                                            <td>@data.description</td>
                                        </tr>
                                    </tbody>

                                    @*<div class="card-body mt-2 mb-2 shadow">
                                            <div class="timeline-heading">
                                                @if (data.url != null)
                                                {
                                                    <img src="http://portfolio.police.gov.bd/@data.url" height="50" width="50" />
                                                }
                                                <h4 class="timeline-title">@data.nameEnglish</h4>
                                                <p>
                                                    <small class="text-muted"><i class="fa fa-time"></i>@data.refDate.ToString("dd-MMMM-yyyy HH:mm tt")</small>
                                                </p>
                                            </div>
                                            <div class="timeline-body ml-5">
                                                <p>@data.description</p>
                                            </div>
                                        </div>*@
                                }

                            </table>
                        }
                    </div>
                    <div class="col-sm-1 mt-2"></div>
                </div>

            </div>
        </div>
    </div>
</div>

