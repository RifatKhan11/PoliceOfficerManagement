<div class="modal fade" id="moveToModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document" style="max-width:1250px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="col-4 modal-title" id="exampleModalLabel"> Move To Posting Place </h5>
                <input type="text" id="moveModalSearchInput" class="col-3 form-control" autocomplete="off" name="keyword" placeholder="Search by Unit . . .">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="dd mt-2 nestable_list_2 nestable-color-2 collapse show" style="max-height:800px; overflow-y:scroll">

                    <div class=" new-user" id="moveToDiv">

                    </div>

                    <div class="col-12 row" style="display:none" id="divLoader">
                        <div class="col-3"></div>
                        <div class="col-6">
                            <img src="~/images/Circles-loader.gif" height="400" width="400" />
                        </div>
                        <div class="col-3"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<div class="modal fade bd-example-modal-lg" id="empDetailsModal" role="dialog" aria-labelledby="empDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1300px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Details Info</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="col-12 row" id="empDetails" style="overflow: scroll; height: 800px;margin:0">
                </div>
            </div>

        </div>
    </div>
</div>



<div class="modal fade bd-example-modal-lg" id="LoadLockedDetailsModal" role="dialog" aria-labelledby="empDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1300px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Locked officer's List</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <table class="table table-bordered table-striped" style="width:100%" id="LockedEmpListTbl">
                    <thead>
                        <tr class="text-light  table-sm" style="background-color:#2A1067">
                            <td>Sl No</td>
                            <td>Photo</td>
                            <td>Bp No </td>
                            <td>Name</td>
                            <td>Current Posting Place</td>
                            <td>Locked Posting Place</td>
                            <td>Add</td>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        </div>
    </div>
</div>



@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

            $('#home-tab').click(function () {
                $('#profile').removeClass('show active');
                $('#home').addClass('show active');
            });

            $('#profile-tab').click(function () {
                $('#home').removeClass('show active');
                $('#profile').addClass('show active');
            });

            $("#moveModalSearchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#moveModalSearch ol li").not(".notsearch").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

        });

        function Edit(Id, trainingCategoryName, trainingCategoryNameBn, trainingCategoryShortName, shortOrder) {
            $("#TrainingCategoryId").val(Id);
            $("#trainingCategoryName").val(trainingCategoryName);
            $("#trainingCategoryNameBn").val(trainingCategoryNameBn);
            $("#trainingCategoryShortName").val(trainingCategoryShortName);
            $("#shortOrder").val(shortOrder);
        }

        function approve1(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to submit this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, submit it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/Assignment/AssignmentMasterUpdate/" + Id,
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Submitted Successfully!!', 'success');
                        window.location.href = "/Employee/Assignment/AssignmentMaster";
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be submit. Please try again later !!!', 'error');
                    });
            });
        }

        function approve(Id) {
            var comment = $("#reasonComment").val();
            var UserId = $("#UserId").val();

            var idArray = [];
            $('.ListOfEmpRevise').each(function () {
                idArray.push(this.value);
            });

            ///alert(idArray);
            //alert(UserId);

            if (UserId == null || UserId == '') {
                swal('Warning', 'Please Select Forward To', 'warning');
                return false;
            }

            if (comment == null || comment == '') {
                swal('Warning', 'Please Write a Note ', 'warning');
                return false;
            }
            swal({
                title: 'Are you sure?', text: 'Do you want to Forward this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: "/Employee/Assignment/AssignmentMasterUpdateWithComment?id=" + Id + "&userId=" + UserId + "&comment=" + comment + "&revideList=" + idArray,
                        type: 'GET',
                    }).done(function () {
                        swal('', 'Successfully Forwarded!', 'success').then((a) => {
                            window.location.href = "/Employee/Assignment/AssignmentMaster";
                        });
                    })
                        .fail(function () {
                            swal('Cancelled', 'It will not be submit. Please try again later !!!', 'error');
                        });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });
        }

        function LoadForMoveTo(empId, refNo, Id) {
            $("#moveToDiv").load("/Employee/Assignment/GetMoveToListOngoing?refNum=" + refNo + "&empId=" + empId);
            $('#divLoader').show();
            $('#moveToDiv').show();
            $('#moveToModal').modal('show');
            $('#AssignmentDetailsIdForChnage').val(Id);
        }


        function moveToPostingPlace(id) {
            var AssignmentDetailsIdForChnage = $('#AssignmentDetailsIdForChnage').val();
            var moveLiId = $('#unitId-' + id);
            var moveLi = $('#moveLi-' + id);
            var check = moveLiId.find('div.wosue').text();
            var postingPlace = moveLi.find('option:selected').val();
            var postingPlaceText = moveLi.find('option:selected').text();

            //alert(postingPlace);
            //alert(postingPlaceText);
            //alert(AssignmentDetailsIdForChnage);
            //return false;

            if (check != '') {
                swal({
                    title: 'Not Done', text: `Place Not Empty Now`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Save!`
                })
                return false;
            }
            else if (postingPlace == '') {
                swal({
                    title: 'Not Done', text: `Select Posting Place First`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok!`
                })
                return false;
            }
            else {
                swal({
                    title: 'Are you sure?', text: `Do you want to move this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Save!`
                }).then((result) => {
                    if (result.value) {
                        $.ajax({
                            url: '/Employee/Assignment/SaveMoveToInfoFromOngoing?detailId=' + AssignmentDetailsIdForChnage + '&sectionId=' + postingPlace,
                            type: 'GET',
                            success: function (rec) {
                                swal({
                                    title: 'Saved', type: 'success', confirmButtonColor: '#007ACC', confirmButtonText: `OK!`
                                }).then(function () {
                                    $('#PlaceOfPostingForChnag-' + AssignmentDetailsIdForChnage).text(postingPlaceText);
                                    $('#moveToModal').modal('hide');
                                })
                            }
                        });
                    } else if (result.dismiss === 'cancel') {
                        return false;
                    }
                });
            }
        }

        function DeleteTo(id) {
            swal({
                title: 'Are you sure?', text: `Do you want to delete this record!`, type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Delete!`
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '/Employee/Assignment/AssignmentDeletefromOgoing?id=' + id,
                        type: 'GET',
                        success: function (rec) {
                            swal({
                                title: 'Deleted', type: 'success', confirmButtonColor: '#007ACC', confirmButtonText: `OK!`
                            }).then(function () {
                                location.reload();
                            })
                        }
                    });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });
        }

        function detailInfoModalOpen(id) {
            $("#empDetails").load("/Employee/EmployeeInfo/GetEmployeeInfoPartialViewById?id=" + id);
            $('#empDetailsModal').modal('show')
        }


        function LoadLockedEmpList(unit, rank) {
            Common.Ajax('GET', '/Employee/Assignment/GetLockedofficersListByMaster?MasterId=' + unit + '&&rankId=' + rank, [], 'json', ajaxEmpDetails, false);
        }

        function ajaxEmpDetails(res) {
            $('#LockedEmpListTbl').DataTable().destroy();
            //console.log(res);
            var option = "";
            var count = 0;
            $.each(res, function (i, item) {
                option += `<tr>
                                <td>${++count}</td>
                                <td><img src="@baseUrl/${item.picture}" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" /></td>
                                <td>${item.Bp}</td>
                                <td>${item.Name}</td>
                                <td>${item.currentPostringPlace}</td>
                                <td>${item.NewPostringPlace}</td>
                                <td>
                                   <a class="btn btn-success btn-sm" href="#" onclick="AddToList('${item.picture}','${item.Bp}','${item.Name}','${item.currentPostringPlace}','${item.NewPostringPlace}','${item.Id}')"><i class="fa fa-plus" title="Add"></i></a>
                                </td>
                          </tr>`
            });
            $('#LockedEmpListTbl tbody').empty();
            $('#LockedEmpListTbl tbody').append(option);
            $('#LockedEmpListTbl').DataTable();
            $("#LoadLockedDetailsModal").modal('show');
        }

        function AddToList(picture, Bp, Name, currentPostringPlace, NewPostringPlace, Id) {
            //$('#PriviousLockedListtbl').DataTable().destroy();
            var rowCount = $('#PriviousLockedListtbl tr').length;
            //console.log(res);
            var option = "";

            option += `<tr id="row-${Id}">
                            <td>${rowCount++} <input type="hidden" class="ListOfEmpRevise" value="${Id}" /></td>
                            <td><img src="@baseUrl/${picture}" style="width:75px;height:75px" class="img-fluid rounded-circle p-0 m-0" /></td>
                            <td>${Bp}</td>
                            <td>${Name}</td>
                            <td>${currentPostringPlace}</td>
                            <td>${NewPostringPlace}</td>
                            <td>
                                <a class="btn btn-danger" style="color:white" onclick="DeleteRow('${Id}')"><i class="ti-trash"></i></a>
                            </td>
                      </tr>`
            $('#PriviousLockedListtbl tbody').append(option);
            //$('#LockedEmpListTbl').DataTable();
            $("#LoadLockedDetailsModal").modal('hide');
        }

        function DeleteRow(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {
                $("#row-" + Id).remove();
                swal('', 'Deleted Successfully!', 'success');
            });
        }

    </script>
}
