@model EmployeeInfoViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";
}
<style>
     
    #formArea {
        border-radius: 20px;
        background: #e0e6e5;
        box-shadow: 5px 5px 8px #9fa3a3, -5px -5px 8px #ffffff;
    }

    .form-control{
        border-radius:20px;
    }
</style>

<div class="container">
    <div class="modal-body mt-5" id="formArea">
        <h5 class="card-header">Posting Information</h5>
        <form id="jobhistory">
            <input type="hidden" name="empId" id="emId" value="@Model.employeeInfo?.Id" />
            <input type="hidden" name="empJobHistoryId" id="empJobHistoryId" value="0" />
            <input type="hidden" name="jobSpecialBranchUnitId" id="jobSpecialBranchUnitIdFinal" value="" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row">
                <div class="col-12 row">
                    <div class="col-md-6 col-12">
                        <div class="form-group row" id="jobDivSubbranch">
                            <label for="example-search-input" class="col-md-4 col-12 col-form-label"> Reference Number: <span style="color:red">*</span></label>
                            <div class="col-md-8 col-12">
                                <input type="text" class="form-control" id="refNum" name="refNum" data-parsley-required="true">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-12">
                        <div class="form-group row">
                            <label for="refDesignation" class="col-sm-4 col-form-label">Rank<span style="color:red"></span></label>
                            <div class="col-sm-8">
                                <select class="select2 form-control mb-3 custom-select" data-parsley-required="true" style="width: 100%;" id="ranksId" name="ranksId">
                                    <option value="">Select</option>
                                    @foreach (var item in Model.rank)
                                    {
                                        <option value="@item.Id">@item.rankName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-12">
                        <div class="form-group row">
                            <label for="example-search-input" class="col-md-4 col-12 col-form-label">Date<span style="color:red">*</span></label>
                            <div class="col-md-8 col-12">
                                <input class="form-control" type="text" name="joiningDateGovt" id="joiningDateGovt" data-parsley-required="true" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-12">
                        <div class="form-group row">
                            <label for="refName" class="col-sm-4 col-form-label">Remerks<span style="color:red">*</span></label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" id="remerks" name="remerks" data-parsley-required="true">
                            </div>
                        </div>
                    </div>
                </div>
            </div><hr />
            <h5 class="card-header ">Employee Information</h5>
            <div class="row mt-2">
                <div class="col-12 row">
                    <div class="col-md-6 col-12">
                        <div class="form-group row">
                            <label for="example-search-input" class="col-md-4 col-12 col-form-label">Place of Posting</label>
                            <div class="col-md-8 col-12">
                                <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="secId" id="secId"></select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-12">
                        <div class="form-group row">
                            <label for="refDesignation" class="col-sm-4 col-form-label">Rank<span style="color:red">*</span></label>
                            <div class="col-sm-8">
                                <select class="select2 form-control mb-3 custom-select" data-parsley-required="true" style="width: 100%;" id="ranksId" name="ranksId">
                                    <option value="">Select</option>
                                    @foreach (var item in Model.rank)
                                    {
                                        <option value="@item.Id">@item.rankName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 row">
                    <div class="col-md-6 col-12">
                        <div class="form-group row">
                            <label for="refContact" class="col-sm-4 col-form-label">Joining Date<span style="color:red">*</span></label>
                            <div class="col-sm-8">
                                <input type="text" readonly class="form-control" id="AssignjoiningDate" name="AssignjoiningDate" data-parsley-required="true">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-12">
                        <div class="form-group row">
                            <label for="refContact" class="col-sm-2 col-form-label d-inline">Still Serving</label>
                            <div class="col-sm-1">
                                <input type="checkbox" id="jobRunningCheckBox" name="jobRunningCheckBox" style="margin-top:10px" value="1">
                            </div>
                            <label for="refEmail" class="col-sm-4 col-form-label" id="AssignresignDatelvl">Release Date</label>
                            <div class="col-sm-5">
                                <input type="text" readonly class="form-control" name="AssignresignDate" id="AssignresignDate">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 row">
                    <div class="col-md-6 col-12">
                        <div class="form-group row">
                            <label for="refOrganization" class="col-sm-4 col-form-label">Reason Of Transfer</label>
                            <div class="col-sm-8">
                                <select class="select2 form-control mb-3 custom-select" style="width: 100%;" id="reasonofTransfer" name="reasonofTransfer">
                                    <option value="">Select</option>
                                    <option value="Administrative">Administrative</option>
                                    <option value="Disciplinary">Disciplinary</option>
                                    <option value="On Application">On Application</option>
                                    <option value="On Promotion">On Promotion</option>
                                    <option value="Regular">Regular</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-12">
                        <div class="form-group row">
                            <label for="refEmail" class="col-sm-4 col-form-label">Service Period</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" id="jobServicePeriod" name="servicePeriod" readonly>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal" onclick="clearJobHistoryModal()">Close</button>
                <button type="submit" class="btn btn-primary btn-sm" id="saveJobHistory">Save</button>
            </div>

        </form>
        <br />
    </div>
</div>

@section Scripts{
<script>
    $(document).ready(function () {
        $('#joiningDateGovt').bootstrapMaterialDatePicker({ weekStart: 0, time: false, format: 'DD-MMM-YYYY' });
    })
    </script>
}