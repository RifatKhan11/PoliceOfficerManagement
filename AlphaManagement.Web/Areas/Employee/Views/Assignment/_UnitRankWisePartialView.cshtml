@model AssignmentViewModel
@{
    ViewData["Title"] = "Employee Posting";
    //Layout = "~/Views/Shared/_LayoutForPartial.cshtml";
}
<link href="~/plugins/nestable/jquery.nestable.css" rel="stylesheet" />
<link href="~/plugins/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/css/bootstrap.min.css" rel="stylesheet">
<link href="~/css/slidebars.min.css" rel="stylesheet">
<link href="~/css/icons.css" rel="stylesheet">
<link href="~/css/menu.css" rel="stylesheet" type="text/css">
<link href="~/css/style.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Zen+Dots&display=swap" rel="stylesheet">

<style>

    .nestable-color-2 .dd-handle {
        background-color: #0069D1;
        color: #fff;
    }

    .nestable-color-2 .dd-handle1 {
        background-color: red !important;
    }

    .sb-custom-toggle-right {
        top: 45%;
        position: fixed;
        right: 0%;
    }
    #divEmpList::-webkit-scrollbar {
        width: 0; /* Remove scrollbar space */
        background: transparent; /* Optional: just make scrollbar invisible */
    }
    /*@@media screen and (max-width: 1400px){
        .empInfo{
            font-size:10px;
        }
    }*/
</style>
<div class="col-12" id="divEmpList" style="padding:0;height:850px;overflow-y:scroll;">
    <ol class="dd-list">
        @{
            if (Model.unitRankWiseEmployeeViewModels.Count() == 0)
            {
                <div style="padding-top:200px;text-align:center;">
                    <p style="font-size:24px;">No Data Found</p>
                </div>
            }
            else
            {
                int[] rangeId = { 1015, 1016, 1019, 1021, 1023, 1022, 1020, 1017 };
                foreach (var data in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 1).GroupBy(x => new { x.unitId, x.mainUnit }).Select(x => new { unitId = x.Key.unitId, mainUnit = x.Key.mainUnit }))
                {
                    <li class="dd-item" data-id="@data.unitId">
                        
                        <div style="font-size:16px!important;padding:10px 25px 30px 20px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.mainUnit  <span class="m-2" title="Total Post"><i class="fa fa-users text-danger"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == data.unitId).FirstOrDefault().numOfPost</span><span class="m-2" title="Total Officers"><i class="fa fa-user text-info"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == data.unitId).FirstOrDefault().totalEmployee</span> <span class="m-2"><i class="fa fa-user-o text-primary" title="Blank Post"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == data.unitId).FirstOrDefault().vacantPost</span></div>
                        <ol class="dd-list">
                            @foreach (var sitem in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 1 && x.unitId == data.unitId && x.employeeId!=0))
                            {

                                <li class="dd-item" id="emp-@sitem.employeeId" data-id="@sitem.unitId" onclick="fnEmployeeShow(@sitem.employeeCode)">
                                    <div class="dd-handle" style="background-color: @sitem.colorCode;color:black;font-weight:bolder;border-radius:7px">
                                        <input type="hidden" class="clsEmpId" id="txtEmpId-@sitem.employeeId" value="@sitem.employeeId" /><span class="empInfo">@Html.Raw(sitem.name)</span><span class="badge pull-right" style="height:100%!important;background-color:#040825;cursor:pointer"><i class="fa fa-plus fa-1x" id="ForReDo-@sitem.employeeId" onclick="fnSelectedEmployee(@sitem.employeeId,'@sitem.name','@sitem.employeeCode',@sitem.rankId,'@sitem.colorCode')"></i></span>

                                        @if (sitem.expertise != "")
                                        {
                                            var title = sitem.expertise.Replace(".png", "").Replace("/batch/", "");

                                            <img src="@sitem.expertise" data-toggle="tooltip" data-placement="top" title="@title" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />
                                        }
                                        else
                                        {
                                        }
                                        &nbsp;
                                        @if (sitem.skillIcon!="")
                                        {
                                            <img src="@sitem.skillIcon" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />

                                        }
                                        &nbsp;
                                        @if (sitem.attachedUnit != "")
                                        {
                                            <img src="~/batch/attached.png" data-toggle="tooltip" data-placement="top" title="@sitem.attachedUnit" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />
                                        }
                                        &nbsp;
                                        @if (sitem.pHQTRTypeId > 0)
                                        {
                                            <img src="~/batch/unmission.png" title="UN Mission" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />

                                        }
                                        &nbsp;
                                        @if (sitem.lockedEmpId > 0)
                                        {
                                            <img src="~/batch/locked.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />

                                        }
                                        else { }
                                    </div>
                                </li>
                            }
                            
                        </ol>
                    </li>

                }

                foreach (var data in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 0).GroupBy(x => new { x.specialBranchUnitId, x.mainUnit }).Select(x => new { unitId = x.Key.specialBranchUnitId, mainUnit = x.Key.mainUnit }))
                {
                    int? nop = 0;
                    int? temp = 0;
                    int? vacant = 0;
                    @foreach (var uu in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 0 && x.specialBranchUnitId == data.unitId).GroupBy(x => new { x.unitId, x.subUnit }).Select(x => new { unitId = x.Key.unitId, subUnit = x.Key.subUnit }))
                    {
                        nop = nop + Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == uu.unitId).FirstOrDefault().numOfPost;
                        temp = temp + Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == uu.unitId).FirstOrDefault().totalEmployee;
                        vacant = nop - temp;
                    }
                    <li class="dd-item" data-id="@data.unitId">

                        <div style="font-size:16px!important;padding:10px 25px 30px 20px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.mainUnit  <span class="m-2" title="Total Post"><i id="nop-@data.unitId" class="fa fa-users text-danger"></i> @nop</span><span class="m-2" title="Total Officers"><i class="fa fa-user text-info"></i>  @temp</span> <span class="m-2"><i class="fa fa-user-o text-primary" title="Blank Post"></i>  @vacant</span></div>
                        <ol class="dd-list">

                            @foreach (var subu in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 0 && x.specialBranchUnitId == data.unitId).GroupBy(x => new { x.unitId, x.subUnit }).Select(x => new { unitId = x.Key.unitId, subUnit = x.Key.subUnit }))
                            {
                                @if (Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 0 && x.unitId == subu.unitId).Count() == 0)
                                {
                                    <li class="dd-item" data-id="@subu?.unitId">

                                        <div class="dd-handle" style="background-color: #040825;border-radius:7px">@subu.subUnit <span class="m-1" title="Total Post"><i class="fa fa-users"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().numOfPost</span><span class="m-1" title="Total Officers"><i class="fa fa-user"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().totalEmployee</span> <span class="m-1"><i class="fa fa-user-o" title="Blank Post"></i> @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().vacantPost</span></div>
                                    </li>
                                }
                                else
                                {

                                    <li class="dd-item" data-id="@subu?.unitId">
                                        <div class="dd-handle" style="background-color: #040825;border-radius:7px">@subu?.subUnit <span class="m-2" title="Total Post"><i class="fa fa-users"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().numOfPost</span><span class="m-1" title="Total Officers"><i class="fa fa-user"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().totalEmployee</span> <span class="m-1"><i class="fa fa-user-o" title="Blank Post"></i>  @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().vacantPost</span></div>
                                        <ol class="dd-list">
                                            @foreach (var sitem in Model.unitRankWiseEmployeeViewModels.Where(x => x.isParent == 0 && x.unitId == subu.unitId && x.employeeId>0))
                                            {

                                                <li class="dd-item" id="emp-@sitem.employeeId" data-id="@sitem.unitId" onclick="fnEmployeeShow(@sitem.employeeCode)">
                                                    <div class="dd-handle" style="background-color: @sitem.colorCode;color:black;font-weight:bolder;border-radius:7px">
                                                        <input type="hidden" class="clsEmpId" id="txtEmpId-@sitem.employeeId" value="@sitem.employeeId" /><span class="empInfo"> @Html.Raw(sitem.name)</span><span class="badge  pull-right" style="height:100%!important;background-color:#040825!important;cursor:pointer"><i class="fa fa-plus fa-1x" id="ForReDo-@sitem.employeeId" onclick="fnSelectedEmployee(@sitem.employeeId,'@sitem.name','@sitem.employeeCode',@sitem.rankId,'@sitem.colorCode')"></i></span>
                                                        @if (sitem.expertise != "")
                                                        {
                                                            <img src="@sitem.expertise" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />
                                                        }
                                                        else
                                                        {
                                                        }
                                                        @if (sitem.attachedUnit != "")
                                                        {
                                                            <img src="~/batch/attached.png" data-toggle="tooltip" data-placement="top" title="@sitem.attachedUnit" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />
                                                        }
                                                        &nbsp;&nbsp;
                                                        @if (sitem.lockedEmpId > 0)
                                                        {
                                                            <img src="~/batch/locked.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />

                                                        }
                                                        &nbsp;&nbsp;
                                                        @if (sitem.pHQTRTypeId > 0)
                                                        {
                                                            <img src="~/batch/unmission.png" title="UN Mission" class="img-fluid rounded-circle p-0 m-0" style="width:25px; height:25px" />

                                                        }
                                                        else { }
                                                    </div>
                                                </li>
                                            }
                                        </ol>
                                    </li>
                                }
                            }
                        </ol>
                    </li>

                }
            }


        }

    </ol>
</div>
<script src="~/js/jquery-3.2.1.min.js"></script>
<script src="~/js/bootstrap.min.js"></script>
<script src="~/js/jquery.slimscroll.min.js"></script>
<script src="~/js/slidebars.min.js"></script>
<script src="~/js/common.js"></script>
<!-- Responsive and datatable js -->
<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
<script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
<script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
<script src="~/plugins/nestable/jquery.nestable.js"></script>
<script src="~/plugins/nestable/nestable.js"></script>
<script src="~/js/dropify.min.js"></script>
<!--app js-->
<script src="~/js/jquery.app.js"></script>
<!--Swall-->
<script type="text/javascript" src="~/plugins/parsleyjs/dist/parsley.min.js"></script>
<script>
    $(document).ready(function () {
        $('#olEmpList').show();
        $('#loaderDiv').hide();
    })
</script>
