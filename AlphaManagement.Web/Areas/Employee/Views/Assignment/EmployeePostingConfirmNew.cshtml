@section Scripts{
    @*<script src="~/js/jquery-3.2.1.min.js"></script>*@
    <script src="~/js/jquery-ui.js"></script>
    <script src="~/js/jquery-ui.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pure.js/2.82/pure.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pure.js/2.82/pure.js"></script>
    <script type="text/javascript">
        let deleteEmpList = [];
        let deleteEmpId = [];
        function deleteEmpFromList(employeeId) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {
                var lidata = $('#DragableList-' + employeeId).html();
                deleteEmpList.push(lidata);
                deleteEmpId.push(employeeId);
                $('#DragableList-' + employeeId).remove()
            });
        }

        function ReturnFromDelete() {
            if (deleteEmpId.length == 0) {
                alert("Nothing To Return");
                return false;
            }
            var emp = deleteEmpId.pop();
            var empdiv = deleteEmpList.pop();
            $('#enlistLiApp').append(`<li class="dd-item enrollst" id="DragableList-${emp}" data-id="${emp}">${empdiv}</li>`)
        }

        function fnAssignedEmployee(id, name, empCode, rank, rankId, color, postingPlace) {
            $('#assignedEmpDiv').show()
            var data = '';
            var check = $(`#slEmpList-${id}`).val();
            if (check == id) {
                $(`#emp-${id}`).hide();
                return false;
            }
            else {
                $(`#emp-${id}`).hide();
                data = `<li class="dd-item" id="slEmp-${id}">
                            <input type="hidden" name="empId" id="slEmpList-${id}" value="${id}"/>
                            <input type="hidden" name="empCode" value="${empCode}"/>
                            <input type="hidden" name="empRank" value="${rankId}"/>
                            <div class="dd-handle row fontStyle" style="background-color:${color};height: 70px;border-radius: 10px;padding: 0;margin: 0;padding-top: 4px;color: black;font-weight: bold;"><span class="col-11">${name},${empCode},${rank},${postingPlace} </span><span class="col-1 badge float-right" style="background-color: white;color:red; height: 23px;width: 20px;" onclick="removeFromSelectedDiv(${id})"><i class="fa fa-times fa-1x"></i></span></div>
                        </li>`;
                //var selectedEmpArr = JSON.parse(localStorage.getItem('EmpData') || '[]');
                //selectedEmpArr.push(id);
                //localStorage.setItem('EmpData', JSON.stringify(selectedEmpArr));
            }
            $('#assignedEmpList').append(data)
            var counter = $('#assignedEmpDiv li').length;
            $('#assignCounter').html(counter);
        }

        $(document).ready(function () {
            $('#VacantBtn').hide();
            $(".trash").droppable({
                drop: function (event, ui) {
                    var id = ui.draggable.find('input[name="employeeDataId"]').val();
                    swal({ title: 'Warning', text: `Delete from list`, type: 'warning', confirmButtonColor: 'red', confirmButtonText: `Delete!` }).then((result) => {
                        if (result.dismiss == 'overlay') {
                            return false;
                        }
                        else {
                            Common.Ajax('GET', '/Employee/Assignment/DeleteEnlistedAssignment/' + id, [], 'json', ajaxDeleteEnlist);
                        }
                    })
                }
            });

            function ajaxDeleteEnlist(res) {
                var employeeId = $('#EmployeeIdHdn').val();
                if (res == 1) {
                    $('#DragableList-' + employeeId).remove();
                }
            }

            $("#txtSearchEmployee").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchEmployeeFreeze").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpListFreeze ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#btnSearchEmployee").on("click", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchPP").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olPPListSuggested ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#moveModalSearchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#moveModalSearch ol li").not(".notsearch").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#moveModalSearchInputName").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $(".notsearch").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#policeUnitId").change(function () {
                var id = $(this).val();
                Common.Ajax('GET', '/Employee/Assignment/GetUnitWiseEmployeInfo/', [], 'json', ajaxUnits);
            })
        });

        $('#frezzEmployee').submit(function (e) {
            e.preventDefault();

            var form = $('#frezzEmployee')
            $.ajax({
                url: '/Employee/Assignment/SaveFrezzPostingData',
                data: form.serialize(),
                type: 'POST',
                success: function (records) {
                    if (records != "Fail") {
                        $('#refNumId').val(records);
                        $('#submitPosting').click();
                    }
                    else {
                        swal('', 'Unable to Save!', 'warning');
                    }
                },
                error: function (erro) {
                    //console.log(erro);
                    swal('', 'Unable to Save!', 'warning');
                }
            });
        })

        $('#postingBtnClick').click(function () {
            var checkEnrollList = $('#olEmpList ol li div').length;
            var empCount = $('#postingForm input[name="employeeId"]').length;
            var empSectionCount = $('#postingForm input[name="sectionId"]').length;
            var empSectionCount1 = $('#postingForm select[name="sectionId"]').length;
            //console.log(empCount)
            //console.log(empSectionCount)
            //console.log(empSectionCount1)
            if (checkEnrollList > 0) {
                swal({
                    title: 'Warning', text: 'Employee List For Posting Not Completed', type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok`
                }).then(function () {
                    return false;
                })
                return false;
            }
            else if (empCount == (empSectionCount + empSectionCount1)) {
                $('#frezzPosting').click();
            }
            else {
                //console.log('check changing posting place');
                swal({
                    title: 'Error', text: 'Please check changing posting place', type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok`
                }).then(function () {
                    return false;
                })
                return false;
            }

        })

        $('#postingForm').submit(function (e) {
            //alert()
            e.preventDefault();
            var form = $('#postingForm')
            $.ajax({
                url: '/Employee/Assignment/SaveNewPostingData',
                data: form.serialize(),
                type: 'POST',
                success: function (records) {
                    $('#AssignmentId').val(records.assignMasterId);
                    if (records.refNumber != 'Fail') {
                        window.location.href = '/Employee/Assignment/AssignmentMasterDetailsForNext?id=' + records.assignMasterId;
                    }
                    else {
                        swal('', 'Unable to Save!', 'warning');
                    }

                },
                error: function (erro) {
                    //console.log(erro);
                    swal('', 'Unable to Save!', 'warning');
                }
            });
        })

        function ajaxUnits(response) {
            var options = '<option value="">Select </option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.subunitName + '</option>';
            });
            $('#policeSubUnitId').empty();
            $('#policeSubUnitId').append(options);
        }

        function LoadSuggested(empId, rankId, refNo) {
            $('#movToEmpId').val(empId);
            $('#divLoader1').show();
            $('#olPPListForSuggestedUnitList').hide();
            $("#olPPListForSuggestedUnitList").load("/Employee/Assignment/GetSuggetionNewList?id=" + empId + "&rankId=" + rankId + "&refNum=" + refNo);
            $('#exampleModal').modal('show');
        }

        var pageNumber = 1;
        function LoadSuggestedNew(empId, rankId, refNo,name) {
            //$('#spnEmpInfo').html(name + ', ' + rank);
            $('#movToEmpId').val(empId);
            $('#NameOfPostedEmp').text(name);
            $('#rankIdForPrvNxt').val(rankId);
            $('#refNoForPrvNxt').val(refNo);
            $('#addAllSuggBtn').empty();
            $('#pageNumber').val(1);

            $.ajax({
                url: '/Employee/Assignment/GetEmployeeBasicInfoForPostingByempId?Id=' + empId,
                type: 'GET',
                success: function (res) {
                    $('#BasicName').text(res.name);
                    $('#BasicBp').text(res.bp);
                    $('#BasicRank').text(res.rank);
                    $('#BasicHD').text(res.HomeDistrict);
                    $('#BasicSHD').text(res.SpouseHomeDistrict);
                    $('#BasicRPU').text(res.priviousPosting);
                    //$('#BasicPPU').text('');
                    $('#BasicEQ').text(res.Education);
                    $('#BasicLPD').text(res.lastPromotionDate);
                    $('#EmpImage').attr("src", "http://portfolio.police.gov.bd/" + res.picture);

                    var option = "";
                    var sl = 1;
                    $.each(res.assignments, function (i, item) {
                        if (res.assignments.length == 1) {
                            option += `<tr class="clsPrevUnit"><td>Privious Posting Unit</td><td>${sl}. ${item}</td></tr>`;
                        } else {
                            if (i == 0) {
                                option += `<tr class="clsPrevUnit"><td>Privious Posting Unit</td><td>${sl}. ${item}. <span id="spnMore" style="cursor:pointer;color:blue;" onclick="fnShowMoreUnit('more')">see more...</span></td></tr>`;
                            } else {
                                if (res.assignments.length == i + 1) {
