                                                                                                                                <input type="hidden" class="unitId" value="${branchUnitName}" />
                                                                                                                                <input type="hidden" class="unit" value="${Id}" />
                                                                                                                            <select class="form-control" style="width:107%;float:right;" id="postPlaceId-${Id}" onchange="changeNewPostingPlace(${Id})">
                                                                                                                                ${data}
                                                                                                                            </select>
                                                                                                                            </div>
                                                                                                                        </li>`)


                    $(".wosue").sortable({
                        connectWith: '.clsFreez',
                        appendTo: 'body',
                        tolerance: 'pointer',
                        revert: 'invalid',
                        forceHelperSize: true,
                        helper: function (event, element) {
                            return element.clone().appendTo("body")
                        },
                        scroll: false,
                        remove: function (event, ui) {
                            ui.item.closest('div').next().find('select').removeAttr('name')
                            //console.log(ui)
                        },
                        start: function (e, ui) {
                            window.grabbed = true;
                            ui.item.startPos = ui.item.prevAll().length + 1;
                            var div = ui.item.get(0);
                            document.body.appendChild(div);
                        },
                        stop: function () {
                            window.grabbed = false;
                        }
                    }).sortable("option", "scroll", false)
                        .disableSelection();
                    $(".wosue").droppable({
                        //accept: '#enlistLiApp',
                        //greedy: true,
                        //revert: "valid",
                        drop: function (event, ui) {
                            $(this).find("input.clsSectionId").attr("name", "sectionId");
                            var empName = ui.helper.find('input[name="employeeName"]').val();
                            var empId = ui.helper.find('input[name="employeeId"]').val();
                            $(this).find("input").attr("id", "selectedPostingPlace" + empId);
                            $(this).closest('div').next().find('select').attr('name', 'sectionId');
                            $(this).closest('li.dd-item').removeAttr('id');
                            //console.log($(this).closest('div').next().find('select'))
                            //$(this).closest('li.dd-item').find('div.form-control').css('background-color', 'red');
                            var empRank = ui.helper.find('input[name="employeeRank"]').val();
                            var empCode = ui.helper.find('input[name="employeeCode"]').val();
                            var empUnit = ui.helper.find('input[name="employeeUnit"]').val();
                            var empSection = ui.helper.find('input[name="employeeSection"]').val();
                            var empColor = ui.helper.find('input[name="employeeColor"]').val();
                            var empBCS = ui.helper.find('input[name="employeeBCS"]').val();
                            var empRankId = ui.helper.find('input[name="employeeRankId"]').val();
                            var refNo = ui.helper.find('input[name="refNo"]').val();
                            var empBatch = ui.helper.find('input[name="employeeBatch"]').val();
                            var empDataId = ui.helper.find('input[name="employeeDataId"]').val();
                            var newPlace = $(this).closest('div').find('.unitId').val();
                            var untId = $(this).closest('div').next().find('.unit').val();
                            var check1 = $('#unitId-' + untId).find('div.wosue').html();
                            if (check1 != '') {
                                $('#unitId-' + untId).removeAttr('id');
                                $('#postPlaceId-' + untId).removeAttr('id');
                            }
                            var sectionId1 = $(this).find('.sectionName').val();
                            var sectionId2 = $(this).closest('div').next().find('option:selected').text();
                            var newSection = '';
                            if (sectionId1 != undefined) {
                                newPlace = $(this).closest('div').find('.unitId').val();
                                newSection = sectionId1
                            }
                            else {
                                newPlace = $(this).closest('div').next().find('.unitId').val();
                                untId = $(this).closest('div').next().find('.unit').val();
                                if (sectionId2 == '--Select--') {
                                    newSection = '';
                                }
                                else {
                                    newSection = sectionId2;
                                }
                            }
                            $('#previewEmpId').val(empId);
                            var check = $(`#slEmpList-${empId}`).val();
                            if (check == empId) {
                                $('#assLi' + empId).remove();
                            }
                            stack.push(empId);
                            var assign = `<li id=assLi${empId} class="row previewCls" style="background-color:${empColor};padding-left:4%;margin-left: 0;">
                                                                                                <div class="col-11" style="padding:0"><input type="hidden" name="empId" id="slEmpList-${empId}" value="${empId}"/>${empName} </br> <i class="fa fa-mail-reply"></i> ${empRank},  ${empSection} - ${empUnit} </br> <i class="fa fa-mail-forward"></i> ${empRank}, <span id="empNewSec-${empId}">${newSection}</span> - ${newPlace}</div>
                                                                                                <div class="col-1"><span style="color:red" id="AlreadyGiven-${empId}" onclick="removePreview(${empId},'${empColor}','${empName}','${empRank}','${empSection}','${empUnit}','${empBCS}',${empRankId},'${refNo}','${empBatch}',${empDataId},${untId},${empCode})"><i class="fa fa-times"></i></span></div></li>`
                            $('#assignedEmpList1').append(assign);
                        }
                    });
                }
            });



            //console.log(data);
            //return false;

        }

