        function AddNewPostingPlace(Id, rankName, rankId, branchUnitName) {
            var data = "";
            $.ajax({
                url: '/global/api/GetPostingPlaceBySpecialBarnchId/' + Id,
                type: 'GET',
                success: function (rec) {
                    $.each(rec, function (i, v) {
                        //alert(v.Name);
                        data += `<option value="${v.Id}">${v.Name}</option>`
                    })

                    $("#DivListAdd-" + Id).append(`<li class="dd-item form-inline notsearch clswosue" id="unitId-${Id}">
                                                                                                                            <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">${rankName}<input type="hidden" name="rankId" value="${rankId}" /></div>
                                                                                                                            <div class="wosue" ondrop="drop(event,${Id})" id="divwosue3" style="width:55%;height:45px;"></div>
