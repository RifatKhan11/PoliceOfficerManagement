        }

        function returnMaster(id) {
            var comment = $("#reasonComment").val();
            if (comment == null || comment == '') {
                swal('Warning', 'Please Write a Note ', 'warning');
                return false;
            }

            var user = $("#UserId").val();
            if (user == null || user == '') {
                swal('Warning', 'Please Select Return User ', 'warning');
                return false;
            }

            swal({
                title: 'Are you sure?', text: 'Do you want to return!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: "/Employee/Assignment/AssignmentMasterReturn?id=" + id + "&comment=" + comment + "&user=" + user,
                        type: 'GET',
                    })
                        .done(function (responce) {
                            if (responce == "update") {
                                location.href = "/Employee/Assignment/AssignmentPostMaster";
                            }
                            else {
                                swal('Failed', 'Unable to return. Please try again later !!!', 'error');
                            }
                        })
                        .fail(function () {
                            swal('Failed', 'Unable to return. Please try again later !!!', 'error');
                        });
                } else if (result.dismiss === 'cancel') {
                    return false;
                }
            });
