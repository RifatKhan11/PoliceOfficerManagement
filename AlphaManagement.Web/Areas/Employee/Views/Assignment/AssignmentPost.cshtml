</div>

<div class="modal fade bd-example-modal-lg" id="mobileViewModal" tabindex="-1" role="dialog" aria-labelledby="mobileViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mobileViewModalLabel">Posting Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 p-0">
                    @foreach (var item in Model.assignmentDetailsModals)
                    {
                        var exprt = Model.badgeAndActivityModels.Where(x => x.employeeId == item.employeeId && x.expertise != "").FirstOrDefault();
                        var locked = Model.badgeAndActivityModels.Where(x => x.employeeId == item.employeeId && x.lockedEmpId > 0).FirstOrDefault();
                        var Unmiss = Model.badgeAndActivityModels.Where(x => x.employeeId == item.employeeId && x.pHQTRTypeId > 0).FirstOrDefault();

                        <div class="card p-0 mt-1">
                            <div class="card-header p-0">
                                <div class="col-12 text-center">
                                    @if (item.picture == null)
                                    {
                                        <img src="~/logo/pp.jpg" style="width:100px;height:100px" class="img-fluid rounded-circle p-0 m-0" />
                                    }
                                    else
                                    {
                                        <img src="@baseUrl/@item.picture" style="width:100px;height:100px" class="img-fluid rounded-circle p-0 m-0" />
                                    }
                                </div>
                                <div class="col-12 text-center">
                                    @item.Name (@item.Bp)
                                    @if (exprt != null)
                                    {
                                        <img src="@exprt.expertise" class="img-fluid rounded-circle p-0 m-0" style="width:50px; height:50px" />
                                    }
                                    @if (locked != null)
                                    {
                                        <img src="~/batch/locked.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:50px; height:50px" />
                                    }
                                    @if (Unmiss != null)
                                    {
                                        <img src="~/batch/unmission.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:50px; height:50px" />
                                    }
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="col-12 text-center p-0">
                                    <label>Rank : </label><label>@item?.rankName</label><br />
                                    <label>BCS Batch : </label><label>@item?.batch</label><br />
                                </div>
                                <div class="col-12">
                                    <label>Current Place : </label><label>@item?.currentPostringPlace</label><br />
                                    <label>Working Period : </label><label>@AlphaManagement.Web.Helpers.CalDateDifference.DateDifference(Convert.ToDateTime(item.joiningDateOfPresentunit), DateTime.Now)</label><br />
                                    <label>New Place : </label><label>@item?.NewPostringPlace</label><br />
                                </div>
                                <div class="col-12 p-0">
                                    <ul>
                                        <li>Educational Qualification : @item.educationalQualification</li>
                                        <li>Date of Birth : @item.dateOfBirth?.ToString("dd-MMM-yyyy")</li>
                                        <li>Home District : @item.homeDistrict</li>
                                        @if (item.LastPromotionDate?.ToString("dd-MMM-yyyy") != "01-Jan-0001")
                                        {
                                            <li>Last promotion Date : @item.LastPromotionDate?.ToString("dd-MMM-yyyy")</li>
                                        }
                                        else
                                        {
                                            <li>Last promotion Date : </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger btn-sm text-center" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>

        function addComment(id,bp,name) {
            $('#listId').val(id);
