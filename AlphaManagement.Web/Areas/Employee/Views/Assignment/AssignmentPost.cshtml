            $('#exampleModal').modal('show');
        }

        $('#saveRemarks').click(function () {
            var id = $('#listId').val();
            var data = $('#remarks').val();
            var formdata = new FormData();
            formdata.append("AssignmentId", id);
            formdata.append("Remarks", data);
            $.ajax({
                url: '@Url.Action("AssignmentComment", "Assignment", new { area = "Employee" })',
                type: "POST",
                data: formdata,
                processData: false,
                contentType: false

            })
            .done(function (response) {
                if (response == "save") {
                    $('#result-' + id).empty();
                    $('#result-' + id).append(data);
                    $('#exampleModal').modal('hide');
                }
            })
        })


