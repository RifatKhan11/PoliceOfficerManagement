@model AssignmentViewModel
@{
    ViewData["Title"] = "Employee Posting";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    List<int?> lstUnit = new List<int?>();
}
<div class="col-12 row">
    <div class="col-1"></div>
    <div class="col-10 dd nestable_list_2 nestable-color-2" id="moveModalSearch">
        <ol class="dd-list">
            @{
                
                @foreach (var data in Model.suggestedBrancheds)
                {
                    if (data.specialBranchUnitId == 0)
                    {
                        <li class="dd-item" data-id="@data.unitId">

                            <div style="font-size:16px!important;padding:10px 25px 30px 20px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.mainUnit  <span class="m-2" title="Total Post"><i class="fa fa-users text-danger"></i>  @Model.suggestedBrancheds.Where(x => x.unitId == data.unitId).FirstOrDefault().numOfPost</span><span class="m-2" title="Total Officers"><i class="fa fa-user text-info"></i>  @Model.suggestedBrancheds.Where(x => x.unitId == data.unitId).FirstOrDefault().totalEmployee</span> <span class="m-2"><i class="fa fa-user-o text-primary" title="Blank Post"></i>  @Model.suggestedBrancheds.Where(x => x.unitId == data.unitId).FirstOrDefault().vacantPost</span></div>
                            <ol class="dd-list">
                                <li class="dd-item col-12 row" id="emp-@data.unitId" data-id="@data.unitId">
                                    <div class="col-2 form-control m-1" style="background-color: lavender; color: black; font-weight: bolder;">@Model?.enlistedAssignments?.FirstOrDefault()?.employee?.rank?.rankName <input type="hidden" name="rankId" value="@Model?.enlistedAssignments?.FirstOrDefault().employee?.rankId" /></div>
                                    <div class="wosue col-6" id="divwosue3" style="width:55%;height:45px;">
                                        <a class="btn col-11" style="height:35px;background-color: yellowgreen;color: white;font-size: 20px;font-weight: bolder;margin-top: 5px;margin-left: 10px;" onclick="moveToPostingPlace(@data.unitId)" href="javascript:void(0)">Move Here</a>
                                    </div>
                                    <div class="dd-nodrag col-3">
                                        <select class="form-control" name="sectionId" style="width:107%;float:right;">
                                            @foreach (var item in Model.sections.Where(x => x.specialBranchUnitId == @data.unitId))
                                            {
                                                <option value="@item.Id">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                </li>

                            </ol>
                        </li>
                    }
                    else if(!lstUnit.Contains(data.unitId))
                    {
                        <li class="dd-item" data-id="@data.unitId">
                            <div style="font-size:16px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.mainUnit</div>
                            <ol class="dd-list">
                                @foreach (var subu in Model.suggestedBrancheds.Where(x => x.specialBranchUnitId == data.specialBranchUnitId).GroupBy(x => new { x.unitId, x.subUnit }).Select(x => new { unitId = x.Key.unitId, subUnit = x.Key.subUnit }))
                                {
                                    lstUnit.Add(subu.unitId);
                                    <li class="dd-item" data-id="@subu?.unitId">
                                        <div class="dd-handle" style="background-color: #040825;border-radius:7px">@subu?.subUnit <span class="m-2" title="Total Post"><i class="fa fa-users"></i>  @Model.suggestedBrancheds.Where(x => x.unitId == subu.unitId).FirstOrDefault().numOfPost</span><span class="m-1" title="Total Officers"><i class="fa fa-user"></i>  @Model.suggestedBrancheds.Where(x => x.unitId == subu.unitId).FirstOrDefault().totalEmployee</span> <span class="m-1"><i class="fa fa-user-o" title="Blank Post"></i>  @Model.suggestedBrancheds.Where(x => x.unitId == subu.unitId).FirstOrDefault().vacantPost</span></div>
                                        <ol class="dd-list">
                                            <li class="dd-item col-12 row" id="emp-@subu.unitId" data-id="@subu.unitId">
                                                <div class="col-2 form-control m-1" style="background-color: lavender; color: black; font-weight: bolder;">@Model?.enlistedAssignments?.FirstOrDefault()?.employee?.rank?.rankName <input type="hidden" name="rankId" value="@Model?.enlistedAssignments?.FirstOrDefault().employee?.rankId" /></div>
                                                <div class="wosue col-6" id="divwosue3" style="width:55%;height:45px;">
                                                    <a class="btn col-11" style="height:35px;background-color: yellowgreen;color: white;font-size: 20px;font-weight: bolder;margin-top: 5px;margin-left: 10px;" onclick="moveToPostingPlace(@subu.unitId)" href="javascript:void(0)">Move Here</a>
                                                </div>
                                                <div class="dd-nodrag col-3">
                                                    <select class="form-control" name="sectionId" style="width:107%;float:right;">
                                                        @foreach (var item in Model.sections.Where(x => x.specialBranchUnitId == subu.unitId))
                                                        {
                                                            <option value="@item.Id">@item.Name</option>
                                                        }
                                                    </select>
                                                </div>
                                            </li>
                                        </ol>
                                    </li>

                                }

                            </ol>
                        </li>
                    }
                    else
                    {

                    }


                }
               
            }

