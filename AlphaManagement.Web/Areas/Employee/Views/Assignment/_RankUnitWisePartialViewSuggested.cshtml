                                            <div class="wosue col-6" id="divwosue3" style="width:55%;height:45px;">
                                                <a class="btn col-11" style="height:35px;background-color: yellowgreen;color: white;font-size: 20px;font-weight: bolder;margin-top: 5px;margin-left: 10px;" onclick="moveToPostingPlace(@subu.unitId)" href="javascript:void(0)">Move Here</a>
