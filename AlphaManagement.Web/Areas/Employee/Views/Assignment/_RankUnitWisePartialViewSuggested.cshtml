                            }

                        </ol>
                    </li>

                }
            }*@

        </ol>

    </div>
    <div class="col-1"></div>
</div>
<script src="~/plugins/nestable/jquery.nestable.js"></script>
<script src="~/plugins/nestable/nestable.js"></script>
<script>
    $(document).ready(function () {

        $('#divLoader1').hide();
        $('#olPPListForSuggestedUnitList').show();
        $('#divLoader').hide();
        $('#moveToDiv').show();
    })
</script>

