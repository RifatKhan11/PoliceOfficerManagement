</style>

<ul class="nav nav-tabs mt-3" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link active p-0 mr-2" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true"> <i class="fa fa-align-justify " style="font-size:30px;color:#13087E" aria-hidden="true"></i></a>
    </li>
    @*<li class="nav-item" role="presentation">
            <a class="nav-link p-0" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false"><i class="fa fa-th" style="font-size:30px;color:#13087E" aria-hidden="true"></i></a>
        </li>*@

</ul>

<div class="tab-content mt-4" id="myTabContent">

    <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
        <div class="row mt-3 border p-1 text-light" style="background-color:#2A1067;border-radius:20px;">
            <div class="col-8">
                <h4 class="ml-2">Reference Number  <span style="font-size:15px;color:red">@Model.assignments?.FirstOrDefault()?.assignmentMaster?.refNo</span></h4>

            </div>
            <div class="col-4">
                <a href="/Employee/Report/WaitAssignListpdf/@Model.assignMasterId" class="btn btn-success float-right" target="_blank">Print</a>

            </div>
        </div>
        
        <div class="card bg-light">
            
            <div class="card-body">
                
                <div class="row">
                    <div class="col-md-12 col-12">
                        <table class="table table-bordered table-striped table-sm"  style="width:100%">
                            <thead>
                                <tr class="table-sm" style="background-color:#2A1067;color:#fff">
                                    <td>Sl No</td>
                                    <td>Bp No</td>
                                    <td>Name</td>
                                    <td>Rank</td>
                                    <td>Batch</td>
                                    <td>Working Period</td>
                                    <td>Previous Posting Place</td>
                                    <td>Posted Posting Place</td>
                                    <td>Remarks</td>
                                </tr>
                            </thead>

                            <tbody>
                                @{var i = 1;}
                                @foreach (var item in Model.assignments)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@item.employee?.employeeCode</td>
                                        <td>@item.employee?.nameEnglish</td>
                                        <td>@item.employee?.rank?.rankName</td>
                                        <td>@item.employee?.bCSBatch?.batchName</td>
                                        <td>@item.employee?.servicePeriod</td>
                                        <td>
                                            @item.employee?.section?.Name, 
                                            @item.employee?.section?.specialBranchUnit?.districts?.districtName
                                        </td>
                                        <td>
                                            @item.section?.Name, 
                                            @item.section?.specialBranchUnit?.districts?.districtName
                                        </td>
                                        <td id="result-@item.Id"></td>
                                    </tr>
                                    i++;
                                }

                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
        <div class="row">
            @foreach (var item in Model.assignments)
            {

                <div class="col-md-4 col-12 p-0" style="border-radius:5px;color:#fff;border:1px solid #aaa;">
                    <div class="card-header border-0">
                        <div class="text-center">
                            @if (item.employee?.Photographs?.FirstOrDefault()?.url == null)
                            {
                                <img src="~/logo/pp.jpg" style="width:100px;height:100px" class="img-fluid rounded-circle" />
                            }
                            else
                            {
                                <img src="/@item.employee?.Photographs?.FirstOrDefault()?.url" style="width:100px;height:100px" class="img-fluid rounded-circle" />
                            }
                        </div>
                    </div>
                    <div class="card text-center border-0">
                        <div class="card-body">
                            <h6 class="text-dark font-weight-bold">Name : @item.employee?.nameEnglish</h6>
                            <h6 class="text-dark font-weight-bold">BP NO :@item.employee?.employeeCode</h6>
                            <h6 class="text-dark font-weight-bold">Rank : @item.employee?.rank?.rankName</h6>
                            <h6 class="text-dark font-weight-bold">Batch :@item.employee?.bCSBatch?.batchName</h6>
                        </div>

                        <table class="table table-bordered" style="width:100%">
                            <tr class="text-dark">
                                <td>Previous Posting Place</td>
                                <td>Posted Posting Place</td>
                            </tr>

                            <tr class="text-dark">
                                <td>@item.employee?.section?.Name</td>
                                <td>@item.section?.Name</td>
                            </tr>
                        </table>
                    </div>

                </div>
            }

        </div>
        <div class="float-right mt-4 mb-4 pt-4">
            <a class="btn btn-success btn-sm" onclick="approve1('@Model.assignments?.FirstOrDefault()?.assignmentMasterId')" href="#">Lock</a>
        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg" id="empDetailsModal" role="dialog" aria-labelledby="empDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Details Info</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="col-12 row" id="empDetails" style="overflow: scroll; height: 600px;margin:0">
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg" id="postingEditModal" role="dialog" aria-labelledby="postingEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Change Posting Place</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="col-12 row">
                    <div class="col-md-6 row">
                        <h3 style="text-align:center">Previous Working Place</h3>
                    </div>
                    <div class="col-md-6 row">
                        <h3 style="text-align:center">Selected Working Place</h3>
                        <div class="col-12 form-group">
                            <select class="form-control">
                                <option value="">Select</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Remarks</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="form-group">
                        <input type="hidden" id="listId" value="" />
                        <label for="message-text" class="col-form-label">Comments</label>
                        <textarea class="form-control" id="remarks"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Close</button>
                <button type="button" id="saveRemarks" class="btn btn-primary btn-sm">Save</button>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>

        function addComment(id) {
            $('#listId').val(id);
            $('#remarks').val('');
            $('#remarks').val($('#result-' + id).html());
            $('#exampleModal').modal('show');
        }

        $('#saveRemarks').click(function () {
            var id = $('#listId').val();
            var data = $('#remarks').val();
            $('#result-' + id).append(data);
            $('#exampleModal').modal('hide');
        })


        $(document).ready(function () {
            $('#tblData').DataTable();
        });

        function Edit(Id, trainingCategoryName, trainingCategoryNameBn, trainingCategoryShortName, shortOrder) {
            $("#TrainingCategoryId").val(Id);
            $("#trainingCategoryName").val(trainingCategoryName);
            $("#trainingCategoryNameBn").val(trainingCategoryNameBn);
            $("#trainingCategoryShortName").val(trainingCategoryShortName);
            $("#shortOrder").val(shortOrder);
        }

        function approve1(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to submit this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, submit it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/Assignment/AssignmentMasterPostUpdate/" + Id,
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Submitted Successfully!', 'success');
                        window.location.href = "/Employee/Assignment/AssignmentPostMaster";
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be submit. Please try again later !!!', 'error');
                    });
            });
        }

        function approve(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to submit this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, submit it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/Assignment/AssignmentMasterPostUpdate/" + Id,
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Submitted Successfully!', 'success');
                        window.location.href = "/Employee/Assignment/AssignmentPostMaster";
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be submit. Please try again later !!!', 'error');
                    });
            });
        }

        function detailInfoModalOpen(id) {
            $("#empDetails").load("/Employee/EmployeeInfo/GetEmployeeInfoPartialViewById?id=" + id);
            $('#empDetailsModal').modal('show')
        }

        function editModalOpen(id) {
            $('#postingEditModal').modal('show')
        }
    </script>
}
