            //var pageNumber = 1;
            $('#addAllSuggBtn').append(`<input type="button" class="btn btn-info btn-sm ml-1" onclick="LoadSuggestedNew(${empId},${rankId},'${refNo}')" value="Suggested Place"><input type="button" class="btn btn-danger btn-sm  ml-1" onclick="LoadForMoveTo(${empId},${rankId},'${refNo}')" value="Ignore Suggetion"><button type="button" class="btn btn-sm btn-info" id="VacantBtn" onclick="ShowHideEmployee()">Vacant Post</button>
