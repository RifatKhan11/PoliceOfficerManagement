        function LoadForMoveTo(empId, rankId, refNo) {
            $("#moveToDiv").load("/Employee/Assignment/GetMoveToNewList?refNum=" + refNo + "&empId=" + empId);
            $('#addAllSuggBtn').empty();
            $('#addAllSuggBtn').append(`<input type="button" class="btn btn-info btn-sm ml-1" onclick="LoadSuggestedNew(${empId},${rankId},'${refNo}')" value="Suggested Place"><input type="button" class="btn btn-danger btn-sm ml-1" onclick="LoadForMoveTo(${empId},${rankId},'${refNo}')" value="Ignore Suggetion">&nbsp;&nbsp;<input type="button" class="btn btn-sm btn-info" value="Vacant Post" id="VacantBtn" onclick="ShowHideEmployee()" />
                                    <input type="button" id="allBtn" class="btn btn-sm btn-success" value="All" style="display:none;" onclick="ShowAllEmployee()">`)
            $('#divLoader').show();
            $('#moveToDiv').hide();
            $('#moveToModal').modal('show');
            $('#movToEmpId').val(empId);
        }

        function moveToPostingPlace(id) {
            var moveLi = $('#moveLi-' + id);
            var empId = $('#movToEmpId').val();
            var empName = $('#DragableEle-' + empId).find('input[name="employeeName"]').val();
            var empRank = $('#DragableEle-' + empId).find('input[name="employeeRank"]').val();
            var empUnit = $('#DragableEle-' + empId).find('input[name="employeeUnit"]').val();
            var empCode = $('#DragableEle-' + empId).find('input[name="employeeCode"]').val();
            var empSection = $('#DragableEle-' + empId).find('input[name="employeeSection"]').val();
            var empColor = $('#DragableEle-' + empId).find('input[name="employeeColor"]').val();
            var newSection = moveLi.find('option:selected').text();
            var newPlace = $('#emp-' + id).find('option:selected').text();
            var sectionId = moveLi.find('option:selected').val();
            var unitName = $('#emp-' + id).find('input[name="newUnitName"]').val();
            var newUnitName = moveLi.find('input[name="newUnitName"]').val();
            var newSectionId = $('#emp-' + id).find('option:selected').val();
            if (newSection == '') {
                newSection = newPlace;
            }
            if (sectionId == undefined) {
                sectionId = newSectionId;
            }
            if (unitName == undefined) {
                unitName = newUnitName;
            }
            $('#DragableList-' + empId).remove();
            $('#previewEmpId').val(empId);
            var assign = `<li id=assLi${empId} class="col-12 row previewCls" style="background-color:${empColor};padding-left:4%;margin-left: 0;">
                            <div class="col-9" style="padding:0">${empName} </br> <i class="fa fa-mail-reply"></i> ${empRank},  ${empSection} - ${empUnit} </br> <i class="fa fa-mail-forward"></i> ${empRank}, <span id="empNewSec-${empId}">${newSection},${unitName}</span></div>
                            <input type="hidden" name="employeeId" value="${empId}"/>
                            <input type="hidden" name="sectionId" value="${sectionId}"/>
                            <div class="col-3">
                            <span style="color:red;float:right;background-color: white;" class="badge sugg" id="AlreadyGiven-${empId}" onclick="removePreview(${empId},'${empColor}','${empName}','${empRank}','${empSection}','${empUnit}','','')"><i class="fa fa-times"></i></span>
                            </div>
                            </li>`
            $('#assignedEmpList1').append(assign);
            $('#moveToModal').modal('hide');
        }

