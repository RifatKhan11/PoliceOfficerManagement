        function prevPage() {
            var num = $('#pageNumber').val();
            if (num > 1) {
                $('#pageNumber').val(num--);
            }
            var empId = $('#movToEmpId').val();
            var rankId = $('#rankIdForPrvNxt').val();
            var refNo = $('#refNoForPrvNxt').val();
            LoadSuggestedPrvNxt(empId, rankId, refNo);
        }

        function nextPage() {
            var num = $('#pageNumber').val();
            if (num > 0) {
                console.log(num++);
                $('#pageNumber').val(num++);
            }
            var empId = $('#movToEmpId').val();
            var rankId = $('#rankIdForPrvNxt').val();
            var refNo = $('#refNoForPrvNxt').val();
            LoadSuggestedPrvNxt(empId, rankId, refNo);
