</div>
@section Scripts{
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.10.3/jquery-ui.min.js"></script>
    <script type="text/javascript">
        function fnAssignedEmployee(id, name, empCode, rank, rankId, color, postingPlace) {
            $('#assignedEmpDiv').show()
            var data = '';
            var check = $(`#slEmpList-${id}`).val();
            if (check == id) {
                $(`#emp-${id}`).hide();
                return false;
            }
            else {
                $(`#emp-${id}`).hide();
                data = `<li class="dd-item" id="slEmp-${id}">
                                            <input type="hidden" name="empId" id="slEmpList-${id}" value="${id}"/>
                                            <input type="hidden" name="empCode" value="${empCode}"/>
                                            <input type="hidden" name="empRank" value="${rankId}"/>
                                            <div class="dd-handle row fontStyle" style="background-color:${color};height: 70px;border-radius: 10px;padding: 0;margin: 0;padding-top: 4px;color: black;font-weight: bold;"><span class="col-11">${name},${empCode},${rank},${postingPlace} </span><span class="col-1 badge float-right" style="background-color: white;color:red; height: 23px;width: 20px;" onclick="removeFromSelectedDiv(${id})"><i class="fa fa-times fa-1x"></i></span></div>
                                        </li>`;
                //var selectedEmpArr = JSON.parse(localStorage.getItem('EmpData') || '[]');
                //selectedEmpArr.push(id);
                //localStorage.setItem('EmpData', JSON.stringify(selectedEmpArr));
            }
            $('#assignedEmpList').append(data)
            var counter = $('#assignedEmpDiv li').length;
            $('#assignCounter').html(counter);
        }

        function ShowHideEmployee() {
            $('.ListOfEmpActive').hide();
            $('#VacantBtn').hide();
            $('#allBtn').show();
        }

        function ShowAllEmployee() {
            $('.ListOfEmpActive').show();
            $('#VacantBtn').show();
            $('#allBtn').hide();
        }

        $('.mmm').click(function () {
            $('#aaa').hide();
            $('#bbb').show();
        });

        $('.ccc').click(function () {
            $('#aaa').show();
            $('#bbb').hide();
        });

        function ajaxFunctionCheck(res) {
            var employeeId = $('#EmployeeIdHdn').val();
            if (res.length > 0) {
                var arr = [];
                var arrId = [];
                $.each(res, function (i, item) {
                    arr.push(item.reason);
                    arrId.push(item.SBUId);
                });
                if (arr.indexOf('Present Address') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Present Address', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).closest('li.dd-item').find('select').removeAttr('name');
                        $('#DragableEle-' + employeeId).closest('div').next().find('input.clsSectionId').removeAttr('name');
                        $('#DragableEle-' + employeeId).closest('div').find('input').removeAttr('id');
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                        var empId = $('#previewEmpId').val();
                        var check = $(`#slEmpList-${empId}`).val();
                        if (check == empId) {
                            $('#assLi' + empId).remove();
                        }
                    })
                }
                else if (arr.indexOf('Permanent Address') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Permanent Address', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).closest('li.dd-item').find('select').removeAttr('name');
                        $('#DragableEle-' + employeeId).closest('div').find('input.clsSectionId').val();
                        $('#DragableEle-' + employeeId).closest('div').find('input').removeAttr('id');
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                        var empId = $('#previewEmpId').val();
                        var check = $(`#slEmpList-${empId}`).val();
                        if (check == empId) {
                            $('#assLi' + empId).remove();
                        }
                    })
                }
                else if (arr.indexOf('Spouse Address') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Spouse Address', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).closest('li.dd-item').find('select').removeAttr('name');
                        $('#DragableEle-' + employeeId).closest('div').find('input.clsSectionId').removeAttr('name');
                        $('#DragableEle-' + employeeId).closest('div').find('input').removeAttr('id');
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                        var empId = $('#previewEmpId').val();
                        var check = $(`#slEmpList-${empId}`).val();
                        if (check == empId) {
                            $('#assLi' + empId).remove();
                        }
                    })
                }
                else if (arr.indexOf('Maternal Family Address') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Maternal Family Address', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).closest('li.dd-item').find('select').removeAttr('name');
                        $('#DragableEle-' + employeeId).closest('div').find('input.clsSectionId').removeAttr('name');
                        $('#DragableEle-' + employeeId).closest('div').find('input').removeAttr('id');
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                        var empId = $('#previewEmpId').val();
                        var check = $(`#slEmpList-${empId}`).val();
                        if (check == empId) {
                            $('#assLi' + empId).remove();
                        }
                    })
                }
                else if (arr.indexOf('Previous Work Place') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Previous Work Place', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).closest('li.dd-item').find('select').removeAttr('name');
                        $('#DragableEle-' + employeeId).closest('div').find('input.clsSectionId').removeAttr('name');
                        $('#DragableEle-' + employeeId).closest('div').find('input').removeAttr('id');
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                        var empId = $('#previewEmpId').val();
                        var check = $(`#slEmpList-${empId}`).val();
                        if (check == empId) {
                            $('#assLi' + empId).remove();
                        }
                    })
                }
                else {
                    //$('#DragableList-' + employeeId).remove();
                    //$('.wosue.DragableEle-' + employeeId).addClass('resizingCls');
                }
            }
            else {
                $('#DragableList-' + employeeId).remove();
                $('#DragableEle-' + employeeId).find('span').remove();
                var unit = $('#DragableEle-' + employeeId).closest('.dd-item').find('.unit').val();
                var check = $('#unitId-' + unit).find('div.wosue')
                //console.log(check)
                if (check != '') {
                    $('#unitId-' + unit).removeAttr('id');
                    $('#postPlaceId-' + unit).removeAttr('id');
                }
            }
        }

        function drop(event, branchId) {
            var employeeId = $('#EmployeeIdHdn').val();
            var check1 = $(this).find("div").length;
            var check = event.target.innerText;
            if (check != "") {
                //$('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
            }
            else {
                Common.Ajax('GET', '/Employee/Assignment/CheckDistrict?branchId=' + branchId + '&employeeid=' + employeeId, [], 'json', ajaxFunctionCheck, true);
            }
        }

        $(document).ready(function () {
            
            $("#txtSearchEmployee").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchEmployeeFreeze").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpListFreeze ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#btnSearchEmployee").on("click", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchPP").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olPPListSuggested ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchPPPlace").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olPPListPlace ol li").not(".notsearch").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#moveModalSearchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#moveModalSearch ol li").not(".notsearch").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchPPPlaceByName").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olPPListPlace ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
        

        $('#postingForm').submit(function (e) {
            e.preventDefault();
            var form = $('#postingForm')
            $.ajax({
                url: '/Employee/Assignment/SaveAddedPostingData',
                data: form.serialize(),
                type: 'POST',
                success: function (records) {
                    //alert(records.status);
                    $('#AssignmentId').val(records.assignMasterId);
                    if (records.refNumber == 'FrezzListEmpty') {
                        if (records.status == 4) {
                            window.location.href = '/Employee/Assignment/AssignmentReturnDetails?id=' + records.assignMasterId;
                        } else if (records.status == 1) {
                            window.location.href = '/Employee/Assignment/AssignmentMasterDetailsForNext?id=' + records.assignMasterId;
                        }
                        else {
