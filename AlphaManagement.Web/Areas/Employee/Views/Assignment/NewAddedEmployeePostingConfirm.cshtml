@model AssignmentViewModel
@{
    ViewData["Title"] = "Employee Posting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .nestable-color-2 .dd-handle {
        background-color: #0069D1;
        color: #fff;
    }

    .nestable-color-2 .dd-handle1 {
        background-color: red !important;
    }


    .wosue .dd-handle {
        width: auto !important;
        height: 35px !important;
        position: relative !important;
    }

    .previewCls {
        color: black;
        font-weight: bolder;
        border-radius: 7px;
        padding: 8px;
        margin-top: 5px;
    }
</style>

<div class="row">
    <div class="col-md-6 col-12">
        <div class="row">
            <div class="col-lg-12 col-12">
                <div class="card bg-white m-b-30">
                    <div class="card bg-white m-b-30">
                        <input type="hidden" value="" id="EmployeeIdHdn" />
                        <input type="hidden" value="" id="DraggedHdn" />
                        <input type="hidden" value="" id="DraggedHdnWithLi" />
                        <div style="display:none">
                            <input type="hidden" value="" id="movToEmpId" />
                            <input type="hidden" value="" id="previewEmpId" />
                        </div>
                        <div class="card-body new-user">
                            <div class="row">
                                <div class="col-lg-6 col-12">
                                    <h5 class="header-title mb-2">Employee List for posting</h5>
                                </div>
                                <div class="col-lg-4 col-12">
                                    <div class="search-content">
                                        <input type="text" id="txtSearchEmployee" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search...">
                                        <span class="search-button" style="cursor:pointer;" id="btnSearchEmployee"><i class="ti ti-search"></i></span>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-12">
                                    <a class="btn btn-success" target="_blank" href="/Employee/Report/PostingConfrimPdf?refNum=@Model.refNumber"><i class="fa  fa-print"></i></a>                                    
                                </div>
                                @*<div class="col-lg-3 col-md-3 col-sm-4"></div>*@
                            </div>
                            <div id="olEmpHolder" style="position: static;overflow: hidden;">
                                <div class="dd nestable_list_2 nestable-color-2" id="olEmpList" style="height:540px;overflow-y:scroll">
                                    <ol class="dd-list" id="enlistLiApp">
                                        @{
                                            int i = 0;
                                            @foreach (var data in Model.enlistedAssignments)
                                            {
                                                string colorCode = "";
                                                if (Convert.ToDateTime(data.employee?.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-2))
                                                {
                                                    colorCode = "#f17878";
                                                }
                                                else if (Convert.ToDateTime(data.employee?.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-1) && Convert.ToDateTime(data.employee?.joiningDatePresentWorkstation).Date > DateTime.Now.AddYears(-2))
                                                {
                                                    colorCode = "yellow";
                                                }
                                                else
                                                {
                                                    colorCode = "#00BCD2";
                                                }
                                                <li class="dd-item enrollst" id="DragableList-@data.employeeId" data-id="@data.Id">
                                                    <div class="dd-handle ui-state-default" id="DragableEle-@data.employeeId" style="background-color: @colorCode;color:black;font-weight:bolder;border-radius:7px">
                                                        <input type="hidden" name="employeeId" id="txtEmpId-@data.Id" value="@data.employeeId" />
                                                        <input type="hidden" name="employeeCode" value="@data.employee?.employeeCode" />
                                                        <input type="hidden" name="employeeName" value="@data.employee?.nameEnglish" />
                                                        <input type="hidden" name="employeeRank" value="@data.employee?.rank?.rankName" />
                                                        <input type="hidden" name="employeeUnit" value="@data.employee?.branch?.branchUnitName" />
                                                        <input type="hidden" name="employeeSection" value="@data.employee?.section?.Name" />
                                                        <input type="hidden" name="employeeColor" value="@colorCode" />
                                                        <input type="hidden" name="employeeRankId" value="@data.employee.rankId" />
                                                        <input type="hidden" name="refNo" value="@data.enlistedAssignmentMaster?.refNo" />
                                                        @data.employee?.nameEnglish - @data.employee?.bCSBatch?.batchName, @data.employee?.rank?.rankName (@data.employee?.section?.Name)
                                                        @{
                                                            int?[] doctor = { 69 };
                                                            int?[] eng = { 59 };
                                                            int?[] llb = { 79 };

                                                            int? doctorInfo = Model.educations.Where(x => doctor.Contains(x.degreeId) && x.employeeId == data.employeeId).Count();
                                                            int? engInfo = Model.educations.Where(x => eng.Contains(x.degreeId) && x.employeeId == data.employeeId).Count();
                                                            int? llbInfo = Model.educations.Where(x => llb.Contains(x.degreeId) && x.employeeId == data.employeeId).Count();

                                                            @if (doctorInfo > 0)
                                                            {
                                                                <img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />
                                                                <input type="hidden" name="employeeBatch" value="doctor.png" />
                                                            }
                                                            else if (engInfo > 0)
                                                            {
                                                                <img src="~/batch/engineer.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />
                                                                <input type="hidden" name="employeeBatch" value="engineer.png" />
                                                            }

                                                            else if (llbInfo > 0)
                                                            {
                                                                <img src="~/batch/advocate.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />
                                                                <input type="hidden" name="employeeBatch" value="advocate.png" />
                                                            }
                                                            else
                                                            {
                                                                @*<img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:50px; height:50px" />*@
                                                            }
                                                        }
                                                        <span onclick="LoadSuggestedNew(@data.employeeId,@data.employee.rankId,'@data.enlistedAssignmentMaster?.refNo','@data.employee.nameEnglish')" class="badge move pull-right  ml-2" style="height:100%!important;background-color:#040825;cursor:pointer">
                                                            <i class="ti-more" title="Move"></i>
                                                        </span>


                                                    </div>
                                                </li>

                                            }
                                        }
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-12">
        <div class="row">
            <div class="col-lg-12 col-sm-12">
                <div class="card">
                    <div class="card-header text-center"><h3>New Assigned Officers' List</h3></div>
                    <div class="card-body">
                        <div class="dd nestable_list_2 nestable-color-2">
                            <form id="postingForm">
                                <div class="col-12" style="padding:0">
                                    <ul class="dd-list" id="assignedEmpList1" style="height:620px;overflow-y:scroll"></ul>
                                </div>
                                <div class="col-12 row">
                                    <div style="display:none">
                                        <input type="hidden" name="referenceNum" id="refNumId" value="@Model?.refNumber" />
                                        <input type="hidden" name="AssignmentId" id="AssignmentId" value="@Model?.assignMasterId" />
                                        <input type="hidden" name="enlistedId" id="enlistedId" value="@Model?.enlistedId" />
                                        <input type="submit" class="col-12 btn btn-danger" style="font-weight: bolder;" id="submitPosting" />
                                    </div>
                                    <input type="button" class="col-9 ml-3 btn btn-sm btn-success" style="font-weight: bolder;" id="postingBtnClick" value="Next" />
                                    <a class="col-1 btn btn-success ml-2" href="#" onclick="UnDo()" title="Undo"><i class="mdi mdi-undo-variant"></i></a>
                                    <a class="col-1 btn btn-danger ml-2" href="#" onclick="ReDo()" title="Redo"><i class="mdi mdi-redo-variant"></i></a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1250px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"> Suggested Posting Place </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="dd mt-2 nestable_list_2 nestable-color-2 collapse show" id="olPPListSuggested" style="max-height:600px; overflow-y:scroll">

                    <div class=" new-user" id="olPPListForSuggestedUnitList">

                    </div>
                    <div class="col-12 row" style="display:none" id="divLoader1">
                        <div class="col-3"></div>
                        <div class="col-6">
                            <img src="~/images/Circles-loader.gif" height="400" width="400" />
                        </div>
                        <div class="col-3"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg" id="empDetailsModal" role="dialog" aria-labelledby="empDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1300px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Details Info</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="col-12 row" id="empDetails" style="overflow: scroll; height: 800px;margin:0">
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="moveToModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1700px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="col-4 modal-title" id="exampleModalLabel"> Suggested Place for <span id="NameOfPostedEmp"></span> </h5>
                <input type="text" id="moveModalSearchInput" class="col-2 form-control" autocomplete="off" name="keyword" placeholder="Search by Unit . . .">&nbsp;
                <input type="text" id="moveModalSearchInputName" class="col-2 form-control" autocomplete="off" name="keyword" placeholder="Search by Name . . .">
                <input type="hidden" id="pageNumber" value="1" />
                <input type="hidden" id="rankIdForPrvNxt" />
                <input type="hidden" id="refNoForPrvNxt" />
                <div class="col-3 text-center" row" id="addAllSuggBtn">

                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-8">
                        <div class="dd mt-2 nestable_list_2 nestable-color-2 collapse show" style="max-height:700px; overflow-y:scroll">

                            <div class=" new-user" id="moveToDiv">

                            </div>

                            <div class="col-12 row" style="display:none" id="divLoader">
                                <div class="col-3"></div>
                                <div class="col-6">
                                    <img src="~/images/Circles-loader.gif" height="400" width="400" />
                                </div>
                                <div class="col-3"></div>
                            </div>

                        </div>
                    </div>
                    <div class="col-sm-4">
                        <h4 class="text-center">Basic Information </h4>
                        <center>
                            <img class="text-center" src="" id="EmpImage" width="150" height="150" alt="Image" />
                        </center>
                        <table class="table">
                            <tr>
                                <td>Name</td>
                                <td id="BasicName"></td>
                            </tr>
                            <tr>
                                <td>BP No</td>
                                <td id="BasicBp"></td>
                            </tr>
                            <tr>
                                <td>Rank</td>
                                <td id="BasicRank"></td>
                            </tr>
                            <tr>
                                <td>Home District</td>
                                <td id="BasicHD"></td>
                            </tr>
                            <tr>
                                <td>Spouse Home District</td>
                                <td id="BasicSHD"></td>
                            </tr>
                            <tr>
                                <td>Curent Posting Unit</td>
                                <td id="BasicRPU"></td>
                            </tr>
                            <tr>
                                <td>Privious Posting Unit</td>
                                <td id="BasicPPU"></td>
                            </tr>
                            <tr>
                                <td>Educational Qualification</td>
                                <td id="BasicEQ"></td>
                            </tr>
