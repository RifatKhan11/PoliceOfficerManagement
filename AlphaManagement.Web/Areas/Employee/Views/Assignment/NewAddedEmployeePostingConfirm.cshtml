            $('#divLoader').show();
            $('#moveToDiv').hide();
            $("#moveToDiv").load("/Employee/Assignment/GetNewSuggetionList2?id=" + empId + "&rankId=" + rankId + "&pageNumber=" + pageNumber + "&pageSize=10&refNum=" + refNo);
            pageNumber = pageNumber + 1;
            $('#VacantBtn').hide();
            $('#allBtn').hide();
            $('#moveToModal').modal('show');
        }

