@model AssignmentViewModel
@{
    ViewData["Title"] = "Employee Posting";
    //Layout = "~/Views/Shared/_LayoutPosting.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .nestable-color-2 .dd-handle {
        background-color: #0069D1;
        color: #fff;
    }

    .nestable-color-2 .dd-handle1 {
        background-color: red !important;
    }

    .wosue .dd-handle {
        width: auto !important;
        height: 35px !important;
        position: relative !important;
    }
</style>

<div class="row">
    <div class="col-md-6 col-12">
        <div class="row">
            <div class="col-lg-12 col-12">
                <div class="card bg-white m-b-30">

                    <div class="card-body new-user">
                        <div class="row">
                            <input type="hidden" value="" id="EmployeeIdHdn" />
                            <input type="hidden" value="" id="DraggedHdn" />
                            <input type="hidden" value="" id="DraggedHdnWithLi" />
                            <div class="col-lg-6 col-12">
                                <h5 class="header-title mb-4">Employee List for posting</h5>
                            </div>
                            <div class="col-lg-6 col-12">
                                <div class="search-content">
                                    <input type="text" id="txtSearchEmployee" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search...">
                                    <span class="search-button" style="cursor:pointer;" id="btnSearchEmployee"><i class="ti ti-search"></i></span>
                                </div>
                            </div>
                            @*<div class="col-lg-3 col-md-3 col-sm-4"></div>*@
                        </div>
                        <div class="dd nestable_list_2 nestable-color-2" id="olEmpList">
                            <ol class="dd-list">
                                @{string colorCode = ""; }
                                @if (Convert.ToDateTime(Model.assignment.employee?.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-2))
                                {
                                    colorCode = "#f17878";
                                }
                                else if (Convert.ToDateTime(Model.assignment.employee?.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-1) && Convert.ToDateTime(Model.assignment.employee?.joiningDatePresentWorkstation).Date > DateTime.Now.AddYears(-2))
                                {
                                    colorCode = "yellow";
                                }
                                else
                                {
                                    colorCode = "#00BCD2";
                                }
                                <li class="dd-item enrollst" id="DragableList-@Model.assignment.employeeId" data-id="@Model.assignment.Id">
                                    <div class="dd-handle ui-state-default" id="DragableEle-@Model.assignment.employeeId" style="background-color: @colorCode;color:black;font-weight:bolder;border-radius:7px">
                                        <input type="hidden" name="employeeId" id="txtEmpId-@Model.assignment?.Id" value="@Model.assignment?.employeeId" />   @Model.assignment?.employee?.nameEnglish - @Model.assignment?.employee?.bCSBatch?.batchName, @Model.assignment?.employee?.rank?.rankName (@Model.assignment?.employee?.section?.Name)
                                        @{
                                            int?[] doctor = { 69 };
                                            int?[] eng = { 59 };
                                            int?[] llb = { 79 };

                                            int? doctorInfo = Model.educations.Where(x => doctor.Contains(x.degreeId) && x.employeeId == Model.assignment.employeeId).Count();
                                            int? engInfo = Model.educations.Where(x => eng.Contains(x.degreeId) && x.employeeId == Model.assignment.employeeId).Count();
                                            int? llbInfo = Model.educations.Where(x => llb.Contains(x.degreeId) && x.employeeId == Model.assignment.employeeId).Count();

                                            @if (doctorInfo > 0)
                                            {
                                                <img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                            }
                                            else if (engInfo > 0)
                                            {
                                                <img src="~/batch/engineer.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                            }

                                            else if (llbInfo > 0)
                                            {
                                                <img src="~/batch/advocate.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                            }
                                            else
                                            {
                                                @*<img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:50px; height:50px" />*@
                                            }
                                        }

                                    </div>
                                </li>

                            </ol>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-12 col-12">
                <form id="frezzEmployee">
                    <div class="card bg-white m-b-30">

                        <div class="card-body new-user">
                            <div class="row">
                                <div class="col-lg-6 col-12">
                                    <h5 class="header-title mb-4">Freeze Employee List</h5>
                                </div>
                                <div class="col-lg-6 col-12">
                                    <div class="search-content">
                                        <input type="text" id="txtSearchEmployeeFreeze" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search...">
                                        <span class="search-button" style="cursor:pointer;" id="btnSearchEmployee"><i class="ti ti-search"></i></span>
                                    </div>
                                </div>

                            </div>
                            <div>
                                <input type="hidden" name="referenceNum" value="@Model.enlistedAssignments?.FirstOrDefault()?.enlistedAssignmentMaster?.refNo" />
                            </div>
                            <div class="dd nestable_list_1 nestable-color-1 clsFreez" id="olEmpListFreeze" style="max-height:400px;min-height:400px;width:100%;overflow-y:scroll">

                            </div>

                        </div>
                    </div>
                    <div class="col-12 row">
                        <div style="display:none">
                            <input type="submit" class="col-12 btn btn-danger" style="font-weight: bolder;" id="frezzPosting" />
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-12">
        <div class="row">
            <div class="col-lg-12 col-sm-12">
                <div class="card bg-white m-b-30">
                    <div class="card-body new-user">
                        <div class="row">
                            <div class="col-lg-4  col-12">
                                <h6 class="header-title mb-4">Suggested Posting Place</h6>
                            </div>
                            <div class="col-lg-6 col-12">
                                <div class="search-content">
                                    <input type="text" id="txtSearchPP" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search...">
                                    <span class="search-button" style="cursor:pointer;" id="btnSearchPP"><i class="ti ti-search"></i></span>
                                </div>
                            </div>
                            <div class="col-lg-2 col-12">
                                <a style="text-decoration:none; border-bottom:0!important;color:#fff!important" data-toggle="collapse" href="#olPPListSuggested" aria-expanded="true" aria-controls="olPPListSuggested" id="aaa" class="text-muted btn btn-sm btn-secondary text-light mmm">
                                    Ignore
                                </a>
                                <a style="text-decoration:none; border-bottom:0!important;color:#fff!important; display:none" data-toggle="collapse" href="#olPPListSuggested" aria-expanded="true" aria-controls="olPPListSuggested" id="bbb" class="text-muted btn btn-sm btn-secondary text-light ccc">
                                    Show
                                </a>
                            </div>
                        </div>

                        <div class="dd mt-2 nestable_list_2 nestable-color-2 collapse show" id="olPPListSuggested" style="max-height:400px; overflow-y:scroll">

                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-12 col-sm-12">
                <form id="postingForm">
                    <div class="card bg-white m-b-30">
                        <div class="card-body new-user">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-4 pr-0 mr-0">
                                    <h5 class="header-title mb-4">Posting Place</h5>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4 pl-0 pr-0 ml-0 mr-0">
                                    <div class="search-content">
                                        <input type="text" id="txtSearchPPPlace" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search by Unit . . .">
                                        <span class="search-button" style="cursor:pointer;" id="btnSearchPP"><i class="ti ti-search"></i></span>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4 pl-0 pr-0 ml-0 mr-0">
                                    <div class="search-content">
                                        <input type="text" id="txtSearchPPPlaceByName" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search by Name . . .">
                                        <span class="search-button" style="cursor:pointer;" id="btnSearchByName"><i class="ti ti-search"></i></span>
                                    </div>
                                </div>
                                <div class="col-lg-1 col-md-1 col-sm- pl-0 pr-0 ml-0 mr-04">
                                    <button type="button" class="btn btn-sm btn-info" id="VacantBtn" onclick="ShowHideEmployee()">Vacant</button>
                                    <button type="button" id="allBtn" class="btn btn-sm btn-success" style="display:none;" onclick="ShowAllEmployee()">All</button>
                                </div>
                            </div>
                            <div id="olPPListHolder" style="position: static;height: 400px;overflow: hidden;">
                                <div class="dd nestable_list_2 nestable-color-2" id="olPPListPlace" style="height:400px;overflow-y:scroll;">
                                    <ol class="dd-list">

                                        @{

                                            foreach (var data in Model.branchUnitWiseEmployees.Where(x => x.isParent == 1))
                                            {
                                                var totalemployees = data.unitEmployees.Count() + Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id).Sum(x => x.subUnitEmployees.Count());
                                                var totalPost = data.unitTotalPost + Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id).Sum(x => x.subUnitTotalPost);
                                                var totalBlankPost = data.unitTotalPost + Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id).Sum(x => x.subUnitTotalBlankPost);
                                                var blankPost = totalPost - totalemployees;
                                                var assign = Model.assignments;
                                                <li class="dd-item" data-id="@data.Id">

                                                    <div style="font-size:16px!important;padding:10px 25px 30px 20px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.parentSpecialBranchUnit.branchUnitName<input type="hidden" class="subUnit" value="@data?.parentSpecialBranchUnit?.Id" />  <span class="m-2" title="Total Post"><i class="fa fa-users text-danger"></i> - @totalPost</span><span class="m-2" title="Total Officers"><i class="fa fa-user text-info"></i> - @totalemployees</span> <span class="m-2"><i class="fa fa-user-o" title="Blank Post"></i> -@blankPost </span></div>
                                                    @if (Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id).Count() > 0)
                                                    {
                                                        <ol class="dd-list">
                                                            @foreach (var subu in Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id))
                                                            {
                                                                var subBlankCount = subu?.subUnitTotalPost - subu?.subUnitEmployees.Count();
                                                                var subEmpCount = subu?.subUnitEmployees.Count() - subu?.subUnitTotalPost;
                                                                @if (subu?.subUnitEmployees.Count() == 0)
                                                                {
                                                                    <li class="dd-item" data-id="@subu?.Id">
                                                                        <div class="dd-handle" style="background-color: #040825;">@subu?.specialBranchUnit.branchUnitName<input type="hidden" class="subUnit" value="@subu?.specialBranchUnit?.specialBranchUnitId" /><input type="hidden" class="subbranchId" value="@subu?.specialBranchUnit.Id" /><span class="m-1" title="Total Post"><i class="fa fa-users"></i> - @subu?.subUnitTotalPost</span><span class="m-1" title="Total Officers"><i class="fa fa-user"></i> - @subu?.subUnitEmployees.Count()</span> <span class="m-1"><i class="fa fa-user-o" title="Blank Post"></i> - @subBlankCount </span></div>
                                                                        <ol class="dd-list">
                                                                            @for (int j = 0; j < subBlankCount; j++)
                                                                            {
                                                                                <li class="dd-item form-inline notsearch">
                                                                                    <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">@Model.assignment.employee?.rank?.rankName <input type="hidden" name="rankId" value="@Model.assignment.employee?.rankId" /></div>
                                                                                    <div class="wosue" id="divwosue3" ondrop="drop(event,@subu?.specialBranchUnit?.specialBranchUnitId)" style="width:55%;height:45px;"></div>
                                                                                    <div class="dd-nodrag col">
                                                                                        <select class="form-control" name="sectionId" style="width:107%;float:right;">
                                                                                            <option value="">Select</option>
                                                                                            @foreach (var item in Model.sections.Where(x => x.specialBranchUnitId == subu?.specialBranchUnit?.Id))
                                                                                            {
                                                                                                <option value="@item.Id">@item.Name</option>
                                                                                            }
                                                                                        </select>
                                                                                    </div>
                                                                                </li>
                                                                            }
                                                                        </ol>
                                                                    </li>
                                                                }
                                                                else
                                                                {
                                                                    List<int> sectionId = new List<int>();
                                                                    <li class="dd-item" data-id="@subu?.Id">
                                                                        <div class="dd-handle" style="background-color: #040825;">@subu?.specialBranchUnit.branchUnitName <input type="hidden" class="subUnit" value="@subu?.specialBranchUnit?.specialBranchUnitId" /> <span class="m-2" title="Total Post"><i class="fa fa-users"></i> - @subu?.subUnitTotalPost</span><span class="m-1" title="Total Officers"><i class="fa fa-user"></i> - @subu?.subUnitEmployees.Count()</span> <span class="m-1"><i class="fa fa-user-o" title="Blank Post"></i> - @subBlankCount </span></div>
                                                                        <ol class="dd-list">
                                                                            @foreach (var sitem in subu?.subUnitEmployees)
                                                                            {
                                                                                string colorCode1 = "";
                                                                                if (Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-2))
                                                                                {
                                                                                    colorCode1 = "#f17878";
                                                                                }
                                                                                else if (Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-1) && Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date > DateTime.Now.AddYears(-2))
                                                                                {
                                                                                    colorCode1 = "yellow";
                                                                                }
                                                                                else
                                                                                {
                                                                                    colorCode1 = "#00BCD2";
                                                                                }
                                                                                sectionId.Add((int)(sitem.sectionId == null ? 0 : sitem.sectionId));

                                                                                <li class="dd-item form-inline ListOfEmpActive notsearch" data-id="@sitem.Id">
                                                                                    <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">@sitem.rank?.rankName<input type="hidden" name="rankId" value="@sitem.rankId" /></div>
                                                                                    <div class="wosue" ondrop="drop(event,@subu?.subUnitId)" style="width:55%;height:45px;">
                                                                                        <div class="dd-handle ui-state-default" id="evnt-@sitem.Id" style="background-color: @colorCode1;color:black;font-weight:bolder;border-radius:7px;">
                                                                                            <input type="hidden" class="clsEmpId" name="frezzEmployeeId" id="txtEmpId-@sitem.Id" value="@sitem.Id" />@sitem.nameEnglish - @sitem.bCSBatch?.batchName, @sitem.rank?.rankName (@sitem?.section?.Name)
                                                                                            @{
                                                                                                int?[] doctor1 = { 69 };
                                                                                                int?[] eng1 = { 59 };
                                                                                                int?[] llb1 = { 79 };

                                                                                                int? doctorInfo1 = Model.educations.Where(x => doctor1.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                                                                int? engInfo1 = Model.educations.Where(x => eng1.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                                                                int? llbInfo1 = Model.educations.Where(x => llb1.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();

                                                                                                @if (doctorInfo1 > 0)
                                                                                                {
                                                                                                    <img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                                                                }
                                                                                                else if (engInfo1 > 0)
                                                                                                {
                                                                                                    <img src="~/batch/engineer.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                                                                }

                                                                                                else if (llbInfo1 > 0)
                                                                                                {
                                                                                                    <img src="~/batch/advocate.jpg" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    @*<img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:50px; height:50px" />*@
                                                                                                }
                                                                                            }
                                                                                        </div>
                                                                                        <input type="hidden" class="clsSectionId" value="@sitem?.sectionId" />
                                                                                    </div>
                                                                                    <div class="col">
                                                                                        @if (assign.Where(x => x.employeeId == sitem.Id).FirstOrDefault() != null)
                                                                                        {
                                                                                            <div class="dd-nodrag form-control" style="float:right;width:107%;">@assign.Where(x => x.employeeId == sitem.Id).FirstOrDefault()?.section?.Name </div>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <div class="dd-nodrag form-control" style="float:right;width:107%;">@sitem?.section?.Name </div>
                                                                                        }
                                                                                    </div>

                                                                                </li>

                                                                            }
                                                                            @for (int j = 0; j < subBlankCount; j++)
                                                                            {
                                                                                <li class="dd-item form-inline notsearch">
                                                                                    <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">@Model?.assignment?.employee?.rank?.rankName <input type="hidden" name="rankId" value="@Model?.assignment?.employee?.rankId" /></div>
                                                                                    <div class="wosue" ondrop="drop(event,@subu?.subUnitId)" id="divwosue3" style="width:55%;height:45px;"><span style="display: none;">subu?.subUnitEmployees.FirstOrDefault().sectionId</span></div>
                                                                                    <div class="dd-nodrag col">
                                                                                        <select class="form-control" name="sectionId" style="width:107%;float:right;">
                                                                                            <option value="">Select</option>
                                                                                            @foreach (var item in Model.sections.Where(x => x.specialBranchUnitId == subu?.specialBranchUnit?.Id).Where(x => !sectionId.Contains(x.Id)))
                                                                                            {
                                                                                                <option value="@item.Id">@item.Name</option>
                                                                                            }
                                                                                        </select>
                                                                                    </div>
                                                                                </li>
                                                                            }
                                                                        </ol>
                                                                    </li>
                                                                }
                                                            }
                                                        </ol>
                                                    }
                                                    else
                                                    {
                                                        if (data?.unitEmployees.Count() > 0)
                                                        {
                                                            <ol class="dd-list" id="olEmpList">
                                                                @foreach (var sitem in data?.unitEmployees)
                                                                {
                                                                    string colorCode2 = "";
                                                                    if (Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-2))
                                                                    {
                                                                        colorCode2 = "#f17878";
                                                                    }
                                                                    else if (Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-1) && Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date > DateTime.Now.AddYears(-2))
                                                                    {
                                                                        colorCode2 = "yellow";
                                                                    }
                                                                    else
                                                                    {
                                                                        colorCode2 = "#00BCD2";
                                                                    }
                                                                    <li class="dd-item form-inline clswosue ListOfEmpActive" data-id="@sitem.Id">
                                                                        <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">@sitem.rank?.rankName <input type="hidden" name="rankId" value="@sitem.rankId" /></div>
                                                                        <div class="wosue" id="divwosue2" ondrop="drop(event,@data?.Id)" style="width:55%;height:45px">
                                                                            <div class="dd-handle ui-state-default" id="evnt-@sitem.Id" style="color:black;font-weight:bolder;border-radius:7px;background-color:@colorCode2;">
                                                                                <input type="hidden" class="clsEmpId" name="frezzEmployeeId" id="txtEmpId-@sitem.Id" value="@sitem.Id" />@sitem.nameEnglish - @sitem.bCSBatch?.batchName, @sitem.rank?.rankName (@sitem?.section?.Name)
                                                                                @{
                                                                                    int?[] doctor2 = { 69 };
                                                                                    int?[] eng2 = { 59 };
                                                                                    int?[] llb2 = { 79 };

                                                                                    int? doctorInfo2 = Model.educations.Where(x => doctor2.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                                                    int? engInfo2 = Model.educations.Where(x => eng2.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                                                    int? llbInfo2 = Model.educations.Where(x => llb2.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();

                                                                                    @if (doctorInfo2 > 0)
                                                                                    {
                                                                                        <img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                                                    }
                                                                                    else if (engInfo2 > 0)
                                                                                    {
                                                                                        <img src="~/batch/engineer.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                                                    }

                                                                                    else if (llbInfo2 > 0)
                                                                                    {
                                                                                        <img src="~/batch/advocate.jpg" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        @*<img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:50px; height:50px" />*@
                                                                                    }
                                                                                }
                                                                            </div>
                                                                            <input type="hidden" class="clsSectionId" value="@sitem?.sectionId" />
                                                                        </div>
                                                                        <div class="dd-nodrag col">
                                                                            @if (assign.Where(x => x.employeeId == sitem.Id).FirstOrDefault() != null)
                                                                            {
                                                                                <div class="dd-nodrag form-control" style="float:right;width:107%;">@assign.Where(x => x.employeeId == sitem.Id).FirstOrDefault()?.section?.Name </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="dd-nodrag form-control" style="float:right;width:107%;">@sitem?.section?.Name</div>
                                                                            }
                                                                        </div>

                                                                    </li>
                                                                }
                                                                @for (int mm = 0; mm < blankPost; mm++)
                                                                {
                                                                    <li class="dd-item form-inline notsearch">
                                                                        <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">@Model.assignment.employee?.rank?.rankName <input type="hidden" class="rank" name="rankId" value="@Model.assignment.employee?.rankId" /></div>
                                                                        <div class="wosue" id="divwosue1" ondrop="drop(event,@data.Id)" style="width:55%;height:45px"><span style="display: none;">@Model.branchUnitWiseEmployees.Where(x => x.isParent == 1).FirstOrDefault()?.unitEmployees.FirstOrDefault()?.sectionId</span></div>
                                                                        <div class="dd-nodrag col">
                                                                            <select class="form-control" name="sectionId" style="width:107%;float:right;">
                                                                                <option value="">Select</option>
                                                                                @foreach (var item in Model.sections.Where(x => x.specialBranchUnitId == data.Id))
                                                                                {
                                                                                    <option value="@item.Id">@item.Name</option>
                                                                                }
                                                                            </select>
                                                                        </div>

                                                                    </li>
                                                                }
                                                            </ol>
                                                        }
                                                        else
                                                        {
                                                            <ol class="dd-list" id="olEmpList">
                                                                @for (int mm = 0; mm < blankPost; mm++)
                                                                {
                                                                    <li class="dd-item form-inline">
                                                                        <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">@Model?.enlistedAssignments?.FirstOrDefault().employee?.rank?.rankName <input type="hidden" class="rank" name="rankId" value="@Model?.enlistedAssignments?.FirstOrDefault().employee?.rankId" /></div>
                                                                        <div class="wosue" ondrop="drop(event,@data.Id)" id="divwosue1" style="width:55%;height:45px"></div>
                                                                        <div class="dd-nodrag col">
                                                                            <select class="form-control" name="sectionId" style="width:107%;float:right;">
                                                                                <option value="">Select</option>
                                                                                @foreach (var item in Model.sections.Where(x => x.specialBranchUnitId == data.Id))
                                                                                {
                                                                                    <option value="@item.Id">@item.Name</option>
                                                                                }
                                                                            </select>
                                                                        </div>

                                                                    </li>
                                                                }
                                                            </ol>
                                                        }
                                                    }
                                                </li>

                                            }
                                        }
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 row">
                        <div style="display:none">
                            <input type="hidden" name="referenceNum" id="refNumId" value="@Model?.refNumber" />
                            <input type="hidden" name="AssignmentId" id="AssignmentId" value="@Model?.enlistedId" />
                            <input type="hidden" name="enlistedId" id="enlistedId" value="@Model?.enlistedId" />
                            <input type="submit" class="col-12 btn btn-danger" style="font-weight: bolder;" id="submitPosting" />
                        </div>
                        <input type="button" class="col-12 btn btn-danger" style="font-weight: bolder;" id="postingBtnClick" value="Save" />
                    </div>

                </form>
            </div>


        </div>
    </div>
</div>


@section Scripts{
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.10.3/jquery-ui.min.js"></script>
    <script type="text/javascript">

        $('.mmm').click(function () {
            $('#aaa').hide();
            $('#bbb').show();
        });

        $('.ccc').click(function () {
            $('#aaa').show();
            $('#bbb').hide();
        });

        function ajaxFunctionCheck(res) {
            var employeeId = $('#EmployeeIdHdn').val();
            if (res.length > 0) {
                var arr = [];
                var arrId = [];
                $.each(res, function (i, item) {
                    arr.push(item.reason);
                    arrId.push(item.SBUId);
                });
                if (arr.indexOf('Present Address') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Present Address', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                    })
                }
                else if (arr.indexOf('Permanent Address') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Permanent Address', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                    })
                }
                else if (arr.indexOf('Spouse Address') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Spouse Address', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                    })
                }
                else if (arr.indexOf('Maternal Family Address') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Maternal Family Address', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                    })
                }
                else if (arr.indexOf('Previous Work Place') >= 0) {
                    swal('warning', 'Cannot Assign. Matched With Previous Work Place', 'warning').then((result) => {
                        $('#DragableList-' + employeeId).empty();
                        $('#DragableEle-' + employeeId).remove();
                        $('#DragableList-' + employeeId).append($('#DraggedHdn').val());
                        $('#DragableEle-' + employeeId).show();
                        $('#DragableList-' + employeeId + ' .ui-sortable-placeholder').remove();
                    })
                }
                else {
                    //$('#DragableList-' + employeeId).remove();
                    //$('.wosue.DragableEle-' + employeeId).addClass('resizingCls');
                }
            }
            else {
                $('#DragableList-' + employeeId).remove();
            }

        }

        function drop(event, branchId) {
            var employeeId = $('#EmployeeIdHdn').val();
            Common.Ajax('GET', '/Employee/Assignment/CheckDistrict?sectionid=0&branchId=' + branchId + '&employeeid=' + employeeId, [], 'json', ajaxFunctionCheck, true);
        }

        $(document).ready(function () {
            $(".wosue").sortable({
                connectWith: '.clsFreez',
                appendTo: 'body',
                tolerance: 'pointer',
                revert: 'invalid',
                forceHelperSize: true,
                helper: function (event, element) {
                    return element.clone().appendTo("body")
                },
                scroll: false,
                start: function (e, ui) {
                    window.grabbed = true;
                    ui.item.startPos = ui.item.prevAll().length + 1;
                    var div = ui.item.get(0);
                    document.body.appendChild(div);
                },
                stop: function () {
                    console.log("Lets do it again!");
                    window.grabbed = false;
                }
            }).sortable("option", "scroll", false);

            $(".enrollst").sortable({
                connectWith: [".wosue", ".clsFreez"],
                appendTo: 'body',
                tolerance: 'pointer',
                revert: 'invalid',
                forceHelperSize: true,
                helper: function (event, element) {
                    return element.clone().appendTo("body")
                },
                scroll: false,
                start: function (e, ui) {
                    var id = $(this).find('input[name="employeeId"]').val();
                    $('#EmployeeIdHdn').val($(this).find('input[name="employeeId"]').val());
                    $('#DraggedHdn').val('');
                    $('#DraggedHdn').val($(this).html());
                    $('#DraggedHdnWithLi').val($('#DragableList-1240').html());
                    window.grabbed = true;
                    //ui.item.startPos = ui.item.index;
                    ui.item.startPos = ui.item.prevAll().length + 1;
                    var div = ui.item.get(0);
                    //$(div).css('left', ui.originalPosition.left);
                    //var pos = $(div).position();
                    //var off = $(div).offset();
                    document.body.appendChild(div);
                },
                stop: function () {
                    console.log("Lets do it again!");
                    window.grabbed = false;
                }
            }).sortable("option", "scroll", false)
                .disableSelection();

            //$(".wosue").sortable({
            //    connectWith: [".clsFreez"]
            //}).sortable("option", "scroll", false);

            $(".wosue").droppable({
                drop: function (event, ui) {
                    $(this).find("input").attr("name", "sectionId")
                }
            });

            $(".wosue").on("sortreceive", function (event, ui) {
                var $list = $(this);
                if ($list.children().length > 2) {
                    $(ui.sender).sortable('cancel');
                }
            });

            $("#olEmpListFreeze").sortable({
                connectWith: ["#olEmpListFreeze"],
                appendTo: 'body',
                tolerance: 'pointer',
                revert: 'invalid',
                forceHelperSize: true,
                helper: 'original',
                scroll: false,
            }).disableSelection();

            $("#txtSearchEmployee").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchEmployeeFreeze").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpListFreeze ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#btnSearchEmployee").on("click", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchPP").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olPPListSuggested ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchPPPlace").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olPPListPlace ol li").not(".notsearch").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#txtSearchPPPlaceByName").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olPPListPlace ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#policeUnitId").change(function () {
                var id = $(this).val();
                Common.Ajax('GET', '/Employee/Assignment/GetUnitWiseEmployeInfo/', [], 'json', ajaxUnits);
            })
        });

        $('#frezzEmployee').submit(function (e) {
            e.preventDefault();
            var form = $('#frezzEmployee')
            $.ajax({
                url: '/Employee/Assignment/SaveFrezzPostingData',
                data: form.serialize(),
                type: 'POST',
                success: function (records) {
                    if (records != "Fail") {
                        $('#submitPosting').click();
                        //swal({
                        //    title: '', text: `Saved!`, type: 'success', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `OK!`
                        //}).then(function () {

                        //    $('#submitPosting').click();
                        //    //window.location.href = '/Employee/Assignment/EmployeePostingConfirm?refNum=' + records;
                        //})
                    }
                    else {
                        swal('', 'Unable to Save!', 'warning');
                    }
                },
                error: function (erro) {
                    console.log(erro);
                    swal('', 'Unable to Save!', 'warning');
                }
            });
        })

        $('#postingBtnClick').click(function () {
            var checkEnrollList = $('#olEmpList ol li div').length;
            if (checkEnrollList > 0) {
                swal({
                    title: 'Warning', text: 'Employee List For Posting Not Completed', type: 'warning', showCancelButton: true, confirmButtonColor: '#007ACC', cancelButtonColor: '#d33', confirmButtonText: `Ok`
                }).then(function () {
                    return false;
                })
                return false;
            }
            else {
                $('#submitPosting').click();
                //$('#frezzPosting').click();
            }

        })

        $('#postingForm').submit(function (e) {
            e.preventDefault();
            var form = $('#postingForm')
            $.ajax({
                url: '/Employee/Assignment/UpdatePostingData',
                data: form.serialize(),
                type: 'POST',
                success: function (records) {
                    if (records != 'Fail') {
                        window.location.href = '/Employee/Assignment/AssignmentPost/' + records;
                    }
                    else {
                        swal('', 'Unable to Save!', 'warning');
                    }

                },
                error: function (erro) {
                    console.log(erro);
                    swal('', 'Unable to Save!', 'warning');
                }
            });
        })

        function ajaxUnits(response) {

            var options = '<option value="">Select </option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.subunitName + '</option>';
            });
            $('#policeSubUnitId').empty();
            $('#policeSubUnitId').append(options);
        }
    </script>
}

