@section Scripts{
    <script>

        function fnViewChange(show, hide) {
            $('#' + hide).hide();
            $('#' + show).show();
        }

        function fnViewChangeInternal(show, hide) {
            $('#' + hide).hide();
            $('#' + show).show();
        }

        $(document).ready(function () {
            $('#tblData').DataTable();
        });

        function Edit(Id, trainingCategoryName, trainingCategoryNameBn, trainingCategoryShortName, shortOrder) {
            $("#TrainingCategoryId").val(Id);
            $("#trainingCategoryName").val(trainingCategoryName);
            $("#trainingCategoryNameBn").val(trainingCategoryNameBn);
            $("#trainingCategoryShortName").val(trainingCategoryShortName);
            $("#shortOrder").val(shortOrder);
        }


        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/MasterData/TrainingCategory/DeleteTrainingCategory/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}
