@model AssignmentViewModel
@{
    ViewData["Title"] = "Employee Posting";
    //Layout = "~/Views/Shared/_LayoutPosting.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .nestable-color-2 .dd-handle {
        background-color: #0069D1;
        color: #fff;
    }

    .nestable-color-2 .dd-handle1 {
        background-color: red !important;
    }


    .wosue .dd-handle {
        width: auto !important;
        height: 35px !important;
        position: relative !important;
    }

    .previewCls {
        color: black;
        font-weight: bolder;
        border-radius: 7px;
        padding: 8px;
        margin-top: 5px;
    }
</style>

<div class="row">
    <div class="col-md-6 col-12">
        <div class="row">
            <div class="col-lg-12 col-12">
                <div class="card bg-white m-b-30">
                    <input type="hidden" value="" id="EmployeeIdHdn" />
                    <input type="hidden" value="" id="DraggedHdn" />
                    <input type="hidden" value="" id="DraggedHdnWithLi" />
                    <div style="display:none">
                        <input type="hidden" value="" id="movToEmpId" />
                        <input type="hidden" value="" id="previewEmpId" />
                    </div>
                    <div class="card-body new-user">
                        <div class="row">
                            <div class="col-lg-5 col-12 pr-0">
                                <h5 class="header-title mb-2">Officers' List for posting</h5>
                            </div>
                            <div class="col-lg-4 col-12">
                                <div class="search-content">
                                    <input type="text" id="txtSearchEmployee" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search...">
                                    <span class="search-button" style="cursor:pointer;" id="btnSearchEmployee"><i class="ti ti-search"></i></span>
                                </div>
                            </div>
                            <div class="col-lg-3 col-12 p-0 m-0 trash">
                                <a class="btn btn-success" target="_blank" href="/Employee/Report/PostingConfrimPdf?refNum=@Model.refNumber"><i class="fa  fa-print"></i></a>
                                &nbsp;
                                <a class="btn btn-danger" href="#"><i class="fa fa-trash"></i></a>
                                &nbsp;
                                <a class="btn btn btn-info sb-toggle-left" title="Assigned List"><i class="fa fa-location-arrow"></i></a>
                            </div>
                            @*<div class="col-lg-3 col-md-3 col-sm-4"></div>*@
                        </div>
                        <div id="olEmpHolder" style="position: static;overflow: hidden;">
                            <div class="dd nestable_list_2 nestable-color-2" id="olEmpList" style="height:540px;overflow-y:scroll">
                                <ol class="dd-list" id="enlistLiApp">
                                    @{
                                        int i = 0;
                                        @foreach (var data in Model.enlistedAssignments)
                                        {
                                            string colorCode = "";
                                            if (Convert.ToDateTime(data.employee?.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-2))
                                            {
                                                colorCode = "#f17878";
                                            }
                                            else if (Convert.ToDateTime(data.employee?.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-1) && Convert.ToDateTime(data.employee?.joiningDatePresentWorkstation).Date > DateTime.Now.AddYears(-2))
                                            {
                                                colorCode = "yellow";
                                            }
                                            else
                                            {
                                                colorCode = "#00BCD2";
                                            }
                                            <li class="dd-item enrollst" id="DragableList-@data.employeeId" data-id="@data.Id">
                                                <div class="dd-handle ui-state-default" id="DragableEle-@data.employeeId" style="background-color: @colorCode;color:black;font-weight:bolder;border-radius:7px">
                                                    <input type="hidden" name="employeeId" id="txtEmpId-@data.Id" value="@data.employeeId" />
                                                    <input type="hidden" name="employeeDataId" value="@data.Id" />
                                                    <input type="hidden" name="employeeCode" value="@data.employee?.employeeCode" />
                                                    <input type="hidden" name="employeeName" value="@data.employee?.nameEnglish" />
                                                    <input type="hidden" name="employeeRank" value="@data.employee?.rank?.rankName" />
                                                    <input type="hidden" name="employeeUnit" value="@data.employee?.branch?.branchUnitName" />
                                                    <input type="hidden" name="employeeSection" value="@data.employee?.section?.Name" />
                                                    <input type="hidden" name="employeeColor" value="@colorCode" />
                                                    <input type="hidden" name="employeeBCS" value="@data.employee?.bCSBatch?.batchName" />
                                                    <input type="hidden" name="employeeRankId" value="@data.employee.rankId" />
                                                    <input type="hidden" name="refNo" value="@data.enlistedAssignmentMaster?.refNo" />
                                                    @data.employee?.nameEnglish - @data.employee?.bCSBatch?.batchName, @data.employee?.rank?.rankName (@data.employee?.section?.Name, @data.employee?.branch?.districts?.districtName)
                                                    @{
                                                        int?[] doctor = { 69 };
                                                        int?[] eng = { 59 };
                                                        int?[] llb = { 79 };

                                                        int? doctorInfo = Model.educations.Where(x => doctor.Contains(x.degreeId) && x.employeeId == data.employeeId).Count();
                                                        int? engInfo = Model.educations.Where(x => eng.Contains(x.degreeId) && x.employeeId == data.employeeId).Count();
                                                        int? llbInfo = Model.educations.Where(x => llb.Contains(x.degreeId) && x.employeeId == data.employeeId).Count();

                                                        @if (doctorInfo > 0)
                                                        {
                                                            <img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />
                                                            <input type="hidden" name="employeeBatch" value="doctor.png" />
                                                        }
                                                        else if (engInfo > 0)
                                                        {
                                                            <img src="~/batch/engineer.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />
                                                            <input type="hidden" name="employeeBatch" value="engineer.png" />
                                                        }

                                                        else if (llbInfo > 0)
                                                        {
                                                            <img src="~/batch/advocate.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />
                                                            <input type="hidden" name="employeeBatch" value="advocate.png" />
                                                        }
                                                        else
                                                        {
                                                            @*<img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:50px; height:50px" />*@
                                                        }
                                                    }

                                                    <span onclick="detailInfoModalOpen('@data?.employee.employeeCode')" class="badge sugg pull-right ml-2" style="height:100%!important;background-color:#040825;cursor:pointer">
                                                        <i class="fa fa-user-o" title="Profile"></i>
                                                    </span>

                                                    <span onclick="LoadSuggestedNew(@data.employeeId,@data.employee.rankId,'@data.enlistedAssignmentMaster?.refNo')" class="badge move pull-right  ml-2" style="height:100%!important;background-color:#040825;cursor:pointer">
                                                        <i class="ti-more" title="Move"></i>
                                                    </span>
                                                    @*<span onclick="LoadSuggested(@data.employeeId,@data.employee.rankId,'@data.enlistedAssignmentMaster?.refNo')" class="badge move pull-right  ml-2" style="height:100%!important;background-color:#040825;cursor:pointer">
                                                            <i class="ti-more" title="Suggestion"></i>
                                                        </span>*@

                                                </div>
                                            </li>

                                        }
                                    }
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-12 col-12">
                <form id="frezzEmployee">
                    <div class="card bg-white m-b-30">

                        <div class="card-body new-user">
                            <div class="row">
                                <div class="col-lg-6 col-12">
                                    <h5 class="header-title mb-4">Freezed Employee List</h5>
                                </div>
                                <div class="col-lg-6 col-12">
                                    <div class="search-content">
                                        <input type="text" id="txtSearchEmployeeFreeze" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search...">
                                        <span class="search-button" style="cursor:pointer;" id="btnSearchEmployee"><i class="ti ti-search"></i></span>
                                    </div>
                                </div>
                                @*<div class="col-lg-3 col-md-3 col-sm-4"></div>*@
                            </div>
                            <div>
                                <input type="hidden" name="referenceNum" value="@Model.enlistedAssignments?.FirstOrDefault()?.enlistedAssignmentMaster?.refNo" />
                            </div>
                            <div class="dd nestable_list_1 nestable-color-1 clsFreez" id="olEmpListFreeze" style="max-height:400px;min-height:400px;width:100%;overflow-y:scroll">

                                @*<ol class="dd-list">
                                        <li class="dd-item sb-custom-toggle-right" id="olEmpListFreeze">
                                            <div class="dd-handle"></div>
                                        </li>
                                    </ol>*@
                            </div>

                        </div>
                    </div>
                    <div class="col-12 row">
                        <div style="display:none">
                            <input type="submit" class="col-12 btn btn-danger" style="font-weight: bolder;" id="frezzPosting" />
                        </div>
                        @*<input type="button" class="col-12 btn btn-warning" style="font-weight: bolder;" id="frezzBtnClick" value="Freeze" />*@
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-12">
        <div class="row">
            @*<div class="col-lg-12 col-sm-12">
                    <div class="card bg-white m-b-30">
                        <div class="card-body new-user">
                            <div class="row">
                                <div class="col-lg-4  col-12">
                                    <h6 class="header-title mb-4">Suggested Posting Place</h6>
                                </div>
                                <div class="col-lg-6 col-12">
                                </div>
                                <div class="col-lg-2 col-12">
                                    <a style="text-decoration:none; border-bottom:0!important;color:#fff!important" data-toggle="collapse" href="#olPPListSuggested" aria-expanded="true" aria-controls="olPPListSuggested" id="aaa" class="text-muted btn btn-sm btn-secondary text-light mmm">
                                        Ignore
                                    </a>
                                    <a style="text-decoration:none; border-bottom:0!important;color:#fff!important; display:none" data-toggle="collapse" href="#olPPListSuggested" aria-expanded="true" aria-controls="olPPListSuggested" id="bbb" class="text-muted btn btn-sm btn-secondary text-light ccc">
                                        Show
                                    </a>
                                </div>
                            </div>

                            <div class="dd mt-2 nestable_list_2 nestable-color-2 collapse show" id="olPPListSuggested" style="max-height:400px; overflow-y:scroll">

                                <div class=" new-user" id="olPPListForSuggestedUnitList">

                                </div>

                            </div>
                        </div>
                    </div>
                </div>*@
            <div class="col-lg-12 col-sm-12">
                <form id="postingForm">
                    <div class="card bg-white m-b-30">
                        <div class="card-body new-user">
                            <div class="row col-12">
                                <div class="col-lg-3 col-md-3 col-sm-3 p-0 m-0">
                                    <h5 class="header-title mb-4">Posting Place</h5>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4 p-0 m-0">
                                    <div class="search-content">
                                        <input type="text" id="txtSearchPPPlace" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search Unit . . .">
                                        <span class="search-button" style="cursor:pointer;" id="btnSearchPP"><i class="ti ti-search"></i></span>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4 p-0 m-0">
                                    <div class="search-content">
                                        <input type="text" id="txtSearchPPPlaceByName" class="form-control" style="width:85%;" autocomplete="off" name="keyword" placeholder="Search Name . . .">
                                        <span class="search-button" style="cursor:pointer;" id="btnSearchByName"><i class="ti ti-search"></i></span>
                                    </div>
                                </div>
                                <div class="col-lg-1 col-md-1 col-sm-1 p-0 m-0">
                                    <button type="button" class="btn btn-sm btn-info" id="VacantBtn" onclick="ShowHideEmployee()">Vacant Post</button>
                                    <button type="button" id="allBtn" class="btn btn-sm btn-success" style="display:none;" onclick="ShowAllEmployee()">All</button>
                                </div>
                            </div>
                            <div id="olPPListHolder" style="position: static;height: 700px;overflow: hidden;">
                                <div class="dd nestable_list_2 nestable-color-2" id="olPPListPlace" style="height:700px;overflow-y:scroll;">
                                    <ol class="dd-list">
                                        @{
                                            if (Model.assignmentPostingModels.Count() == 0)
                                            {
                                                <div style="padding-top:200px;text-align:center;">
                                                    <p style="font-size:24px;">No Data Found</p>
                                                </div>
                                            }
                                            else
                                            {
                                                var rankName = Model?.enlistedAssignments?.FirstOrDefault().employee?.rank?.rankName;
                                                var rankId = Model?.enlistedAssignments?.FirstOrDefault().employee?.rank?.Id;
                                                var assign = Model.assignments;
                                                int[] rangeId = { 1015, 1016, 1019, 1021, 1023, 1022, 1020, 1017 };
                                                foreach (var data in Model.assignmentPostingModels.Where(x => x.isParent == 1).GroupBy(x => new { x.unitId, x.mainUnit, x.rankId, x.rankName }).Select(x => new { unitId = x.Key.unitId, mainUnit = x.Key.mainUnit, rankId = x.Key.rankId, rankName = x.Key.rankName }))
                                                {
                                                    int? nop = Model.assignmentPostingModels.Where(x => x.unitId == data.unitId).FirstOrDefault().numOfPost;
                                                    int? temp = Model.assignmentPostingModels.Where(x => x.unitId == data.unitId).FirstOrDefault().totalEmployee;
                                                    int? blankPost = nop - temp;
                                                    <li class="dd-item" data-id="@data.unitId">

                                                        <div style="font-size:16px!important;padding:10px 25px 30px 20px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.mainUnit  <span class="m-2" title="Total Post"><i class="fa fa-users text-danger"></i> @nop </span><span class="m-2" title="Total Officers"><i class="fa fa-user text-info"></i> @temp </span> <span class="m-2"><i class="fa fa-user-o text-primary" title="Blank Post"></i>  @Model.assignmentPostingModels.Where(x => x.unitId == data.unitId).FirstOrDefault().vacantPost</span></div>
                                                        <ol class="dd-list">
                                                            @foreach (var sitem in Model.assignmentPostingModels.Where(x => x.isParent == 1 && x.unitId == data.unitId && x.employeeId != 0))
                                                            {
                                                                <li class="dd-item form-inline ListOfEmpActive notsearch" data-id="@sitem.unitId">
                                                                    <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">@sitem?.rankName<input type="hidden" name="rankId" value="@sitem.rankId" /></div>
                                                                    <div class="wosue" ondrop="drop(event,@sitem?.unitId)" style="width:55%;height:45px;">
                                                                        <div class="dd-handle ui-state-default" id="evnt-@sitem.employeeId" style="background-color: @sitem.colorCode;color:black;font-weight:bolder;border-radius:7px;">
                                                                            <input type="hidden" class="clsEmpId" name="frezzEmployeeId" id="txtEmpId-@sitem.employeeId" value="@sitem.employeeId" />@sitem.name
                                                                            @if (sitem.expertise != "")
                                                                            {
                                                                                <img src="@sitem.expertise" class="img-fluid rounded-circle p-0 m-0" style="width:20px; height:20px" />
                                                                            }
                                                                            else
                                                                            {
                                                                            }
                                                                            &nbsp;
                                                                            @if (sitem.attachedUnit != "")
                                                                            {
                                                                                <img src="~/batch/attached.png" data-toggle="tooltip" data-placement="top" title="@sitem.attachedUnit" class="img-fluid rounded-circle p-0 m-0" style="width:20px; height:20px" />
                                                                            }
                                                                            &nbsp;
                                                                            @if (sitem.pHQTRTypeId > 0)
                                                                            {
                                                                                <img src="~/batch/unmission.png" title="UN Mission" class="img-fluid rounded-circle p-0 m-0" style="width:20px; height:20px" />

                                                                            }
                                                                            &nbsp;
                                                                            @if (sitem.lockedEmpId > 0)
                                                                            {
                                                                                <img src="~/batch/locked.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:20px; height:20px" />

                                                                            }
                                                                            else { }
                                                                        </div>
                                                                        <input type="hidden" class="unitId" value="@sitem.mainUnit" />
                                                                        <input type="hidden" class="sectionName" value="@sitem?.sectionName" />
                                                                        <input type="hidden" class="clsSectionId" value="@sitem?.sectionId" />
                                                                        <input type="hidden" class="unit" value="@sitem.unitId" />
                                                                    </div>
                                                                    <div class="col">
                                                                        @if (assign.Where(x => x.employeeId == sitem.employeeId).FirstOrDefault() != null)
                                                                        {
                                                                            <div class="dd-nodrag form-control" style="float:right;width:107%;">@assign.Where(x => x.employeeId == sitem.employeeId).FirstOrDefault()?.section?.Name </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="dd-nodrag form-control" style="float:right;width:107%;">@sitem?.sectionName </div>
                                                                        }
                                                                    </div>

                                                                </li>
                                                            }

                                                            @for (int p = 0; p < blankPost; p++)
                                                            {
                                                                <li class="dd-item form-inline notsearch" id="unitId-@data.unitId">
                                                                    <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">@rankName <input type="hidden" name="rankId" value="@rankId" /></div>
                                                                    <div class="wosue" ondrop="drop(event,@data.unitId)" id="divwosue3" style="width:55%;height:45px;"></div>
                                                                    <div class="dd-nodrag col">
                                                                        <input type="hidden" class="unitId" value="@data.mainUnit" />
                                                                        <input type="hidden" class="unit" value="@data.unitId" />
                                                                        <select class="form-control" style="width:107%;float:right;" id="postPlaceId-@data.unitId" onchange="changeNewPostingPlace(@data.unitId)">
                                                                            @foreach (var item in Model.sections.Where(x => x.specialBranchUnitId == data.unitId))
                                                                            {
                                                                                <option value="@item.Id">@item.Name</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                </li>
                                                            }
                                                            <div id="DivListAdd-@data.unitId" class="mb-2"></div>
                                                            <li>
                                                                <button class="btn btn-block" style="background-color: lavender; color: black; font-weight: bolder;" type="button" onclick="AddNewPostingPlace('@data.unitId','@rankName','@rankId','@data.mainUnit')">Create New Post</button>
                                                            </li>
                                                        </ol>
                                                    </li>

                                                }

                                                foreach (var data in Model.assignmentPostingModels.Where(x => x.isParent == 0).GroupBy(x => new { x.specialBranchUnitId, x.mainUnit }).Select(x => new { unitId = x.Key.specialBranchUnitId, mainUnit = x.Key.mainUnit }))
                                                {
                                                    int? nop = 0;
                                                    int? temp = 0;
                                                    int? vacant = 0;
                                                    int? blankPost = 0;

                                                    @foreach (var uu in Model.assignmentPostingModels.Where(x => x.isParent == 0 && x.specialBranchUnitId == data.unitId).GroupBy(x => new { x.unitId, x.subUnit }).Select(x => new { unitId = x.Key.unitId, subUnit = x.Key.subUnit }))
                                                    {
                                                        nop = nop + Model.assignmentPostingModels.Where(x => x.unitId == uu.unitId).FirstOrDefault().numOfPost;
                                                        temp = temp + Model.assignmentPostingModels.Where(x => x.unitId == uu.unitId).FirstOrDefault().totalEmployee;
                                                        vacant = nop - temp;

                                                    }
                                                    <li class="dd-item" data-id="@data.unitId">

                                                        <div style="font-size:16px!important;padding:10px 25px 30px 20px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.mainUnit  <span class="m-2" title="Total Post"><i id="nop-@data.unitId" class="fa fa-users text-danger"></i> @nop</span><span class="m-2" title="Total Officers"><i class="fa fa-user text-info"></i>  @temp</span> <span class="m-2"><i class="fa fa-user-o text-primary" title="Blank Post"></i>  @vacant</span></div>
                                                        <ol class="dd-list">

                                                            @foreach (var subu in Model.assignmentPostingModels.Where(x => x.isParent == 0 && x.specialBranchUnitId == data.unitId).GroupBy(x => new { x.unitId, x.subUnit, x.rankId, x.rankName }).Select(x => new { unitId = x.Key.unitId, subUnit = x.Key.subUnit, rankId = x.Key.rankId, rankName = x.Key.rankName }))
                                                            {
                                                                int? nopp = Model.assignmentPostingModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().numOfPost;
                                                                int? tempp = Model.assignmentPostingModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().totalEmployee;
                                                                int? blankPostp = nopp - tempp;
                                                                @if (Model.assignmentPostingModels.Where(x => x.isParent == 0 && x.unitId == subu.unitId).Count() == 0)
                                                                {
                                                                    <li class="dd-item" data-id="@subu?.unitId">

                                                                        <div class="dd-handle" style="background-color: #040825;border-radius:7px">@subu.subUnit <span class="m-1" title="Total Post"><i class="fa fa-users"></i>  @nopp</span><span class="m-1" title="Total Officers"><i class="fa fa-user"></i>  @tempp</span> <span class="m-1"><i class="fa fa-user-o" title="Blank Post"></i> @Model.unitRankWiseEmployeeViewModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().vacantPost</span></div>
                                                                    </li>
                                                                }
                                                                else
                                                                {
                                                                    List<int> sectionId = new List<int>();
                                                                    <li class="dd-item" data-id="@subu?.unitId">
                                                                        <div class="dd-handle" style="background-color: #040825;border-radius:7px">@subu?.subUnit <span class="m-2" title="Total Post"><i class="fa fa-users"></i> @nopp </span><span class="m-1" title="Total Officers"><i class="fa fa-user"></i>  @tempp</span> <span class="m-1"><i class="fa fa-user-o" title="Blank Post"></i>  @Model.assignmentPostingModels.Where(x => x.unitId == subu.unitId).FirstOrDefault().vacantPost</span></div>
                                                                        <ol class="dd-list">
                                                                            @foreach (var sitem in Model.assignmentPostingModels.Where(x => x.isParent == 0 && x.unitId == subu.unitId))
                                                                            {
                                                                                sectionId.Add((int)(sitem.sectionId == null ? 0 : sitem.sectionId));
                                                                                <li class="dd-item form-inline ListOfEmpActive notsearch" data-id="@sitem.employeeId">
                                                                                    <div class="form-control" style="background-color: lavender; color: black; font-weight: bolder;">@sitem.rankName<input type="hidden" name="rankId" value="@sitem.rankId" /></div>
                                                                                    <div class="wosue" ondrop="drop(event,@subu?.unitId)" style="width:55%;height:45px;">
                                                                                        <div class="dd-handle ui-state-default" id="evnt-@sitem.employeeId" style="background-color: @sitem.colorCode;color:black;font-weight:bolder;border-radius:7px;">
                                                                                            <input type="hidden" class="clsEmpId" name="frezzEmployeeId" id="txtEmpId-@sitem.employeeId" value="@sitem.employeeId" />@sitem.name
                                                                                            @if (sitem.expertise != "")
                                                                                            {
                                                                                                <img src="@sitem.expertise" class="img-fluid rounded-circle p-0 m-0" style="width:20px; height:20px" />
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                            }
                                                                                            @if (sitem.attachedUnit != "")
                                                                                            {
                                                                                                <img src="~/batch/attached.png" data-toggle="tooltip" data-placement="top" title="@sitem.attachedUnit" class="img-fluid rounded-circle p-0 m-0" style="width:20px; height:20px" />
                                                                                            }
                                                                                            &nbsp;&nbsp;
                                                                                            @if (sitem.lockedEmpId > 0)
                                                                                            {
                                                                                                <img src="~/batch/locked.png" title="Locked" class="img-fluid rounded-circle p-0 m-0" style="width:20px; height:20px" />

                                                                                            }
                                                                                            &nbsp;&nbsp;
