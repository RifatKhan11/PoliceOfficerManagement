@section Scripts{
    <script type="text/javascript">


        let stack = [];
        let Restack = [];

        function UnDo() {
            let id = stack.pop();
            removeFromSelectedDiv(id)
            Restack.push(id);
            //console.log(stack);
        }

        function ReDo() {
            let id = Restack.pop();
            $("#ForReDo-" + id).click();
            //console.log(stack);
        }

        function fnEmployeeShow(id) {
            $("#olPPList").load("/Employee/EmployeeInfo/GetPartialEmployeeInfo?id=" + id);
            //Common.Ajax('GET', '/Employee/EmployeeInfo/EmployeeInfoProfileView/' + id, [], 'json', ajaxEmployeeProfile, false);
        }

        function ajaxEmployeeProfile(res) {
            //console.log(res);
            $('#sEmpName').html(res.employeeInfo ?.nameEnglish);
            $('#sEmpBP').html(res.employeeInfo ?.employeeCode);
            $('#sEmpRank').html(res.employeeInfo ?.rank ?.rankName);
            $('#joiningDate').html(formatDate(res.employeeInfo ?.joiningDatePresentWorkstation));
            $('#bCSBatch').html(res.employeeInfo ?.BCSBatches ?.batchName);
            $('#homeDistrict').html(res.addressInformation ?.District ?.districtName);
            $('#education').html(res.educationalQualifications ?.degree ?.degreeName);
            //alert(res.photograph ?.url);
            if (res.photograph ?.url == '' || res.photograph ?.url == null || res.photograph ?.url == 'undefined') {
                $('#sEmpImage').attr('src', '~/' + res.photograph ?.url);
            } else {
                $('#sEmpImage').attr('src', '~/images/users/userImage.jpg');
            }

        }

        $("#toTopforView").click(function () {
            alert("dbbfcjdsab");
            //1 second of animation time
            //html works for FFX but not Chrome
            //body works for Chrome but not FFX
            //This strange selector seems to work universally
            $("html, body").animate({ scrollTop: 0 }, 1000);
        });

        $(document).ready(function () {

            $('#tblData').DataTable();
            //loadEmployeeListByRankUnit();
            jQuery(".select2").select2({
                width: '100%'
            });

            $('#txtSearchEmployee').keyup('on', function () {
                var val = $(this).val();
                if (val != '') {
                    $('.dd').nestable('expandAll');
                }
                
            })

            var sld = 1;
            $('.sb-custom-toggle-right, #btnSlideClose').click(function () {

                let id = $(this).find('.clsEmpId').val();
                if (sld == 1) {
                    setTimeout(function () {
                        $('#enlistArr').removeClass('sb-custom-toggle-rightArrRem');
                        $('#enlistArr').addClass('sb-custom-toggle-rightArr');

                        $('#slideArray').removeClass('fa fa-chevron-left fa-4x');
                        $('#slideArray').addClass('fa fa-chevron-right fa-4x');
                        $('.counterdeg').hide();
                    }, 200);

                    sld = 0;

                } else {
                    setTimeout(function () {
                        $('#enlistArr').removeClass('sb-custom-toggle-rightArr');
                        $('#enlistArr').addClass('sb-custom-toggle-rightArrRem');

                        $('#slideArray').removeClass('fa fa-chevron-right fa-4x');
                        $('#slideArray').addClass('fa fa-chevron-left fa-4x');
                        if ($('#enlistCounter').html() == '0') {
                            $('.counterdeg').hide();
                        }
                        else {
                            $('.counterdeg').show();
                        }

                    }, 150);

                    sld = 1;
                }

            });

            $("#txtSearchEmployee").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                    //$('#olEmpList ol .dd-item').nestable('expandAll');
                });

            });

            $("#btnSearchEmployee").on("click", function () {
                var value = $(this).val().toLowerCase();
                $("#olEmpList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);

                });
            });

            $("#btnSearch").on("click", function () {
                var rankId = $("#rankId").val();
                //$.get("/Employee/Assignment/GetRankWiseEmployeInfo/?rankid=" + rankId, function (res) {
                //  //  var data = JSON.parse(data);
                //    var data = res;
                //});

                Common.Ajax('GET', '/Employee/Assignment/GetRankWiseEmployeInfo/?rankid=' + rankId, [], 'json', ajaxSpecialBranchUnit, false);
            });

            $("#txtSearchPP").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#olPPList ol li").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $("#policeUnitId").change(function () {
                var id = $(this).val();
                Common.Ajax('GET', '/Employee/Assignment/GetUnitWiseEmployeInfo/', [], 'json', ajaxUnits);
            })
        });

        function ajaxSpecialBranchUnit(res) {
            //Console.log(res);
        }


        function ajaxUnits(response) {

            var options = '<option value="">Select </option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.subunitName + '</option>';
            });
            $('#policeSubUnitId').empty();
            $('#policeSubUnitId').append(options);
        }


        function EditAssignment(Id, employeeId, assignmentTypeId, StartDate, EndDate, designationId, departmentId, EntryNo, Remarks) {
            $("#AssignmentId").val(Id);
            $("#employeeId").val(employeeId);
            $("#assignmentTypeId").val(assignmentTypeId);
            $("#StartDate").val(StartDate);
            $("#EndDate").val(EndDate);
            $("#designationId").val(designationId);
            $("#departmentId").val(departmentId);
            $("#EntryNo").val(EntryNo);
            $("#Remarks").val(Remarks);
        }

        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/AwardEntry/DeleteAssignment/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }

        function loadEmployeeListByRankUnit() {
            $('#olEmpList').hide();
            $('#loaderDiv').show();
            var rankId = $('#rankId').val();
            var unitId = $('#unitId').val();
            var batch = $('#batchId').val();
            var servicePeriod = $('#servicePeriodId').val();
            var bandId = $('#bandId').val();
            var type = $('#selectedStatusId').val();
            var skillId = $('#specialSkillTypeId').val();
            var isLocked = 0;
            var isAttached = 0;
            var isUnMission = 0;
            var isPRL = 0;
            if (type == 'locked') {
                isLocked = 1
            } else if (type == 'attached') {
                isAttached = 1
            } else if (type == 'unmission') {
                isUnMission = 1
            } else if (type == 'prl') {
                isPRL = 1
            } else {

            }
            //$("#olEmpList").load("/Employee/Assignment/GetRankUnitWisePartialEmployeeView?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId);
            $("#olEmpList").load("/Employee/Assignment/GetUnitRankWisePartialEmployeeView?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId + "&isLocked=" + isLocked + "&isAttached=" + isAttached + "&isUnMission=" + isUnMission + "&isPRL=" + isPRL + "&skillId=" + skillId);
        }
        function openExportToExcel() {
            var rankId = $('#rankId').val();
            var unitId = $('#unitId').val();
            var batch = $('#batchId').val();
            var servicePeriod = $('#servicePeriodId').val();
            var bandId = $('#bandId').val();
            var type = $('#selectedStatusId').val();
            var isLocked = 0;
            var isAttached = 0;
            var isUnMission = 0;
            var isPRL = 0;
            if (type == 'locked') {
                isLocked = 1
            } else if (type == 'attached') {
                isAttached = 1
            } else if (type == 'unmission') {
                isUnMission = 1
            } else if (type == 'prl') {
                isPRL = 1
            } else {

            }
            window.open("/Employee/Assignment/UnitRankOfficerListExportToExcel?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId + "&isLocked=" + isLocked + "&isAttached=" + isAttached + "&isUnMission=" + isUnMission + "&isPRL=" + isPRL);
            //$("#olEmpList").load("/Employee/Assignment/GetRankUnitWisePartialEmployeeView?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId);
            //$("#olEmpList").load("/Employee/Assignment/UnitRankOfficerListExportToExcel?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId + "&isLocked=" + 0 + "&isAttached=" + 0 + "&isUnMission=" + 0);
        }

        function iconLoad(type, id) {
            $('#olEmpList').hide();
            $('#loaderDiv').show();
            var rankId = 0;
            var unitId = 0;
            var batch = 0;
            var servicePeriod = 0;
            var bandId = 0;
            var isLocked = 0;
            var isAttached = 0;
            var isUnMission = 0;
            var isPRL = 0;
            if (type == 'period') {
                servicePeriod = id;
            }
            else if (type == 'expertise') {
                bandId = id
            } else if (type == 'locked') {
                isLocked = id
            } else if (type == 'attached') {
                isAttached = id
            } else if (type == 'unmission') {
                isUnMission = id
            } else if (type == 'prl') {
                isPRL = id
            }

            $("#olEmpList").load("/Employee/Assignment/GetUnitRankWisePartialEmployeeView?rankId=" + rankId + "&unitId=" + unitId + "&batch=" + batch + "&servicePeriod=" + servicePeriod + "&bandId=" + bandId + "&isLocked=" + isLocked + "&isAttached=" + isAttached + "&isUnMission=" + isUnMission + "&isPRL=" + isPRL);
        }

    </script>
}

