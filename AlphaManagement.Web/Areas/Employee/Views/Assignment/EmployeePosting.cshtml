@model AssignmentViewModel
@{
    ViewData["Title"] = "Employee Posting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .nestable-color-2 .dd-handle {
        background-color: #0069D1;
        color: #fff;
    }

    .nestable-color-2 .dd-handle1 {
        background-color: red !important;
    }

    .sb-custom-toggle-right {
        top: 45%;
        position: fixed;
        right: 0%;
    }

    .counterdeg {
        font-weight: bolder;
        color: white;
        background-color: #ff7d01;
        border-radius: 50%;
        padding: 10px;
    }

    #countTab {
        color: red;
        background-color: white;
        border-radius: 50%;
        width: 45px !important;
        margin-left: 10px !important;
        margin-top: -10px !important;
        padding: 0;
        margin: 0;
    }
</style>

<div class="row">
    <div class="sb-custom-toggle-right sb-custom-toggle-rightArrRem" id="enlistArr" style="cursor:pointer;height:80px;">
        <span class="form-inline">
            <span><i class="fa fa-chevron-left fa-4x" id="slideArray" style="width:10px;color:darkolivegreen;opacity:.3"></i></span>
        </span>
        <span class="counterdeg" style="display:none"><label id="enlistCounter" style="width:16px;text-align:center;margin-top:18px;">0</label></span>

    </div>
    <div class="col-lg-6 col-sm-12">
        <div class="card bg-white m-b-30">

            <div class="card-body new-user">
                <div class="row">
                    <div class="col-12 row">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-12 pr-0 mr-0" style="margin-top: 10px;">
                            <h5 class="header-title float-left mb-2">Officers' List</h5>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3 col-12">
                            <div class="form-group row">
                                <div class="col-md-12 col-12 col-12">
                                    <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="rankId" id="rankId" data-parsley-required="true">
                                        <option value="0">All Rank</option>
                                        @foreach (var item in Model.ranks.Where(x => x.rankCode == "Officer").OrderBy(x=>x.shortOrder))
                                        {
                                            <option value="@item.Id">@item.rankName</option>

                                        }
                                    </select>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3 col-12">
                            <div class="form-group row">
                                <div class="col-md-12 col-12 col-12">
                                    <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="unitId" id="unitId" data-parsley-required="true">
                                        <option value="0">All Unit</option>
                                        @foreach (var item in Model.specialBranchUnits.OrderBy(x=>x.Id))
                                        {
                                            <option value="@item.Id">@item.branchUnitName</option>

                                        }
                                    </select>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3 col-12">
                            <div class="form-group row">
                                <div class="col-md-12 col-12 col-12">
                                    <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="batchId" id="batchId" data-parsley-required="true">
                                        <option value="0">All Batch</option>
                                        @foreach (var item in Model.bCSBatches)
                                        {
                                            <option value="@item.Id">@item.batchName</option>

                                        }
                                    </select>

                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-12 row pb-0 mb-3">

                        <div class="col-lg-3 col-md-3 col-sm-3 col-12  mb-0 pb-0">
                            <div class="form-group row  mb-0 pb-0">
                                <div class="col-md-12 col-12 col-12  mb-0 pb-0">
                                    <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="bandId" id="bandId" data-parsley-required="true">
                                        <option value="0">Professional Degree</option>
                                        <option value="2700">BBA/MBA</option>
                                        <option value="1458" style="background-image:url(~/batch/engineer.png);">Civil Engineering</option>
                                        <option value="2780" style="background-image:url(~/batch/engineer.png);">Computer Science and Engineering</option>
                                        <option value="1460" style="background-image:url(~/batch/engineer.png);">Electrical Engineering</option>
                                        <option value="79" style="background-image:url(~/batch/engineer.png);">LLB/LLM</option>
                                        @*<option value="83">MBA</option>*@
                                        <option value="69" style="background-image:url(~/batch/doctor.jpg);">MBBS/BDS</option>
                                        <option value="1467" style="background-image:url(~/batch/engineer.png);">Mechanical  Engineering</option>
                                        <option value="1528">Pharmacy</option>
                                        <option value="58" style="background-image:url(~/batch/doctor.jpg);">Veterinary</option>

                                    </select>
                                    @*<input type="hidden" id="bandId" />*@
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3 col-12  mb-0 pb-0">
                            <div class="form-group row  mb-0 pb-0">
                                <div class="col-md-12 col-12 col-12  mb-0 pb-0">
                                    <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="specialSkillTypeId" id="specialSkillTypeId" data-parsley-required="true">
                                        <option value="0">Select Skill</option>
                                        @foreach (var data in Model.specialSkillTypes.OrderBy(x=>x.name))
                                        {
                                            <option value="@data.Id">@data.name</option>
                                        }
                                    </select>
                                    @*<input type="hidden" id="servicePeriodId" />*@
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-3 col-12  mb-0 pb-0">
                            <div class="form-group row  mb-0 pb-0">
                                <div class="col-md-12 col-12 col-12  mb-0 pb-0">
                                    <select class="select2 form-control mb-3 custom-select" style="width: 100%;" name="servicePeriodId" id="servicePeriodId" data-parsley-required="true">
                                        <option value="0">Duration Of Posting</option>
                                        <option value="1">0 to 1 Year</option>
                                        <option value="2">1 to 2 Years</option>
                                        <option value="3">2 to 3 Years</option>
                                        <option value="4">3+ Years</option>
                                    </select>
                                    @*<input type="hidden" id="servicePeriodId" />*@
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-3 mb-0 pb-0">
                            <button class="btn btn-info" onclick="loadEmployeeListByRankUnit()" id="btnLoadData">Load</button>
                            <button class="btn btn-success" onclick="UnDo()" title="Undo"><i class="mdi mdi-undo-variant"></i></button>
                            <button class="btn btn-danger" onclick="ReDo()" title="Redo"><i class="mdi mdi-redo-variant"></i></button>
                        </div>

                    </div>
                    <div class="col-12 row" style="padding:0;margin:0;padding-left:2%;">
                        <span class="rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('period',1)" data-toggle="tooltip" data-placement="top" title="Up to 1 year" style="height:30px;width:30px;background-color:#00BCD2;border-color:black;border-style:ridge;border-width:0.5px;cursor:pointer;"></span>&nbsp;&nbsp;&nbsp;&nbsp;
        <span class="rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('period',2)" data-toggle="tooltip" data-placement="top" title="Up to 2 years" style="height:30px;width:30px;background-color:yellow;border-color:black;border-style:ridge;border-width:0.5px;cursor:pointer;"></span>&nbsp;&nbsp;&nbsp;&nbsp;
        <span class="rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('period',3)" data-toggle="tooltip" data-placement="top" title="More then 2 years" style="height:30px;width:30px;background-color:#f17878;border-color:black;border-style:ridge;border-width:0.5px;cursor:pointer;"></span>
        <label style="font-size:26px;padding-top:5px;">&nbsp;||&nbsp;</label>
        @*<img src="/batch/engineer.png" class="img-fluid rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('expertise',59)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Engineer" />&nbsp;&nbsp;&nbsp;&nbsp;
        <img src="/batch/doctor.png" class="img-fluid rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('expertise',69)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Doctor" />&nbsp;&nbsp;&nbsp;&nbsp;
        <img src="/batch/lawyer.PNG" class="img-fluid rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('expertise',79)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Lawyer" />&nbsp;&nbsp;&nbsp;&nbsp;
        <img src="/batch/pharmacist.png" class="img-fluid rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('expertise',1528)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Pharmacist" />&nbsp;&nbsp;&nbsp;&nbsp;
        <img src="/batch/literature.png" class="img-fluid rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('expertise',2702)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Literature" />&nbsp;&nbsp;
        <label style="font-size:26px;padding-top:5px;">&nbsp;||&nbsp;</label>*@
        <img src="~/batch/unmission.png" class="img-fluid rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('unmission',1)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Selected for UN Mission" />&nbsp;&nbsp;&nbsp;&nbsp;
        <img src="/batch/attached.png" class="img-fluid rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('attached',1)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Attached" />&nbsp;
        <label style="font-size:26px;padding-top:5px;">&nbsp;||&nbsp;</label>
        <img src="/batch/locked.png" class="img-fluid rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('locked',1)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="Locked" />&nbsp;&nbsp;
        <label style="font-size:26px;padding-top:5px;">&nbsp;||&nbsp;</label>
        <img src="~/images/prl.png" class="img-fluid rounded-circle p-0 m-0 clsExpandClick" onclick="iconLoad('prl',1)" style="width:30px; height:30px;cursor:pointer;" data-toggle="tooltip" data-placement="top" title="PRL" />
        <label style="font-size:26px;padding-top:5px;">&nbsp;||&nbsp;</label>
                        <div class="col-lg-6 col-md-6 col-sm-4 col-12 search-content float-right  mb-0 pb-0">
                            <input type="text" id="txtSearchEmployee" class="form-control" style="width:90%;" autocomplete="off" name="keyword" placeholder="Search...">
                            <span class="search-button" style="cursor:pointer;" id="btnSearchEmployee"><i class="ti ti-search"></i></span>
                        </div>


                        @*<div class="col-lg-3 col-md-3 col-sm-4 col-12  mb-0 pb-0">
                            <button class="btn btn-info" onclick="loadEmployeeListByRankUnit()" id="btnLoadData">Load</button>
                        </div>


                        <div class="col-lg-1 col-md-1 col-sm-2 col-12">
                            <a class="btn btn-success" href="#" onclick="UnDo()" title="Undo"><i class="mdi mdi-undo-variant"></i></a>
                        </div>
                        <div class="col-lg-1 col-md-1 col-sm-2 col-12">
                            <a class="btn btn-danger ml-3" href="#" onclick="ReDo()" title="Redo"><i class="mdi mdi-redo-variant"></i></a>
                        </div>*@
                        @*<div class="col-lg-3 col-md-3 col-sm-2 col-12">
                            <button class="btn-sm btn-default" type="button" onclick="openExportToExcel()">Export To Excel</button>
                        </div>*@

                    </div>
                </div>

                <div class="dd nestable_list_2 nestable-color-2" id="olEmpList">

                </div>

                <div class="col-12 row" id="loaderDiv" style="display:none">
                    <div class="col-1"></div>
                    <div class="col-6">
                        <img src="~/images/Circles-loader.gif" style="height:600px;width:500px" />
                    </div>
                    <div class="col-5"></div>
                </div>


            </div>
        </div>
    </div>

    <div class="col-lg-6 col-12">
        <div class="">
            <div class="new-user" id="olPPList">

            </div>
        </div>
    </div>
</div><!--end row-->


