@model AssignmentViewModel
@{
    ViewData["Title"] = "Employee Posting";
    //Layout = "~/Views/Shared/_LayoutForPartial.cshtml";
}
<link href="~/plugins/nestable/jquery.nestable.css" rel="stylesheet" />
<link href="~/plugins/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/plugins/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="~/css/bootstrap.min.css" rel="stylesheet">
<link href="~/css/slidebars.min.css" rel="stylesheet">
<link href="~/css/icons.css" rel="stylesheet">
<link href="~/css/menu.css" rel="stylesheet" type="text/css">
<link href="~/css/style.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Zen+Dots&display=swap" rel="stylesheet">

<style>

    .nestable-color-2 .dd-handle {
        background-color: #0069D1;
        color: #fff;
    }

    .nestable-color-2 .dd-handle1 {
        background-color: red !important;
    }

    .sb-custom-toggle-right {
        top: 45%;
        position: fixed;
        right: 0%;
    }
    #divEmpList::-webkit-scrollbar {
        width: 0; /* Remove scrollbar space */
        background: transparent; /* Optional: just make scrollbar invisible */
    }
    /*@@media screen and (max-width: 1400px){
        .empInfo{
            font-size:10px;
        }
    }*/
</style>
<div class="col-12" id="divEmpList" style="padding:0;height:850px;overflow-y:scroll;">
    <ol class="dd-list">
        @{
            int i = 0;

            foreach (var data in Model.branchUnitWiseEmployees.Where(x => x.isParent == 1))
            {
                var totalemployees = data.unitEmployees.Count() + Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id).Sum(x => x.subUnitEmployees.Count());
                var totalPost = data.unitTotalPost + Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id).Sum(x => x.subUnitTotalPost);
                var totalBlankPost = data.unitTotalPost + Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id).Sum(x => x.subUnitTotalBlankPost);
                var blankPost = totalPost - totalemployees;
                <li class="dd-item" data-id="@data.Id">

                    <div style="font-size:16px!important;padding:10px 25px 30px 20px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.parentSpecialBranchUnit?.branchUnitName  <span class="m-2" title="Total Post"><i class="fa fa-users text-danger"></i>  @totalPost</span><span class="m-2" title="Total Officers"><i class="fa fa-user text-info"></i>  @totalemployees</span> <span class="m-2"><i class="fa fa-user-o text-primary" title="Blank Post"></i>  @blankPost @*@totalBlankPost*@</span></div>
                    @if (Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id).Count() > 0)
                    {

                        <ol class="dd-list">
                            @foreach (var subu in Model.branchUnitWiseEmployees.Where(x => x.specialBranchUnit?.specialBranchUnitId == data.Id))
                            {
                                var subBlankCount = subu?.subUnitTotalPost - subu?.subUnitEmployees.Count();
                                @if (subu?.subUnitEmployees.Count() == 0)
                                {
                                    <li class="dd-item" data-id="@subu?.Id">

                                        <div class="dd-handle" style="background-color: #040825;border-radius:7px">@subu?.specialBranchUnit.branchUnitName <span class="m-1" title="Total Post"><i class="fa fa-users"></i>  @subu?.subUnitTotalPost</span><span class="m-1" title="Total Officers"><i class="fa fa-user"></i>  @subu?.subUnitEmployees.Count()</span> <span class="m-1"><i class="fa fa-user-o" title="Blank Post"></i> @subBlankCount @*@subu?.subUnitTotalBlankPost*@</span></div>
                                    </li>
                                }
                                else
                                {

                                    <li class="dd-item" data-id="@subu?.Id">
                                        <div class="dd-handle" style="background-color: #040825;border-radius:7px">@subu?.specialBranchUnit.branchUnitName <span class="m-2" title="Total Post"><i class="fa fa-users"></i>  @subu?.subUnitTotalPost</span><span class="m-1" title="Total Officers"><i class="fa fa-user"></i>  @subu?.subUnitEmployees.Count()</span> <span class="m-1"><i class="fa fa-user-o" title="Blank Post"></i>  @subBlankCount @*@subu?.subUnitTotalBlankPost*@</span></div>
                                        <ol class="dd-list">
                                            @foreach (var sitem in subu?.subUnitEmployees)
                                            {
                                                string colorCode = "";
                                                if (Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-2))
                                                {
                                                    colorCode = "#f17878";
                                                }
                                                else if (Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-1) && Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date > DateTime.Now.AddYears(-2))
                                                {
                                                    colorCode = "yellow";
                                                }
                                                else
                                                {
                                                    colorCode = "#00BCD2";
                                                }
                                                <li class="dd-item" id="emp-@sitem.Id" data-id="@sitem.Id" onclick="fnEmployeeShow(@sitem.employeeCode)">
                                                    <div class="dd-handle" style="background-color: @colorCode;color:black;font-weight:bolder;border-radius:7px">
                                                        <input type="hidden" class="clsEmpId" id="txtEmpId-@sitem.Id" value="@sitem.Id" /><span class="empInfo"> @sitem.nameEnglish - @sitem.bCSBatch?.batchName, @sitem.rank?.rankName (@sitem?.section?.Name)</span><span class="badge  pull-right" style="height:100%!important;background-color:#040825!important;cursor:pointer"><i class="fa fa-plus fa-1x" onclick="fnSelectedEmployee(@sitem.Id,'@sitem.nameEnglish','@sitem.bCSBatch?.batchName', '@sitem.rank?.rankName',@sitem.rankId,'@colorCode','@sitem?.section?.Name')"></i></span>
                                                        @{
                                                            int?[] doctor = { 69 };
                                                            int?[] eng = { 59 };
                                                            int?[] llb = { 79 };

                                                            //int? doctorInfo = Model.branchUnitWiseEmployees?.FirstOrDefault().EducationalQualifications.Where(x => doctor.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                            //int? engInfo = Model.branchUnitWiseEmployees?.FirstOrDefault().EducationalQualifications.Where(x => eng.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                            //int? llbInfo = Model.branchUnitWiseEmployees?.FirstOrDefault().EducationalQualifications.Where(x => llb.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();

                                                            int? doctorInfo = Model.educations.Where(x => doctor.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                            int? engInfo = Model.educations.Where(x => eng.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                            int? llbInfo = Model.educations.Where(x => llb.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();

                                                            @if (doctorInfo > 0)
                                                            {
                                                                <img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />
                                                            }
                                                            else if (engInfo > 0)
                                                            {
                                                                <img src="~/batch/engineer.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                            }

                                                            else if (llbInfo > 0)
                                                            {
                                                                <img src="~/batch/advocate.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                            }
                                                            else
                                                            {
                                                                @*<img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:50px; height:50px" />*@
                                                            }
                                                        }

                                                    </div>
                                                </li>
                                            }
                                        </ol>
                                    </li>
                                }
                            }
                        </ol>
                    }
                    else
                    {
                        if (data?.unitEmployees.Count() > 0)
                        {
                            <ol class="dd-list">
                                @foreach (var sitem in data?.unitEmployees)
                                {
                                    string colorCode = "";
                                    if (Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-2))
                                    {
                                        colorCode = "#f17878";
                                    }
                                    else if (Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date < DateTime.Now.AddYears(-1) && Convert.ToDateTime(sitem.joiningDatePresentWorkstation).Date > DateTime.Now.AddYears(-2))
                                    {
                                        colorCode = "yellow";
                                    }
                                    else
                                    {
                                        colorCode = "#00BCD2";
                                    }
                                    <li class="dd-item" id="emp-@sitem.Id" data-id="@sitem.Id" onclick="fnEmployeeShow(@sitem.employeeCode)">
                                        <div class="dd-handle" style="background-color: @colorCode;color:black;font-weight:bolder;border-radius:7px">
                                            <input type="hidden" class="clsEmpId" id="txtEmpId-@sitem.Id" value="@sitem.Id" /><span class="empInfo">@sitem.nameEnglish - @sitem.bCSBatch?.batchName, @sitem.rank?.rankName  (@sitem?.section?.Name)</span><span class="badge pull-right" style="height:100%!important;background-color:#040825;cursor:pointer"><i class="fa fa-plus fa-1x" onclick="fnSelectedEmployee(@sitem.Id,'@sitem.nameEnglish','@sitem.employeeCode', '@sitem.rank?.rankName',@sitem.rankId,'@colorCode','@sitem?.section?.Name')"></i></span>
                                            @{
                                                int?[] doctor = { 69 };
                                                int?[] eng = { 59 };
                                                int?[] llb = { 79 };
                                                

                                                int? doctorInfo = Model.educations.Where(x => doctor.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                int? engInfo = Model.educations.Where(x => eng.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();
                                                int? llbInfo = Model.educations.Where(x => llb.Contains(x.degreeId) && x.employeeId == @sitem.Id).Count();

                                                @if (doctorInfo > 0)
                                                {
                                                    <img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />
                                                }
                                                else if (engInfo > 0)
                                                {
                                                    <img src="~/batch/engineer.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                }
                                                else if (llbInfo > 0)
                                                {
                                                    <img src="~/batch/advocate.png" class="img-fluid rounded-circle" style="width:20px; height:20px" />

                                                }
                                                else
                                                {
                                                    @*<img src="~/batch/doctor.png" class="img-fluid rounded-circle" style="width:50px; height:50px" />*@
                                                }
                                            }

                                        </div>
                                    </li>
                                }
                            </ol>
                        }

                    }
                </li>

            }
        }

    </ol>
</div>
<script src="~/js/jquery-3.2.1.min.js"></script>
<script src="~/js/bootstrap.min.js"></script>
<script src="~/js/jquery.slimscroll.min.js"></script>
<script src="~/js/slidebars.min.js"></script>
<script src="~/js/common.js"></script>
<!-- Responsive and datatable js -->
<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
<script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
<script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>
<script src="~/plugins/nestable/jquery.nestable.js"></script>
<script src="~/plugins/nestable/nestable.js"></script>
<script src="~/js/dropify.min.js"></script>
<!--app js-->
<script src="~/js/jquery.app.js"></script>
<!--Swall-->
<script type="text/javascript" src="~/plugins/parsleyjs/dist/parsley.min.js"></script>
<script>
    $(document).ready(function () {
        $('#olEmpList').show();
        $('#loaderDiv').hide();
    })
</script>
