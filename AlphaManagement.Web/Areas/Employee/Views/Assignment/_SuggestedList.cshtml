@model AssignmentViewModel

@{
    ViewData["Title"] = "_SuggestedList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>_SuggestedList</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<ol class="dd-list">

        @{

            foreach (var data in Model.suggestedUnits.Select(x=>new { x.unitId,x.unitName}).Distinct())
