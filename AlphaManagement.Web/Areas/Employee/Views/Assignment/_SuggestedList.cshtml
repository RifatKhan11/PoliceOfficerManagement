                var totalemployees = Model.suggestedUnits.Where(x => x.unitId == data.unitId).Sum(x=>x.TotalEmployee);
                var totalPost = Model.suggestedUnits.Where(x => x.unitId == data.unitId).Sum(x => x.TotalPost);
                var totalBlankPost = Model.suggestedUnits.Where(x => x.unitId == data.unitId).Sum(x => x.TotalPost)- Model.suggestedUnits.Where(x => x.unitId == data.unitId).Sum(x => x.TotalEmployee);
                var blankPost = totalPost - totalemployees;
                <li class="dd-item" data-id="@data.unitId">

                    <div style="font-size:16px!important;padding:10px 25px 30px 20px!important;background-color: #2a1067;border-radius:7px" class="dd-handle">@data?.unitName  <span class="m-2" title="Total Post"><i class="fa fa-users text-danger"></i> - @totalPost</span><span class="m-2" title="Total Officers"><i class="fa fa-user text-info"></i> - @totalemployees</span> <span class="m-2"><i class="fa fa-user-o" title="Blank Post"></i> - @blankPost</span></div>

