@model AssignmentViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout_Blank.cshtml";
}
<link href="~/css/dropify.min.css" rel="stylesheet" />

@*@section Style{
        <style>

        </style>
    }*@

<div class="row">
    <div class="col-md-12 col-12 mt-4">
        <div class="card">
            <div class="card-header">
                <h4 class="pt-2 pb-2 mt-2">@Model.fLang.Title</h4>
            </div>
            <div class="card-body">
                <form role="form" asp-area="Employee" asp-controller="Assignment" asp-action="Index">
                    <input type="hidden" name="AssignmentId" id="AssignmentId" value="" />
                    <input type="hidden" name="employeeId" id="employeeId" value="@ViewBag.employeeId" />

                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="policeUnitId">@Model.fLang.policeUnit</label>

                                <div class="col-md-8 col-12">
                                    <select class="form-control" name="policeUnitId" id="policeUnitId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.specialBranchUnits)
                                        {
                                            <option value="@item.Id">@item.branchUnitName</option>
                                        }

                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="policeSubUnitId">@Model.fLang.policeSubUnit</label>
                                <div class="col-md-8 col-12">

                                    <select class="form-control" name="policeSubUnitId" id="policeSubUnitId"></select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="designationId">@Model.fLang.designation</label>

                                <div class="col-md-8 col-12">
                                    <select class="form-control" name="designationId" id="designationId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.designations)
                                        {
                                            <option value="@item.Id">@item.designationName</option>
                                        }

                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="designationId">@Model.fLang.department</label>
                                <div class="col-md-8 col-12">

                                    <select class="form-control" name="departmentId" id="departmentId">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.departments)
                                        {
                                            <option value="@item.Id">@item.deptName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="EntryNo">@Model.fLang.EntryNo</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="EntryNo" name="EntryNo" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="assignmentTypeId">@Model.fLang.assignmentType</label>

                                <div class="col-md-8 col-12">
                                    <select class="form-control" name="assignmentTypeId" id="assignmentTypeId">
                                        <option value="">Select</option>
                                        <option value="1">Assignment</option>
                                        <option value="2">Transfer</option>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="StartDate">@Model.fLang.StartDate</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="StartDate" name="StartDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-group row">
                                <label class="col-md-4 col-12" for="EndDate">@Model.fLang.EndDate</label>

                                <div class="col-md-8 col-12">
                                    <input type="text" id="EndDate" name="EndDate" value="" class="form-control" />
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-md-12 col-12">
                            <div class="form-group row">
                                <label class="col-md-2 col-12" for="Remarks">@Model.fLang.Remarks</label>

                                <div class="col-md-10 col-12">
                                    <textarea required="" class="form-control" id="Remarks" name="Remarks" rows="5" data-parsley-id="24"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                            <div class="float-right">
                                <button type="reset" class="btn btn-danger">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>




<div class="row">
    <div class="col-lg-12 col-sm-12">
        <div class="card m-b-30">
            <div class="card-header">
                <h4 class="header-title">@Model.fLang.Title</h4>
            </div>
            <div class="card-body table-responsive">

                <div class="table-odd">
                    <table id="tblData" class="table table-bordered table-responsive text-nowrap">
                        <thead>
                            <tr>
                                <th>Sl#</th>
                                <th>@Model.fLang.employee</th>
                                <th>@Model.fLang.assignmentType</th>
                                <th>@Model.fLang.StartDate</th>
                                <th>@Model.fLang.EndDate</th>
                                <th>@Model.fLang.designation</th>
                                <th>@Model.fLang.department</th>
                                <th>@Model.fLang.EntryNo</th>
                                <th>@Model.fLang.action</th>

                            </tr>
                        </thead>

                        <tbody>
                            @{ 
                                int sl = 0;
                             @foreach (var item in Model.assignments)
                             {
                                 sl = sl + 1;

                                <tr>
                                    <td>@sl</td>
                                    <td>@item.employee.nameEnglish</td>
                                    <td>
                                        @if (item.assignmentTypeId == 1)
                                        {
                                            <span>Assignment</span>
                                        }
                                        else if (item.assignmentTypeId == 2)
                                        {
                                            <span>Transfer</span>
                                        }
                                        else
                                        {

                                        }
                                    </td>
                                    <td>@item.StartDate</td>
                                    <td>@item.EndDate</td>
                                    <td>@item.designation.designationName</td>
                                    <td>@item.department.deptName</td>
                                    <td>@item.EntryNo</td>
                                    <td>
                                        <button type="button" class="tabledit-edit-button btn btn-sm btn-info" style="float: none; margin: 5px;" onclick="EditAssignment(@item.Id,@item.employeeId,@item.assignmentTypeId,'@item.StartDate','@item.EndDate','@item.designationId',@item.departmentId,@item.EntryNo,'@item.Remarks')"><span class="ti-pencil"></span></button>
                                        <button type="button" class="tabledit-delete-button btn btn-sm btn-danger" style="float: none; margin: 5px;" onclick="Delete(@item.Id)"><span class="ti-trash"></span></button>
                                    </td>
                                </tr>
                            }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/dropify.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tblData').DataTable();

            $('#StartDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false });
            $('#EndDate').bootstrapMaterialDatePicker({ weekStart: 0, time: false });


        $("#policeUnitId").change(function(){
          var id=$(this).val();
          Common.Ajax('GET', '/Employee/Assignment/PoliceSubunits/' + id, [], 'json', ajaxSubUnits);
            })
        });




        function ajaxSubUnits(response){


            var options = '<option value="">Select </option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.Id + '">' + item.subunitName + '</option>';
            });
            $('#policeSubUnitId').empty();
            $('#policeSubUnitId').append(options);
        }


       function EditAssignment(Id,employeeId,assignmentTypeId,StartDate,EndDate,designationId,departmentId,EntryNo,Remarks){
        $("#AssignmentId").val(Id);
        $("#employeeId").val(employeeId);
        $("#assignmentTypeId").val(assignmentTypeId);
        $("#StartDate").val(StartDate);
        $("#EndDate").val(EndDate);
        $("#designationId").val(designationId);
        $("#departmentId").val(departmentId);
        $("#EntryNo").val(EntryNo);
        $("#Remarks").val(Remarks);
        }



        function Delete(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: "/Employee/AwardEntry/DeleteAssignment/" + Id,
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.reload();
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }
    </script>
}

